        },
        prev: () => { const k = plStep(-1); bpGo(k < 0 ? pl.i : k); },
        next: ended => { const k = plStep(1); if (k >= 0) return bpGo(k); if (ended) bpGo(pl.items.indexOf(plOrder()[0]), false); } });
