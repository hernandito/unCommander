  const fkShow = on => { $('.uc-fkeys').hidden = !on; const c = $('.uc-fkbar'); if (c) c.checked = on; store.set('fkHidden', !on); window.dispatchEvent(new Event('resize')); };
  fkShow(!store.get('fkHidden', false));
