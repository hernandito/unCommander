<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "uncommander">
<!ENTITY author    "hernandito">
<!ENTITY version   "2026.10.18">
<!ENTITY github    "hernandito/uncommander">
<!ENTITY branch    "main">
<!ENTITY raw       "https://raw.githubusercontent.com/&github;/&branch;">
<!ENTITY pluginURL "&raw;/&name;.plg">
<!ENTITY plugdir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY cfgdir    "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="UnCommander"
        pluginURL="&pluginURL;"
        icon="folder-open"
        support="https://forums.unraid.net/"
        min="6.12.0">

<CHANGES>
###2026.10.18
- FIRST PUBLIC RELEASE.
- Two-pane, Midnight Commander-style file manager in its own tab of the Unraid menu bar.
- Copy, move, delete (to trash or for good), rename, new folder, permissions, find - with F-keys or taps.
- Background jobs with progress, Undo, Restore from trash, practice mode.
- Batch rename, compress / extract (zip, tar, 7z, rar), folder sizes, compare folders.
- View and edit text files with colour highlighting; picture and PDF viewer.
- Optional Whole OS view: browse / like MC on the console.
- Midnight Commander theme, per-device text size, your own CSS, keyboard shortcuts list.
- Tools: empty folders on disks, movie folders without a video (Radarr), TV shows with missing episodes (TVmaze + Sonarr).
</CHANGES>

<!--
  Wipe the plugin folder first. Unraid will not overwrite a file that already
  exists, so without this an update could leave old files in place.
  Only /usr/local/emhttp (RAM) is touched - settings on the flash drive in
  /boot/config/plugins/uncommander are kept.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
pkill -f "/usr/local/emhttp/plugins/uncommander/include/worker.php" 2>/dev/null
rm -rf /usr/local/emhttp/plugins/uncommander
mkdir -p /usr/local/emhttp/plugins/uncommander /boot/config/plugins/uncommander
]]>
</INLINE>
</FILE>

