      if (!st.cues) return;
      const off = conv() ? st.t0 : 0;      // shown on the stream's own clock
      for (const [a, b, txt] of st.cues) if (b - off > 0) { try { tr.addCue(new VTTCue(Math.max(0, a - off), b - off, txt)); } catch (e) {} }
