      let ow = st.w, oh = st.h;
      if (ow * oh > CANVAS_MAX) { const f = Math.sqrt(CANVAS_MAX / (ow * oh)); ow = Math.round(ow * f); oh = Math.round(oh * f); }   // the device's canvas limit
      out.width = Math.max(1, ow); out.height = Math.max(1, oh);
