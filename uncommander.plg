        for (let i = 0; i < n; i++) { const e = ifd + 2 + i * 12; if (d.getUint16(e, le) === 0x0112) return { value: d.getUint16(e + 8, le), at: e + 8, le, has: true }; }
        return { value: 1, has: false, exif: true };
