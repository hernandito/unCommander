          <span class="ic">${mi(m.ic)}</span><span class="lb">${esc(m.label)}${m.sub ? `<small>${esc(m.sub)}</small>` : ''}</span>${m.lock ? '<span class="sc">🔒</span>' : keys && m.sc ? `<span class="sc">${m.sc}</span>` : ''}</button>`).join('')
