      let w = .9, h = w * RW() / a / RH();
      if (h > .9) { h = .9; w = h * a * RH() / RW(); }
      st.crop = { x: (1 - w) / 2, y: (1 - h) / 2, w, h };
    }
    function draw() {
      const c = st.crop;
      box.hidden = !c;
      if (c) Object.assign(box.style, { left: c.x * 100 + '%', top: c.y * 100 + '%', width: c.w * 100 + '%', height: c.h * 100 + '%' });
      fw.value = st.w; fh.value = st.h;
