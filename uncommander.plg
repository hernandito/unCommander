        if (shut) npCol.clear(); else { const key = plKeyer(); pl.items.forEach(p => { const k = key(p); npCol.add(k.ar); if (k.al) npCol.add(k.al); }); }
        npSaveCol(); npRows(); npScrollTo(npPos());
      }
