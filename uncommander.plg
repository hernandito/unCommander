  $j = json_decode((string)$raw, true);
  if ($code >= 400) {
    $msg = is_array($j) ? implode('; ', array_filter(array_map(fn($e) => is_array($e) ? ($e['errorMessage'] ?? $e['message'] ?? '') : (string)$e, isset($j['message']) ? [$j] : $j))) : '';
