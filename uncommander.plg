      const n = T.picked.size;
      b.hidden = !n; b.textContent = T.asking ? `Yes, delete ${n} empty folder${n === 1 ? '' : 's'}` : `Delete ${n} empty folder${n === 1 ? '' : 's'}…`;
      bGo.hidden = T.asking || ['running', 'queued'].includes((T.last || {}).state);
