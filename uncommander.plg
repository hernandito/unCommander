/* a folder on this server, as Lidarr sees it (through the folder pairs in Settings) */
function uc_lidarr_path(array $c, string $hp): ?string {
  $best = null; $len = -1;
  foreach ($c['map'] as $m) if (($hp === $m['host'] || str_starts_with($hp, $m['host'] . '/')) && strlen($m['host']) > $len) { $best = $m['lidarr'] . substr($hp, strlen($m['host'])); $len = strlen($m['host']); }
  return $best;
}
/* what was asked of Lidarr, per album folder - kept next to History (on the array) */
function uc_lidarr_jobs_file(): string { return uc_data_file('lidarr-jobs.json'); }
function uc_lidarr_jobs(): array { $f = uc_lidarr_jobs_file(); return is_file($f) ? (json_decode((string)file_get_contents($f), true) ?: []) : []; }
function uc_lidarr_job_set(string $p, array $v): array {
  $f = uc_lidarr_jobs_file(); if (!is_dir(dirname($f))) @mkdir(dirname($f), 0777, true);
  $h = fopen("$f.lock", 'c'); if ($h) flock($h, LOCK_EX);
  $all = uc_lidarr_jobs();
  $all[$p] = array_merge($all[$p] ?? [], $v, ['at' => time()]);
  /* finished ones are forgotten after two weeks */
  foreach ($all as $k => $x) if (in_array($x['state'] ?? '', ['sent', 'failed', 'nothing'], true) && time() - ($x['at'] ?? 0) > 14 * 86400) unset($all[$k]);
  @file_put_contents("$f.tmp", json_encode($all, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)); @rename("$f.tmp", $f);
  if ($h) { flock($h, LOCK_UN); fclose($h); }
  return $all[$p];
}
function uc_sonarr_hostpath(array $c, string $rp): ?string {
  $best = null;
  foreach ($c['map'] as $m) if ($rp === $m['sonarr'] || str_starts_with($rp, rtrim($m['sonarr'], '/') . '/')) {
    if (!$best || strlen($m['sonarr']) > strlen($best['sonarr'])) $best = $m;
  }
  return $best ? $best['host'] . substr($rp, strlen(rtrim($best['sonarr'], '/'))) : null;
}
function uc_sonarr_path(array $c, string $host): ?string {
  $best = null;
  foreach ($c['map'] as $m) if ($host === $m['host'] || str_starts_with($host, $m['host'] . '/')) {
    if (!$best || strlen($m['host']) > strlen($best['host'])) $best = $m;
  }
  return $best ? rtrim($best['sonarr'], '/') . substr($host, strlen($best['host'])) : null;
}
/* What was sent to Sonarr, per show folder (flash drive) */
function uc_sonarr_hist(?array $set = null): array { return uc_tv_store('sonarr', $set); }
function uc_sonarr_note(string $path, array $o): array {
  $h = uc_sonarr_hist();
  $h[$path] = array_merge($h[$path] ?? [], $o, ['at' => time()]);
  uc_sonarr_hist($h);
  return $h[$path];
}

/* A title reduced to plain letters and digits for comparing ("Amélie!" = "amelie").
 * Built in on purpose: unRAID's PHP has no iconv or intl. */
function uc_fold(string $t): string {
  static $map = null;
  if ($map === null) {
    $map = [];
    foreach (['a' => 'àáâãäåāăą', 'c' => 'çćĉċč', 'd' => 'ďđ', 'e' => 'èéêëēĕėęě', 'g' => 'ĝğġģ', 'h' => 'ĥħ', 'i' => 'ìíîïĩīĭįı',
              'j' => 'ĵ', 'k' => 'ķ', 'l' => 'ĺļľŀł', 'n' => 'ñńņňŉ', 'o' => 'òóôõöøōŏő', 'r' => 'ŕŗř', 's' => 'śŝşšș', 't' => 'ţťŧț',
              'u' => 'ùúûüũūŭůűų', 'w' => 'ŵ', 'y' => 'ýÿŷ', 'z' => 'źżž', 'ae' => 'æ', 'oe' => 'œ', 'ss' => 'ß', 'th' => 'þ'] as $to => $chars)
      foreach (preg_split('//u', $chars, -1, PREG_SPLIT_NO_EMPTY) as $ch) { $map[$ch] = $to; $map[mb_strtoupper($ch)] = $to; }
    $map['&'] = 'and';
  }
  return preg_replace('/[^a-z0-9]+/', '', strtolower(strtr($t, $map)));
}

/* What was sent to Radarr, per movie folder - kept on the flash drive so it
 * survives new scans and reboots. */
function uc_radarr_hist(?array $set = null): array {
  $f = uc_data_file('radarr-sent.json');
  if ($set !== null) { file_put_contents("$f.tmp", json_encode($set, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)); rename("$f.tmp", $f); return $set; }
  return is_file($f) ? (json_decode(file_get_contents($f), true) ?: []) : [];
}
function uc_radarr_note(string $path, array $o): array {
  $h = uc_radarr_hist();
  $h[$path] = array_merge($h[$path] ?? [], $o, ['at' => time()]);
  uc_radarr_hist($h);
  return $h[$path];
}
/* the path Radarr sees -> the same folder on this server (the pairs, the other way) */
function uc_radarr_hostpath(array $c, string $rp): ?string {
  $best = null;
  foreach ($c['map'] as $m) if ($rp === $m['radarr'] || str_starts_with($rp, rtrim($m['radarr'], '/') . '/')) {
    if (!$best || strlen($m['radarr']) > strlen($best['radarr'])) $best = $m;
  }
  return $best ? $best['host'] . substr($rp, strlen(rtrim($best['radarr'], '/'))) : null;
}

/* server folder -> the path Radarr sees, using the saved pairs */
function uc_radarr_path(array $c, string $host): ?string {
  $best = null;
  foreach ($c['map'] as $m) if ($host === $m['host'] || str_starts_with($host, $m['host'] . '/')) {
    if (!$best || strlen($m['host']) > strlen($best['host'])) $best = $m;
  }
  return $best ? rtrim($best['radarr'], '/') . substr($host, strlen($best['host'])) : null;
}

/* Sonarr/Radarr must use the folder we're looking at - the one that already
 * holds part of the show or movie. If the item points somewhere else:
 *   - that other folder is missing or has no videos -> point the item here
 *     (nothing is moved);
 *   - it has videos too -> stop and say so, so nothing gets split further. */
function uc_has_video(string $dir): bool {
  if (!is_dir($dir)) return false;
  $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS));
  $n = 0;
  foreach ($it as $f) { if (++$n > 20000) return true; if ($f->isFile() && preg_match('/\.(mkv|mp4|m4v|avi|ts|m2ts|wmv|mov|mpe?g|iso)$/i', $f->getFilename())) return true; }
  return false;
}
function uc_arr_same_folder(string $app, array $item, string $want, callable $toHost, callable $get, callable $put): array {
  $have = rtrim((string)($item['path'] ?? ''), '/');
  if ($have === '' || $have === rtrim($want, '/')) return $item;
  $other = $toHost($have);
  if ($other !== null && uc_has_video($other))
    throw new UcError("$app already has this in another folder: " . $other . " - and there are videos there too. Merge the two folders (or change the path in $app) first, so the files don't end up split across both.");
  $full = $get();
  $full['path'] = rtrim($want, '/');
  return (array)$put($full) ?: $full;
}

/* ---------- undo for copies ----------
 * A copy, move or Compare copy that may replace files runs rsync with
 * --backup-dir pointing into the trash, so every file it replaces is kept.
 * The worker also records what it wrote. Undo then moves the new copies to
 * the trash and puts the replaced files back. */
define('UC_UNDO', UC_STATE . '/undo');
function uc_undo_meta(string $id): ?array {
  if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) return null;
  $f = UC_UNDO . "/$id.json";
  return is_file($f) ? json_decode(file_get_contents($f), true) : null;
}
/* A trash entry that holds files to merge back into a folder (not one item). */
function uc_trash_merge_bin(string $dest, string $label): string {
  $root = uc_trash_root(rtrim($dest, '/') . '/x');
  $bin = "$root/" . date('Ymd-His') . " $label";
  for ($k = 2; file_exists($bin); $k++) $bin = "$root/" . date('Ymd-His') . " $label ($k)";
  return $bin;
}
function uc_trash_merge_mark(string $bin, string $dest): void {
  file_put_contents("$bin/.uncommander-origin", $dest);
  touch("$bin/.uncommander-merge");
}
/* Move everything under $from into $to, replacing files that are there.
 * Returns how many files moved; empty folders left in $from are removed. */
function uc_merge_back(string $from, string $to): int {
  $n = 0;
  if (!is_dir($from)) return 0;
  $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($from, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::SELF_FIRST);
  $files = [];
  foreach ($it as $p => $info) {
    $rel = substr($p, strlen($from) + 1);
    if ($info->isDir() && !$info->isLink()) { if (!is_dir("$to/$rel")) @mkdir("$to/$rel", 0777, true); continue; }
    $files[] = $rel;
  }
  foreach ($files as $rel) {
    $t = "$to/$rel";
    if (is_dir($t) && !is_link($t)) continue;            // a folder took its place - leave it in the trash
    if (!is_dir(dirname($t))) @mkdir(dirname($t), 0777, true);
    if (@rename("$from/$rel", $t)) $n++;
  }
  exec('find ' . escapeshellarg($from) . ' -depth -type d -empty -delete 2>/dev/null');
  return $n;
}

function uc_json($data, int $code = 200): never {
  http_response_code($code);
  header('Content-Type: application/json');
  echo json_encode($data, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
  exit;
}

function uc_job_file(string $id): string {
  if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) throw new UcError('Bad job id');
  return UC_JOBS . "/$id.json";
}
function uc_job_read(string $id): ?array {
  $f = uc_job_file($id);
  return is_file($f) ? json_decode(file_get_contents($f), true) : null;
}
/* While unCommander's progress window shows a job, the page "touches" a
 * small .watch file every few seconds. When the job ends, a fresh .watch means
 * someone saw it finish - nothing more to say. A stale one means they pressed
 * "Continue in background", closed the tab or went to another page: then the
 * job gets an alert row on unCommander's page (until dismissed, on every
 * device) and, if enabled, a normal unRAID notification. */
function uc_job_watch_file(string $id): string { return substr(uc_job_file($id), 0, -5) . '.watch'; }
function uc_job_touch(string $id): void { @touch(uc_job_watch_file($id)); }
function uc_job_watched(string $id): bool {
  $f = uc_job_watch_file($id);
  clearstatcache(true, $f);
  return is_file($f) && time() - filemtime($f) <= 15;
}
function uc_job_announce(array &$job): void {
  if (uc_job_watched($job['id'])) { $job['seen'] = true; return; }   // watched to the end: not logged
  $job['alert'] = true;
  if (!uc_settings()['notify_unraid']) return;
  $took = max(0, ($job['finished'] ?? time()) - ($job['started'] ?? $job['created'] ?? time()));
  $failed = $job['state'] === 'failed';
  $verb = ['copy' => 'Copy', 'move' => 'Move', 'perms' => 'Permissions change', 'back' => 'Undo'][$job['type']] ?? 'Job';
  $what = ['done' => 'finished', 'failed' => 'FAILED', 'cancelled' => 'cancelled'][$job['state']] ?? $job['state'];
  $bits = [$job['label'] ?? $verb];
  if (!empty($job['files'])) $bits[] = number_format($job['files']) . ' files';
  if (!empty($job['bytes'])) $bits[] = uc_human_bytes((int)$job['bytes']);
  $bits[] = 'took ' . uc_human_time($took);
  $desc = implode(' - ', $bits) . ($job['error'] ? '. ' . $job['error'] : '');
  $desc = str_replace('→', 'to', $desc);
  $notify = '/usr/local/emhttp/webGui/scripts/notify';
  if (is_executable($notify))
    exec(implode(' ', array_map('escapeshellarg', [$notify, '-e', 'unCommander', '-s', "unCommander: $verb $what", '-d', $desc,
      '-i', $failed ? 'alert' : ($job['state'] === 'cancelled' ? 'warning' : 'normal'), '-l', '/UnCommander'])) . ' >/dev/null 2>&1');
}
function uc_human_bytes(int $n): string {
  $u = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']; $i = 0; $v = $n;
  while ($v >= 1000 && $i < count($u) - 1) { $v /= 1000; $i++; }
  return ($i ? number_format($v, $v < 10 ? 1 : 0) : $v) . ' ' . $u[$i];
}
function uc_human_time(int $s): string {
  if ($s < 60) return "$s s";
  if ($s < 3600) return intdiv($s, 60) . ' min' . ($s % 60 && $s < 600 ? ' ' . ($s % 60) . ' s' : '');
  return intdiv($s, 3600) . ' h ' . intdiv($s % 3600, 60) . ' min';
}

function uc_job_forget(string $id): void {
  $b = substr(uc_job_file($id), 0, -5);
  foreach (['.json', '.log', '.watch'] as $x) @unlink($b . $x);
}

function uc_job_write(array $job): void {
  @mkdir(UC_JOBS, 0700, true);
  $f = uc_job_file($job['id']);
  file_put_contents("$f.tmp", json_encode($job, JSON_UNESCAPED_SLASHES));
  rename("$f.tmp", $f);
}

/* Auto-refresh: a fingerprint of each folder's last-changed time. One
 * find -maxdepth 0 stats the folders themselves - nothing is listed. A share
 * folder (/mnt/user/...) is checked on every disk/pool that holds it, as a
 * file added on disk2 doesn't change the time the share shows. */
function uc_watch_sigs(array $paths): array {
  $out = []; $who = [];
  foreach ($paths as $want) {
    $out[$want] = '';
    try { $dir = $want === '/' || $want === '' ? '/mnt' : uc_path($want); } catch (Throwable $e) { continue; }
    $list = [$dir];
    if (preg_match('#^/mnt/(user0?)(/.*)?$#', $dir, $m))
      foreach (uc_array_mounts() as $d) if ($m[1] === 'user' || str_starts_with($d, 'disk')) $list[] = "/mnt/$d" . ($m[2] ?? '');
    foreach ($list as $x) $who[$x][] = $want;
  }
  if ($who) {
    $raw = (string)shell_exec('find -H ' . implode(' ', array_map('escapeshellarg', array_keys($who))) . ' -maxdepth 0 -printf ' . escapeshellarg('%p\t%T@\0') . ' 2>/dev/null');
    foreach (explode("\0", $raw) as $rec) {
      $t = strrpos($rec, "\t"); if ($t === false) continue;
      $p = substr($rec, 0, $t);
      foreach ($who[$p] ?? [] as $want) $out[$want] .= "$p=" . substr($rec, $t + 1) . ';';
    }
  }
  foreach ($out as $k => $v) $out[$k] = $v === '' ? 'gone' : md5($v);
  return $out;
}

/* ---------- TV shows: TVmaze (no key needed) ----------
 * TVmaze allows about 20 requests per 10 seconds, so every call is spaced at
 * least 0.6 s apart, and a "slow down" (429) waits and tries again - 10 s,
 * then 20 s, then 40 s - instead of giving up on the show. */
function uc_tvmaze_base(): string { return rtrim(getenv('UC_TVMAZE') ?: 'https://api.tvmaze.com', '/'); }
/* GET a TVmaze path. Returns the decoded JSON, null for "not found", and throws
 * a UcError if TVmaze can't be reached. */
function uc_tvmaze_get(string $path) {
  static $last = 0.0;
  $wait = 10;
  for ($try = 0; $try < 4; $try++) {
    $gap = 0.6 - (microtime(true) - $last);
    if ($gap > 0) usleep((int)($gap * 1e6));
    $last = microtime(true);
    $ch = curl_init(uc_tvmaze_base() . '/' . ltrim($path, '/'));
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => true, CURLOPT_MAXREDIRS => 3,
      CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_TIMEOUT => 30, CURLOPT_USERAGENT => 'unCommander (unRAID plugin)',
      CURLOPT_HTTPHEADER => ['Accept: application/json']]);
    $raw = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE); $err = curl_error($ch);
    curl_close($ch);
    if ($raw === false) throw new UcError("Can't reach TVmaze ($err)");
    if ($code === 429) { sleep($wait); $wait *= 2; continue; }
    /* a hiccup on TVmaze's side (502, 503, 504, Cloudflare's 52x): try again shortly */
    if ($code >= 500 && $try < 2) { sleep(1 + $try); continue; }
    if ($code === 404) return null;
    if ($code >= 400) throw new UcError("TVmaze answered with error $code");
    $j = json_decode((string)$raw, true);
    if ($j === null && trim((string)$raw) !== 'null') throw new UcError("TVmaze sent an answer that isn't readable (HTTP $code)");
    return $j;
  }
  throw new UcError('TVmaze is busy (too many requests) - try again in a few minutes');
}
/* A show and its regular episodes (no specials), cached in memory (/tmp):
 * ended shows for 30 days, running ones for 12 hours. */
function uc_tv_show(int $id, bool $cachedOnly = false): ?array {
  $dir = UC_STATE . '/tvmaze'; @mkdir($dir, 0700, true);
  $f = "$dir/$id.json";
  $c = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
  if ($c && time() - ($c['fetched'] ?? 0) < (($c['show']['status'] ?? '') === 'Ended' ? 30 * 86400 : 12 * 3600)) return $c;
  if ($cachedOnly) return $c;
  /* one call normally; if TVmaze chokes on the combined answer (it happens with
   * some shows), ask for the show and its episodes separately */
  try { $j = uc_tvmaze_get("shows/$id?embed=episodes"); }
  catch (UcError $e) {
    $j = uc_tvmaze_get("shows/$id");
    if ($j) $j['_embedded']['episodes'] = (array)uc_tvmaze_get("shows/$id/episodes");
  }
  if (!$j) return null;
  if (!isset($j['_embedded']['episodes'])) $j['_embedded']['episodes'] = (array)uc_tvmaze_get("shows/$id/episodes");
  $eps = [];
  foreach ((array)($j['_embedded']['episodes'] ?? []) as $e) {
    if (($e['type'] ?? 'regular') !== 'regular' || !isset($e['season'], $e['number']) || (int)$e['season'] < 1) continue;
    $eps[] = [(int)$e['season'], (int)$e['number'], (string)($e['airdate'] ?? ''), mb_substr((string)($e['name'] ?? ''), 0, 120)];
  }
  $c = ['fetched' => time(), 'show' => uc_tv_brief($j), 'eps' => $eps];
  file_put_contents("$f.tmp", json_encode($c, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE)); rename("$f.tmp", $f);
  return $c;
}
/* Sonarr's numbering (TheTVDB order) for a show, from Sonarr's own listings
 * service - no key needed. Only asked for when your files don't line up with
 * TVmaze (a season released in two halves, "parts", DVD order...), because
 * Sonarr is the one that will name and fetch the files. Cached like TVmaze's.
 * Returns [[season, episode, airdate, title], ...] or null. Never throws. */
function uc_skyhook_base(): string { return rtrim(getenv('UC_SKYHOOK') ?: 'https://skyhook.sonarr.tv/v1/tvdb/shows/en', '/'); }
function uc_tv_sonarr_eps(int $tvdb, bool $ended = false): ?array {
  static $down = false;   // unreachable once: don't wait on it again for every show
  if ($tvdb < 1) return null;
  $dir = UC_STATE . '/tvmaze'; @mkdir($dir, 0700, true);
  $f = "$dir/sonarr-$tvdb.json";
  $c = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
  if ($c && time() - ($c['fetched'] ?? 0) < ($ended ? 30 * 86400 : 12 * 3600)) return $c['eps'] ?: null;
  if ($down) return $c['eps'] ?? null;
  $ch = curl_init(uc_skyhook_base() . "/$tvdb");
  curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => true, CURLOPT_MAXREDIRS => 3,
    CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_TIMEOUT => 30, CURLOPT_USERAGENT => 'unCommander (unRAID plugin)', CURLOPT_HTTPHEADER => ['Accept: application/json']]);
  $raw = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE); curl_close($ch);
  if ($raw === false || ($code >= 400 && $code !== 404)) { $down = true; return $c['eps'] ?? null; }   // can't ask now: last known answer, if any
  $j = $code === 404 ? [] : (json_decode((string)$raw, true) ?: []);
  $eps = [];
  foreach ((array)($j['episodes'] ?? []) as $e) {
    if (!isset($e['seasonNumber'], $e['episodeNumber']) || (int)$e['seasonNumber'] < 1) continue;
    $eps[] = [(int)$e['seasonNumber'], (int)$e['episodeNumber'], substr((string)($e['airDate'] ?? $e['airDateUtc'] ?? ''), 0, 10), mb_substr((string)($e['title'] ?? ''), 0, 120)];
  }
  usort($eps, fn($a, $b) => [$a[0], $a[1]] <=> [$b[0], $b[1]]);
  file_put_contents("$f.tmp", json_encode(['fetched' => time(), 'eps' => $eps], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE)); rename("$f.tmp", $f);
  return $eps ?: null;
}
/* How badly a folder's episode numbers fit an episode list: files the list doesn't
 * have, and aired episodes (3+ days ago) the folder doesn't have. */
function uc_tv_misfit(array $have, array $eps): array {
  $cut = date('Y-m-d', time() - 3 * 86400); $known = []; $miss = 0;
  foreach ($eps as $ep) { $known["{$ep[0]}.{$ep[1]}"] = true; if ($ep[2] !== '' && $ep[2] <= $cut && !isset($have["{$ep[0]}.{$ep[1]}"])) $miss++; }
  $unk = 0; foreach ($have as $k => $_) if (!isset($known[$k])) $unk++;
  return [$unk, $miss];
}
/* A scanned show whose files don't line up with TVmaze: check them against
 * Sonarr's numbering, and use that list when it fits better. */
function uc_tv_try_sonarr_order(array &$row): bool {
  if (empty($row['show']) || empty($row['eps']) || !empty($row['order']) || empty($row['show']['tvdb'])) return false;
  $have = array_fill_keys(array_map('strval', (array)($row['have'] ?? [])), true);
  [$u, $m] = uc_tv_misfit($have, $row['eps']);
  if ($u < 2 || $m < 1 || min($u, $m) / max($u, $m) < 0.5) return false;   // same test as "Needs a look" in the browser
  $alt = uc_tv_sonarr_eps((int)$row['show']['tvdb'], ($row['show']['status'] ?? '') === 'Ended');
  if (!$alt) return false;
  [$u2, $m2] = uc_tv_misfit($have, $alt);
  /* only when it really explains the files: (almost) every file is on Sonarr's list,
   * and far fewer episodes are left over than with TVmaze's */
  if ($u2 > max(1, (int)floor(count($have) * 0.05)) || ($u2 + $m2) * 2 > $u + $m) return false;
  $row['eps'] = $alt; $row['order'] = 'sonarr';
  $row['tvmaze_fit'] = [$u, $m];
  return true;
}
/* the few show fields unCommander uses */
function uc_tv_brief(array $j): array {
  return ['id' => (int)($j['id'] ?? 0), 'name' => (string)($j['name'] ?? ''), 'year' => substr((string)($j['premiered'] ?? ''), 0, 4) ?: null,
          'status' => (string)($j['status'] ?? ''), 'type' => (string)($j['type'] ?? ''), 'network' => (string)($j['network']['name'] ?? $j['webChannel']['name'] ?? ''),
          'poster' => $j['image']['medium'] ?? null, 'url' => (string)($j['url'] ?? ''), 'tvdb' => $j['externals']['thetvdb'] ?? null, 'imdb' => $j['externals']['imdb'] ?? null,
          'rating' => isset($j['rating']['average']) ? (float)$j['rating']['average'] : null, 'genres' => array_slice((array)($j['genres'] ?? []), 0, 4),
          'ended' => (string)($j['ended'] ?? ''),
          'summary' => mb_substr(trim(html_entity_decode(strip_tags((string)($j['summary'] ?? '')), ENT_QUOTES, 'UTF-8')), 0, 400)];
}
/* TVmaze show search -> short candidate list */
function uc_tv_search(string $q): array {
  $out = [];
  /* folder names can't hold ":" so it's often a "-" ("Star Trek- Picard"); a dash
   * can also upset the search - search on the words only */
  $q = trim(preg_replace('/\s+/', ' ', preg_replace('/\s*[-–—:|\/]+\s*/u', ' ', $q)));
  foreach ((array)uc_tvmaze_get('search/shows?q=' . rawurlencode($q)) as $hit) if (!empty($hit['show']['id'])) $out[] = uc_tv_brief($hit['show']) + ['score' => $hit['score'] ?? 0];
  return $out;
}
/* "The Office (US)" / "The.Office" / "Office, The" -> "office us" - for comparing titles */
function uc_tv_norm(string $t): string {
  $t = preg_replace('/,\s*(the|a|an)\s*$/i', '', trim($t));
  $t = str_replace('&', ' and ', mb_strtolower($t));
  $t = implode(' ', array_map('uc_fold', preg_split('/[^\p{L}\p{N}]+/u', $t, -1, PREG_SPLIT_NO_EMPTY)));
  $t = preg_replace('/,\s*the$/', '', $t);
  $t = preg_replace('/[^a-z0-9]+/', ' ', $t);
  $t = preg_replace('/^(the|a|an) /', '', trim($t));
  return trim($t);
}
/* Which show each folder is (found automatically or picked by you), and your
 * choices per show (ignore it, ignore seasons, mark complete). Small files on
 * the flash drive, written only when something changes. */
function uc_tv_store(string $what, ?array $set = null): array {
  $f = uc_data_file('tv-' . $what . '.json');
  if ($set !== null) { file_put_contents("$f.tmp", json_encode($set, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)); rename("$f.tmp", $f); return $set; }
  return is_file($f) ? (json_decode((string)file_get_contents($f), true) ?: []) : [];
}

require_once __DIR__ . '/history.php';

/* ---------- music tags ----------
 * One set of fields for every kind of file; ffmpeg writes each the way that
 * kind keeps it (ID3v2.3 in MP3, Vorbis comments in FLAC/OGG, iTunes tags in
 * M4A). Only the tags change: the sound is copied as it is, and checked. */
const UC_TAG_FIELDS = ['title', 'artist', 'album', 'album_artist', 'date', 'track', 'disc', 'genre', 'composer', 'comment'];
function uc_tag_kind(string $p): string {
  $e = strtolower(pathinfo($p, PATHINFO_EXTENSION));
  return ['mp3' => 'mp3', 'flac' => 'vorbis', 'ogg' => 'ogg', 'oga' => 'ogg', 'opus' => 'ogg', 'm4a' => 'mp4', 'm4b' => 'mp4'][$e] ?? '';
}
function uc_tags_read(string $p, string $ff): array {
  $o = [];
  exec('timeout 15 ' . escapeshellarg($ff) . ' -hide_banner -loglevel error -nostdin -i ' . escapeshellarg(uc_direct($p)) . ' -f ffmetadata - 2>/dev/null', $o);
  $raw = [];
  for ($i = 1, $n = count($o); $i < $n; $i++) {
    $l = $o[$i];
    if ($l === '' || $l[0] === ';' || $l[0] === '#') continue;
    if ($l[0] === '[') break;                                  // stream and chapter sections: not the song's tags
    while (preg_match('/(?<!\\\\)(\\\\\\\\)*\\\\$/', $l) && $i + 1 < $n) $l = substr($l, 0, -1) . "\n" . $o[++$i];   // a value over several lines
    $eq = -1;
    for ($k = 0, $len = strlen($l); $k < $len; $k++) { if ($l[$k] === '\\') { $k++; continue; } if ($l[$k] === '=') { $eq = $k; break; } }
    if ($eq < 1) continue;
    $un = fn($s) => preg_replace('/\\\\(.)/s', '$1', $s);
    $raw[strtolower($un(substr($l, 0, $eq)))] = $un(substr($l, $eq + 1));
  }
  $alias = ['albumartist' => 'album_artist', 'album artist' => 'album_artist', 'tracknumber' => 'track', 'discnumber' => 'disc', 'year' => 'date', 'tdrc' => 'date', 'tyer' => 'date'];
  $tags = [];
  foreach ($raw as $k => $v) { $k = $alias[$k] ?? $k; if (in_array($k, UC_TAG_FIELDS, true) && !isset($tags[$k])) $tags[$k] = $v; }
  $o = [];
  exec('timeout 15 ' . escapeshellarg($ff) . ' -hide_banner -nostdin -i ' . escapeshellarg(uc_direct($p)) . ' 2>&1', $o);
  $codec = ''; $cover = false;
  foreach ($o as $l) {
    if (!$codec && preg_match('/Stream #0:\d+.*?: Audio: (\w+)/', $l, $m)) $codec = $m[1];
    if (str_contains($l, 'attached pic')) $cover = true;
  }
  $kind = uc_tag_kind($p);
  $ro = '';
  if (!$kind) $ro = "Tags can't be changed in ." . strtolower(pathinfo($p, PATHINFO_EXTENSION)) . ' files';
  elseif (!$codec) $ro = "This doesn't look like a sound file ffmpeg can read";
  elseif ($kind === 'ogg' && $cover) $ro = 'This OGG file has a picture inside; its tags are left alone so the picture isn\'t lost';
  return ['tags' => (object)$tags, 'cover' => $cover, 'codec' => $codec, 'kind' => $kind, 'ro' => $ro];
}
/* MusicBrainz: free, no key; asks for at most one request a second and a name in User-Agent */
function uc_mb_base(): string { return rtrim(getenv('UC_MB') ?: 'https://musicbrainz.org/ws/2', '/'); }
function uc_caa_base(): string { return rtrim(getenv('UC_CAA') ?: 'https://coverartarchive.org', '/'); }
function uc_mb_get(string $path) {
  static $last = 0.0;
  for ($try = 0; $try < 3; $try++) {
    $gap = 1.05 - (microtime(true) - $last);
    if ($gap > 0) usleep((int)($gap * 1e6));
    $last = microtime(true);
    $ch = curl_init(uc_mb_base() . '/' . ltrim($path, '/'));
    curl_setopt_array($ch, [CURLOPT_RETURNTRANSFER => true, CURLOPT_FOLLOWLOCATION => true, CURLOPT_MAXREDIRS => 3,
      CURLOPT_CONNECTTIMEOUT => 8, CURLOPT_TIMEOUT => 30, CURLOPT_USERAGENT => 'unCommander/1 ( https://github.com/hernandito/unCommander )',
      CURLOPT_HTTPHEADER => ['Accept: application/json']]);
    $raw = curl_exec($ch); $code = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE); $err = curl_error($ch);
    curl_close($ch);
    if ($raw === false) throw new UcError("Can't reach MusicBrainz ($err)");
    if ($code === 503 || $code === 429) { sleep(2 + 2 * $try); continue; }
    if ($code === 404) return null;
    if ($code >= 400) throw new UcError("MusicBrainz answered with error $code");
    $j = json_decode((string)$raw, true);
    if (!is_array($j)) throw new UcError("MusicBrainz sent an answer that isn't readable");
    return $j;
  }
  throw new UcError('MusicBrainz is busy - try again in a minute');
}
function uc_mb_credit($ac): string {
  $s = '';
  foreach ((array)$ac as $c) $s .= ($c['name'] ?? ($c['artist']['name'] ?? '')) . ($c['joinphrase'] ?? '');
  return trim($s);
}

/* ---------- playlists ----------
 * Preferences (where each app's playlists go, how its paths look, the Plex
 * address and token) in playlists.json next to the settings; the token never
 * goes back to the browser. */
function uc_pl_prefs(): array {
  $f = uc_data_file('playlists.json');
  $p = is_file($f) ? (json_decode((string)file_get_contents($f), true) ?: []) : [];
  return array_merge(['targets' => [], 'last' => 'navidrome', 'plex_url' => '', 'plex_token' => '', 'jf_url' => '', 'jf_key' => '', 'jf_user' => '', 'jf_uname' => ''], $p);
}
function uc_pl_prefs_save(array $p): void {
  $f = uc_data_file('playlists.json');
  file_put_contents("$f.tmp", json_encode($p, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE));
  rename("$f.tmp", $f);
}
/* Docker folder mappings of the containers whose name or image matches: [{app, container, host}] */
function uc_docker_maps(string $re): array {
  $out = [];
  if (is_executable('/usr/bin/docker')) {
    foreach (explode("\n", (string)shell_exec("/usr/bin/docker ps -a --format '{{.Names}}|{{.Image}}' 2>/dev/null")) as $l) {
      [$name, $img] = array_pad(explode('|', trim($l), 2), 2, '');
      if ($name === '' || !preg_match($re, "$name $img")) continue;
      foreach (explode("\n", (string)shell_exec('/usr/bin/docker inspect -f ' . escapeshellarg('{{range .Mounts}}{{.Destination}}|{{.Source}}{{"\n"}}{{end}}') . ' ' . escapeshellarg($name) . ' 2>/dev/null')) as $m) {
        [$dst, $src] = array_pad(explode('|', trim($m), 2), 2, '');
        if ($dst !== '' && $src !== '') $out[] = ['app' => $name, 'image' => $img, 'container' => rtrim($dst, '/') ?: '/', 'host' => rtrim($src, '/')];
      }
    }
  }
  if (!$out) foreach (glob('/boot/config/plugins/dockerMan/templates-user/*.xml') ?: [] as $t) {
    $x = @simplexml_load_file($t); if (!$x) continue;
    $name = (string)$x->Name;
    if (!preg_match($re, $name . ' ' . (string)$x->Repository)) continue;
    foreach ($x->Config as $cfg) {
      if ((string)$cfg['Type'] !== 'Path') continue;
      $dst = rtrim((string)$cfg['Target'], '/'); $src = rtrim(trim((string)$cfg) ?: (string)$cfg['Default'], '/');
      if ($dst !== '' && $src !== '') $out[] = ['app' => $name, 'image' => (string)$x->Repository, 'container' => $dst, 'host' => $src];
    }
  }
  return $out;
}
/* "a/../b" and "./" out of a path */
function uc_norm_path(string $p): string {
  $abs = str_starts_with($p, '/'); $out = [];
  foreach (explode('/', $p) as $s) {
    if ($s === '' || $s === '.') continue;
    if ($s === '..') { if ($out && end($out) !== '..') array_pop($out); elseif (!$abs) $out[] = '..'; continue; }
    $out[] = $s;
  }
  return ($abs ? '/' : '') . implode('/', $out);
}

/* Unassigned Devices' network shares (Main › Unassigned Devices › Remote shares): each one, where it
 * mounts (/mnt/remotes/...), and whether it's mounted now. Mounting goes through UD's own script, so
 * UD shows the same state and its credentials are used. */
const UC_UD_RC = '/usr/local/sbin/rc.unassigned';
function uc_ud_mounts(): array {
  $m = [];
  foreach (@file(getenv('UC_MOUNTS') ?: '/proc/mounts', FILE_IGNORE_NEW_LINES) ?: [] as $l) {
    $f = explode(' ', $l); if (count($f) < 3) continue;
    $dec = fn($x) => preg_replace_callback('/\\\\([0-7]{3})/', fn($o) => chr(octdec($o[1])), $x);
    $m[] = ['src' => $dec($f[0]), 'at' => $dec($f[1]), 'type' => $f[2]];
  }
  return $m;
}
function uc_ud_remotes(): array {
  $f = is_file('/tmp/unassigned.devices/config/samba_mount.cfg') ? '/tmp/unassigned.devices/config/samba_mount.cfg' : '/boot/config/plugins/unassigned.devices/samba_mount.cfg';
  $ini = is_file($f) ? (@parse_ini_file($f, true, INI_SCANNER_RAW) ?: []) : [];
  $mounts = uc_ud_mounts(); $out = [];
  foreach ($ini as $src => $o) {
    if (!is_array($o)) continue;
    $src = (string)$src; $nfs = !str_starts_with($src, '//');
    /* UD's name for the mount: the one set in UD, else SERVER_share */
    $mp = trim((string)($o['mountpoint'] ?? ''), '"');
    if ($mp === '') $mp = $nfs ? preg_replace('#[:/]+#', '_', trim(preg_replace('#^([^:]+):/*(.*)$#', '$1_$2', $src), '/')) : preg_replace('#/+#', '_', ltrim($src, '/'));
    $path = '/mnt/remotes/' . $mp; $mounted = false;
    $share = strtolower(preg_replace('#^//[^/]+#', '', preg_replace('#^[^:]+:#', '', $src)));
    foreach ($mounts as $m) {
      if (!str_starts_with($m['at'], '/mnt/remotes/')) continue;
      $ms = strtolower(preg_replace('#^//[^/]+#', '', preg_replace('#^[^:]+:#', '', $m['src'])));
      if ($m['at'] === $path || (strcasecmp($m['src'], $src) === 0) || ($share !== '' && $ms === $share && strtolower(basename($m['at'])) === strtolower($mp))) { $path = $m['at']; $mounted = true; break; }
    }
    $out[] = ['src' => $src, 'name' => basename($path), 'nfs' => $nfs, 'path' => $path, 'mounted' => $mounted];
  }
  return $out;
}
/* inside a Kodi share: the folder Kodi keeps music playlists in */
function uc_kodi_pldir(string $p): ?string {
  foreach (['userdata/playlists/music', 'playlists/music', '.kodi/userdata/playlists/music', 'storage/.kodi/userdata/playlists/music', 'Kodi/userdata/playlists/music'] as $d)
    if (is_dir("$p/$d")) return "$p/$d";
  return null;
}
/* Disks in the server that aren't in the array or a pool (Unassigned Devices mounts them under /mnt/disks):
 * each partition with a file system, mounted or not */
function uc_ud_disks(): array {
  $j = getenv('UC_LSBLK') ? (string)@file_get_contents(getenv('UC_LSBLK'))
    : (string)shell_exec('timeout 10 lsblk -J -l -b -o NAME,PATH,TYPE,FSTYPE,LABEL,SIZE,MOUNTPOINT,SERIAL,MODEL,PKNAME 2>/dev/null');
  $all = (json_decode($j, true) ?: [])['blockdevices'] ?? [];
  /* the array's and pools' disks and the flash drive are left out */
  $taken = [];
  foreach ((@parse_ini_file(getenv('UC_DISKS_INI') ?: '/var/local/emhttp/disks.ini', true) ?: []) as $d) if (!empty($d['device'])) $taken[$d['device']] = 1;
  $byName = []; foreach ($all as $b) $byName[$b['name']] = $b;
  $cfgF = '/boot/config/plugins/unassigned.devices/unassigned.devices.cfg';
  $cfg = is_file($cfgF) ? (@parse_ini_file($cfgF, true, INI_SCANNER_RAW) ?: []) : [];
  $mounts = []; foreach (uc_ud_mounts() as $m) $mounts[$m['src']] = $m['at'];
  $out = [];
  foreach ($all as $b) {
    if (($b['type'] ?? '') !== 'part' && ($b['type'] ?? '') !== 'disk') continue;
    $fs = (string)($b['fstype'] ?? '');
    if (!in_array($fs, ['xfs', 'btrfs', 'ext4', 'ext3', 'ext2', 'ntfs', 'exfat', 'vfat', 'hfsplus', 'apfs'], true)) continue;
    $parent = (string)($b['pkname'] ?? '') ?: $b['name'];
    if (isset($taken[$parent]) || isset($taken[$b['name']]) || preg_match('/^(md|nmd|zram|loop|sr)\d/', $b['name'])) continue;
    $mp = (string)($b['mountpoint'] ?? '') ?: ($mounts[$b['path']] ?? '');
    if ($mp !== '' && !str_starts_with($mp, '/mnt/disks/')) continue;          // mounted somewhere else: not ours to touch
    $disk = $byName[$parent] ?? $b; $serial = (string)($disk['serial'] ?? '');
    $name = '';
    foreach ($cfg as $sec => $o) if ($serial !== '' && stripos((string)$sec, $serial) !== false) foreach ((array)$o as $k => $v) if (str_starts_with((string)$k, 'mountpoint')) { $name = basename(trim((string)$v, '"')); break 2; }
    if ($name === '') $name = (string)($b['label'] ?? '') ?: trim(preg_replace('/\s+/', '_', (string)($disk['model'] ?? '')) . ($serial !== '' ? '_' . substr($serial, -6) : ''), '_') ?: $b['name'];
    $out[] = ['src' => $b['path'], 'name' => $mp !== '' ? basename($mp) : $name, 'path' => $mp !== '' ? $mp : "/mnt/disks/$name", 'mounted' => $mp !== '',
      'about' => trim(implode(' · ', array_filter([$b['name'], strtoupper($fs), $b['size'] ? round($b['size'] / 1e9) . ' GB' : '', $disk['model'] ?? '']))), 'disk' => true];
  }
  return $out;
}
/* For a pane at /mnt/remotes or /mnt/disks (or inside one of them): what Unassigned Devices could mount there */
function uc_ud_here(string $dir): ?array {
  if (!preg_match('#^/mnt/(remotes|disks)(?:/([^/]+))?#', $dir, $m)) return null;
  $list = $m[1] === 'remotes' ? uc_ud_remotes() : uc_ud_disks();
  if (!$list) return null;
  $off = null;
  if (!empty($m[2])) foreach ($list as $e) if (!$e['mounted'] && basename($e['path']) === $m[2]) $off = $e;
  return ['kind' => $m[1], 'all' => $list, 'off' => $off, 'rc' => is_executable(UC_UD_RC)];
}
function uc_ud_find(string $src): ?array {
  foreach (str_starts_with($src, '/dev/') ? uc_ud_disks() : uc_ud_remotes() as $e) if ($e['src'] === $src) return $e;
  return null;
}

/* ---------- User Scripts (the plugin by Squid) ----------
 * Its scripts live in /boot/config/plugins/user.scripts/scripts/<name>/script. They're run the way
 * User Scripts runs them - copied to /tmp/user.scripts/tmpScripts/<name>/ first, the background ones
 * logging to log.txt there and marked in /tmp/user.scripts/running - so its own page shows the same. */
define('UC_US_DIR', getenv('UC_US_DIR') ?: '/boot/config/plugins/user.scripts/scripts');
define('UC_US_TMP', '/tmp/user.scripts');
function uc_us_vars(string $file): array {
  $v = [];
  foreach (array_slice(@file($file, FILE_IGNORE_NEW_LINES) ?: [], 0, 60) as $i => $l) {
    $l = trim(str_replace("\r", '', $l));
    if ($i === 0 && str_starts_with($l, '#!')) continue;
    if ($l === '' ) continue;
    if (preg_match('/^<\?(php)?$/i', $l)) continue;
    if ($l[0] !== '#') break;
    if (preg_match('/^#\s*(\w+)\s*=\s*(.*)$/', $l, $m)) $v[$m[1]] = trim($m[2], " \t\"'");
  }
  foreach (['foregroundOnly', 'backgroundOnly', 'arrayStarted', 'clearLog', 'noParity'] as $b) if (isset($v[$b])) $v[$b] = filter_var($v[$b], FILTER_VALIDATE_BOOLEAN);
  return $v;
}
function uc_us_running(string $id): bool {
  $pf = UC_US_TMP . "/running/$id";
  if (!is_file($pf)) return false;
  $pid = (int)trim((string)@file_get_contents($pf));
  return $pid > 0 && file_exists("/proc/$pid");
}
function uc_us_list(): array {
  $out = [];
  foreach (glob(UC_US_DIR . '/*/script') ?: [] as $f) {
    $id = basename(dirname($f)); $v = uc_us_vars($f);
    $desc = is_file(dirname($f) . '/description') ? trim((string)@file_get_contents(dirname($f) . '/description')) : (string)($v['description'] ?? '');
    $out[] = ['id' => $id, 'name' => (string)($v['name'] ?? '') ?: $id, 'desc' => mb_substr(strip_tags($desc), 0, 300),
      'arg' => isset($v['argumentDescription']) ? ['about' => (string)$v['argumentDescription'], 'def' => (string)($v['argumentDefault'] ?? '')] : null,
      'fg' => empty($v['backgroundOnly']), 'bg' => empty($v['foregroundOnly']), 'running' => uc_us_running($id),
      'log' => is_file(UC_US_TMP . "/tmpScripts/$id/log.txt")];
  }
  usort($out, fn($a, $b) => strnatcasecmp($a['name'], $b['name']));
  return $out;
}
function uc_us_clean($l): ?array {
  if (!is_array($l)) return null;
  return array_values(array_unique(array_filter(array_map(fn($x) => is_string($x) && $x !== '' && !str_contains($x, '/') ? mb_substr($x, 0, 120) : null, array_slice($l, 0, 200)))));
}

/* ---------- Clean up (Settings › Trash & History) ----------
 * What unCommander keeps that can go, how big each is, and clearing the ones picked. */
function uc_du(array $paths, int $secs = 60): int {
  $paths = array_values(array_filter($paths, 'file_exists')); if (!$paths) return 0;
  $o = (string)shell_exec("timeout $secs du -scb " . implode(' ', array_map('escapeshellarg', $paths)) . ' 2>/dev/null | tail -1');
  return (int)$o;
}
function uc_trash_dirs(): array {
  $d = [];
  foreach (array_merge(glob('/mnt/user/*/' . UC_TRASH, GLOB_ONLYDIR) ?: [], glob('/mnt/*/' . UC_TRASH, GLOB_ONLYDIR) ?: [], glob('/mnt/{disks,remotes}/*/' . UC_TRASH, GLOB_ONLYDIR | GLOB_BRACE) ?: [], glob('/boot/' . UC_TRASH, GLOB_ONLYDIR) ?: []) as $t)
    if (!preg_match('#^/mnt/user0?/' . preg_quote(UC_TRASH, '#') . '$#', $t)) $d[] = $t;
  return array_values(array_unique($d));
}
function uc_clean_parts(): array {
  $S = UC_STATE; $hist = uc_hist_path(); $cfg = dirname(UC_CFG);
  $live = []; foreach (glob("$S/hls-*") ?: [] as $h) if (filemtime($h) < time() - 120) $live[] = $h;     // video pieces no player is using
  return [
    'trash'  => ['Trash', 'Everything in the trash, on every share and disk. History can no longer undo deletes after this.', uc_trash_dirs()],
    'hist'   => ['History', 'The list of changes (copies, moves, renames…) and their Undo. Nothing on the disks changes.', [$hist]],
    'cache'  => ['Thumbnails and scan results', 'Picture previews, folder sizes, tool scans and covers kept in memory - made again when needed.', array_merge(array_map(fn($x) => "$S/$x", ['thumbs', 'scans', 'sizes', 'mbcover', 'tvmaze', 'subs', 'music-check.json'])) ],
    'left'   => ['Leftovers', 'Pieces of uploads and picture edits that never finished, old download links, video pieces from closed players, and script output from the User Scripts window.', array_merge(glob("$S/put/*") ?: [], glob("$S/dl-*.json") ?: [], $live, glob("$S/us-*") ?: [], glob("$S/ffmpeg.err") ?: [])],
    'lists'  => ['Finished lists', 'Albums sent to Lidarr that are done, music-check "Accept"s, and the list of movies sent to Radarr. Only the lists - nothing on Lidarr or Radarr changes.', array_values(array_filter([uc_data_file('lidarr-jobs.json'), uc_data_file('music-accept.json'), uc_data_file('radarr-sent.json')], 'is_file'))],
    'ffmpeg' => ['ffmpeg', 'The video tool unCommander fetched the first time a video, a song length or music tags needed it (Jellyfin\'s build of ffmpeg, from GitHub), kept in unCommander\'s folder. It plays MKV films with any sound, adds subtitles and converts pictures browsers can\'t show. Removing it frees the space and memory; it\'s fetched again the next time something needs it.', array_values(array_filter(array_merge([(string)uc_ff_gz(), UC_FF_BIN, "$cfg/" . UC_FF_NAME], glob("$cfg/ffmpeg-*-linux-x64.gz") ?: []), fn($f) => $f !== '' && file_exists($f)))],
  ];
}
/* folders picked in the tools' tree, relative to the shares (Media, Media/Movies…): checked, no ../ or hidden ones */
function uc_rel_dirs($in): array {
  $l = is_string($in) ? (json_decode($in, true) ?: []) : (array)$in; $out = [];
  foreach (array_slice($l, 0, 500) as $d) {
    $d = trim((string)$d, '/');
    if ($d === '' || preg_match('#(^|/)\.#', $d) || str_contains($d, "\0")) continue;
    $out[] = $d;
  }
  /* a folder inside another picked one is already covered */
  sort($out); $keep = [];
  foreach ($out as $d) { $in2 = false; foreach ($keep as $k) if (str_starts_with($d, "$k/")) $in2 = true; if (!$in2) $keep[] = $d; }
  return $keep;
}
/* tools' scans (in memory): the newest of each tool is kept until a new one replaces it; older ones go after a day */
/* What's using space: a scan's folders are spread over this many files, by name */
const UC_SPACE_BUCKETS = 64;
function uc_space_bucket(string $rel): int { return hexdec(substr(md5($rel), 0, 4)) % UC_SPACE_BUCKETS; }
const UC_SPACE_KINDS = ['vid', 'aud', 'img', 'arc', 'oth'];
function uc_space_kind(string $name): int {
  return preg_match('/\.(mkv|mp4|m4v|avi|mov|wmv|ts|m2ts|webm|mpe?g|iso|vob)$/i', $name) ? 0 : (preg_match('/\.(mp3|flac|m4a|aac|ogg|opus|wav|wma|aiff?|ape|dsf)$/i', $name) ? 1
    : (preg_match('/\.(jpe?g|png|gif|webp|heic|tiff?|bmp|raw|cr2|nef|arw|dng)$/i', $name) ? 2 : (preg_match('/\.(zip|rar|7z|tar|gz|xz|bz2|zst|img|qcow2|vdisk)$/i', $name) ? 3 : 4)));
}
/* one walk of a folder: folder rel => [bytes, files, sub-folder names, biggest files [name => bytes], smaller files [bytes, count], bytes by kind].
 * $tick(seen, bytes) is called every half second; returning true stops the walk. */
function uc_space_walk(string $root, ?callable $tick = null): array {
  $D = ['' => [0, 0, [], [], [0, 0], [0, 0, 0, 0, 0]]];
  $seen = 0; $bytes = 0; $last = 0; $stop = false;
  $h = popen('find -H ' . escapeshellarg($root) . ' -mindepth 1 -printf ' . escapeshellarg('%y\t%s\t%P\0') . ' 2>/dev/null', 'r');
  $buf = '';
  while ($h && !feof($h) && !$stop) {
    $buf .= fread($h, 1 << 16); $parts = explode("\0", $buf); $buf = array_pop($parts);
    foreach ($parts as $e) {
      $a = explode("\t", $e, 3); if (count($a) < 3) continue;
      [$t, $size, $rel] = $a; $size = (int)$size;
      $i = strrpos($rel, '/'); $par = $i === false ? '' : substr($rel, 0, $i); $name = $i === false ? $rel : substr($rel, $i + 1);
      if ($t === 'd') {
        $D[$rel] ??= [0, 0, [], [], [0, 0], [0, 0, 0, 0, 0]];
        $D[$par] ??= [0, 0, [], [], [0, 0], [0, 0, 0, 0, 0]];
        $D[$par][2][] = $name;
        continue;
      }
      $D[$par] ??= [0, 0, [], [], [0, 0], [0, 0, 0, 0, 0]];
      $kind = uc_space_kind($name);
      $f = &$D[$par][3]; $f[$name] = $size;
      if (count($f) > 120) { arsort($f); $rest = array_slice($f, 60, null, true); $f = array_slice($f, 0, 60, true); $D[$par][4][0] += array_sum($rest); $D[$par][4][1] += count($rest); }
      unset($f);
      /* up the tree: this folder and every one above it */
      $p = $par;
      while (true) { $D[$p][0] += $size; $D[$p][1]++; $D[$p][5][$kind] += $size; if ($p === '') break; $j = strrpos($p, '/'); $p = $j === false ? '' : substr($p, 0, $j); $D[$p] ??= [0, 0, [], [], [0, 0], [0, 0, 0, 0, 0]]; }
      $seen++; $bytes += $size;
    }
    if ($tick && microtime(true) - $last > 0.5) { $last = microtime(true); $stop = (bool)$tick($seen, $bytes); }
  }
  if ($h) pclose($h);
  if ($tick) $tick($seen, $bytes);
  return $D;
}
/* what the map shows for one folder of a walk: its total, and its sub-folders and biggest files */
function uc_space_entry(array &$D, string $rel): array {
  [$bytes, $n, $kids, $files, $rest] = $D[$rel];
  if (count($files) > 60) { arsort($files); $more = array_slice($files, 60, null, true); $files = array_slice($files, 0, 60, true); $rest[0] += array_sum($more); $rest[1] += count($more); }
  $items = [];
  foreach (array_unique($kids) as $k) {
    $k = (string)$k; $x = $D[$rel === '' ? $k : "$rel/$k"] ?? [0, 0]; $kd = $x[5] ?? [0, 0, 0, 0, 0];
    $items[] = ['n' => $k, 'd' => 1, 's' => $x[0], 'c' => $x[1], 'k' => UC_SPACE_KINDS[array_search(max($kd), $kd)]];
  }
  foreach ($files as $k => $v) $items[] = ['n' => (string)$k, 'd' => 0, 's' => $v];
  if ($rest[1]) $items[] = ['n' => '', 'd' => 0, 's' => $rest[0], 'c' => $rest[1], 'rest' => 1];
  usort($items, fn($a, $b) => $b['s'] <=> $a['s']);
  return ['s' => $bytes, 'c' => $n, 'items' => $items];
}
/* After changes made in the panes: look again at just the folders that were open there (and where jobs
 * copied or moved to), and fix the scan to match - new folders are walked, gone ones dropped, the files
 * right inside re-read, and the totals of every folder above adjusted. Only the small files those
 * folders live in are rewritten. Returns how many folders changed. */
function uc_space_refresh(string $id, array $dirs): int {
  $jf = UC_STATE . "/scans/$id.json";
  $st = json_decode((string)@file_get_contents($jf), true);
  if (!$st || ($st['tool'] ?? '') !== 'space' || ($st['state'] ?? '') !== 'done') throw new UcError('That scan is no longer available - scan again');
  $root = rtrim($st['root'], '/') ?: '/';
  $lk = fopen("$jf.lock", 'c'); flock($lk, LOCK_EX);
  $tf = fn(string $rel) => UC_STATE . "/scans/$id.tree." . sprintf('%02x', uc_space_bucket($rel));
  $L = []; $dirty = [];
  $get = function (string $rel) use (&$L, $tf) {
    if (array_key_exists($rel, $L)) return $L[$rel];
    $L[$rel] = null; $f = $tf($rel);
    if (!is_file($f)) return null;
    $needle = '[' . json_encode($rel, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . ',';
    $h = fopen($f, 'r');
    while ($h && ($line = fgets($h)) !== false) if (str_starts_with($line, $needle)) { $j = json_decode($line, true); $L[$rel] = is_array($j) ? $j[1] : null; break; }
    if ($h) fclose($h);
    return $L[$rel];
  };
  $set = function (string $rel, array $v) use (&$L, &$dirty) { $L[$rel] = $v; $dirty[$rel] = true; };
  $rels = [];
  foreach ($dirs as $d) {
    $d = rtrim((string)$d, '/') ?: '/';
    if ($d === $root) $rels[''] = 0;
    elseif (str_starts_with($d, $root === '/' ? '/' : "$root/")) { $r = substr($d, strlen($root === '/' ? '/' : "$root/")); $rels[$r] = substr_count($r, '/') + 1; }
  }
  arsort($rels);                                         // deepest first, so a folder's change is in its parent before the parent is looked at
  $changed = 0;
  foreach (array_keys($rels) as $rel) {
    $rel = (string)$rel; $abs = $rel === '' ? $root : ($root === '/' ? "/$rel" : "$root/$rel");
    $old = $get($rel); if (!$old || !is_dir($abs) || is_link($abs)) continue;
    $now = @scandir($abs); if ($now === false) continue;
    $oldDirs = []; $oldFB = 0; $oldFC = 0;
    foreach ($old['items'] as $it) { if (!empty($it['d'])) $oldDirs[$it['n']] = $it; elseif (!empty($it['rest'])) { $oldFB += $it['s']; $oldFC += $it['c']; } else { $oldFB += $it['s']; $oldFC++; } }
    $ds = 0; $dc = 0; $dirItems = []; $files = []; $seenDirs = [];
    foreach ($now as $n) {
      if ($n === '.' || $n === '..') continue;
      $p = "$abs/$n"; $isDir = is_dir($p) && !is_link($p);
      if (!$isDir) { $sz = @lstat($p); $files[$n] = $sz ? (int)$sz['size'] : 0; continue; }
      $seenDirs[$n] = true;
      if (isset($oldDirs[$n])) { $dirItems[] = $oldDirs[$n]; continue; }
      /* a folder that wasn't there: walk it */
      $W = uc_space_walk($p); $sub = $rel === '' ? $n : "$rel/$n";
      foreach (array_keys($W) as $wr) { $wr = (string)$wr; $set($wr === '' ? $sub : "$sub/$wr", uc_space_entry($W, $wr)); }
      $kd = $W[''][5];
      $dirItems[] = ['n' => (string)$n, 'd' => 1, 's' => $W[''][0], 'c' => $W[''][1], 'k' => UC_SPACE_KINDS[array_search(max($kd), $kd)]];
      $ds += $W[''][0]; $dc += $W[''][1];
    }
    foreach ($oldDirs as $n => $it) if (!isset($seenDirs[$n])) { $ds -= $it['s']; $dc -= $it['c'] ?? 0; }
    $ds += array_sum($files) - $oldFB; $dc += count($files) - $oldFC;
    arsort($files); $top = array_slice($files, 0, 60, true); $more = array_slice($files, 60, null, true);
    $items = $dirItems;
    foreach ($top as $k => $v) $items[] = ['n' => (string)$k, 'd' => 0, 's' => $v];
    if ($more) $items[] = ['n' => '', 'd' => 0, 's' => array_sum($more), 'c' => count($more), 'rest' => 1];
    usort($items, fn($a, $b) => $b['s'] <=> $a['s']);
    $sameItems = json_encode($items) === json_encode($old['items']);
    if ($sameItems && !$ds && !$dc) continue;
    $changed++;
    $set($rel, ['s' => $old['s'] + $ds, 'c' => $old['c'] + $dc, 'items' => $items]);
    if (!$ds && !$dc) continue;
    /* every folder above: its total, and this branch's line in it */
    $child = $rel;
    while ($child !== '') {
      $j = strrpos($child, '/'); $par = $j === false ? '' : substr($child, 0, $j); $nm = $j === false ? $child : substr($child, $j + 1);
      $pv = $get($par); if (!$pv) break;
      $pv['s'] += $ds; $pv['c'] += $dc;
      foreach ($pv['items'] as &$it) if (!empty($it['d']) && $it['n'] === $nm) { $it['s'] += $ds; $it['c'] = ($it['c'] ?? 0) + $dc; }
      unset($it);
      usort($pv['items'], fn($a, $b) => $b['s'] <=> $a['s']);
      $set($par, $pv); $child = $par;
    }
  }
  /* write back: only the small files holding a changed folder */
  $by = [];
  foreach (array_keys($dirty) as $r) $by[uc_space_bucket((string)$r)][(string)$r] = true;
  foreach ($by as $b => $want) {
    $f = UC_STATE . "/scans/$id.tree." . sprintf('%02x', $b);
    $in = @fopen($f, 'r'); $out = fopen("$f.tmp", 'w');
    while ($in && ($line = fgets($in)) !== false) {
      $key = preg_match('/^\[("(?:[^"\\\\]|\\\\.)*")/', $line, $m) ? json_decode($m[1]) : null;
      if (is_string($key) && isset($want[$key])) continue;            // replaced below
      fwrite($out, $line);
    }
    if ($in) fclose($in);
    foreach (array_keys($want) as $r) fwrite($out, json_encode([(string)$r, $L[$r]], JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
    fclose($out); rename("$f.tmp", $f);
  }
  flock($lk, LOCK_UN); fclose($lk); @unlink("$jf.lock");
  return $changed;
}
function uc_scans_tidy(): void {
  $newest = [];
  $all = glob(UC_STATE . '/scans/*.json') ?: [];
  foreach ($all as $f) { $j = json_decode((string)@file_get_contents($f), true) ?: []; $t = ($j['tool'] ?? '?') . '/' . ($j['mode'] ?? ''); if (!isset($newest[$t]) || filemtime($f) > filemtime($newest[$t])) $newest[$t] = $f; }
  foreach ($all as $f) if (!in_array($f, $newest, true) && time() - filemtime($f) > 86400) { $b = substr($f, 0, -5); foreach (['.json', '.results', '.tree', '.list', '.list.sorted'] as $x) @unlink($b . $x); foreach (glob($b . '.tree.*') ?: [] as $x) @unlink($x); }
}
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/moviescan.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander — Tools > Movie folders without a video.
 * Looks at each folder directly inside the chosen root (one folder per movie)
 * and flags the ones with no video file anywhere inside. For those it reads
 * the local .nfo (title, year, plot, rating, ids) and finds a poster. Read-only. */
require_once __DIR__ . '/lib.php';

$id = $argv[1] ?? '';
if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) exit(1);
$file = UC_STATE . "/scans/$id.json";
$st = json_decode((string)@file_get_contents($file), true);
if (!$st) exit(1);
$stop = false;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$stop) { $stop = true; });
function save(array $st): void {
  global $file;
  file_put_contents("$file.tmp", json_encode($st, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE));
  rename("$file.tmp", $file);
}
$st['pid'] = getmypid(); $st['state'] = 'running'; save($st);

const VIDEO = ['mkv', 'mp4', 'm4v', 'avi', 'mov', 'wmv', 'mpg', 'mpeg', 'mpe', 'ts', 'm2ts', 'mts', 'iso', 'img', 'vob', 'webm', 'flv', 'divx', 'xvid',
               '3gp', 'ogv', 'ogm', 'rmvb', 'rm', 'asf', 'strm', 'mk3d', 'dvr-ms', 'wtv', 'f4v', 'm2v', 'bdmv'];
const IMAGE = ['jpg', 'jpeg', 'png', 'webp', 'tbn', 'gif', 'bmp'];
$root = rtrim($st['root'], '/');

/* the movie folders */
$folders = [];
foreach (scandir($root) ?: [] as $n) {
  if ($n === '.' || $n === '..' || $n === UC_TRASH || $n[0] === '.') continue;
  if (is_dir("$root/$n") && !is_link("$root/$n")) $folders[$n] = ['video' => 0, 'sample' => 0, 'nfo' => [], 'img' => [], 'other' => 0, 'files' => 0, 'bytes' => 0, 'list' => []];
}
$st['total'] = count($folders); save($st);

/* every file below them, in one pass */
$h = popen('find -H ' . escapeshellarg($root) . ' -mindepth 2 -name ' . escapeshellarg(UC_TRASH) . ' -prune -o ! -type d -printf ' . escapeshellarg('%P\t%s\0') . ' 2>/dev/null', 'r');
$buf = ''; $seen = 0; $last = 0;
while ($h && !feof($h)) {
  if ($stop) break;
  $buf .= fread($h, 1 << 16);
  $parts = explode("\0", $buf); $buf = array_pop($parts);
  foreach ($parts as $e) {
    $t = strrpos($e, "\t"); if ($t === false) continue;
    $rel = substr($e, 0, $t); $size = (int)substr($e, $t + 1);
    $i = strpos($rel, '/'); if ($i === false) continue;
    $top = substr($rel, 0, $i); if (!isset($folders[$top])) continue;
    $f = &$folders[$top];
    $inner = substr($rel, $i + 1); $name = basename($inner);
    $ext = strtolower(pathinfo($name, PATHINFO_EXTENSION));
    $f['files']++; $f['bytes'] += $size;
    if (count($f['list']) < 40) $f['list'][] = [$inner, $size];
    if (in_array($ext, VIDEO, true) || strtoupper($name) === 'VIDEO_TS.IFO') {
      if (preg_match('/(^|[ ._\-\[(])(sample|trailer)([ ._\-\])]|$)/i', $name) || preg_match('#(^|/)(samples?|trailers?)/#i', $inner)) $f['sample']++;
      else $f['video']++;
    } elseif ($ext === 'nfo') $f['nfo'][] = $inner;
    elseif (in_array($ext, IMAGE, true)) $f['img'][] = $inner;
    else $f['other']++;
    unset($f);
    $seen++;
  }
  if (microtime(true) - $last > 0.5) { $last = microtime(true); $st['seen'] = $seen; save($st); }
}
if ($h) pclose($h);

/* read a Kodi-style .nfo: title, year, plot, rating, ids, genres */
function nfo_read(string $path): array {
  $raw = @file_get_contents($path, false, null, 0, 262144);
  if ($raw === false || $raw === '') return [];
  $o = [];
  $tag = function (string $t) use ($raw) { return preg_match('#<' . $t . '(?:\s[^>]*)?>(.*?)</' . $t . '>#is', $raw, $m) ? trim(html_entity_decode(strip_tags(preg_replace('#<!\[CDATA\[(.*?)\]\]>#s', '$1', $m[1])), ENT_QUOTES | ENT_XML1, 'UTF-8')) : ''; };
  foreach (['title', 'originaltitle', 'year', 'plot', 'outline', 'tagline', 'runtime', 'mpaa', 'premiered'] as $t) { $v = $tag($t); if ($v !== '') $o[$t] = mb_substr($v, 0, 1500); }
  if (empty($o['year']) && !empty($o['premiered']) && preg_match('/^(\d{4})/', $o['premiered'], $m)) $o['year'] = $m[1];
  if (preg_match('#<rating[^>]*default="true"[^>]*>.*?<value>([\d.]+)</value>#is', $raw, $m) || preg_match('#<ratings>.*?<value>([\d.]+)</value>#is', $raw, $m) || preg_match('#<rating>([\d.]+)</rating>#i', $raw, $m)) $o['rating'] = round((float)$m[1], 1);
  if (preg_match('#<uniqueid[^>]*type="tmdb"[^>]*>(\d+)<#i', $raw, $m) || preg_match('#<tmdbid>(\d+)<#i', $raw, $m)) $o['tmdb'] = $m[1];
  if (preg_match('#<uniqueid[^>]*type="imdb"[^>]*>(tt\d+)<#i', $raw, $m) || preg_match('#<imdbid>(tt\d+)<#i', $raw, $m) || preg_match('#<id>(tt\d+)</id>#i', $raw, $m) || preg_match('#imdb\.com/title/(tt\d+)#i', $raw, $m)) $o['imdb'] = $m[1];
  if (preg_match_all('#<genre>(.*?)</genre>#is', $raw, $m)) $o['genres'] = array_slice(array_map(fn($g) => trim(strip_tags($g)), $m[1]), 0, 6);
  return $o;
}

$results = [];
foreach ($folders as $name => $f) {
  if ($f['video']) continue;
  $kind = $f['sample'] ? 'sample' : (!$f['files'] ? 'empty' : ($f['nfo'] || $f['img'] ? 'meta' : 'other'));
  $r = ['name' => (string)$name, 'path' => "$root/$name", 'kind' => $kind, 'files' => $f['files'], 'bytes' => $f['bytes'], 'list' => $f['list'],
        'mtime' => @filemtime("$root/$name") ?: 0];
  /* from the folder name: "Title (Year)" and {tmdb-123} / {imdb-tt123} / [tmdbid-123] tags */
  $n = (string)$name;
  if (preg_match('/[\[{](?:tmdb|tmdbid)[-=](\d+)[\]}]/i', $n, $m)) $r['tmdb'] = $m[1];
  if (preg_match('/[\[{](?:imdb|imdbid)[-=](tt\d+)[\]}]/i', $n, $m)) $r['imdb'] = $m[1];
  $clean = trim(preg_replace('/\s*[\[{][^\]}]*[\]}]/', '', $n));
  if (preg_match('/^(.*?)[\s.(\[]+((?:19|20)\d{2})[)\]]?(?:\s|$|\.)/', $clean, $m)) { $r['title'] = trim(str_replace('.', ' ', $m[1])); $r['year'] = $m[2]; }
  else $r['title'] = $clean;
  /* the .nfo: prefer movie.nfo or one named like the folder */
  if ($f['nfo']) {
    usort($f['nfo'], fn($a, $b) => (substr_count($a, '/') <=> substr_count($b, '/')) ?: ((basename($b) === 'movie.nfo') <=> (basename($a) === 'movie.nfo')));
    $info = nfo_read("$root/$name/" . $f['nfo'][0]);
    foreach ($info as $k => $v) if ($v !== '' && $v !== []) $r[$k] = $v;
    $r['nfo'] = $f['nfo'][0];
  }
  /* a poster */
  $best = null;
  foreach ($f['img'] as $img) {
    $b = strtolower(basename($img));
    $score = preg_match('/^(poster|folder|cover|movie)\.\w+$/', $b) ? 3 : (str_contains($b, 'poster') ? 2 : (str_contains($b, 'fanart') || str_contains($b, 'backdrop') ? 0 : 1));
    if (substr_count($img, '/')) $score -= 2;
    if ($best === null || $score > $best[0]) $best = [$score, $img];
  }
  if ($best) $r['poster'] = $best[1];
  $results[] = $r;
}
usort($results, fn($a, $b) => strnatcasecmp($a['name'], $b['name']));
/* the list goes to its own file, one JSON line per folder; the status file stays small */
$out = fopen(UC_STATE . "/scans/$id.results", 'w');
foreach ($results as $r) fwrite($out, json_encode($r, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
fclose($out);
$st['found'] = count($results); $st['seen'] = $seen;
$st['state'] = $stop ? 'stopped' : 'done'; $st['finished'] = time();
save($st);
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/sizer.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander — adds up folder sizes for "Folder sizes" (More row).
 * Started detached by the API, one per request, and independent of the
 * copy/move queue: it only reads. Progress goes to a small JSON file the page
 * polls, so it keeps going if the window is closed. */
require_once __DIR__ . '/lib.php';

$id = $argv[1] ?? '';
if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) exit(1);
$file = UC_STATE . "/sizes/$id.json";
$st = json_decode((string)@file_get_contents($file), true);
if (!$st) exit(1);

$stop = false;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$stop) { $stop = true; });

function save(array $st): void {
  global $file;
  file_put_contents("$file.tmp", json_encode($st, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE));
  rename("$file.tmp", $file);
}

$st['pid'] = getmypid();
$st['state'] = 'running';
save($st);

foreach ($st['items'] as $i => $it) {
  if ($stop) { $st['items'][$i]['state'] = 'stopped'; continue; }
  $st['items'][$i]['state'] = 'running';
  $st['items'][$i]['started'] = microtime(true);
  save($st);
  /* %y type, %s apparent size in bytes, %h the folder it's in */
  $h = popen('find -H ' . escapeshellarg($it['path']) . ' -printf ' . escapeshellarg("%y %s %h\n") . ' 2>/dev/null', 'r');
  $files = 0; $dirs = -1; $bytes = 0; $last = 0;
  while ($h && ($line = fgets($h)) !== false) {
    if ($stop) break;
    $p = explode(' ', rtrim($line, "\n"), 3);
    if (($p[0] ?? '') === 'd') $dirs++;
    else { $files++; $bytes += (int)($p[1] ?? 0); }
    if (microtime(true) - $last > 0.5) {
      $last = microtime(true);
      $st['items'][$i] = array_merge($st['items'][$i], ['files' => $files, 'dirs' => max(0, $dirs), 'bytes' => $bytes, 'now' => $p[2] ?? '']);
      save($st);
    }
  }
  if ($h) pclose($h);
  $st['items'][$i] = array_merge($st['items'][$i], ['files' => $files, 'dirs' => max(0, $dirs), 'bytes' => $bytes, 'now' => '',
    'state' => $stop ? 'stopped' : 'done', 'secs' => round(microtime(true) - $st['items'][$i]['started'], 1)]);
  save($st);
}
$st['state'] = $stop ? 'stopped' : 'done';
$st['finished'] = time();
save($st);
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/spacescan.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander — "What's using space here": one walk of the folder, adding up every file into its
 * folder and all the folders above it. Each folder keeps its sub-folders and its 60 biggest files
 * (the rest as one "smaller files" total), so the map and list can go in and out instantly.
 * Started detached; progress in the scan's JSON file, the result in its .tree file. */
require_once __DIR__ . '/lib.php';

$id = $argv[1] ?? '';
if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) exit(1);
$file = UC_STATE . "/scans/$id.json";
$st = json_decode((string)@file_get_contents($file), true);
if (!$st) exit(1);
$stop = false;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$stop) { $stop = true; });
function save(array $st): void { global $file; file_put_contents("$file.tmp", json_encode($st, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE)); rename("$file.tmp", $file); }
$st['pid'] = getmypid(); $st['state'] = 'running'; $st['seen'] = 0; $st['bytes'] = 0; save($st);

$root = $st['root'];
$D = uc_space_walk($root, function ($seen, $bytes) use (&$st, &$stop) { $st['seen'] = $seen; $st['bytes'] = $bytes; save($st); return $stop; });
/* the result: one line per folder, ready to show (its sub-folders with their totals, its biggest files),
 * spread over 64 small files by the folder's name - so showing a folder reads one small file, never the
 * whole scan (a big appdata has hundreds of thousands of folders) */
$st['phase'] = 'saving'; save($st);
$hs = [];
for ($i = 0; $i < UC_SPACE_BUCKETS; $i++) $hs[$i] = fopen(UC_STATE . "/scans/$id.tree." . sprintf('%02x', $i), 'w');
foreach (array_keys($D) as $rel) {
  $rel = (string)$rel;
  fwrite($hs[uc_space_bucket($rel)], json_encode([$rel, uc_space_entry($D, $rel)], JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
}
foreach ($hs as $h2) fclose($h2);
unset($st['phase']);
$st['state'] = $stop ? 'stopped' : 'done'; $st['finished'] = time(); $st['dirs'] = count($D);
save($st);
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/tvparse.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander - TV tool: reading episode numbers from file names.
 * Used by the scan (tvscan.php) and by the quick recheck of shows sent to Sonarr. */
const TV_VIDEO = ['mkv', 'mp4', 'm4v', 'avi', 'mov', 'wmv', 'mpg', 'mpeg', 'ts', 'm2ts', 'mts', 'iso', 'vob', 'webm', 'flv', 'divx', 'xvid',
               'ogm', 'rmvb', 'asf', 'strm', 'mk3d', 'wtv', 'dvr-ms', 'f4v', '3gp'];
/* folders that hold extras, not episodes */
const TV_EXTRAS = ['extras', 'extra', 'featurettes', 'featurette', 'behind the scenes', 'deleted scenes', 'interviews', 'scenes', 'shorts',
                'trailers', 'trailer', 'other', 'others', 'samples', 'sample', 'bonus', 'bonus features', 'specials', 'special'];
/* ---------- reading episode numbers from a file's path ---------- */
/* returns ['eps' => [[s, e], ...], 'dates' => ['2019-03-14'], 'skip' => bool] */
function uc_tv_parse_ep(string $inner): array {
  $dirs = explode('/', $inner); $name = array_pop($dirs);
  foreach ($dirs as $d) if (in_array(strtolower(trim($d)), TV_EXTRAS, true)) return ['eps' => [], 'dates' => [], 'skip' => true];
  $stem = preg_replace('/\.[^.]+$/', '', $name);
  if (preg_match('/(^|[ ._\-\[(])(sample|trailer)([ ._\-\])]|$)/i', $stem)) return ['eps' => [], 'dates' => [], 'skip' => true];
  $out = [];
  /* S01E05, S01E05E06, S01E05-E07, S01E05-07. A second number needs an "E" unless it
   * follows the dash directly: in "S04E15 - 100th Day of School" the 100 is the title.
   * Ordinals (1st, 100th) and resolutions (720p) are never episode numbers. */
  $SEP = '(?:-e?|[ ._]+-[ ._]*e|-[ ._]+e|[ ._]?e)';
  $NUM = '(\d{1,4})(?!\d)(?!(?:st|nd|rd|th|p|i)(?![a-z]))';
  if (preg_match('/(?<![a-z0-9])s(\d{1,3})[ ._-]?e(\d{1,4})(?!\d)((?:' . $SEP . '\d{1,4}(?!\d)(?!(?:st|nd|rd|th|p|i)(?![a-z])))*)/i', $stem, $m)) {
    $s = (int)$m[1]; $prev = (int)$m[2]; $out[] = [$s, $prev];
    if ($m[3] !== '' && preg_match_all('/(' . $SEP . ')' . $NUM . '/i', $m[3], $mm, PREG_SET_ORDER)) {
      foreach ($mm as [, $sep, $n]) {
        $n = (int)$n;
        if ($n <= $prev || $n - $prev > 20) break;      // not a believable next episode: stop reading
        if (str_contains($sep, '-')) { for ($k = $prev + 1; $k <= $n; $k++) $out[] = [$s, $k]; }
        else $out[] = [$s, $n];
        $prev = $n;
      }
    }
    return ['eps' => $out, 'dates' => [], 'skip' => false];
  }
  /* 1x05, 1x05-1x06 */
  if (preg_match('/(?<![a-z0-9])(\d{1,2})x(\d{2,3})(?![0-9p])((?:(?:-|[ ._]*-[ ._]*\d{1,2}x)\d{2,3}(?!\d)(?!(?:st|nd|rd|th|p|i)(?![a-z])))*)/i', $stem, $m)) {
    $s = (int)$m[1]; $prev = (int)$m[2]; $out[] = [$s, $prev];
    if ($m[3] !== '' && preg_match_all('/(?:\d{1,2}x)?(\d{2,3})(?!\d)/i', $m[3], $mm)) foreach ($mm[1] as $n) { $n = (int)$n; if ($n <= $prev || $n - $prev > 20) break; $out[] = [$s, $n]; $prev = $n; }
    return ['eps' => $out, 'dates' => [], 'skip' => false];
  }
  /* daily shows: 2019-03-14 / 2019.03.14 */
  if (preg_match('/(?<!\d)((?:19|20)\d{2})[.\-_ ](\d{2})[.\-_ ](\d{2})(?!\d)/', $stem, $m)) return ['eps' => [], 'dates' => ["$m[1]-$m[2]-$m[3]"], 'skip' => false];
  /* "Season 2/Episode 05.mkv", "Season 2/E05 - Title.mkv", "Season 2/05 - Title.mkv" */
  $season = null;
  foreach (array_reverse($dirs) as $d) if (preg_match('/^(?:season|series|staffel|saison|temporada|s)[ ._-]*(\d{1,3})$/i', trim($d), $m)) { $season = (int)$m[1]; break; }
  if ($season !== null) {
    if (preg_match('/(?<![a-z0-9])(?:ep(?:isode)?|e)[ ._-]?(\d{1,3})(?![0-9])/i', $stem, $m) || preg_match('/^(\d{1,3})(?![0-9])(?:[ ._-]|$)/', $stem, $m))
      return ['eps' => [[$season, (int)$m[1]]], 'dates' => [], 'skip' => false];
  }
  return ['eps' => [], 'dates' => [], 'skip' => false];
}


/* The episodes in a show folder now (["1.5", "2.3", ...]) - dates of daily
 * shows are matched to episodes with the show's episode list ($eps). */
function uc_tv_folder_have(string $path, array $eps, ?array &$odd = null, ?array &$info = null): array {
  $raw = (string)shell_exec('find -H ' . escapeshellarg($path) . ' -mindepth 1 -name ' . escapeshellarg(UC_TRASH) . ' -prune -o -type f -printf ' . escapeshellarg('%P\t%s\0') . ' 2>/dev/null');
  $have = []; $dates = []; $fileOf = []; $info = ['files' => 0, 'bytes' => 0, 'extras' => 0, 'unparsed' => []];
  $list = []; foreach (explode("\0", $raw) as $e) { $t = strrpos($e, "\t"); if ($t !== false) $list[substr($e, 0, $t)] = (int)substr($e, $t + 1); }
  uksort($list, 'strnatcasecmp');
  foreach ($list as $inner => $size) {
    if ($inner === '' || !in_array(strtolower(pathinfo($inner, PATHINFO_EXTENSION)), TV_VIDEO, true)) continue;
    $info['files']++; $info['bytes'] += $size;
    $p = uc_tv_parse_ep($inner);
    if ($p['skip']) { $info['extras']++; continue; }
    foreach ($p['eps'] as [$s, $e]) if ($s > 0) { $have["$s.$e"] = true; $fileOf["$s.$e"] ??= $inner; }
    foreach ($p['dates'] as $d) $dates[$d] = true;
    if (!$p['eps'] && !$p['dates'] && count($info['unparsed']) < 25) $info['unparsed'][] = $inner;
  }
  if ($dates) foreach ($eps as [$s, $e, $d]) if ($d !== '' && isset($dates[$d])) $have["$s.$e"] = true;
  $odd = uc_tv_odd_files($fileOf, $eps);
  return array_keys($have);
}

/* the files whose episode number isn't in the show's episode list:
 * "4.100" => "Season 4/Show - S04E100.mkv" (at most 80, so the scan stays small) */
function uc_tv_odd_files(array $fileOf, array $eps): array {
  $known = []; foreach ($eps as $ep) $known["{$ep[0]}.{$ep[1]}"] = true;
  $out = [];
  foreach ($fileOf as $k => $f) { if (isset($known[$k])) continue; $out[(string)$k] = $f; if (count($out) >= 80) break; }
  return $out;
}

/* Look in a scanned show's folder again and update its row: episodes, file count,
 * odd numbers - for downloads that arrived after the scan. */
function uc_tv_refresh_row(array &$r): void {
  if (empty($r['path']) || !is_dir($r['path'])) return;
  $r['have'] = uc_tv_folder_have($r['path'], (array)($r['eps'] ?? []), $odd, $info);
  $r['odd'] = (object)$odd;
  foreach (['files', 'bytes', 'extras', 'unparsed'] as $k) $r[$k] = $info[$k];
}
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/tvscan.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander - Tools > TV shows with missing episodes.
 * Each folder directly inside the chosen root is one show. For each show:
 *   1. read the episode numbers from the video file names (S01E05, 1x05,
 *      S01E01-E02, dates for daily shows; specials, extras and samples skipped)
 *   2. work out which show it is: the folder's saved match, then ids in
 *      tvshow.nfo or the folder name, then a title (+ year) search - with your
 *      episode files deciding between look-alikes
 *   3. get the show's episode list from TVmaze (cached in memory)
 * The verdict (complete, missing...) is worked out in the browser, so your
 * "ignore" choices apply straight away. Read-only: nothing is changed. */
require_once __DIR__ . '/lib.php';
require_once __DIR__ . '/tvparse.php';

$id = $argv[1] ?? '';
if (!preg_match('/^[a-z0-9]{6,32}$/', $id)) exit(1);
$file = UC_STATE . "/scans/$id.json";
$st = json_decode((string)@file_get_contents($file), true);
if (!$st) exit(1);
$stop = false;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$stop) { $stop = true; });
function save(array $st): void {
  global $file;
  file_put_contents("$file.tmp", json_encode($st, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE));
  rename("$file.tmp", $file);
}
$st['pid'] = getmypid(); $st['state'] = 'running'; $st['phase'] = 'files'; save($st);

$root = rtrim($st['root'], '/');

/* the show folders */
$shows = [];
foreach (scandir($root) ?: [] as $n) {
  if ($n === '.' || $n === '..' || $n[0] === '.' || $n === UC_TRASH) continue;
  if (is_dir("$root/$n") && !is_link("$root/$n")) $shows[$n] = ['files' => [], 'count' => 0, 'bytes' => 0];
}
$st['total'] = count($shows); save($st);

/* every video file below them, in one pass */
$h = popen('find -H ' . escapeshellarg($root) . ' -mindepth 2 -name ' . escapeshellarg(UC_TRASH) . ' -prune -o -type f -printf ' . escapeshellarg('%P\t%s\0') . ' 2>/dev/null', 'r');
$buf = ''; $seen = 0; $last = 0;
while ($h && !feof($h) && !$stop) {
  $buf .= fread($h, 1 << 16);
  $parts = explode("\0", $buf); $buf = array_pop($parts);
  foreach ($parts as $e) {
    $t = strrpos($e, "\t"); if ($t === false) continue;
    $rel = substr($e, 0, $t); $i = strpos($rel, '/'); if ($i === false) continue;
    $top = substr($rel, 0, $i); if (!isset($shows[$top])) continue;
    $inner = substr($rel, $i + 1);
    $ext = strtolower(pathinfo($inner, PATHINFO_EXTENSION));
    if (!in_array($ext, TV_VIDEO, true)) continue;
    $seen++;
    $shows[$top]['count']++; $shows[$top]['bytes'] += (int)substr($e, $t + 1);
    if (count($shows[$top]['files']) < 5000) $shows[$top]['files'][] = $inner;
  }
  if (microtime(true) - $last > 0.5) { $last = microtime(true); $st['seen'] = $seen; save($st); }
}
if ($h) pclose($h);

/* ---------- tvshow.nfo: ids, title and year (only to know WHICH show) ---------- */
function nfo_ids(string $dir): array {
  $f = "$dir/tvshow.nfo";
  if (!is_file($f)) return [];
  $raw = (string)@file_get_contents($f, false, null, 0, 262144);
  $o = [];
  $tag = fn($t) => preg_match('#<' . $t . '(?:\s[^>]*)?>(.*?)</' . $t . '>#is', $raw, $m) ? trim(html_entity_decode(strip_tags(preg_replace('#<!\[CDATA\[(.*?)\]\]>#s', '$1', $m[1])), ENT_QUOTES | ENT_XML1, 'UTF-8')) : '';
  if (preg_match('#<uniqueid[^>]*type="(?:tvdb|thetvdb)"[^>]*>\s*(\d+)\s*<#i', $raw, $m) || preg_match('#<tvdbid>\s*(\d+)\s*<#i', $raw, $m)) $o['tvdb'] = $m[1];
  if (preg_match('#<uniqueid[^>]*type="imdb"[^>]*>\s*(tt\d+)\s*<#i', $raw, $m) || preg_match('#<imdb_?id>\s*(tt\d+)\s*<#i', $raw, $m) || preg_match('#imdb\.com/title/(tt\d+)#i', $raw, $m)) $o['imdb'] = $m[1];
  if (empty($o['tvdb']) && preg_match('#<id>\s*(\d{4,7})\s*</id>#i', $raw, $m)) $o['tvdb'] = $m[1];   // old Kodi files: <id> is the TheTVDB id
  if (preg_match('#<uniqueid[^>]*type="tvmaze"[^>]*>\s*(\d+)\s*<#i', $raw, $m)) $o['tvmaze'] = $m[1];
  $t = $tag('title'); if ($t !== '') $o['title'] = $t;
  $y = $tag('year') ?: substr($tag('premiered'), 0, 4); if (preg_match('/^(19|20)\d{2}$/', $y)) $o['year'] = $y;
  return $o;
}

/* how well a candidate's episode list fits the episodes in the folder (0..1) */
function fit(array $have, array $eps): float {
  if (!$have) return 0.0;
  $set = []; foreach ($eps as [$s, $e]) $set["$s.$e"] = true;
  $hit = 0; foreach ($have as $k => $_) if (isset($set[$k])) $hit++;
  return $hit / count($have);
}

/* ---------- each show ---------- */
$matches = uc_tv_store('matches'); $newMatches = 0;
$out = fopen(UC_STATE . "/scans/$id.results", 'w');
$done = 0; $looked = 0; $down = null;   // once TVmaze can't be reached, don't wait on it again for every show $st['phase'] = 'shows'; save($st);
uksort($shows, 'strnatcasecmp');
foreach ($shows as $name => $f) {
  if ($stop) break;
  $path = "$root/$name";
  $st['current'] = $name; $st['done'] = $done; save($st);

  /* the episodes in the folder */
  $have = []; $dates = []; $unparsed = []; $extras = 0; $fileOf = [];
  natcasesort($f['files']);
  foreach ($f['files'] as $inner) {
    $p = uc_tv_parse_ep($inner);
    if ($p['skip']) { $extras++; continue; }
    foreach ($p['eps'] as [$s, $e]) if ($s > 0) { $have["$s.$e"] = true; $fileOf["$s.$e"] ??= $inner; }
    foreach ($p['dates'] as $d) $dates[$d] = $inner;
    if (!$p['eps'] && !$p['dates']) { if (count($unparsed) < 25) $unparsed[] = $inner; else $unparsed[25] = '…'; }
  }
  $row = ['name' => (string)$name, 'path' => $path, 'files' => $f['count'], 'bytes' => $f['bytes'], 'extras' => $extras, 'unparsed' => array_values($unparsed)];

  /* which show is it? */
  $nfo = nfo_ids($path);
  $folderTitle = trim(preg_replace('/\s*[\[{(][^\]})]*[\]})]\s*/', ' ', $name));
  $folderTitle = trim(preg_replace('/[._]+/', ' ', $folderTitle));
  $year = preg_match('/\((\d{4})\)/', $name, $m) ? $m[1] : ($nfo['year'] ?? null);
  $title = $nfo['title'] ?? $folderTitle;
  $tvm = null; $how = null; $cand = [];
  try {
    if (!empty($matches[$path]['id'])) { $tvm = (int)$matches[$path]['id']; $how = $matches[$path]['how'] ?? 'saved'; }
    if ($down !== null) {
      /* TVmaze is unreachable: use what's cached, otherwise say so */
      $sh = $tvm ? uc_tv_show($tvm, true) : null;
      if (!$sh) throw new UcError($down);
    }
    if (!$tvm && !empty($nfo['tvmaze'])) { $tvm = (int)$nfo['tvmaze']; $how = 'nfo'; }
    /* an id from a saved match or tvshow.nfo that TVmaze doesn't know (any more):
     * forget it and fall back to the title search below */
    if ($tvm && !uc_tv_show($tvm, $down !== null)) {
      if (!empty($matches[$path]['id']) && (int)$matches[$path]['id'] === $tvm) { unset($matches[$path]); $newMatches++; }
      $tvm = null; $how = null; $row['stale'] = true;
    }
    $tag = fn($k) => preg_match('/[\[{](?:' . $k . ')(?:id)?[-=]([a-z]*\d+)[\]}]/i', $name, $mm) ? $mm[1] : null;
    foreach ([['thetvdb', $nfo['tvdb'] ?? $tag('tvdb'), 'nfo'], ['imdb', $nfo['imdb'] ?? $tag('imdb'), 'nfo']] as [$k, $v, $src]) {
      if ($tvm || !$v) continue;
      $looked++;
      $j = uc_tvmaze_get("lookup/shows?$k=" . rawurlencode((string)$v));
      if ($j && !empty($j['id'])) { $tvm = (int)$j['id']; $how = isset($nfo['tvdb']) || isset($nfo['imdb']) ? 'nfo' : 'folder'; }
    }
    if (!$tvm && $title !== '') {
      /* title search: an exact title (and year, when known) that only one show has */
      $looked++;
      $list = uc_tv_search($title);
      $want = uc_tv_norm($title);
      $exact = array_values(array_filter($list, fn($c) => uc_tv_norm($c['name']) === $want));
      if ($year) { $y = array_values(array_filter($exact, fn($c) => $c['year'] === $year)); if ($y) $exact = $y; }
      if (count($exact) === 1) { $tvm = $exact[0]['id']; $how = 'title'; }
      elseif (count($exact) > 1 && $have) {
        /* look-alikes: the one whose episode list fits the files best */
        $scores = [];
        foreach (array_slice($exact, 0, 4) as $c) { $sh = uc_tv_show($c['id']); $scores[$c['id']] = $sh ? fit($have, $sh['eps']) : 0; }
        arsort($scores); $ids = array_keys($scores); $best = $scores[$ids[0]]; $second = $scores[$ids[1]] ?? 0;
        if ($best >= 0.9 && $best - $second >= 0.3) { $tvm = $ids[0]; $how = 'fit'; }
      }
      if (!$tvm) $cand = array_slice($exact ?: $list, 0, 8);
    }
    if ($tvm) {
      $sh = uc_tv_show($tvm);
      if (!$sh) { $row['err'] = "TVmaze doesn't have the show this folder was matched to - pick it again"; $tvm = null; }
      else {
        /* daily shows named by date: find the episode that aired that day */
        if ($dates) { $byDate = []; foreach ($sh['eps'] as [$s, $e, $d]) if ($d !== '') $byDate[$d][] = "$s.$e"; foreach ($dates as $d => $_) foreach ($byDate[$d] ?? [] as $k) $have[$k] = true; }
        $row['show'] = $sh['show']; $row['eps'] = $sh['eps']; $row['how'] = $how;
        /* numbered differently from TVmaze? Sonarr's numbering may be the one the files use */
        $row['have'] = array_keys($have);
        uc_tv_try_sonarr_order($row);
        /* the file names behind episode numbers the list doesn't have - shown in Details */
        $odd = uc_tv_odd_files($fileOf, $row['eps']); if ($odd) $row['odd'] = $odd;
        if (empty($matches[$path]['id']) || (int)$matches[$path]['id'] !== $tvm) { $matches[$path] = ['id' => $tvm, 'how' => $how, 'name' => $sh['show']['name']]; $newMatches++; }
      }
    } else { $row['cand'] = $cand; $row['title'] = $title; $row['year'] = $year; }
  } catch (UcError $e) {
    $row['err'] = $e->getMessage();
    if (str_starts_with($row['err'], "Can't reach")) $down = $row['err'];
  }
  $row['have'] = array_keys($have);
  fwrite($out, json_encode($row, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
  fflush($out);
  $done++;
  $st['done'] = $done; $st['looked'] = $looked; save($st);
}
fclose($out);
/* matches found this time are remembered - one write at the end */
if ($newMatches) uc_tv_store('matches', $matches);
$st['current'] = null; $st['found'] = $done; $st['seen'] = $seen;
$st['state'] = $stop ? 'stopped' : 'done'; $st['finished'] = time();
save($st);
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/include/worker.php" Mode="0644">
<INLINE><![CDATA[<?php
/* unCommander — background job runner. Started detached (setsid) by the API,
 * so a copy keeps going after the browser tab closes. Jobs run one at a time:
 * each worker waits on a shared lock, which gives a simple FIFO-ish queue. */
require_once __DIR__ . '/lib.php';

$id = $argv[1] ?? '';
$job = uc_job_read($id);
if (!$job || $job['state'] !== 'queued') exit(1);

$job['pid'] = getmypid();
uc_job_write($job);

$cancelled = false;
$child = null;
pcntl_async_signals(true);
pcntl_signal(SIGTERM, function () use (&$cancelled, &$child) {
  $cancelled = true;
  if ($child) { $st = proc_get_status($child); if ($st['running']) posix_kill($st['pid'], SIGTERM); }
});

$lock = fopen(UC_STATE . '/run.lock', 'c');
while (!flock($lock, LOCK_EX | LOCK_NB)) {
  if ($cancelled) finish('cancelled');
  usleep(500000);
}

$job['state'] = 'running';
$job['started'] = time();
uc_job_write($job);

function finish(string $state, ?string $error = null): never {
  global $job;
  $job['state'] = $state;
  $job['error'] = $error;
  $job['finished'] = time();
  if ($state === 'done') { $job['pct'] = 100; $job['eta'] = ''; }
  try { uc_job_announce($job); } catch (Throwable $e) {}
  /* History: this job's step can now be undone (or an undo's move-back is done) */
  try { if (!empty($job['hist'])) $job['type'] === 'back' ? uc_hist_back_done($job) : uc_hist_job_done($job); } catch (Throwable $e) {}
  uc_job_write($job);
  exit($state === 'done' ? 0 : 1);
}

/* Run a command, feeding each \r- or \n-terminated line to $onLine. */
function run(array $argv, callable $onLine, ?string $cwd = null): array {
  global $child, $cancelled;
  $cmd = implode(' ', array_map('escapeshellarg', $argv));
  /* stdin is /dev/null so nothing can sit waiting for an answer (a password prompt, say) */
  $child = proc_open($cmd, [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $cwd);
  if (!$child) return [127, 'could not start ' . $argv[0]];
  stream_set_blocking($pipes[1], false);
  stream_set_blocking($pipes[2], false);
  $buf = ''; $err = '';
  while (true) {
    $r = [$pipes[1], $pipes[2]]; $w = $e = null;
    if (@stream_select($r, $w, $e, 1) === false && !$cancelled) continue;
    foreach ($r as $p) {
      $chunk = fread($p, 65536);
      if ($chunk === '' || $chunk === false) continue;
      if ($p === $pipes[2]) { $err = substr($err . $chunk, -4000); continue; }
      $buf .= preg_replace('/\x08+/', "\n", $chunk);     // 7-Zip redraws its progress with backspaces, not new lines
      while (preg_match('/^([^\r\n]*)[\r\n]/', $buf, $m)) {
        $buf = substr($buf, strlen($m[0]));
        if ($m[1] !== '') $onLine($m[1]);
      }
    }
    if (feof($pipes[1]) && feof($pipes[2])) break;
  }
  fclose($pipes[1]); fclose($pipes[2]);
  $rc = proc_close($child);
  $child = null;
  return [$rc, trim($err)];
}

$lastWrite = 0;
function progress(array $fields): void {
  global $job, $lastWrite;
  $job = array_merge($job, $fields);
  if (microtime(true) - $lastWrite > 0.5) { uc_job_write($job); $lastWrite = microtime(true); }
}

/* Undo bookkeeping for copy, move and Compare copies (see lib.php). */
@mkdir(UC_UNDO, 0700, true);
foreach (glob(UC_UNDO . '/*') ?: [] as $old) if (filemtime($old) < time() - 7 * 86400) @unlink($old);
$undo = null;
function undo_begin(array &$argv): void {
  global $job, $undo;
  $undo = ['id' => $job['id'], 'type' => $job['type'], 'dest' => rtrim($job['dest'], '/'), 'bin' => null, 'at' => time(),
           /* replacing with the trash switched off: the old versions aren't kept, so no undo */
           'blocked' => ($job['exists'] ?? 'skip') !== 'skip' && !uc_settings()['trash']];
  $undo['list'] = fopen(UC_UNDO . '/' . $job['id'] . '.written', 'w');
  if (($job['exists'] ?? 'skip') !== 'skip' && uc_settings()['trash']) {
    $undo['bin'] = uc_trash_merge_bin($undo['dest'], 'Replaced by ' . ($job['type'] === 'move' ? 'move' : 'copy'));
    $argv[] = '--backup';
    $argv[] = '--backup-dir=' . $undo['bin'] . '/' . basename($undo['dest']);
  }
}
function undo_note(string $name): void {
  global $undo;
  if (!$undo) return;
  /* rsync writes odd characters as \#ooo (octal) */
  $name = preg_replace_callback('/\\\\#([0-7]{3})/', fn($m) => chr(octdec($m[1])), $name);
  fwrite($undo['list'], $name . "\0");
}
function undo_end(): void {
  global $undo;
  if (!$undo) return;
  fclose($undo['list']);
  if ($undo['bin'] && is_dir($undo['bin'])) uc_trash_merge_mark($undo['bin'], $undo['dest']);
  else $undo['bin'] = null;
  unset($undo['list']);
  file_put_contents(UC_UNDO . '/' . $undo['id'] . '.json', json_encode($undo, JSON_UNESCAPED_SLASHES));
  $undo = null;
}

/* rsync --info=progress2 lines look like:
 *   5,734,617,088  46%  211.23MB/s    0:00:32 (xfr#3, to-chk=10/50)
 * and --out-format='F:%n' gives us the file currently being sent. */
$parse = function (string $line) {
  if (str_starts_with($line, 'F:')) { undo_note(substr($line, 2)); progress(['file' => substr($line, 2)]); return; }
  if (preg_match('/^\s*([\d,]+)\s+(\d+)%\s+(\S+)\s+(\d+:\d\d:\d\d)/', $line, $m)) {
    $bytes = (int)str_replace(',', '', $m[1]);
    $pct = (int)$m[2];
    $f = [];
    if (preg_match('/xfr#(\d+)/', $line, $x)) $f['files'] = (int)$x[1];
    /* to-chk=left/total counts every item in the list (files and folders) */
    if (preg_match('/to-che?c?k=(\d+)\/(\d+)/', $line, $x)) { $f['count'] = (int)$x[2]; $f['checked'] = (int)$x[2] - (int)$x[1]; }
    progress(['bytes' => $bytes, 'pct' => $pct, 'speed' => $m[3], 'eta' => $m[4],
              'total' => $pct > 0 ? (int)round($bytes * 100 / $pct) : null] + $f);
  }
};

try {
  if ($job['type'] === 'copy' || $job['type'] === 'move') {
    $flags = ['rsync', '-a', '--info=progress2', '--no-inc-recursive', '--out-format=F:%n'];
    if ($job['exists'] === 'skip') $flags[] = '--ignore-existing';
    if ($job['exists'] === 'newer') $flags[] = '--update';
    if ($job['type'] === 'move') $flags[] = '--remove-source-files';
    undo_begin($flags);
    /* items pasted under a new name ("Keep both") go one by one */
    $as = $job['as'] ?? []; $ex = $job['excl'] ?? []; $plain = []; $ren = [];
    foreach ($job['sources'] as $k => $s) { $n = $as[$k] ?? ''; if ($n !== '' && $n !== basename($s)) $ren[] = [$s, $n, $ex[$k] ?? []]; else $plain[] = [$s, $ex[$k] ?? []]; }
    /* left-outs: anchored rsync patterns, wildcards escaped so names are taken literally */
    $exN = 0;
    $exFile = function (array $pats) use ($job, &$exN) {
      if (!$pats) return [];
      $f = UC_STATE . '/jobs/' . $job['id'] . '.' . ($exN++) . '.ex';
      file_put_contents($f, implode("\n", array_map(fn($x) => '/' . preg_replace('/([*?\[\]\\\\])/', '\\\\$1', $x), $pats)) . "\n");
      return ['--exclude-from=' . $f];
    };
    $rc = 0; $err = '';
    if ($plain) {
      $pats = [];
      foreach ($plain as [$s, $xs]) foreach ($xs as $x) $pats[] = basename($s) . '/' . $x;
      $argv = array_merge($flags, $exFile($pats), ['--'], array_map(fn($x) => rtrim($x[0], '/'), $plain), [rtrim($job['dest'], '/') . '/']);   // no trailing slash: copy the folder itself
      [$rc, $err] = run($argv, $parse);
    }
    foreach ($ren as [$s, $n, $xs]) {
      if ($rc !== 0 || $cancelled) break;
      $isDir = is_dir($s) && !is_link($s);
      /* what rsync lists is relative to the item here, so put the new name in front for Undo */
      $p2 = function (string $line) use ($n, $isDir, $parse) {
        if (str_starts_with($line, 'F:')) { $f = substr($line, 2); $line = 'F:' . ($isDir ? ($f === './' ? "$n/" : "$n/$f") : $n); }
        $parse($line);
      };
      $argv = array_merge($flags, $isDir ? $exFile($xs) : [], ['--', $isDir ? rtrim($s, '/') . '/' : $s, rtrim($job['dest'], '/') . '/' . $n . ($isDir ? '/' : '')]);
      [$rc, $err] = run($argv, $p2);
    }
    undo_end();
    foreach (glob(UC_STATE . '/jobs/' . $job['id'] . '.*.ex') ?: [] as $f) @unlink($f);
    if ($cancelled) finish('cancelled');
    if ($rc !== 0) finish('failed', "rsync exited with code $rc" . ($err ? ": $err" : ''));

    if ($job['type'] === 'move') {
      /* rsync removed the files; sweep the now-empty folders it left behind. */
      foreach ($job['sources'] as $s) if (is_dir($s))
        run(['find', $s, '-depth', '-type', 'd', '-empty', '-delete'], fn($l) => null);
    }
    finish('done');
  }

  if ($job['type'] === 'sync') {
    /* exact list from the Compare window; -r so a listed folder brings its contents */
    $list = UC_STATE . '/jobs/' . $job['id'] . '.list';
    file_put_contents($list, implode("\0", $job['rel']) . "\0");
    $argv = ['rsync', '-a', '-r', '--from0', '--files-from=' . $list, '--info=progress2', '--no-inc-recursive', '--out-format=F:%n'];
    if ($job['exists'] !== 'overwrite') $argv[] = '--ignore-existing';
    undo_begin($argv);
    $argv[] = '--';
    $argv[] = rtrim($job['root'], '/') . '/';
    $argv[] = rtrim($job['dest'], '/') . '/';
    [$rc, $err] = run($argv, $parse);
    undo_end();
    @unlink($list);
    if ($cancelled) finish('cancelled');
    if ($rc !== 0) finish('failed', "rsync exited with code $rc" . ($err ? ": $err" : ''));
    finish('done');
  }

  /* Undo from History: move items back across disks. Each task moves a list
   * of paths (relative to 'from') into 'to'; rsync removes the sources. */
  if ($job['type'] === 'back') {
    foreach ($job['tasks'] as $t) {
      $list = UC_STATE . '/jobs/' . $job['id'] . '.list';
      if ($t['rec']) {
        /* a whole item: straight back to its old place, under its old name */
        $src = rtrim($t['from'], '/') . '/' . $t['prefix']; $nn = $t['newname'] ?? $t['prefix'];
        $isDir = is_dir($src) && !is_link($src);
        $argv = ['rsync', '-a', '--info=progress2', '--no-inc-recursive', '--remove-source-files', '--ignore-existing', '--', $isDir ? "$src/" : $src, rtrim($t['to'], '/') . '/' . $nn . ($isDir ? '/' : '')];
      } else {
        /* only the files it brought, from a folder that was already there */
        file_put_contents($list, implode("\0", $t['rel']) . "\0");
        $argv = ['rsync', '-a', '--from0', '--files-from=' . $list, '--info=progress2', '--no-inc-recursive', '--remove-source-files', '--ignore-existing', '--', rtrim($t['from'], '/') . '/', rtrim($t['to'], '/') . '/'];
      }
      [$rc, $err] = run($argv, $parse);
      @unlink($list);
      if ($cancelled) finish('cancelled');
      if ($rc !== 0) finish('failed', "rsync exited with code $rc" . ($err ? ": $err" : ''));
      /* what's left where it was: only empty folders it made */
      if ($t['rec']) { foreach ($t['rel'] as $r) if (is_dir($t['from'] . "/$r")) run(['find', $t['from'] . "/$r", '-depth', '-type', 'd', '-empty', '-delete'], fn($l) => null); }
      else { $d = $t['rmdirs']; usort($d, fn($a, $b) => substr_count($b, '/') <=> substr_count($a, '/')); foreach ($d as $x) @rmdir($t['from'] . "/$x"); }
      if (!empty($t['job'])) uc_hist_put_back_replaced((string)$t['job'], (string)$t['prefix']);
    }
    finish('done');
  }

  if ($job['type'] === 'perms') {
    $o = $job['options'];
    $R = $o['recursive'] ? ['-R'] : [];
    foreach ($job['sources'] as $s) {
      progress(['file' => $s]);
      if ($o['preset']) {
        /* unRAID's "New Permissions": nobody:users, folders 777, files 666. */
        [$rc, $err] = run(array_merge(['chown'], $R, ['nobody:users', '--', $s]), fn($l) => null);
        if ($rc) finish('failed', $err);
        [$rc, $err] = run(array_merge(['chmod'], $R, ['u-x,go-rwx,go+u,ugo+X', '--', $s]), fn($l) => null);
        if ($rc) finish('failed', $err);
      } else {
        if ($o['owner'] !== '' || $o['group'] !== '') {
          [$rc, $err] = run(array_merge(['chown'], $R, [$o['owner'] . ':' . $o['group'], '--', $s]), fn($l) => null);
          if ($rc) finish('failed', $err);
        }
        if ($o['mode'] !== '') {
          [$rc, $err] = run(array_merge(['chmod'], $R, [$o['mode'], '--', $s]), fn($l) => null);
          if ($rc) finish('failed', $err);
        }
      }
      if ($cancelled) finish('cancelled');
    }
    finish('done');
  }
  /* 7-Zip's -bsp1 progress: "  42% 17 + some/file" redrawn with backspaces */
  $p7 = function (string $line) {
    global $job;
    if (preg_match('/^\s*(\d+)%(?:\s+(\d+))?(?:\s*[+U-]\s+(.*))?/', $line, $m)) {
      $f = ['pct' => min(99, (int)$m[1])];
      if (!empty($job['total'])) $f['bytes'] = (int)($job['total'] * $f['pct'] / 100);
      if (!empty($m[2])) $f['checked'] = (int)$m[2];
      if (!empty($m[3])) $f['file'] = trim($m[3]);
      progress($f);
    }
  };
  /* tar --checkpoint: one "CP n" line per ~1 MB (100 records of 10 KB) */
  $ptar = function (int $total) {
    return function (string $line) use ($total) {
      if (preg_match('/^CP(\d+)/', $line, $m)) {
        $bytes = (int)$m[1] * 100 * 10240;
        progress(['bytes' => $bytes] + ($total > 0 ? ['pct' => min(99, (int)($bytes * 100 / $total)), 'total' => $total] : []));
      }
    };
  };
  /* unRAID's usual ownership and permissions for what we just made */
  $tidy = function (string $path, bool $recursive) {
    run(array_merge(['chown'], $recursive ? ['-R'] : [], ['nobody:users', '--', $path]), fn($l) => null);
    run(array_merge(['chmod'], $recursive ? ['-R'] : [], ['u-x,go-rwx,go+u,ugo+X', '--', $path]), fn($l) => null);
  };

  if ($job['type'] === 'compress') {
    $names = array_map('basename', $job['sources']);
    $out = $job['out'];
    /* step 1: count what's going in, so the bar can show real progress */
    progress(['phase' => 'Counting the files']);
    $cnt = 0; $tot = 0;
    $h = popen('find ' . implode(' ', array_map('escapeshellarg', $job['sources'])) . ' ! -type d -printf ' . escapeshellarg("%s\n") . ' 2>/dev/null', 'r');
    while ($h && ($l = fgets($h)) !== false) { $cnt++; $tot += (int)$l; if ($cancelled) break; }
    if ($h) pclose($h);
    if ($cancelled) finish('cancelled');
    progress(['phase' => 'Compressing', 'count' => $cnt, 'total' => $tot]);
    $tmp = dirname($out) . '/.' . basename($out) . '.part';      // built under a hidden name, renamed when complete
    @unlink($tmp);
    if ($job['format'] === 'zip' && is_executable(UC_7Z)) {
      [$rc, $err] = run(array_merge([UC_7Z, 'a', '-tzip', '-mx=' . ($job['store'] ? 0 : 5), '-bso0', '-bsp1', '-bse2', '-y', '--', $tmp], $names), $p7, $job['srcdir']);
    } elseif ($job['format'] === 'zip') {
      [$rc, $err] = run(array_merge(['zip', '-r', '-q', $job['store'] ? '-0' : '-6', $tmp, '--'], $names), fn($l) => null, $job['srcdir']);
    } else {
      $total = $tot;
      $cmd = 'tar -cz --checkpoint=100 --checkpoint-action=echo=CP%u -f ' . escapeshellarg($tmp) . ' -- ' . implode(' ', array_map('escapeshellarg', $names)) . ' 2>&1';
      [$rc, $err] = run(['sh', '-c', $cmd], $ptar($total), $job['srcdir']);
    }
    if ($cancelled) { @unlink($tmp); finish('cancelled'); }
    if ($rc !== 0 && !($job['format'] === 'zip' && is_executable(UC_7Z) && $rc === 1)) {   // 7-Zip: 1 = warnings (e.g. a file changed while reading)
      @unlink($tmp); finish('failed', "Compressing failed (code $rc)" . ($err ? ": $err" : ''));
    }
    progress(['phase' => 'Saving the archive', 'pct' => 99, 'file' => '']);
    if (!@rename($tmp, $out)) { @unlink($tmp); finish('failed', 'Could not save ' . basename($out)); }
    $tidy($out, false);
    $job['outsize'] = (int)@filesize($out);
    /* "Delete the originals" - only now that the archive is complete and saved */
    if (!empty($job['remove'])) {
      progress(['phase' => 'Moving the originals to the trash']);
      try { [$cnt, $bins] = uc_delete_paths($job['sources'], false, $items); $job['removed'] = $bins; $job['removed_items'] = $items; }
      catch (Throwable $e) { finish('failed', 'The archive was saved, but removing the originals failed: ' . $e->getMessage()); }
    }
    finish('done');
  }

  /* Copying out of an archive (it was open like a folder): just those items, taken out into a hidden work
   * folder next to where they go, then moved into place - so nothing half-made shows up there. */
  if ($job['type'] === 'extract' && !empty($job['members'])) {
    $a = $job['sources'][0]; $dest = rtrim($job['target'], '/'); $over = $job['exists'] === 'overwrite';
    $stage = $dest . '/.uc-copyout-' . $job['id'];
    $clean = function () use ($stage) { if (is_dir($stage)) run(['rm', '-rf', '--', $stage], fn($l) => null); };
    if (!@mkdir($stage, 0700)) finish('failed', "Could not make a work folder in $dest");
    $lst = UC_JOBS . '/' . $job['id'] . '.list';
    progress(['phase' => 'Taking it out of the archive', 'count' => count($job['afiles']), 'total' => (int)$job['total']]);
    if ($job['afiles']) {
      if ($job['kind'] === 'tar') {
        file_put_contents($lst, implode("\0", $job['afiles']) . "\0");
        [$rc, $err] = run(['sh', '-c', 'tar -x --no-same-owner -f ' . escapeshellarg($a) . ' -C ' . escapeshellarg($stage) . ' --checkpoint=100 --checkpoint-action=echo=CP%u --null --no-wildcards -T ' . escapeshellarg($lst) . ' 2>&1'], $ptar((int)$job['total']));
      } else {
        file_put_contents($lst, implode("\n", $job['afiles']) . "\n");
        $pw = uc_arc_pw((string)($job['akey'] ?? ''));
        [$rc, $err] = run([UC_7Z, 'x', '-y', '-spd', '-bso0', '-bsp1', '-bse2', '-scsUTF-8', '-p' . ($pw !== '' ? $pw : 'UCNOPASS'), '-o' . $stage, '-i@' . $lst, '--', $a], $p7);
        if ($rc === 1) $rc = 0;                                        // 7-Zip: 1 = warnings only
        if ($rc && preg_match('/password|encrypted/i', $err)) $err = 'the archive needs its password - open it again in the pane and type it';
      }
      @unlink($lst);
      if ($cancelled) { $clean(); finish('cancelled'); }
      if ($rc !== 0) { $clean(); finish('failed', "Copying out of the archive failed (code $rc)" . ($err ? ': ' . mb_substr($err, 0, 300) : '')); }
    }
    foreach ($job['edirs'] as $d) @mkdir($stage . '/' . $d, 0777, true);     // empty folders inside
    progress(['phase' => 'Putting it in place', 'pct' => 99, 'file' => '']);
    $made = []; $skipped = 0; $replaced = []; $into = false;
    $place = function (string $src, string $dst) use (&$place, &$made, &$skipped, &$replaced, &$into, $over) {
      if (!file_exists($src) && !is_link($src)) return;
      if (!file_exists($dst) && !is_link($dst)) { if (@rename($src, $dst)) $made[] = $dst; return; }
      if (is_dir($src) && !is_link($src) && is_dir($dst) && !is_link($dst)) {      // a folder that's already there: what's new goes in
        $into = true;
        foreach (scandir($src) ?: [] as $n) if ($n !== '.' && $n !== '..') $place("$src/$n", "$dst/$n");
        return;
      }
      if (!$over) { $skipped++; return; }
      try { uc_delete_paths([$dst], false, $items); $replaced = array_merge($replaced, $items ?? []); } catch (Throwable $e) { $skipped++; return; }
      if (@rename($src, $dst)) $made[] = $dst;
    };
    foreach ($job['members'] as $m) $place($stage . '/' . $m, $dest . '/' . basename($m));
    $clean();
    foreach ($made as $m) $tidy($m, is_dir($m) && !is_link($m));
    /* History: each new item can be undone (to the trash); replaced ones come back from the trash */
    $parts = count($made) <= 2000 ? array_map(fn($m) => ['t' => 'made', 'p' => $m], $made)
                                  : [['t' => 'into', 'p' => $dest, 's' => 'x', 'why' => count($made) . " items went into folders that already had things in them - remove them by hand"]];
    if ($parts || $replaced) { $job['hist'] = uc_hist_add($job['hlabel'] ?? $job['label'], $parts ?: [['t' => 'into', 'p' => $dest, 's' => 'x', 'why' => 'nothing new was added']]); $job['removed_items'] = $replaced; }
    progress(['bytes' => (int)$job['total'], 'skipped' => $skipped]);
    finish('done');
  }

  if ($job['type'] === 'extract') {
    $a = $job['sources'][0]; $target = $job['target']; $skip = $job['exists'] === 'skip';
    progress(['phase' => 'Reading the archive']);
    try { $info = uc_archive_list($a, 0); progress(['count' => $info['files'], 'total' => $info['bytes']]); } catch (Throwable $e) {}
    if (!is_dir($target) && !@mkdir($target, 0777, true)) finish('failed', "Could not create $target");
    progress(['phase' => 'Extracting']);
    $stamp = UC_JOBS . '/' . $job['id'] . '.stamp';
    touch($stamp); sleep(1);              // everything extracted after this moment gets unRAID's ownership below
    if ($job['kind'] === 'tar') {
      $cmd = 'tar -x ' . ($skip ? '--skip-old-files' : '--overwrite') . ' --no-same-owner --checkpoint=100 --checkpoint-action=echo=CP%u -f ' . escapeshellarg($a) . ' -C ' . escapeshellarg($target) . ' 2>&1';
      [$rc, $err] = run(['sh', '-c', $cmd], $ptar((int)($job['total'] ?? 0)));
    } elseif (is_executable(UC_7Z)) {
      [$rc, $err] = run([UC_7Z, 'x', '-o' . $target, $skip ? '-aos' : '-aoa', '-pUCNOPASS', '-bso0', '-bsp1', '-bse2', '-y', '--', $a], $p7);
      if ($rc && stripos($err, 'password') !== false) $err = "it's password-protected - unCommander can't open those yet";
    } else {
      [$rc, $err] = run(['unzip', $skip ? '-n' : '-o', '-q', $a, '-d', $target], fn($l) => null);
    }
    if ($cancelled) { @unlink($stamp); finish('cancelled'); }
    progress(['phase' => 'Setting ownership and permissions', 'pct' => 99, 'file' => '']);
    /* new files belong to nobody:users like the rest of the array */
    if (!empty($job['made'])) $tidy($target, true);
    else run(['sh', '-c', 'find ' . escapeshellarg($target) . ' -mindepth 1 -cnewer ' . escapeshellarg($stamp) . ' -exec chown nobody:users {} + -exec chmod u-x,go-rwx,go+u,ugo+X {} + 2>/dev/null'], fn($l) => null);
    @unlink($stamp);
    if ($rc !== 0 && !($job['kind'] !== 'tar' && is_executable(UC_7Z) && $rc === 1)) finish('failed', "Extracting failed (code $rc)" . ($err ? ": $err" : ''));
    /* "Delete the archive" - only after a clean extract */
    if (!empty($job['remove'])) {
      progress(['phase' => 'Moving the archive to the trash']);
      try { [$cnt, $bins] = uc_delete_paths(uc_archive_parts($a), false, $items); $job['removed'] = $bins; $job['removed_items'] = $items; }
      catch (Throwable $e) { finish('failed', 'Everything was extracted, but removing the archive failed: ' . $e->getMessage()); }
    }
    progress(['bytes' => (int)($job['total'] ?? 0)]);
    finish('done');
  }

  finish('failed', 'Unknown job type');
} catch (Throwable $e) {
  finish('failed', $e->getMessage());
}
]]></INLINE>
</FILE>
