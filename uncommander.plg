      if (ow.length) $('.pal-now', box).insertAdjacentHTML('afterend', `<div class="st-warn pal-ow">Your CSS (below) sets ${ow.map(([k]) => `<span class="mono">--${k}</span>`).join(', ')} - those win over this theme until you take them out of it.</div>`);
