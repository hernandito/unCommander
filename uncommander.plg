<!--
  7-Zip (for .rar and .7z): the official static Linux build, checksum-pinned,
  cached on the flash drive and unpacked into unCommander's own folder only.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
Z=/boot/config/plugins/uncommander/7z2603-linux-x64.tar.xz
SHA=dc99eff5008f1ab79bd7084c68513701547a808a89502bf4133683535ab3c695
URL=https://github.com/ip7z/7zip/releases/download/26.03/7z2603-linux-x64.tar.xz
BIN=/usr/local/emhttp/plugins/uncommander/bin
mkdir -p /boot/config/plugins/uncommander "$BIN"
if ! echo "$SHA  $Z" | sha256sum -c --status 2>/dev/null; then
  rm -f "$Z"
  echo "Downloading 7-Zip (about 1.6 MB)..."
  if curl -fsSL --max-time 120 -o "$Z.part" "$URL" && echo "$SHA  $Z.part" | sha256sum -c --status; then
    mv "$Z.part" "$Z"
  else
    rm -f "$Z.part"
    echo "Note: could not download 7-Zip. Extracting .rar and .7z will be unavailable until unCommander is reinstalled while the server is online."
  fi
fi
if [ -f "$Z" ]; then
  rm -f "$BIN/7zzs"
  xz -dc "$Z" 2>/dev/null | tar -xf - -C "$BIN" 7zzs 2>/dev/null || tar -xJf "$Z" -C "$BIN" 7zzs
  chmod 755 "$BIN/7zzs" 2>/dev/null
  if [ -x "$BIN/7zzs" ] && "$BIN/7zzs" >/dev/null 2>&1; then
    echo "7-Zip ready."
  else
    echo "Note: 7-Zip could not be unpacked - .rar and .7z extraction is unavailable."
  fi
  find /boot/config/plugins/uncommander -maxdepth 1 -name '7z*-linux-x64.tar.xz' ! -name "$(basename "$Z")" -delete
fi
]]>
</INLINE>
</FILE>

<!-- INSTALL SCRIPT -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
NAME="uncommander"
# Entities aren't expanded inside CDATA: close it, let the parser fill in
# &version;, then reopen.
VERSION="]]>&version;<![CDATA["
PLUGDIR="/usr/local/emhttp/plugins/$NAME"
CONF="/boot/config/plugins/$NAME"

mkdir -p "$CONF"
# default settings - created once, never overwritten
[ -f "$CONF/uncommander.cfg" ] || echo 'TRASH_DAYS="30"' > "$CONF/uncommander.cfg"

chown -R root:root "$PLUGDIR"
find "$PLUGDIR" -type d -exec chmod 755 {} +
find "$PLUGDIR" -type f -exec chmod 644 {} +
chmod 755 "$PLUGDIR/scripts/"* "$PLUGDIR/bin/"* 2>/dev/null

# the custom menu name from Settings, if one was saved
php "$PLUGDIR/scripts/apply-menu-name"

# daily trash clean-up at 04:17
echo "17 4 * * * $PLUGDIR/scripts/purge-trash &>/dev/null" > "$CONF/uncommander.cron"
update_cron

echo ""
echo "----------------------------------------------------"
echo " unCommander $VERSION installed."
echo " Open it from the Unraid menu bar (reload the page)."
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- REMOVE SCRIPT -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
rm -f /boot/config/plugins/uncommander/uncommander.cron
update_cron
pkill -f "/usr/local/emhttp/plugins/uncommander/include/worker.php" 2>/dev/null
rm -rf /usr/local/emhttp/plugins/uncommander /tmp/uncommander
echo ""
echo "unCommander removed. Your settings (/boot/config/plugins/uncommander) and any"
echo ".uncommander-trash folders on your shares were left in place."
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
