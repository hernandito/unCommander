<FILE Name="/usr/local/emhttp/plugins/uncommander/UnCommanderWebApp.page" Mode="0644">
<INLINE><![CDATA[Menu="Buttons"
Link="uc-webapp-hook"
---
<?php
/* unCommander as an iPad Home Screen app: that app has its own login, and
 * after logging in unRAID always opens its Main page. When the page is shown
 * inside unCommander's Home Screen app (and only there), go back to unCommander.
 * Adds nothing to unRAID's own pages otherwise. */
?>
<script>
(function () {
  try {
    var app = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone;
    if (app && localStorage.getItem('uc.webapp') === '1' && location.pathname.indexOf('/plugins/uncommander/') !== 0)
      location.replace('/plugins/uncommander/uncommander.php');
  } catch (e) {}
})();
</script>
]]></INLINE>
</FILE>
<FILE Name="/usr/local/emhttp/plugins/uncommander/css/uncommander.css" Mode="0644">
<INLINE><![CDATA[/* unCommander — scoped under #uc so nothing leaks into the unRAID webGUI. */
#uc {
  --ground: #eef0f2; --surface: #fff; --surface-2: #f6f7f8; --surface-3: #e9ecee;
  --line: #d3d8dc; --line-soft: #e3e7ea; --ink: #16191c; --ink-2: #3d454c; --muted: #6b757d;
  --accent: #008cb4; --accent-ink: #fff; --accent-soft: #e0f3f8; --accent-soft-t: color-mix(in srgb, var(--accent-soft) 67%, transparent);
  --ok: #2f7d46; --warn: #9a6a10; --danger: #b5342c;
  --cursor: #fbf3dc;          /* the cursor row in the active pane (the cream bar) */
  --cursor-off: #eceef0;      /* the cursor row in the other pane */
  --sel-count: var(--accent); /* "3 of 120 selected" in a pane header */
  --shadow: 0 1px 2px rgba(16,20,24,.06), 0 8px 24px rgba(16,20,24,.08);
  --r: 10px; --row: 23px;      /* --row: height of a row in the file lists */
  --r-btn: 6px;      /* corners of buttons: F-keys, shortcuts, toolbar and dialog buttons */
  --r-input: 6px;    /* corners of text boxes, drop-downs and the two path boxes */
  --name-font: var(--mono);   /* file names in the lists and the path boxes */
  --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-family: var(--sans); font-size: calc(14px * var(--fs, 1)); line-height: 1.45; color: var(--ink);
  background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
  box-shadow: var(--shadow); overflow: hidden; outline: none; position: relative;
  margin: 4px 0 0; text-align: left;
  /* Fills the window: the JS sets the height to the space below the unRAID
   * menu. Top bars and function keys keep their size; the file lists flex. */
  display: flex; flex-direction: column;
}
#uc > * { flex: none; }
#uc > .uc-panes { flex: 1 1 auto; min-height: 0; }
#uc.uc-dark {
  --ground: #131619; --surface: #1c2024; --surface-2: #22272c; --surface-3: #2a3037;
  --line: #363d45; --line-soft: #2b3138; --ink: #e8ecef; --ink-2: #c2cad1; --muted: #8a949d;
  --accent: #4c9aff; --accent-ink: #07111f; --accent-soft: #13233a; --accent-soft-t: color-mix(in srgb, var(--accent-soft) 67%, transparent);
  --ok: #5fbe7d; --warn: #e0ab48; --danger: #f0736a;
  --cursor: #3b3423; --cursor-off: #2c3137;
  --shadow: 0 1px 2px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.45);
}
#uc * { box-sizing: border-box; }
#uc button, #uc input, #uc select { font: inherit; color: inherit; margin: 0; min-width: 0; text-transform: none; letter-spacing: normal; box-shadow: none; }

/* bars */
#uc .uc-appbar { display: flex; align-items: center; gap: 6px; padding: 4px 10px; background: var(--surface-3); border-bottom: 1px solid var(--line); font-size: calc(13px * var(--fs, 1)); }
#uc .uc-logo { font-weight: 700; letter-spacing: -.01em; font-size: calc(15px * var(--fs, 1)); }
#uc .uc-logo span { color: var(--logo-ink, var(--accent)); }
#uc .uc-sep, #uc .uc-spacer { flex: 1; }
#uc .uc-jump { font: 500 calc(13px * var(--fs, 1))/1 var(--mono); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-input); padding: 5px 9px; width: 240px; height: auto; color: var(--ink); }
#uc .uc-jump:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--accent); }
#uc .uc-jump.miss { border-color: var(--danger); color: var(--danger); }
#uc .uc-jump.miss:focus { outline-color: var(--danger); }
#uc .uc-chip { font: 500 calc(11px * var(--fs, 1))/1 var(--mono); color: var(--muted); border: 1px solid var(--line); border-radius: 20px; padding: 4px 9px; white-space: nowrap; }
#uc select { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-input); padding: 3px 6px; font-size: calc(12.5px * var(--fs, 1)); height: auto; width: auto; }

#uc .uc-crumbs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; padding: 4px 10px; border-bottom: 1px solid var(--line-soft); }
#uc .uc-path { display: flex; align-items: center; min-width: 0; background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r-input); }
#uc .uc-path.active { border-color: var(--accent); }
#uc .uc-path.editing { outline: 2px solid var(--accent); outline-offset: -1px; }
/* Whole OS view, outside /mnt: the path box turns red */
#uc .uc-path.uc-outside, #uc .uc-path.uc-outside.active { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger); }
#uc .uc-path.uc-outside.editing { outline-color: var(--danger); }
#uc .uc-trail { flex: 1; min-width: 0; display: flex; align-items: center; overflow-x: auto; scrollbar-width: none; white-space: nowrap; font: 400 calc(13px * var(--fs, 1))/1 var(--name-font); color: var(--ink-2); padding: 6px 9px; cursor: text; user-select: text; -webkit-user-select: text; }
#uc .uc-trail::-webkit-scrollbar { display: none; }
#uc .uc-path.editing .uc-trail { display: none; }
#uc .tr-sep { color: var(--muted); padding: 0 1px; }
#uc .tr-seg { cursor: pointer; padding: 2px 2px; border-radius: 3px; }
#uc .tr-seg:hover { background: var(--crumb-hover, color-mix(in srgb, var(--accent) 12%, transparent)); color: var(--crumb-hover-ink, var(--accent)); }
#uc .uc-path.active .tr-seg.here { color: var(--ink); font-weight: 700; }
#uc .tr-seg.here { font-weight: 700; }
#uc .tr-seg.ahead, #uc .tr-sep.ahead { color: var(--muted); opacity: .6; font-weight: 400; }
#uc .tr-find { color: var(--accent); }
#uc .uc-crumb { display: none; flex: 1; min-width: 0; font: 400 calc(13px * var(--fs, 1))/1 var(--name-font); color: var(--ink); background: transparent; border: 0; padding: 6px 9px; height: auto; outline: none; }
#uc .uc-path.editing .uc-crumb { display: block; }
#uc .uc-path-btn { -webkit-appearance: none !important; appearance: none !important; flex: none; display: grid !important; place-items: center; width: 26px !important; height: 26px !important; min-width: 0 !important; margin: 0 2px 0 0 !important; padding: 0 !important;
  background: transparent !important; border: 0 !important; border-radius: 6px !important; box-shadow: none !important; color: var(--muted); cursor: pointer; }
#uc .uc-path-btn:last-child { margin-right: 4px !important; }
#uc .uc-path-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linejoin: round; stroke-linecap: round; }
#uc .uc-path-btn:hover, #uc .uc-path-btn:active { background: var(--accent-soft) !important; color: var(--accent); }
#uc .uc-path.editing .uc-path-btn[data-path="copy"] { display: none !important; }
#uc .uc-crumb-btns { display: flex; gap: 6px; }

#uc .uc-btn { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-btn); padding: 4px 10px; font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); cursor: pointer; line-height: 1.2; }
#uc .uc-btn:hover { border-color: var(--accent); color: var(--ink); }
#uc .uc-btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
#uc .uc-btn.danger { color: var(--danger); }
#uc .uc-btn.primary.danger { background: var(--danger); border-color: var(--danger); color: #fff; }
#uc .uc-btn:disabled { opacity: .5; cursor: default; }

#uc input::placeholder, #uc textarea::placeholder { color: var(--muted) !important; opacity: .55 !important; font-style: italic; }
#uc .uc-goto { appearance: none !important; display: inline-flex !important; align-items: center; justify-content: space-between; gap: 6px; background: var(--surface) !important; border: 1px solid var(--line) !important; border-radius: var(--r-input) !important; padding: 3px 6px 3px 8px !important; margin: 0 !important; height: auto !important; font-size: calc(12.5px * var(--fs, 1)) !important; font-weight: 400 !important; text-transform: none !important; letter-spacing: 0 !important; cursor: pointer; color: color-mix(in srgb, var(--muted) 55%, var(--surface)) !important; font-style: italic; min-width: 120px !important; box-shadow: none !important; }
#uc .uc-goto svg { width: 12px; height: 12px; fill: none; stroke: var(--muted); stroke-width: 1.6; flex: none; }
#uc .uc-goto:hover, #uc .uc-goto[aria-expanded="true"] { border-color: var(--accent) !important; }
#uc .uc-list .uc-row.cursor { background: var(--cursor); }
#uc .uc-pane:not(.active) .uc-list .uc-row.cursor { background: var(--cursor-off); }
#uc .uc-pane:has(.selinfo b) .uc-pane-head .count { color: var(--sel-count); }
#uc .uc-pane.active:has(.selinfo b) .uc-pane-head .count { color: var(--sel-count-head, #ffe65e); }   /* on the coloured header of the active pane */
#uc.uc-dark { --sel-count-head: #6b0f0f; }
/* shortcut bar */
#uc .uc-bookmarks { display: flex; flex-wrap: wrap; gap: 5px; padding: 3px 10px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
#uc .uc-bm { font: 500 calc(12.5px * var(--fs, 1))/1.2 var(--sans); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-btn); padding: 4px 11px; cursor: pointer; max-width: 220px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-bm:hover { border-color: var(--accent); color: var(--ink); }
#uc .uc-bm.on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }
#uc .uc-bm-add { font: 500 calc(12.5px * var(--fs, 1))/1.2 var(--sans); color: var(--muted); background: transparent; border: 1px dashed var(--line); border-radius: var(--r-btn); padding: 4px 11px; cursor: pointer; }
#uc .uc-bm-add:hover { color: var(--accent); border-color: var(--accent); }
#uc .uc-settings-btn { white-space: nowrap; }

/* settings */
/* Settings tabs: real folder tabs - the open one joins the page below it.
 * !important throughout: unRAID styles every <button> (background, border, margin, size). */
#uc .st-tabs[hidden] { display: none; }
#uc .st-tabs { display: flex; gap: 3px; align-items: flex-end; border-bottom: 1px solid var(--line); margin: -4px 0 4px; padding: 0 2px; flex-wrap: wrap; }
#uc .st-tabs .st-tab { all: unset; box-sizing: border-box; position: relative; margin: 0 0 -1px 0 !important; min-width: 0 !important; height: auto !important;
  font: 600 calc(13px * var(--fs, 1))/1 var(--sans) !important; letter-spacing: 0 !important; text-transform: none !important; cursor: pointer;
  padding: 10px 15px 9px !important; color: var(--muted) !important;
  background: color-mix(in srgb, var(--line) 35%, var(--surface)) !important; background-image: none !important; box-shadow: none !important;
  border: 1px solid var(--line) !important; border-bottom-color: var(--line) !important; border-radius: 7px 7px 0 0 !important; }
#uc .st-tabs .st-tab:hover { color: var(--ink) !important; background: color-mix(in srgb, var(--line) 18%, var(--surface)) !important; }
#uc .st-tabs .st-tab.on { color: var(--accent) !important; background: var(--surface) !important; border-bottom-color: var(--surface) !important; padding-top: 12px !important; z-index: 1; }
#uc .st-tabs .st-tab.on::before { content: ''; position: absolute; left: -1px; right: -1px; top: -1px; height: 3px; background: var(--accent); border-radius: 7px 7px 0 0; }
#uc .st-tabs .st-tab:focus-visible { outline: 2px solid var(--accent) !important; outline-offset: 2px; }
#uc .st-panel { display: flex; flex-direction: column; gap: 12px; }
#uc .st-panel[hidden] { display: none; }
#uc .st-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
#uc .st-bms { display: flex; flex-direction: column; gap: 6px; }
#uc .st-bm { display: grid; grid-template-columns: minmax(90px, 1fr) minmax(140px, 2fr) auto auto auto; gap: 6px; align-items: center; }
#uc .st-bm input[type=text], #uc .st-panel input[type=text] { font: 500 calc(13px * var(--fs, 1))/1 var(--mono); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-input); padding: 8px 10px; width: 100%; height: auto; }
#uc .st-bm .uc-btn { padding: 7px 10px; }
#uc textarea.st-css { width: 100%; min-height: 240px; height: 38vh; resize: vertical; font: calc(12.5px * var(--fs, 1))/18px var(--mono); background: var(--surface-2); color: var(--ink); border: 1px solid var(--line); border-radius: var(--r-input); padding: 10px; margin: 0; tab-size: 2; }
#uc textarea.st-css:focus, #uc .st-panel input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
#uc .st-ref { font-size: calc(12.5px * var(--fs, 1)); border: 1px solid var(--line-soft); border-radius: var(--r); padding: 8px 10px; }
#uc .st-ref summary { cursor: pointer; font-weight: 600; color: var(--ink-2); }
#uc .st-ref-h { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 14px 0 6px; }
#uc .st-ref table { width: 100%; border-collapse: collapse; }
#uc .st-ref td { padding: 4px 6px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
#uc .st-ref td.mono { color: var(--accent); white-space: nowrap; width: 1%; }
#uc .st-big { font-weight: 600; font-size: calc(14px * var(--fs, 1)); }
#uc .st-radio { display: flex; gap: 10px; align-items: flex-start; padding: 2px 12px; margin-bottom: 6px; border: none; border-radius: var(--r); cursor: pointer; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; }
#uc .st-radio:has(input:checked) { background: none; }
#uc .st-radio input { margin-top: 3px; accent-color: var(--accent); }
#uc .st-vol { width: 100%; accent-color: var(--accent); }
#uc .st-snd-grid { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-items: center; }
#uc .uc-dlg.settings .dlg-body { max-height: 70vh; }

/* panes */
#uc .uc-panes { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: minmax(0, 1fr); column-gap: 8px; padding: 4px 2px 0; }
#uc .uc-pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
#uc .uc-pane > * { flex: none; }
/* Each pane's header, column titles and list sit in one framed box. The
 * active pane gets an accent frame with a thick, unbroken left edge; the
 * other a thin pale-grey frame. The footer stays outside, below the box. */
#uc .uc-box { flex: 1 1 auto !important; min-height: 0; display: flex; flex-direction: column; border: 2px solid var(--line); border-radius: 5px; overflow: hidden; }
#uc .uc-box > * { flex: none; }
/* both panes keep the same border widths - only the colour changes, so nothing inside moves or narrows.
 * The thicker left edge of the active pane is drawn inside, over the content, not as extra border. */
#uc .uc-pane.active .uc-box { border-color: var(--accent); background-color: var(--pane-active-bg); }
#uc .uc-pane.active .uc-box::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--accent); z-index: 7; pointer-events: none; }
/* Whole OS view, outside /mnt: the active pane's list gets its own tint (and the path box turns red) */
#uc { --outside-bg: color-mix(in srgb, var(--danger) 8%, var(--surface)); }
#uc .uc-pane.active.uc-outside .uc-box { background-color: var(--outside-bg); }
#uc .uc-pane-foot { display: none !important; }
#uc .uc-pane-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 7px 10px; background: var(--surface-2); border-bottom: 1px solid var(--line-soft); font: 600 calc(11px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#uc .uc-pane.active .uc-pane-head { background: var(--accent); color: var(--accent-ink); border-bottom-color: color-mix(in srgb, var(--accent) 30%, transparent); }
#uc .uc-cols, #uc .uc-row { display: grid; grid-template-columns: 36px minmax(0,1fr) 52px 80px 38px; align-items: center; }
/* columns each pane shows (sliders button at the right of the column titles) */
#uc .uc-pane .uc-cols, #uc .uc-pane .uc-row { grid-template-columns: var(--cols, 36px minmax(0,1fr) 46px 72px 34px); padding-right: 24px; }
#uc .uc-pane.hide-size .col-size, #uc .uc-pane.hide-date .col-date, #uc .uc-pane.hide-mode .col-mode, #uc .uc-pane.hide-disk .col-disk { display: none; }
#uc .uc-row .col-disk { white-space: nowrap; overflow: hidden; padding: 0 3px; font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); color: var(--ink-2); }
#uc .uc-row .col-disk .d { display: inline-block; padding: 2px 4px; margin-right: 2px; border-radius: 3px; background: color-mix(in srgb, var(--ink) 8%, transparent); }
#uc .uc-row .col-disk .d.pool { background: color-mix(in srgb, #1f8a4c 16%, transparent); color: #1f7a44; }
#uc.uc-dark .uc-row .col-disk .d.pool { color: #7fd6a0; }
#uc .uc-cols .col-disk { cursor: default; }
#uc .uc-cols { position: relative; }
#uc .uc-colbtn { -webkit-appearance: none !important; appearance: none !important; position: absolute; right: 3px; top: 50%; transform: translateY(-50%); width: 22px !important; height: 20px !important; min-width: 0 !important; margin: 0 !important; padding: 0 !important; display: grid !important; place-items: center;
  background: transparent !important; border: 0 !important; border-radius: 4px !important; box-shadow: none !important; color: var(--muted); cursor: pointer; }
#uc .uc-colbtn svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
#uc .uc-colbtn:hover, #uc .uc-colbtn.on { background: var(--accent-soft) !important; color: var(--accent); }
#uc .uc-colpop { position: absolute; right: 6px; top: 100%; margin-top: 4px; z-index: 30; width: 250px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); padding: 6px 0; font: calc(13px * var(--fs, 1))/1.3 var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink); cursor: default; white-space: normal; }
#uc .uc-colpop[hidden] { display: none; }
#uc .uc-colpop .h { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding: 6px 12px 8px; }
#uc .uc-colpop .r { display: flex; align-items: center; justify-content: space-between; padding: 7px 12px; cursor: pointer; }
#uc .uc-colpop .r.fixed { cursor: default; }
#uc .uc-colpop .sub { color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); }
#uc .uc-colpop .ft { border-top: 1px solid var(--line-soft); margin-top: 4px; padding: 8px 12px 4px; color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); line-height: 1.4; }
#uc .uc-sw { width: 30px; height: 18px; border-radius: 10px; background: var(--line); position: relative; flex: none; transition: background .15s; }
#uc .uc-sw::after { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.25); transition: left .15s; }
#uc .uc-sw.on { background: var(--accent); }
#uc .uc-sw.on::after { left: 14px; }
/* finished-job alerts: stay until dismissed */
#uc .uc-alerts { display: flex; flex-direction: column; gap: 1px; background: var(--line-soft); border-bottom: 1px solid var(--line); }
#uc .uc-alerts[hidden] { display: none; }
#uc .uc-alert { display: flex; align-items: center; gap: 10px; padding: 6px 10px; background: color-mix(in srgb, #1f8a4c 10%, var(--surface)); font-size: calc(13px * var(--fs, 1)); }
#uc .uc-alert.bad { background: color-mix(in srgb, var(--danger) 12%, var(--surface)); }
#uc .uc-alert.warn { background: color-mix(in srgb, #d08a00 12%, var(--surface)); }
#uc .uc-alert .ic { font-weight: 800; color: #1f8a4c; width: 16px; text-align: center; }
#uc .uc-alert.bad .ic { color: var(--danger); }
#uc .uc-alert.warn .ic { color: #b07400; }
#uc .uc-alert .tx { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .uc-alert .tx .err { color: var(--danger); }
#uc .uc-alert .uc-btn { flex: none; }
#uc .uc-dlg.pg-dlg { max-width: 640px; }
#uc .uc-jobchip { cursor: pointer; font-family: var(--sans); font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
#uc .uc-jobchip[hidden] { display: none; }
#uc .uc-jobchip { color: #1f7a44; border-color: #8fd0a8; background: #e7f6ec; }
#uc .uc-jobchip.busy { color: #fff; border-color: #1f8a4c; background: #1f8a4c; box-shadow: 0 0 0 3px color-mix(in srgb, #1f8a4c 22%, transparent); }
#uc.uc-dark .uc-jobchip { color: #7fd6a0; border-color: #2f6b45; background: #15301f; }
#uc.uc-dark .uc-jobchip.busy { color: #fff; border-color: #2f9e5c; background: #23804a; }
#uc .uc-jobchip .spin { width: 10px; height: 10px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: uc-spin .8s linear infinite; }
@keyframes uc-spin { to { transform: rotate(360deg); } }
#uc .pg-list { border: 1px solid var(--line-soft); border-radius: var(--r); overflow: hidden; }
#uc .pg-list .uc-job:first-child { border-top: 0; }
#uc .pg-list .uc-job { padding: 10px 12px; gap: 4px 12px; }
#uc .uc-job .jr { display: flex; gap: 8px; align-items: center; }
#uc .uc-job .now { color: var(--ink-2); }
#uc .uc-job .now .mono { color: var(--ink); }
#uc .uc-job.done .lbl, #uc .uc-job.cancelled .lbl { color: var(--ink-2); }
#uc .pg-list .uc-job .meta { white-space: normal; overflow-wrap: anywhere; font-family: var(--sans); font-size: calc(12.5px * var(--fs, 1)); }
#uc .pg-list .bar { height: 10px; margin: 2px 0; }
#uc .pg-hint { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); background: var(--surface-2); border-radius: var(--r); padding: 8px 10px; line-height: 1.45; }
#uc .pg-hint[hidden] { display: none; }
#uc .pg-ok { color: var(--ok, #1f8a4c); }
#uc .st-list { margin: 0; padding-left: 20px; font-size: calc(13px * var(--fs, 1)); color: var(--ink-2); line-height: 1.5; }
#uc .uc-cols { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line-cols, #cacaca); background: var(--cols-bg, color-mix(in srgb, var(--ink) 5%, var(--surface))); }
#uc .uc-cols > div { padding: 4px 5px; cursor: pointer; white-space: nowrap; }
#uc .uc-cols > div.on { color: var(--accent); }
#uc .uc-list { position: relative; overflow-y: auto; touch-action: manipulation; -webkit-tap-highlight-color: transparent; flex: 1 1 auto !important; min-height: 90px; }
#uc .uc-spacer-v { position: relative; }
#uc .uc-row { position: absolute; left: 0; right: 0; height: var(--rowpx, var(--row)); border-bottom: 1px solid var(--line-soft); font-size: calc(13px * var(--fs, 1)); cursor: default; user-select: none; }
#uc .uc-row > div { padding: 0 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-row.sel { background: var(--accent-soft); }
/* cursor row: tinted background and a plain bottom line - no outline box */
#uc .uc-row.cursor { box-shadow: none; border-top: none; border-bottom: 1px solid #d7d7d7; }
#uc .uc-pane:not(.active) .uc-row.cursor { box-shadow: none; }
#uc.uc-dark .uc-row.cursor { border-bottom-color: #4a525a; }
#uc .uc-row:hover { background: var(--surface-2); }
/* Fingers: no hover shade on rows. iPad Safari keeps :hover stuck on the last row it
 * touched, which left an old row looking grey (like a second cursor) after tapping
 * into the other pane. The class is set on a touch and cleared when a mouse moves. */
#uc.uc-touch .uc-row:hover:not(.cursor):not(.sel) { background: transparent; }
#uc .uc-row.sel:hover { background: var(--accent-soft); }
#uc .nm { font-family: var(--sans); }
#uc .nm.dir { color: var(--accent); font-weight: 600; }
/* regular file names: softer grey, sans 12px (folders stay bold accent) */
#uc .uc-row .nm:not(.dir) { color: #373737; font: 500 calc(12px * var(--fs, 1))/1.3 var(--sans); }
#uc.uc-dark .uc-row .nm:not(.dir) { color: #b4bcc3; }
#uc .nm .up { display: inline-block; width: 13px; height: 13px; vertical-align: -2px; margin-right: 5px; fill: var(--accent); }
#uc .uc-row .nm.dir { cursor: pointer; }
#uc .nm.link { font-style: italic; }
#uc .num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--ink-2); }
#uc .perm { font-family: var(--mono); color: var(--muted); font-size: calc(12px * var(--fs, 1)); }
#uc .uc-row .col-date { font: 500 calc(11px * var(--fs, 1))/1 var(--sans); letter-spacing: -.01em; font-variant-numeric: tabular-nums; padding: 0 3px !important; text-overflow: clip !important; }
#uc .perm.odd { color: var(--warn); }
/* checkbox column: a separate, full-height tap zone */
#uc .uc-row .col-sel { align-self: stretch; display: flex; align-items: center; justify-content: center; padding: 0 !important; cursor: pointer; }
#uc .uc-row .col-sel:active { background: var(--accent-soft); }
#uc .box { display: inline-block; width: 16px; height: 16px; border-radius: 3px; border: 1.5px solid var(--line); background: var(--surface); vertical-align: -2px; position: relative; cursor: pointer; }
#uc .box.on { background: var(--accent); border-color: var(--accent); }
#uc .box.on::after { content: ""; position: absolute; left: 4.5px; top: 1px; width: 4px; height: 8px; border: solid var(--accent-ink); border-width: 0 2px 2px 0; transform: rotate(42deg); }
#uc .uc-pane-foot { padding: 2px 8px 1px; font: 500 calc(11px * var(--fs, 1))/1.4 var(--mono); color: var(--muted); background: transparent; border-top: 0; display: flex; justify-content: space-between; gap: 8px; }
#uc .uc-pane-foot b { color: var(--accent); font-weight: 600; }
#uc .uc-empty { padding: 24px; text-align: center; color: var(--muted); font-size: calc(13px * var(--fs, 1)); }
#uc .uc-error { color: var(--danger); }

#uc .uc-selbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 3px 10px; background: var(--surface-2); border-top: none; }
#uc .uc-lbl { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
#uc .uc-pat { font: 500 calc(12px * var(--fs, 1))/1 var(--mono); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-input); padding: 4px 8px; width: 130px; height: auto; }
#uc .uc-hidden { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); display: flex; align-items: center; gap: 5px; cursor: pointer; }

/* F-keys and the More row share one strip; the › / ‹ button slides between
 * them. The right end is kept clear for unRAID's floating scroll arrows. */
#uc .uc-fkeys { display: flex; align-items: stretch; gap: 4px; padding: 4px var(--fk-clear, 56px) 4px 5px; background: var(--surface-3); border-top: 1px solid var(--line); }
#uc .uc-fk-vp { flex: 1 1 auto; min-width: 0; overflow: hidden; }
#uc .uc-fk-track { display: flex; width: 200%; transition: transform .42s cubic-bezier(.65,0,.35,1); }
#uc .uc-fkeys.more .uc-fk-track { transform: translateX(-50%); }
#uc .uc-fk-page { width: 50%; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 4px; padding-right: 4px; }
#uc .uc-fkeys:not(.sliding):not(.more):not(.both) .uc-fk-page[data-page="more"], #uc .uc-fkeys.more:not(.sliding) .uc-fk-page[data-page="f"] { visibility: hidden; }
#uc .uc-fk-toggle { flex: none; width: 34px; padding: 0 !important; color: var(--accent); border-color: var(--accent); font-size: calc(20px * var(--fs, 1)); font-weight: 700; }
#uc .uc-fk-toggle span { display: inline-block; transition: transform .42s cubic-bezier(.65,0,.35,1); }
#uc .uc-fkeys.more .uc-fk-toggle span { transform: rotate(-90deg); }
#uc .uc-fk .ic { font-size: calc(13px * var(--fs, 1)); color: var(--fk-key, var(--muted)); }
#uc .uc-fk.soon { opacity: .5; }
#uc .uc-fk .soon-tag { font: 600 calc(8.5px * var(--fs, 1))/1 var(--mono); color: var(--muted); border: 1px solid var(--line); border-radius: 8px; padding: 2px 4px; }
@media (prefers-reduced-motion: reduce) { #uc .uc-fk-track, #uc .uc-fk-toggle span { transition: none; } }
#uc .uc-fk { display: flex; align-items: center; justify-content: center; gap: 4px; background: var(--fk-bg, var(--surface)); border: 1px solid var(--fk-line, var(--line)); border-radius: var(--r-btn); padding: 7px 2px; white-space: nowrap; overflow: hidden; min-width: 0; font-size: calc(12.5px * var(--fs, 1)); font-weight: 600; color: var(--fk-ink, var(--ink-2)); cursor: pointer; }
#uc .uc-fk:hover { border-color: var(--accent); }
#uc .uc-fk .k { font: 600 calc(9.5px * var(--fs, 1))/1 var(--mono); color: var(--fk-key, var(--muted)); }
#uc .uc-fk.primary { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); font-weight: 600; }
#uc .uc-fk.danger { color: var(--fk-danger, var(--danger)) !important; font-weight: 700; border-color: color-mix(in srgb, var(--danger) 40%, var(--fk-line, var(--line))); }
/* Delete: white text while it's pointed at (unRAID paints hovered buttons red) or pressed */
@media (hover: hover) { #uc .uc-fk.danger:hover, #uc .uc-fk.danger:hover .k { color: #fff !important; } }
#uc .uc-fk.danger:active, #uc .uc-fk.danger:active .k { color: #fff !important; }
#uc .uc-fk[hidden] { display: none; }
#uc .uc-fk.locked { opacity: .4; }
#uc .uc-fk.locked::after { content: "🔒"; font-size: calc(10px * var(--fs, 1)); }
#uc .uc-practice { cursor: pointer; color: #9a6400; border-color: #e0b44a; background: #fff6e0; font-family: var(--sans); font-weight: 600; }
#uc.uc-dark .uc-practice { color: #f0c062; border-color: #8a6a22; background: #2e2614; }
#uc .uc-practice[hidden] { display: none; }
#uc .st-help { margin-top: 14px; padding: 4px 14px 10px; border: 1px solid var(--line-soft); border-radius: var(--r); background: var(--surface-2); font-size: calc(13px * var(--fs, 1)); line-height: 1.5; color: var(--ink-2); }
#uc .st-help h4 { margin: 12px 0 4px; font-size: calc(13px * var(--fs, 1)); color: var(--ink); }
#uc .st-help p { margin: 0 0 8px; }
#uc .st-help ol, #uc .st-help ul { margin: 0 0 8px; padding-left: 20px; }
#uc .st-help li { margin: 2px 0; }
#uc .st-safe { border-collapse: collapse; margin: 12px 0; font-size: calc(13px * var(--fs, 1)); width: 100%; }
#uc .st-safe td { padding: 7px 10px; border: 1px solid var(--line); vertical-align: top; line-height: 1.45; }
#uc .st-safe td:first-child { font-weight: 600; white-space: nowrap; width: 1%; }

/* jobs */
#uc .uc-jobs { border-top: 1px solid var(--line); background: var(--surface); }
#uc .uc-jobs-list { max-height: 22vh; overflow-y: auto; }
#uc .uc-jobs-head { display: flex; justify-content: space-between; align-items: center; padding: 3px 10px; font: 600 calc(11px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
#uc .uc-jobs-head .uc-btn { font: 500 calc(12px * var(--fs, 1))/1.2 var(--sans); letter-spacing: 0; text-transform: none; }
#uc .uc-job { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 2px 12px; padding: 4px 10px; border-top: 1px solid var(--line-soft); font-size: calc(13px * var(--fs, 1)); }
#uc .uc-job .lbl { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .uc-job .meta { font: 500 calc(12px * var(--fs, 1))/1.4 var(--mono); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; grid-column: 1; }
#uc .uc-job .st { font: 600 calc(11px * var(--fs, 1))/1 var(--mono); text-transform: uppercase; letter-spacing: .08em; align-self: center; }
#uc .uc-job .st.done { color: var(--ok); } #uc .uc-job .st.failed { color: var(--danger); } #uc .uc-job .st.running { color: var(--accent); }
#uc .uc-job .err { color: var(--danger); font-size: calc(12.5px * var(--fs, 1)); grid-column: 1 / -1; }
#uc .bar { height: 8px; background: var(--surface-3); border-radius: 20px; overflow: hidden; grid-column: 1 / -1; }
#uc .bar > i { display: block; height: 100%; background: var(--accent); border-radius: 20px; transition: width .4s; }
#uc .bar.indet > i { width: 30% !important; animation: uc-indet 1.2s ease-in-out infinite; }
@keyframes uc-indet { 0% { margin-left: -30%; } 100% { margin-left: 100%; } }

/* dialogs */
#uc .uc-modal { position: fixed; inset: 0; background: rgba(10,12,14,.45); display: flex; align-items: center; justify-content: center; padding: 24px 16px; z-index: 10000; }
#uc .uc-modal[hidden] { display: none; }
#uc .uc-dlg { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); width: 100%; max-width: 520px; overflow: hidden; max-height: calc(100vh - 48px); display: flex; flex-direction: column; }
#uc .uc-dlg > .dlg-body { flex: 1 1 auto; min-height: 0; }
#uc .uc-dlg.wide { max-width: 820px; }
#uc .dlg-head { padding: 10px 14px; background: var(--surface-3); border-bottom: 1px solid var(--line); font-weight: 600; font-size: calc(14px * var(--fs, 1)); }
#uc .dlg-body { padding: 14px; display: flex; flex-direction: column; gap: 12px; font-size: calc(13px * var(--fs, 1)); max-height: 60vh; overflow: auto; }
#uc .dlg-foot { padding: 10px 14px; border-top: 1px solid var(--line-soft); display: flex; gap: 8px; justify-content: flex-end; background: var(--surface-2); }
#uc .field { display: flex; flex-direction: column; gap: 5px; }
#uc .field > label { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
#uc .field input[type=text] { font: 500 calc(13px * var(--fs, 1))/1 var(--mono); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-input); padding: 8px 10px; width: 100%; height: auto; }
#uc .field input[type=text]:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
#uc .chk { display: flex; gap: 6px; align-items: center; font-size: calc(13px * var(--fs, 1)); cursor: pointer; }
#uc .radios { display: flex; gap: 14px; flex-wrap: wrap; }
#uc .warnbox { background: var(--accent-soft); border-left: 3px solid var(--accent); padding: 8px 10px; border-radius: 4px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .mono { font-family: var(--mono); font-size: calc(12.5px * var(--fs, 1)); word-break: break-all; }
#uc .muted { color: var(--muted); }
#uc pre.peek { margin: 0; font: calc(12px * var(--fs, 1))/1.45 var(--mono); white-space: pre-wrap; word-break: break-all; background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: var(--r); padding: 10px; max-height: 55vh; overflow: auto; }
#uc .modegrid { display: grid; grid-template-columns: auto repeat(3, 1fr); gap: 6px 10px; align-items: center; font: calc(12.5px * var(--fs, 1)) var(--mono); }
#uc .modegrid .h { font-weight: 600; color: var(--muted); font-size: calc(11px * var(--fs, 1)); text-transform: uppercase; }

#uc .uc-toast { position: absolute; left: 50%; bottom: 76px; transform: translateX(-50%); background: var(--ink); color: var(--surface); padding: 9px 14px; border-radius: var(--r); font-size: calc(13px * var(--fs, 1)); box-shadow: var(--shadow); z-index: 60; max-width: 90%; }
#uc .uc-toast.err { background: var(--danger); color: #fff; }
#uc .uc-toast[hidden] { display: none; }
#uc .uc-upbox { position: absolute; right: 14px; bottom: 76px; width: min(380px, calc(100% - 28px)); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 10px 12px; z-index: 59; display: grid; grid-template-columns: 1fr auto; gap: 6px 10px; align-items: center; font-size: calc(13px * var(--fs, 1)); }
#uc .uc-upbox[hidden] { display: none; }
#uc .uc-upbox .ub-t { grid-column: 1 / -1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
#uc .uc-upbox .ub-bar { grid-column: 1 / -1; height: 6px; border-radius: 3px; background: var(--surface-3, rgba(128,128,128,.25)); overflow: hidden; }
#uc .uc-upbox .ub-bar i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s; }
#uc .uc-upbox .ub-s { color: var(--muted); font-size: .92em; }
#uc .up-have { max-height: 180px; overflow: auto; margin-top: 8px; font-size: .92em; color: var(--muted); }

/* Find File */
#uc .ff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 22px; }
#uc .ff-col { display: flex; flex-direction: column; gap: 7px; }
#uc .ff-col .field { margin-bottom: 3px; }
#uc .field input[type=text]:disabled { opacity: .45; }
#uc .ff-hint { font-size: calc(12px * var(--fs, 1)); line-height: 1.5; }
#uc .ff-tree { border: 1px solid var(--line); border-radius: var(--r); max-height: 190px; overflow: auto; background: var(--surface-2); padding: 4px 0; margin-top: -4px; }
#uc .ff-node { font: 500 calc(12.5px * var(--fs, 1))/1 var(--mono); color: var(--accent); padding: 7px 12px; cursor: pointer; }
#uc .ff-node:hover { background: var(--accent-soft); }
#uc .ff-tree .muted, #uc .ff-tree .uc-error { padding: 7px 12px; }
#uc .ff-status { display: flex; align-items: center; gap: 8px; font-size: calc(13px * var(--fs, 1)); }
#uc .ff-status b { color: var(--accent); }
#uc .ff-spin { width: 14px; height: 14px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: uc-spin .8s linear infinite; flex: none; }
@keyframes uc-spin { to { transform: rotate(360deg); } }
#uc .ff-results { border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); max-height: 46vh; overflow: auto; font: calc(12.5px * var(--fs, 1))/1 var(--mono); }
#uc .ff-results:empty { display: none; }
#uc .ff-dir { padding: 8px 10px 4px; color: var(--muted); font-weight: 600; word-break: break-all; line-height: 1.35; }
#uc .ff-hit { padding: 6px 10px 6px 26px; cursor: pointer; word-break: break-all; line-height: 1.35; }
#uc .ff-hit.dir { color: var(--accent); font-weight: 600; }
#uc .ff-hit:hover { background: var(--surface-2); }
#uc .ff-hit.on { background: var(--accent-soft); box-shadow: inset 2px 0 0 var(--accent); }
#uc .ff-hit { display: flex; gap: 10px; align-items: baseline; }
#uc .ff-name { flex: none; max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .ff-ln { color: var(--muted); }
#uc .ff-snip { flex: 1; min-width: 0; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: calc(12px * var(--fs, 1)); }
#uc mark { background: color-mix(in srgb, var(--accent) 28%, transparent); color: inherit; border-radius: 2px; padding: 0 1px; }
#uc .uc-endfind { font: 600 calc(11px * var(--fs, 1))/1 var(--sans); letter-spacing: 0; text-transform: none; color: var(--accent); background: var(--surface); border: 1px solid var(--accent); border-radius: 20px; padding: 4px 10px; cursor: pointer; margin-left: auto; margin-right: 8px; }
#uc .uc-endfind[hidden] { display: none; }
#uc .uc-cancel { font: 600 calc(11px * var(--fs, 1))/1 var(--sans); letter-spacing: 0; text-transform: none; color: var(--danger); background: var(--surface); border: 1px solid currentColor; border-radius: 20px; padding: 4px 10px; cursor: pointer; margin-left: auto; margin-right: 8px; }
#uc .uc-cancel[hidden] { display: none; }
#uc .uc-pane.busy .uc-list { opacity: .45; pointer-events: none; transition: opacity .2s; }
#uc .uc-pane.busy .count { text-transform: none; letter-spacing: 0; }

/* permissions dialog */
#uc .uc-dlg.pm-dlg { max-width: 560px; }
#uc .pm-target { display: flex; flex-direction: column; gap: 2px; padding-bottom: 10px; border-bottom: 1px solid var(--line-soft); }
#uc .pm-name { font-size: calc(15px * var(--fs, 1)); font-weight: 600; word-break: break-all; }
#uc .pm-path { font-size: calc(11.5px * var(--fs, 1)); word-break: break-all; }
#uc .pm-section { display: flex; flex-direction: column; gap: 8px; }
#uc .pm-h { font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
#uc .pm-status { padding: 9px 11px; border-radius: var(--r); font-size: calc(13px * var(--fs, 1)); line-height: 1.45; border-left: 3px solid; }
#uc .pm-status.ok { background: color-mix(in srgb, var(--ok) 10%, var(--surface)); border-color: var(--ok); }
#uc .pm-status.warn { background: color-mix(in srgb, var(--warn) 12%, var(--surface)); border-color: var(--warn); }
#uc .pm-table { width: 100%; border-collapse: collapse; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pm-table th { font-weight: 600; color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); text-align: center; padding: 4px 6px; border-bottom: 1px solid var(--line); }
#uc .pm-table td { padding: 5px 6px; border-bottom: 1px solid var(--line-soft); text-align: center; }
#uc .pm-table td:first-child { text-align: left; white-space: nowrap; }
#uc .pm-table .mono { color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); }
#uc .pm-yes { color: var(--ok); font-weight: 700; }
#uc .pm-no { color: var(--line); }
#uc .pm-note { font-size: calc(12px * var(--fs, 1)); line-height: 1.45; }
#uc .pm-choice { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r); cursor: pointer; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; }
#uc .pm-choice:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
#uc .pm-choice input { margin-top: 3px; accent-color: var(--accent); flex: none; }
#uc .pm-choice .muted { font-size: calc(12.5px * var(--fs, 1)); }
#uc .pm-badge { font: 600 calc(10px * var(--fs, 1))/1 var(--sans); text-transform: uppercase; letter-spacing: .06em; color: var(--accent-ink); background: var(--accent); border-radius: 20px; padding: 3px 7px; margin-left: 4px; vertical-align: 1px; }
#uc .pm-custom { display: flex; flex-direction: column; gap: 10px; padding: 10px 12px; border: 1px dashed var(--line); border-radius: var(--r); }
#uc .pm-custom[hidden] { display: none; }
#uc .pm-row { display: grid; grid-template-columns: 1fr 1fr 80px; gap: 8px; }
#uc .pm-grid { display: grid; grid-template-columns: auto repeat(3, 1fr); gap: 6px 10px; align-items: center; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pm-g-who { font-weight: 600; color: var(--ink-2); }
#uc .pm-caution { padding: 9px 11px; border-radius: var(--r); font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; background: color-mix(in srgb, var(--danger) 9%, var(--surface)); border-left: 3px solid var(--danger); }

/* viewer + editor */
#uc .uc-dlg:focus { outline: none; }
#uc .mv-stage { position: relative; height: min(68vh, calc(100vh - 210px)); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: var(--r); border: 1px solid var(--line);
  background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 18px 18px; }
#uc .mv-img { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in; user-select: none; -webkit-user-drag: none; }
#uc .mv-stage.zoom { display: block; overflow: auto; }
#uc .mv-stage.zoom .mv-img { max-width: none; max-height: none; cursor: zoom-out; }
#uc .mv-stage.loading::after { content: "Loading…"; position: absolute; color: var(--muted); font-size: calc(13px * var(--fs, 1)); }
#uc .mv-meta { display: flex; justify-content: space-between; gap: 10px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .mv-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .mv-pdf { width: 100%; height: min(72vh, calc(100vh - 190px)); border: 1px solid var(--line); border-radius: var(--r); background: #fff; }
#uc .dlg-foot .uc-btn[hidden] { display: none; }
#uc .uc-dlg.full { max-width: min(1800px, calc(100vw - 40px)); }
#uc .uc-modal:has(.uc-dlg.full) { padding-top: 24px; }
#uc .vw-meta { color: var(--muted); font-size: calc(12px * var(--fs, 1)); word-break: break-all; }
#uc .vw { position: relative; height: min(62vh, calc(100vh - 230px)); overflow: auto; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r); font: calc(12.5px * var(--fs, 1))/18px var(--mono); outline: none; }
#uc .vw-l { display: flex; min-width: max-content; }
#uc .vw-n { flex: none; width: var(--gw, 5ch); padding: 0 8px 0 4px; text-align: right; color: var(--muted); user-select: none; border-right: 1px solid var(--line-soft); margin-right: 8px; position: sticky; left: 0; background: var(--surface-2); }
#uc .vw-t { white-space: pre; padding-right: 12px; }
#uc .vw-l.hit, #uc .vw-l.hit .vw-n { background: var(--accent-soft); }
#uc .vw-l.hit .vw-n { color: var(--accent); font-weight: 600; box-shadow: inset 3px 0 0 var(--accent); }
#uc .ed-wrap { position: relative; background: var(--surface-2); border-radius: var(--r); overflow: hidden; }
#uc .ed-hl { position: absolute; left: 0; right: 0; background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); pointer-events: none; }
#uc textarea.ed { position: relative; display: block; width: 100%; height: min(62vh, calc(100vh - 250px)); resize: vertical; font: calc(12.5px * var(--fs, 1))/18px var(--mono); tab-size: 4; background: transparent; color: var(--ink); border: 1px solid var(--line); border-radius: var(--r); padding: 8px 10px; white-space: pre; overflow: auto; margin: 0; }
#uc textarea.ed:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
#uc textarea.ed::selection { background: color-mix(in srgb, var(--accent) 35%, transparent); }
#uc .ed-status { display: flex; justify-content: space-between; font-size: calc(12px * var(--fs, 1)); color: var(--muted); }
#uc .ed-dirty.on { color: var(--accent); font-weight: 600; }

@media (max-width: 900px) {
  #uc .st-bm { grid-template-columns: 1fr auto auto auto; }
  #uc .st-bm .st-path { grid-column: 1 / -1; grid-row: 2; }
  #uc .ff-grid { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  #uc .uc-panes { grid-template-columns: 1fr; grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); row-gap: 6px; }
  #uc .uc-crumbs { grid-template-columns: 1fr; }
}

/* trash bins: what's inside, when and where from */
#uc .uc-row .bin-name { color: var(--accent); font-weight: 600; }
#uc .uc-row .bin-meta { margin-left: 10px; font: 400 calc(11.5px * var(--fs, 1)) var(--sans); color: var(--muted); }

/* folder sizes */
#uc .uc-row .col-size.dsz { color: var(--accent); font-weight: 600; }
#uc .sz-list { display: flex; flex-direction: column; gap: 10px; }
#uc .sz-row { display: grid; grid-template-columns: 18px minmax(0,1fr) auto; gap: 2px 10px; align-items: center; }
#uc .sz-row .n { font-weight: 600; color: var(--accent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .sz-row .v { font: 600 calc(13px * var(--fs, 1)) var(--mono); text-align: right; font-variant-numeric: tabular-nums; }
#uc .sz-row .s { grid-column: 2 / 4; color: var(--muted); font-size: calc(12px * var(--fs, 1)); overflow-wrap: anywhere; }
#uc .sz-row .bar { grid-column: 2 / 4; height: 4px; }
#uc .sz-row .ok { color: var(--ok); font-weight: 800; }
#uc .sz-row .wait, #uc .sz-row .stp { color: var(--muted); }
#uc .sz-row .spin { width: 13px; height: 13px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: uc-spin .8s linear infinite; }
#uc .sz-total { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 10px; font-weight: 700; }
#uc .sz-total .v { font: 700 calc(14px * var(--fs, 1)) var(--mono); }
#uc .sz-time { margin-right: auto; align-self: center; color: var(--muted); font-size: calc(12px * var(--fs, 1)); }

/* where-is (Disk cell tap) */
#uc .uc-row .col-disk { cursor: pointer; }
#uc .wh-list { display: flex; flex-direction: column; border: 1px solid var(--line-soft); border-radius: var(--r); }
#uc .wh-row { display: grid; grid-template-columns: 64px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 9px 10px; border-top: 1px solid var(--line-soft); font-size: calc(13px * var(--fs, 1)); }
#uc .wh-row:first-child { border-top: 0; }
#uc .wh-d { font: 700 calc(12px * var(--fs, 1)) var(--mono); padding: 3px 6px; border-radius: 4px; background: color-mix(in srgb, var(--ink) 8%, transparent); text-align: center; }
#uc .wh-d.pool { background: color-mix(in srgb, #1f8a4c 16%, transparent); color: #1f7a44; }
#uc .wh-info .mono { font-size: calc(11.5px * var(--fs, 1)); overflow-wrap: anywhere; }
#uc .wh-empty { color: var(--warn); }

/* undo */
#uc .uc-toast .t-undo { -webkit-appearance: none; appearance: none; background: none; border: 0; margin: 0 0 0 14px; padding: 0; min-width: 0; font: 700 calc(13px * var(--fs, 1)) var(--sans); color: #8fc2ff; cursor: pointer; }
#uc .uc-fk.off { opacity: .45; }

#uc .tr-seg.tr-root { padding: 2px 4px; color: var(--muted); }
#uc .tr-seg.tr-root.here { color: var(--ink); }

/* compress / extract */
#uc .radios.col { flex-direction: column; gap: 7px; }
#uc .chk[hidden] { display: none; }
#uc .ar-list { border: 1px solid var(--line-soft); border-radius: var(--r); max-height: 52vh; overflow: auto; }
#uc .ar-row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 10px; border-top: 1px solid var(--line-soft); font-size: calc(12.5px * var(--fs, 1)); }
#uc .ar-row:first-child { border-top: 0; }
#uc .ar-row .mono { overflow-wrap: anywhere; }
#uc .ar-row.dir .mono { color: var(--accent); font-weight: 600; }
#uc .ar-row .num { flex: none; color: var(--muted); font-variant-numeric: tabular-nums; }

/* settings: grouped sections */
/* Settings > Keyboard shortcuts */
#uc kbd { display: inline-block; min-width: 1.6em; padding: 2px 6px; font: 600 calc(11.5px * var(--fs, 1))/1.3 var(--mono); text-align: center; color: var(--ink); background: linear-gradient(var(--surface), var(--surface-2)); border: 1px solid var(--line); border-bottom-width: 2px; border-radius: 5px; box-shadow: 0 1px 0 rgba(0,0,0,.06); white-space: nowrap; }
#uc .kb-intro { margin-bottom: 12px; line-height: 1.5; }
/* plain blocks, not a <table>: unRAID styles every table (no-wrap cells, stripes, widths),
 * which made long descriptions run into the next column */
#uc .kb-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 4px 28px; align-items: start; }
#uc .kb-group { margin-bottom: 14px; min-width: 0; }
#uc .kb-gh { font: 700 calc(11px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--head-ink, var(--accent)); padding: 0 10px 7px; border-bottom: 1px solid var(--line); margin-bottom: 2px; }
#uc .kb-table { display: block; }
#uc .kb-row { display: grid; grid-template-columns: 136px minmax(0, 1fr); gap: 12px; align-items: center; padding: 6px 10px; border-bottom: 1px solid var(--line-soft); font-size: calc(13px * var(--fs, 1)); line-height: 1.4; }
#uc .kb-row:last-child { border-bottom: none; }
#uc .kb-k { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; white-space: nowrap; }
#uc .kb-d { min-width: 0; white-space: normal; overflow-wrap: anywhere; color: var(--ink); }
/* Settings > Look & sound > Theme */
/* each section of a Settings tab is its own card with a heading strip */
#uc .st-panel { border: 1px solid var(--line); border-radius: 8px; padding: 0 14px 14px; background: var(--surface); }
#uc .st-panel:not([hidden]) ~ .st-panel:not([hidden]) { margin-top: 14px; }
#uc .st-h { margin: 0 -14px 2px; padding: 9px 14px; font: 700 calc(12px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--head-ink, var(--ink-2)); background: var(--surface-2); border-bottom: 1px solid var(--line-soft); border-radius: 8px 8px 0 0; }

/* batch rename */
#uc .uc-dlg.br-dlg .dlg-body { max-height: calc(100vh - 130px); }
#uc .uc-modal:has(.br-dlg) { padding: 12px 16px; }
#uc .br-help, #uc .br-help * { overflow-wrap: anywhere; }
#uc .br-help .mono { white-space: normal; }
#uc .br-ex { border-collapse: collapse; margin: 6px 0; width: 100%; font-size: calc(12.5px * var(--fs, 1)); }
#uc .br-ex th, #uc .br-ex td { border: 1px solid var(--line-soft); padding: 5px 8px; text-align: left; vertical-align: top; }
#uc .br-ex th { background: var(--surface); font-weight: 600; font-size: calc(11.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .br-ex td .muted { font-size: calc(11.5px * var(--fs, 1)); margin-top: 2px; }
#uc .br-top { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: space-between; }
#uc .br-seg { display: inline-flex; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
#uc .br-seg button { -webkit-appearance: none; appearance: none; margin: 0; border: 0; border-right: 1px solid var(--line); background: var(--surface); padding: 7px 14px; font: 500 calc(13px * var(--fs, 1)) var(--sans); color: var(--ink); cursor: pointer; min-width: 0; }
#uc .br-seg button:last-child { border-right: 0; }
#uc .br-seg button.on { background: var(--accent); color: #fff; font-weight: 600; }
#uc .br-rules { display: flex; flex-direction: column; gap: 10px; }
#uc .br-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
#uc .br-chips { display: flex; gap: 6px; flex-wrap: wrap; }
#uc .br-chips button { -webkit-appearance: none; appearance: none; margin: 0; min-width: 0; font: 600 calc(11.5px * var(--fs, 1)) var(--mono); border: 1px dashed var(--accent); color: var(--accent); background: var(--surface); border-radius: 5px; padding: 4px 7px; cursor: pointer; }
#uc .br-small { width: 52px !important; padding: 5px 7px !important; }
#uc .br-help { border: 1px solid var(--line-soft); border-radius: var(--r); padding: 6px 12px; background: var(--surface-2); font-size: calc(13px * var(--fs, 1)); line-height: 1.5; }
#uc .br-help summary { cursor: pointer; font-weight: 600; color: var(--accent); padding: 2px 0; }
#uc .br-help h4 { margin: 12px 0 2px; font-size: calc(13px * var(--fs, 1)); }
#uc .br-help p { margin: 4px 0; } #uc .br-help ul { margin: 4px 0; padding-left: 20px; }
#uc .br-tbl { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
#uc .br-rows { max-height: 56vh; overflow: auto; }
#uc .br-tr { display: grid; grid-template-columns: 28px minmax(0,1fr) 16px minmax(0,1fr) 22px; align-items: center; min-height: 26px; border-bottom: 1px solid var(--line-soft); }
#uc .br-tr > div { padding: 3px 5px; }
/* full names, wrapped, in a narrow typeface so long names fit */
#uc .br-tr .nm { font-family: "Avenir Next Condensed", "Roboto Condensed", "Arial Narrow", "Helvetica Neue", var(--sans); font-stretch: condensed; font-size: calc(13px * var(--fs, 1)); line-height: 1.3; overflow-wrap: anywhere; letter-spacing: -.01em; }
#uc .br-tr .ic { text-align: center; font-weight: 700; color: var(--muted); padding: 0; }
#uc .br-tr.go .ic { color: var(--ok); }
#uc .br-tr.bad .ic, #uc .br-tr .prob { color: var(--danger); }
#uc .br-tr .prob { font: 500 calc(11px * var(--fs, 1)) var(--sans); margin-top: 2px; }
#uc .br-hl { border-collapse: collapse; margin: 6px 0; }
#uc .br-hl td { padding: 4px 8px; border: 1px solid var(--line-soft); vertical-align: top; }
#uc .br-hl td.mono { white-space: nowrap; font-weight: 600; color: var(--accent); }
/* unRAID styles every button and input; keep ours looking like ours */
#uc .br-seg button, #uc .br-chips button { -webkit-appearance: none !important; appearance: none !important; box-shadow: none !important; margin: 0 !important; min-width: 0 !important; border-radius: 0 !important; height: auto !important; line-height: 1.2 !important; }
#uc .br-seg button { background: var(--surface) !important; border: 0 !important; border-right: 1px solid var(--line) !important; }
#uc .br-seg button:last-child { border-right: 0 !important; }
#uc .br-seg button.on { background: var(--accent) !important; color: #fff !important; }
#uc .br-chips button { background: var(--surface) !important; border: 1px dashed var(--accent) !important; border-radius: 5px !important; color: var(--accent) !important; }
#uc .br-rules input[type=text], #uc .br-rules select { -webkit-appearance: none; appearance: none; border: 1px solid var(--line) !important; border-radius: var(--r-input) !important; background: var(--surface-2) !important; box-shadow: none !important; }
#uc .br-rules select { padding: 5px 24px 5px 8px; background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%), linear-gradient(135deg, var(--muted) 50%, transparent 50%) !important; background-position: calc(100% - 13px) 50%, calc(100% - 8px) 50% !important; background-size: 5px 5px !important; background-repeat: no-repeat !important; }
#uc .br-tr.h { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); background: var(--surface-2); min-height: 24px; }
#uc .br-tr .ar { color: var(--muted); text-align: center; }
#uc .br-tr.go .new { font-weight: 600; }
#uc .br-tr.same, #uc .br-tr.off { color: var(--muted); }
#uc .br-tr.off { opacity: .6; }
#uc .br-tr.bad { background: color-mix(in srgb, var(--danger) 9%, transparent); }
#uc .br-tr.bad .sts { color: var(--danger); }
#uc .br-tr .sts { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); }
#uc .br-tr mark.del { background: color-mix(in srgb, var(--danger) 18%, transparent); color: inherit; text-decoration: line-through; border-radius: 2px; }
#uc .br-tr mark.add { background: color-mix(in srgb, #1f8a4c 22%, transparent); color: inherit; border-radius: 2px; }
#uc .br-sum { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font-size: calc(12.5px * var(--fs, 1)); }
#uc .br-sum .ok { color: var(--ok); } #uc .br-sum .bad { color: var(--danger); }
#uc .br-note { margin-right: auto; align-self: center; font-size: calc(12px * var(--fs, 1)); color: var(--warn); }
@media (max-width: 760px) { #uc .br-grid { grid-template-columns: 1fr; } }
#uc .br-tr > div.ar { padding: 0; text-overflow: clip; }

/* colour picker (Settings > Look & sound) */
#uc .st-color { display: inline-flex; align-items: center; gap: 6px; }
#uc .st-col { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; width: 34px !important; height: 30px !important; padding: 3px !important; border: 1px solid var(--line) !important; border-radius: var(--r) !important; background: repeating-conic-gradient(#ccc 0 25%, #fff 0 50%) 0 0 / 10px 10px !important; cursor: pointer; box-shadow: none !important; }
#uc .st-col i { display: block; width: 100%; height: 100%; border-radius: 3px; }
#uc .st-panel input.st-hex { width: 86px; font: 600 calc(12.5px * var(--fs, 1)) var(--mono); text-align: center; padding: 6px; }

#uc .radios.ind { padding-left: 18px; }
#uc .dlg-hr { border: 0; border-top: 1px solid var(--line-soft); margin: 2px 0; height: 0; }

/* extract window */
#uc .uc-dlg.ex-dlg { max-width: 600px; }
#uc .ex-card { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); }
#uc .ex-ic { flex: none; width: 34px; height: 34px; border-radius: 8px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-size: calc(18px * var(--fs, 1)); font-weight: 700; }
#uc .ex-main { flex: 1; min-width: 0; }
#uc .ex-name { font: 600 calc(13.5px * var(--fs, 1)) var(--mono); overflow-wrap: anywhere; }
#uc .ex-sum { font-size: calc(12.5px * var(--fs, 1)); margin-top: 2px; }
#uc .ex-list { flex: none; }
#uc div.ind { padding-left: 18px; }
#uc .uc-dlg .chk > span { line-height: 1.4; }
#uc .uc-dlg .chk { align-items: flex-start; }
#uc .uc-dlg .chk > input { margin-top: 2px; flex: none; }
#uc .uc-job .ph { color: var(--ink); }

/* compare */
#uc .uc-cmpbar { display: grid; grid-template-columns: minmax(0,1fr) 34px minmax(0,1fr); gap: 0 6px; align-items: stretch; padding: 8px; margin: 4px 10px 0; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface-2); font-size: calc(12.5px * var(--fs, 1)); line-height: 1.4; }
#uc .uc-cmpbar[hidden] { display: none; }
#uc .uc-cmpbar .cb-card { background: var(--surface); border: 1px solid var(--line); border-radius: 7px; padding: 6px 10px 7px; min-width: 0; }
#uc .uc-cmpbar .cb-card.src { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }
#uc .uc-cmpbar .cb-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
#uc .uc-cmpbar .cb-side { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
#uc .uc-cmpbar .cb-role { font: 700 calc(9.5px * var(--fs, 1))/1 var(--sans); letter-spacing: .04em; text-transform: uppercase; padding: 3px 6px; border-radius: 8px; background: var(--line-soft); color: var(--muted); }
#uc .uc-cmpbar .cb-card.src .cb-side { color: var(--accent); }
#uc .uc-cmpbar .cb-card.src .cb-role { background: var(--accent); color: #fff; }
#uc .uc-cmpbar .cb-counts { display: flex; flex-wrap: wrap; gap: 2px 12px; }
#uc .uc-cmpbar .cs { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; color: var(--ink-2); font-size: calc(12px * var(--fs, 1)); }
#uc .uc-cmpbar .cs i { width: 8px; height: 8px; border-radius: 50%; background: var(--line); flex: none; }
#uc .uc-cmpbar .cs b { font: 700 calc(12px * var(--fs, 1)) var(--mono); color: var(--ink); }
#uc .uc-cmpbar .cs.only i { background: #1f8a4c; }
#uc .uc-cmpbar .cs.newer i { background: #d08a00; }
#uc .uc-cmpbar .cs.differ i { background: #7c3aed; }
#uc .uc-cmpbar .cs.older i { background: #b9bec6; }
#uc .uc-cmpbar .cs.same i, #uc .uc-cmpbar .cs.both i { background: transparent; border: 1.5px solid #b9bec6; width: 7px; height: 7px; }
#uc .uc-cmpbar .cs.same, #uc .uc-cmpbar .cs.both, #uc .uc-cmpbar .cs.older, #uc .uc-cmpbar .cs.none { color: var(--muted); }
#uc .uc-cmpbar .cb-dir { align-self: center; justify-self: center; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: #fff; font: 700 calc(19px * var(--fs, 1))/1 var(--sans); }
#uc .uc-cmpbar .cb-dir span { display: block; line-height: 1; transform: translate(var(--cb-dx, 0px), var(--cb-dy, 0px)); }
#uc .uc-cmpbar .cb-dir.left span { transform: translate(calc(-1 * var(--cb-dx, 0px)), calc(-1 * var(--cb-dy, 0px))) rotate(180deg); }
#uc .uc-cmpbar .cb-foot { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; margin-top: 7px; padding: 0 2px; }
#uc .uc-cmpbar .cb-msg { flex: 1; min-width: 0; color: var(--ink); }
#uc .uc-cmpbar .cb-msg .muted { margin-left: 4px; }
#uc .uc-cmpbar .cb-close { flex: none; }
#uc .cmp-tag { display: inline-block; font: 700 calc(9.5px * var(--fs, 1))/1 var(--sans); padding: 3px 6px; border-radius: 8px; margin-left: 6px; vertical-align: 1px; background: var(--line); color: var(--ink-2); white-space: nowrap; }
#uc .cmp-tag.only { background: #1f8a4c; color: #fff; }
#uc .cmp-tag.newer { background: #d08a00; color: #fff; }
#uc .cmp-tag.differ { background: #7c3aed; color: #fff; }
#uc .cmp-tag.same { background: var(--surface); border: 1px solid var(--line); }
#uc .uc-row.cmp-only { background: color-mix(in srgb, #1f8a4c 9%, var(--surface)); }
#uc .uc-row.cmp-newer { background: color-mix(in srgb, #d08a00 12%, var(--surface)); }
#uc .uc-row.cmp-same .nm, #uc .uc-row.cmp-same .num, #uc .uc-row.cmp-same .perm, #uc .uc-row.cmp-older .nm { opacity: .45; }

/* ---------- Detailed compare window (style B) ---------- */
#uc .uc-dlg.ct-dlg .dlg-body { display: flex; flex-direction: column; gap: 10px; max-height: calc(100vh - 150px); }
#uc .ct-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .ct-paths > div { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
#uc .ct-paths .mono { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .ct-lbl { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); flex: none; }
#uc .ct-wait[hidden] { display: none; }
#uc .ct-wait { display: flex; gap: 10px; align-items: center; color: var(--muted); padding: 24px 4px; }
#uc .ct-main { display: flex; flex-direction: column; gap: 10px; min-height: 0; flex: 1 1 auto; }
#uc .ct-main[hidden] { display: none; }
#uc .ct-filters { display: flex; flex-wrap: wrap; gap: 6px; }
#uc .ct-f { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; font: 500 calc(12.5px * var(--fs, 1))/1 var(--sans) !important; padding: 6px 11px !important; border-radius: 16px !important; border: 1px solid var(--line) !important; background: var(--accent-soft-t) !important; color: var(--ink-2) !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .ct-f b { font: 700 calc(12px * var(--fs, 1)) var(--mono); margin-left: 3px; color: var(--ink); }
#uc .ct-f.on { border-color: var(--accent) !important; background: var(--accent-soft) !important; color: var(--accent) !important; font-weight: 600 !important; }
#uc .ct-f.on b { color: var(--accent); }
#uc .ct-bulk { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: calc(12px * var(--fs, 1)); }
#uc .ct-bulk .uc-btn { padding: 4px 9px; font-size: calc(12px * var(--fs, 1)); }
#uc .ct-table { border: 1px solid var(--line); border-radius: 6px; overflow: auto; min-height: 120px; flex: 1 1 auto; -webkit-overflow-scrolling: touch; }
#uc .ct-row { display: grid; grid-template-columns: minmax(0,1fr) 74px 88px 44px minmax(0,1fr) 74px 88px; align-items: center; border-bottom: 1px solid var(--line-soft); font: calc(12.5px * var(--fs, 1))/1.25 var(--mono); min-height: 34px; }
#uc .ct-row > div { padding: 3px 6px; min-width: 0; align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
#uc .ct-row > div.r { align-items: flex-end; }
#uc .ct-row > div.c { align-items: center; }
#uc .ct-row .r { text-align: right; }
#uc .ct-row .c { text-align: center; padding: 0; }
#uc .ct-row .num { font-variant-numeric: tabular-nums; color: var(--ink-2); font-size: calc(12px * var(--fs, 1)); white-space: nowrap; }
#uc .ct-h { position: sticky; top: 0; z-index: 1; min-height: 26px; background: var(--surface-2); font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
#uc .ct-name { display: flex; flex-direction: column; }
#uc .ct-name .nm, #uc .ct-name .in { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .ct-name.dir .nm { color: var(--accent); font-weight: 600; }
#uc .ct-row .in { display: block; font-size: calc(10.5px * var(--fs, 1)); color: var(--muted); }
#uc .ct-do { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; width: 34px !important; height: 26px !important; padding: 0 !important; border-radius: 6px !important; border: 1px solid transparent !important; background: transparent !important; font: 700 calc(16px * var(--fs, 1))/1 var(--sans) !important; color: var(--muted) !important; cursor: pointer; }
#uc .ct-do:hover { border-color: var(--line) !important; background: var(--surface) !important; }
#uc .do-r .ct-do, #uc .do-l .ct-do { color: #1f8a4c !important; background: color-mix(in srgb, #1f8a4c 10%, transparent) !important; }
#uc .ct-do.rep { color: #b26f00 !important; background: color-mix(in srgb, #d08a00 14%, transparent) !important; }
#uc .ct-rep { color: #b26f00; font-weight: 600; }
/* tint the side that will be copied from */
#uc .ct-row.do-r > div:nth-child(-n+3) { background: color-mix(in srgb, #1f8a4c 8%, transparent); }
#uc .ct-row.do-l > div:nth-child(n+5) { background: color-mix(in srgb, #1f8a4c 8%, transparent); }
#uc .ct-row.st-same, #uc .ct-row.do-n:not(.st-differ) .ct-name .nm { color: var(--muted); }
#uc .ct-row.st-differ .ct-name .nm { color: #7c3aed; }
#uc .ct-more { padding: 12px; text-align: center; font-size: calc(12.5px * var(--fs, 1)); }
#uc .ct-help { font-size: calc(12px * var(--fs, 1)); line-height: 1.45; }
#uc .ct-foot { margin-right: auto; align-self: center; font-size: calc(12px * var(--fs, 1)); }
#uc .uc-cmpbar .cb-full { flex: none; }
@media (max-width: 900px) { #uc .ct-row { grid-template-columns: minmax(0,1fr) 62px 76px 40px minmax(0,1fr) 62px 76px; font-size: calc(12px * var(--fs, 1)); } }
#uc .ct-wait .spin { width: 14px; height: 14px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; animation: uc-spin .8s linear infinite; flex: none; }

/* ---------- colour highlighting ---------- */
#uc { --hl-k: #0b5cad; --hl-s: #1a7f37; --hl-n: #b35900; --hl-c: #7d848c; --hl-p: #8250df; --hl-v: #c2185b; --hl-h: #0b5cad; --hl-t: #116329; --hl-a: #8250df; --hl-e: #cf222e; --hl-w: #9a6700; }
#uc.uc-dark { --hl-k: #79b8ff; --hl-s: #85e89d; --hl-n: #ffab70; --hl-c: #8b949e; --hl-p: #d2a8ff; --hl-v: #f692ce; --hl-h: #79b8ff; --hl-t: #7ee787; --hl-a: #d2a8ff; --hl-e: #ff7b72; --hl-w: #e3b341; }
#uc .hl-k { color: var(--hl-k); font-weight: 600; }
#uc .hl-s { color: var(--hl-s); }
#uc .hl-n { color: var(--hl-n); }
#uc .hl-c { color: var(--hl-c); font-style: italic; }
#uc .hl-p { color: var(--hl-p); }
#uc .hl-v { color: var(--hl-v); }
#uc .hl-h { color: var(--hl-h); font-weight: 700; }
#uc .hl-t { color: var(--hl-t); }
#uc .hl-a { color: var(--hl-a); }
#uc .hl-e { color: var(--hl-e); font-weight: 700; }
#uc .hl-w { color: var(--hl-w); font-weight: 600; }
#uc .vw-top { display: flex; align-items: center; gap: 12px; }
#uc .vw-top .vw-meta { flex: 1; min-width: 0; }
#uc .hl-pick { flex: none; display: inline-flex; align-items: center; gap: 6px; font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
#uc .hl-pick.muted { text-transform: none; letter-spacing: 0; font: calc(12px * var(--fs, 1)) var(--sans); }
#uc .hl-pick select { font: calc(12.5px * var(--fs, 1)) var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink); max-width: 190px; }
/* editor: coloured copy behind a transparent textarea */
#uc .ed-pre { position: absolute; inset: 0; margin: 0; overflow: hidden; pointer-events: none; border: 1px solid transparent; padding: 8px 10px; font: calc(12.5px * var(--fs, 1))/18px var(--mono); tab-size: 4; white-space: pre; color: var(--ink); background: transparent; }
#uc .ed-wrap:not(.hl-on) .ed-pre { display: none; }
#uc .ed-wrap.hl-on textarea.ed { color: transparent; -webkit-text-fill-color: transparent; caret-color: var(--ink); }
#uc .ed-wrap.hl-on textarea.ed::selection { -webkit-text-fill-color: transparent; }

#uc .cr-list { max-height: 180px; overflow: auto; font-size: calc(12px * var(--fs, 1)); border: 1px solid var(--line-soft); border-radius: 6px; padding: 6px 8px; background: var(--surface-2); }
#uc .cr-list .mono { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .warnbox.warn { background: color-mix(in srgb, #d08a00 12%, var(--surface)); border-left-color: #d08a00; }

/* pane header Back button */
#uc .uc-headl { display: inline-flex; align-items: center; gap: 4px; min-width: 0; }
#uc .uc-back { appearance: none !important; -webkit-appearance: none !important; margin: -3px 0 !important; min-width: 0 !important; width: 24px !important; height: 22px !important; padding: 0 !important; display: inline-grid; place-items: center; border-radius: 5px !important; border: 1px solid var(--line) !important; background: var(--surface) !important; color: var(--ink-2) !important; cursor: pointer; box-shadow: none !important; }
#uc .uc-back svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-back:hover:not(:disabled) { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .uc-pane.active .uc-back:not(:disabled) { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)) !important; color: var(--accent) !important; }
#uc .uc-back:disabled { opacity: .35; cursor: default; }

/* Delete dialog list */
#uc .dl-head { display: flex; gap: 10px; align-items: baseline; font-size: calc(12px * var(--fs, 1)); color: var(--muted); }
#uc .dl-head > span:first-child { font-weight: 600; color: var(--ink-2); flex: none; }
#uc .dl-where { font-family: var(--mono); font-size: calc(11.5px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
#uc .dl-list { border: 1px solid var(--line); border-radius: 6px; max-height: 210px; overflow: auto; background: var(--surface-2); }
#uc .dl-row { display: grid; grid-template-columns: 18px minmax(0,1fr) auto; gap: 6px; align-items: center; padding: 3px 8px; border-bottom: 1px solid var(--line-soft); font: calc(12.5px * var(--fs, 1))/1.3 var(--mono); }
#uc .dl-row:last-child { border-bottom: 0; }
#uc .dl-ic svg { width: 14px; height: 14px; display: block; fill: none; stroke: var(--muted); stroke-width: 1.3; stroke-linejoin: round; }
#uc .dl-row.dir .dl-ic svg { stroke: var(--accent); fill: color-mix(in srgb, var(--accent) 15%, transparent); }
#uc .dl-row.dir .dl-nm { color: var(--accent); font-weight: 600; }
#uc .dl-nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .dl-in { display: block; font-size: calc(10.5px * var(--fs, 1)); color: var(--muted); font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
#uc .dl-sz { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); font-variant-numeric: tabular-nums; }
#uc .dl-more { padding: 4px 8px; font-size: calc(12px * var(--fs, 1)); color: var(--muted); }

/* Forward button (same look as Back) */
#uc .uc-fwd { appearance: none !important; -webkit-appearance: none !important; margin: -3px 0 !important; min-width: 0 !important; width: 24px !important; height: 22px !important; padding: 0 !important; display: inline-grid; place-items: center; border-radius: 5px !important; border: 1px solid var(--line) !important; background: var(--surface) !important; color: var(--ink-2) !important; cursor: pointer; box-shadow: none !important; }
#uc .uc-fwd svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-fwd:hover:not(:disabled) { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .uc-pane.active .uc-fwd:not(:disabled) { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)) !important; color: var(--accent) !important; }
#uc .uc-fwd:disabled { opacity: .35; cursor: default; }

/* shortcuts row + Left | Right toggle */
#uc .uc-bmrow { display: flex; align-items: center; gap: 8px; background: var(--surface-2); border-bottom: 1px solid var(--line); padding-right: 10px; }
#uc .uc-bmrow .uc-bookmarks { flex: 1 1 auto; min-width: 0; background: none; border-bottom: 0; }
#uc .uc-panetog { flex: none; display: inline-flex; gap: 6px; }
#uc .uc-bm.pt-seg { display: inline-flex; align-items: center; gap: 6px; max-width: none; overflow: visible; transition: color .2s, border-color .2s, background .2s, opacity .2s; }
#uc .pt-seg svg { width: 1.1em; height: 1.1em; flex: none; fill: none; stroke: currentColor; stroke-width: 1.3; }
#uc .pt-seg svg .f { fill: currentColor; stroke: none; opacity: .55; transition: opacity .2s; }
#uc .uc-bm.pt-seg.off { border-style: dashed; background: transparent; color: var(--muted); }
#uc .pt-seg.off svg .f { opacity: 0; }
/* ↻ refresh buttons either side of the Left | Right toggle: square, same look */
#uc .uc-bm.pt-rf { display: inline-flex; align-items: center; justify-content: center; padding: 4px !important; aspect-ratio: 1; align-self: stretch; max-width: none; overflow: visible; }
#uc .pt-rf svg { width: 1.15em; height: 1.15em; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-bm.pt-rf:disabled { opacity: .35; cursor: default; border-style: dashed; }
#uc .uc-bm.pt-rf.spin svg { animation: uc-rf .6s ease; }
@keyframes uc-rf { from { transform: rotate(0); } to { transform: rotate(360deg); } }

/* hiding a pane: the columns ease to zero (side-by-side layout only) */
#uc .uc-pane, #uc .uc-crumbs > .uc-path { transition: opacity .3s ease; min-width: 0; }
@media (min-width: 701px) {
  #uc.uc-anim .uc-panes, #uc.uc-anim .uc-crumbs { transition: grid-template-columns .4s cubic-bezier(.65,0,.35,1), column-gap .4s cubic-bezier(.65,0,.35,1); }
  #uc.only-0 .uc-panes { grid-template-columns: 1fr 0fr; column-gap: 0; }
  #uc.only-1 .uc-panes { grid-template-columns: 0fr 1fr; column-gap: 0; }
  #uc.only-0 .uc-crumbs { grid-template-columns: 1fr auto 0fr; }
  #uc.only-1 .uc-crumbs { grid-template-columns: 0fr auto 1fr; }
}
#uc.only-0 .uc-pane[data-pane="1"], #uc.only-1 .uc-pane[data-pane="0"],
#uc.only-0 .uc-path[data-pane="1"], #uc.only-1 .uc-path[data-pane="0"] { opacity: 0; pointer-events: none; overflow: hidden; }
#uc.only-0 .uc-path[data-pane="1"], #uc.only-1 .uc-path[data-pane="0"] { border-width: 0; padding: 0; }
@media (max-width: 700px) {
  #uc.only-0 .uc-panes, #uc.only-1 .uc-panes { grid-template-rows: minmax(0,1fr); }
  #uc.only-0 .uc-pane[data-pane="1"], #uc.only-1 .uc-pane[data-pane="0"],
  #uc.only-0 .uc-path[data-pane="1"], #uc.only-1 .uc-path[data-pane="0"] { display: none; }
}

/* Delete list: show whole names */
#uc .dl-nm { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; }
#uc .dl-in { overflow-wrap: anywhere; }
#uc .dl-row { align-items: start; }
#uc .dl-ic { padding-top: 1px; }
#uc .dl-sz { padding-top: 1px; white-space: nowrap; }
#uc .dl-head { flex-wrap: wrap; } #uc .dl-where { white-space: normal; overflow: visible; overflow-wrap: anywhere; }

/* Settings > Tools */
#uc .tl-card { display: flex; gap: 12px; align-items: center; border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; margin-top: 0; background: var(--surface); }
#uc .tl-card.soon { opacity: .6; }
#uc .tl-txt { flex: 1; display: flex; flex-direction: column; gap: 3px; font-size: calc(13px * var(--fs, 1)); }
#uc .tl-txt .muted { font-size: calc(12px * var(--fs, 1)); line-height: 1.4; }

/* Empty folders tool */
#uc .uc-dlg.ef-dlg .dlg-body { display: flex; flex-direction: column; gap: 12px; max-height: calc(100vh - 150px); }
#uc .ef-intro { font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; }
#uc .ef-setup { display: flex; flex-direction: column; gap: 10px; }
#uc .ef-setup.compact { flex-direction: row; flex-wrap: wrap; align-items: flex-end; gap: 6px 16px; padding-bottom: 10px; border-bottom: 1px solid var(--line-soft); }
#uc .ef-setup.compact > .muted { display: none; }
#uc .ef-disks { display: flex; flex-wrap: wrap; gap: 4px 14px; }
#uc .ef-prog { display: flex; flex-direction: column; gap: 6px; }
#uc .ef-prog-h { font-size: calc(12.5px * var(--fs, 1)); color: var(--muted); }
#uc .ef-dk { display: grid; grid-template-columns: 18px 70px 1fr auto; gap: 8px; align-items: center; font-size: calc(13px * var(--fs, 1)); }
#uc .ef-dk .ic { color: #1f8a4c; font-weight: 700; }
#uc .ef-dk .spin { width: 13px; height: 13px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; }
#uc .ef-res { display: flex; flex-direction: column; gap: 8px; min-height: 0; flex: 1 1 auto; }
#uc .ef-bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; font-size: calc(13px * var(--fs, 1)); }
#uc .ef-list { border: 1px solid var(--line); border-radius: 6px; overflow: auto; min-height: 80px; max-height: calc(100vh - 380px); background: var(--surface); }
#uc .ef-row { display: grid; grid-template-columns: 20px 62px minmax(0,1fr) auto auto; gap: 8px; align-items: center; padding: 5px 8px; border-bottom: 1px solid var(--line-soft); font-size: calc(12.5px * var(--fs, 1)); cursor: pointer; }
#uc .ef-row:last-child { border-bottom: 0; }
#uc .ef-row.on { background: var(--accent-soft); }
#uc .ef-disk { font: 600 calc(11px * var(--fs, 1))/1 var(--mono); padding: 3px 6px; border-radius: 4px; background: color-mix(in srgb, var(--ink) 8%, transparent); justify-self: start; }
#uc .ef-disk.sm { font-size: calc(10px * var(--fs, 1)); padding: 2px 4px; }
#uc .ef-path { font-family: var(--mono); overflow-wrap: anywhere; min-width: 0; }
#uc .ef-path .in { color: var(--muted); }
#uc .ef-kind { display: inline-block; margin-left: 6px; font: 600 calc(10.5px * var(--fs, 1))/1 var(--sans); padding: 2px 6px; border-radius: 8px; background: var(--line-soft); color: var(--ink-2); vertical-align: 1px; }
#uc .ef-also { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); white-space: nowrap; }
#uc .ef-open { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; font: 600 calc(11.5px * var(--fs, 1))/1 var(--sans) !important; padding: 4px 8px !important; border-radius: 5px !important; border: 1px solid var(--line) !important; background: var(--surface) !important; color: var(--accent) !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .ef-none { padding: 14px; text-align: center; font-size: calc(12.5px * var(--fs, 1)); }
#uc .ef-note { font-size: calc(12px * var(--fs, 1)); line-height: 1.45; }
@media (max-width: 760px) { #uc .ef-row { grid-template-columns: 20px 56px minmax(0,1fr) auto; } #uc .ef-also { grid-column: 3 / 4; white-space: normal; } }
#uc .ef-res[hidden], #uc .ef-prog[hidden], #uc .ef-setup[hidden], #uc .ef-lonebox[hidden] { display: none; }
#uc .ef-dk { grid-template-columns: 18px minmax(70px, max-content) 1fr auto; }

/* Movie folders tool */
#uc .uc-dlg.mt-dlg .dlg-body { display: flex; flex-direction: column; gap: 10px; max-height: calc(100vh - 150px); }
#uc .mt-rootrow { display: flex; gap: 8px; }
#uc .mt-rootrow .mt-root { flex: 1; min-width: 0; font-family: var(--mono); }
#uc .mt-prog { display: flex; gap: 10px; align-items: center; padding: 10px 2px; }
#uc .mt-prog .spin, #uc .mt-res .spin { width: 14px; height: 14px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; }
#uc .mt-prog[hidden], #uc .mt-res[hidden], #uc .mt-export[hidden], #uc .mt-detail[hidden], #uc .mt-list[hidden] { display: none; }
#uc .mt-res { display: flex; flex-direction: column; gap: 8px; min-height: 0; flex: 1 1 auto; }
#uc .mt-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 12px; font-size: calc(13px * var(--fs, 1)); }
#uc .mt-filters { display: flex; flex-wrap: wrap; gap: 5px; }
#uc .mt-export { border: 1px solid var(--line); border-radius: 6px; padding: 8px 10px; background: var(--surface-2); display: flex; flex-direction: column; gap: 6px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .mt-xrow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
#uc .mt-xrow .mt-xdir { flex: 1 1 220px; min-width: 0; font-family: var(--mono); font-size: calc(12px * var(--fs, 1)); }
#uc .mt-wrap { min-height: 0; flex: 1 1 auto; display: flex; flex-direction: column; }
#uc .mt-list, #uc .mt-detail { border: 1px solid var(--line); border-radius: 6px; overflow: auto; min-height: 120px; max-height: calc(100vh - 360px); background: var(--surface); }
#uc .mt-row { display: grid; grid-template-columns: 20px 34px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 5px 8px; border-bottom: 1px solid var(--line-soft); cursor: pointer; font-size: calc(13px * var(--fs, 1)); }
#uc .mt-row:last-child { border-bottom: 0; }
#uc .mt-row.on { background: var(--accent-soft); }
#uc .mt-thumb { width: 34px; height: 50px; object-fit: cover; border-radius: 3px; background: var(--surface-3); display: block; }
#uc .mt-thumb.none { background: repeating-linear-gradient(135deg, var(--surface-2) 0 6px, var(--surface-3) 6px 12px); }
#uc .mt-main { min-width: 0; overflow-wrap: anywhere; }
#uc .mt-year { color: var(--muted); font-weight: 400; }
#uc .mt-rate { color: #b26f00; font-weight: 600; font-size: calc(12px * var(--fs, 1)); white-space: nowrap; }
#uc .mt-sub { display: block; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); margin-top: 2px; }
#uc .mt-kind { display: inline-block; font: 600 calc(10.5px * var(--fs, 1))/1 var(--sans); padding: 2px 6px; border-radius: 8px; background: var(--line-soft); color: var(--ink-2); margin-right: 4px; }
#uc .mt-kind.meta { background: color-mix(in srgb, #d08a00 18%, transparent); color: #8a5a00; }
#uc .mt-kind.empty { background: color-mix(in srgb, var(--danger) 14%, transparent); color: var(--danger); }
#uc .mt-kind.sample { background: color-mix(in srgb, #7c3aed 15%, transparent); color: #6d28d9; }
#uc.uc-dark .mt-kind.meta { color: #e3b341; } #uc.uc-dark .mt-kind.sample { color: #c4a5ff; }
#uc .mt-acts { display: flex; gap: 5px; }
#uc .mt-detail { padding: 10px 12px; }
#uc .mt-dgrid { display: grid; grid-template-columns: 170px minmax(0,1fr); gap: 16px; margin-top: 10px; }
#uc .mt-poster { width: 170px; border-radius: 6px; box-shadow: 0 2px 10px rgba(0,0,0,.2); display: block; }
#uc .mt-poster.none { height: 250px; display: grid; place-items: center; text-align: center; padding: 10px; font-size: calc(12px * var(--fs, 1)); color: var(--muted); background: var(--surface-2); border: 1px dashed var(--line); box-shadow: none; }
#uc .mt-dtext h3 { margin: 0 0 4px; font: 700 calc(18px * var(--fs, 1))/1.25 var(--sans); color: var(--ink); }
#uc .mt-facts { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .mt-tag { font-style: italic; color: var(--muted); margin-top: 6px; font-size: calc(13px * var(--fs, 1)); }
#uc .mt-plot { font-size: calc(13px * var(--fs, 1)); line-height: 1.5; margin: 8px 0; }
#uc .mt-links { font-size: calc(12.5px * var(--fs, 1)); margin-bottom: 8px; }
#uc .mt-links a { color: var(--accent); }
#uc .mt-status { font-size: calc(12px * var(--fs, 1)); color: var(--muted); margin-bottom: 4px; }
#uc .mt-path { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); overflow-wrap: anywhere; margin-bottom: 8px; }
#uc .mt-files { border-top: 1px solid var(--line-soft); padding-top: 6px; font-size: calc(12px * var(--fs, 1)); }
#uc .mt-files > div { display: flex; justify-content: space-between; gap: 10px; padding: 1px 0; }
#uc .mt-files .mono { overflow-wrap: anywhere; }
#uc .mt-note { font-size: calc(12px * var(--fs, 1)); line-height: 1.45; }
#uc .uc-btn.soon { opacity: .55; }
@media (max-width: 640px) { #uc .mt-dgrid { grid-template-columns: 1fr; } #uc .mt-poster { width: 140px; } }
#uc .uc-headl .side { margin: 0 2px; }
#uc .uc-headl .act { margin-left: 2px; }

/* colour picker */
#uc .cp-pop { margin-top: 8px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); box-shadow: var(--shadow); padding: 12px; display: flex; flex-direction: column; gap: 8px; max-width: 560px; }
#uc .cp-top { display: grid; grid-template-columns: minmax(0,1fr) 22px 22px 150px; gap: 10px; }
#uc .cp-sv { position: relative; height: 190px; border-radius: 6px; cursor: crosshair; touch-action: none;
  background: linear-gradient(to top, #000, transparent), linear-gradient(to right, #fff, transparent), hsl(var(--h, 210), 100%, 50%); }
#uc .cp-svk { position: absolute; width: 16px; height: 16px; margin: -8px 0 0 -8px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.4), 0 1px 4px rgba(0,0,0,.4); pointer-events: none; }
#uc .cp-hue, #uc .cp-alpha { position: relative; border-radius: 6px; touch-action: none; cursor: ns-resize; }
#uc .cp-hue { background: linear-gradient(#f00 0%, #ff0 16.66%, #0f0 33.33%, #0ff 50%, #00f 66.66%, #f0f 83.33%, #f00 100%); }
#uc .cp-alpha { background: repeating-conic-gradient(#ccc 0 25%, #fff 0 50%) 0 0 / 10px 10px; overflow: hidden; }
#uc .cp-agrad { position: absolute; inset: 0; }
#uc .cp-k { position: absolute; left: -3px; right: -3px; height: 8px; margin-top: -4px; border-radius: 3px; border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(0,0,0,.45); pointer-events: none; }
#uc .cp-side { display: flex; flex-direction: column; gap: 6px; }
#uc .cp-prev { height: 44px; border-radius: 6px; overflow: hidden; border: 1px solid var(--line); background: repeating-conic-gradient(#ccc 0 25%, #fff 0 50%) 0 0 / 10px 10px; display: flex; flex-direction: column; }
#uc .cp-new, #uc .cp-old { flex: 1; background: var(--c); }
#uc .cp-old { cursor: pointer; }
#uc .cp-f { display: flex; flex-direction: column; gap: 2px; font: 600 calc(9.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; color: var(--muted); min-width: 0; }
#uc .cp-f input { width: 100%; min-width: 0; font: calc(12.5px * var(--fs, 1)) var(--mono) !important; padding: 4px 5px !important; margin: 0 !important; height: auto !important; letter-spacing: 0; }
#uc .cp-trio { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 5px; }
#uc .cp-lbl { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
#uc .cp-lbl[hidden], #uc .cp-rec[hidden] { display: none; }
#uc .cp-grid { display: grid; grid-template-columns: repeat(var(--n), minmax(0,1fr)); gap: 2px; }
#uc .cp-row { display: flex; flex-wrap: wrap; gap: 3px; }
#uc .cp-sw { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; padding: 0 !important; height: 20px !important; border: 1px solid rgba(0,0,0,.12) !important; border-radius: 3px !important; background: var(--c) !important; cursor: pointer; box-shadow: none !important; }
#uc .cp-row .cp-sw { width: 24px !important; }
#uc .cp-sw:hover { transform: scale(1.25); position: relative; z-index: 1; box-shadow: 0 1px 6px rgba(0,0,0,.35) !important; }
#uc .cp-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; border-top: 1px solid var(--line-soft); padding-top: 8px; margin-top: 2px; }
#uc .cp-fmt { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
#uc .cp-fmt button { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; color: var(--muted) !important; font: 600 calc(11px * var(--fs, 1))/1 var(--mono) !important; padding: 6px 8px !important; cursor: pointer; box-shadow: none !important; letter-spacing: 0 !important; }
#uc .cp-fmt button + button { border-left: 1px solid var(--line) !important; }
#uc .cp-fmt button.on { background: var(--accent-soft) !important; color: var(--accent) !important; }
#uc .cp-out { flex: 1 1 140px; font: 600 calc(12.5px * var(--fs, 1)) var(--mono); color: var(--ink); overflow-wrap: anywhere; }
@media (max-width: 600px) { #uc .cp-top { grid-template-columns: minmax(0,1fr) 22px 22px; } #uc .cp-side { grid-column: 1 / -1; } }
#uc .cp-f input { color: var(--ink) !important; background: var(--surface) !important; border: 1px solid var(--line) !important; border-radius: 4px !important; }

/* Settings: a comfortable width instead of nearly full screen */
#uc .uc-dlg.settings { max-width: 720px; }
/* ✕ in the header of Settings and Tools windows */
#uc .dlg-head { display: flex; align-items: center; gap: 10px; }
#uc .dlg-x { appearance: none !important; -webkit-appearance: none !important; margin: -4px -6px -4px auto !important; min-width: 0 !important; width: 30px !important; height: 30px !important; padding: 0 !important; border: 0 !important; border-radius: 6px !important; background: transparent !important; color: var(--muted) !important; font: 400 calc(17px * var(--fs, 1))/1 var(--sans) !important; cursor: pointer; box-shadow: none !important; display: grid; place-items: center; }
#uc .dlg-x:hover { background: color-mix(in srgb, var(--ink) 8%, transparent) !important; color: var(--ink) !important; }
#uc .tl-when { font-size: calc(12px * var(--fs, 1)); } #uc .tl-when[hidden] { display: none; }

/* top bar: Go to and Jump give way so Settings always fits its label */
#uc .uc-appbar .uc-goto { flex: 0 1 120px; width: 120px !important; min-width: 90px !important; max-width: 130px !important; text-overflow: ellipsis; }
/* /mnt | / System switch, next to the name - same look as the pane switch */
#uc .uc-sysseg { flex: none; display: inline-flex; gap: 0; }
#uc .uc-sysseg[hidden] { display: none; }
/* looks like real buttons: the one not chosen stands up, the chosen one is pressed in */
#uc .uc-sysseg .sys-b { max-width: none; font: 600 calc(12.5px * var(--fs, 1))/1.2 var(--sans); padding: 4px 11px; transition: background .15s, box-shadow .15s, color .15s; }
#uc .uc-sysseg .sys-b:not(.on) { background: linear-gradient(var(--surface), color-mix(in srgb, var(--line) 30%, var(--surface))) !important;
  box-shadow: 0 1px 1.5px rgba(0,0,0,.13), inset 0 1px 0 rgba(255,255,255,.7); }
#uc .uc-sysseg .sys-b.on { background: color-mix(in srgb, var(--accent) 16%, var(--surface)) !important; color: var(--accent) !important;
  border-color: color-mix(in srgb, var(--accent) 55%, var(--line)) !important; cursor: default;
  box-shadow: inset 0 2px 4px rgba(0,0,0,.2), inset 0 1px 1px rgba(0,0,0,.12); padding-top: 5px; padding-bottom: 3px; }
#uc.uc-dark .uc-sysseg .sys-b:not(.on) { box-shadow: 0 1px 1.5px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.06); }
#uc.uc-dark .uc-sysseg .sys-b.on { box-shadow: inset 0 2px 5px rgba(0,0,0,.6); }
#uc .uc-sysseg .sys-b:first-child { border-radius: var(--r-btn) 0 0 var(--r-btn); }
#uc .uc-sysseg .sys-b:last-child { border-radius: 0 var(--r-btn) var(--r-btn) 0; margin-left: -1px; }
#uc .uc-sysseg .sys-b:not(.on) { color: var(--muted); }
#uc .uc-sysseg .sys-b.on { position: relative; z-index: 1; }
#uc .st-sysnotes { margin: -2px 0 14px 28px; padding-left: 16px; font-size: calc(12.5px * var(--fs, 1)); line-height: 1.5; }
#uc .uc-appbar .uc-jump { flex: 0 1 200px; min-width: 110px; }
#uc .uc-appbar .uc-settings-btn, #uc .uc-appbar .uc-chip { flex: none; }
#uc .ef-x { color: var(--danger); }
#uc .ef-skipbox { font-size: calc(12.5px * var(--fs, 1)); line-height: 1.4; } #uc .ef-skipbox .muted { font-size: calc(12px * var(--fs, 1)); } #uc .ef-loading { display: flex; gap: 8px; align-items: center; font-size: calc(12.5px * var(--fs, 1)); margin-top: 4px; } #uc .ef-loading .spin { width: 13px; height: 13px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; }
#uc .ef-dkn { text-align: right; font-size: calc(12.5px * var(--fs, 1)); }
#uc .ef-legend { font-size: calc(11.5px * var(--fs, 1)); line-height: 1.4; margin-top: 4px; }

/* Radarr: settings box */
#uc .rd-box { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; margin-top: 10px; background: var(--surface); display: flex; flex-direction: column; gap: 8px; font-size: calc(13px * var(--fs, 1)); }
#uc .rd-box[hidden], #uc .rd-more[hidden] { display: none; }
#uc .rd-h { font-size: calc(13.5px * var(--fs, 1)); }
#uc .rd-intro, #uc .rd-foot { font-size: calc(12px * var(--fs, 1)); line-height: 1.4; }
#uc .rd-grid { display: grid; grid-template-columns: minmax(0,2fr) 80px minmax(0,1fr); gap: 8px; }
#uc .rd-grid .rd-keyf { grid-column: 1 / -1; }
#uc .rd-more .rd-grid { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
#uc .cp-f span i { font-style: normal; text-transform: none; letter-spacing: 0; font-family: var(--sans); font-weight: 400; }
#uc .rd-grid select { width: 100%; font-size: calc(13px * var(--fs, 1)); }
#uc .rd-more { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line-soft); padding-top: 8px; }
#uc .rd-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
#uc .rd-res { font-size: calc(12.5px * var(--fs, 1)); display: inline-flex; gap: 6px; align-items: center; }
#uc .rd-res.ok { color: #1f7a44; font-weight: 600; }
#uc .rd-res.err { color: var(--danger); }
#uc .rd-res .spin, #uc .rd-chip .spin { width: 11px; height: 11px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; }
#uc .rd-maph { font-weight: 600; font-size: calc(12.5px * var(--fs, 1)); }
#uc .rd-maph .muted { font-weight: 400; }
#uc .rd-pair { display: grid; grid-template-columns: auto auto minmax(0,1fr) auto; gap: 8px; align-items: center; }
#uc .rd-rp { font-size: calc(12.5px * var(--fs, 1)); font-weight: 600; }
#uc .rd-arrow { color: var(--muted); }
#uc .rd-hp { font: calc(12.5px * var(--fs, 1)) var(--mono) !important; padding: 4px 6px !important; color: var(--ink) !important; }
#uc .rd-det { font: 600 calc(10px * var(--fs, 1))/1 var(--sans); color: #1f7a44; background: color-mix(in srgb, #1f8a4c 12%, transparent); padding: 3px 6px; border-radius: 8px; white-space: nowrap; }
/* Radarr: in the movie list */
#uc .rd-chip { display: inline-flex; align-items: center; gap: 5px; margin-top: 3px; font: 600 calc(11px * var(--fs, 1))/1.2 var(--sans); padding: 2px 7px; border-radius: 8px; background: var(--line-soft); color: var(--ink-2); max-width: 100%; }
#uc .rd-chip.added, #uc .rd-chip.exists { background: color-mix(in srgb, #1f8a4c 14%, transparent); color: #1f7a44; }
#uc .rd-chip.pick { background: color-mix(in srgb, #d08a00 16%, transparent); color: #8a5a00; cursor: pointer; }
#uc .rd-chip.err { background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); white-space: normal; }
#uc .rd-one { color: #1f7a44 !important; }
#uc .rd-pickh { margin: 10px 0; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; }
#uc .rd-cands { display: flex; flex-direction: column; gap: 10px; }
#uc .rd-cand { display: grid; grid-template-columns: 60px minmax(0,1fr); gap: 12px; align-items: start; border-bottom: 1px solid var(--line-soft); padding-bottom: 10px; font-size: calc(13px * var(--fs, 1)); }
#uc .rd-cand img, #uc .rd-cand .mt-thumb { width: 60px; height: 90px; object-fit: cover; border-radius: 4px; }
#uc .rd-cand p { margin: 4px 0 8px; font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); line-height: 1.4; }
#uc .rd-cand a { color: var(--accent); font-size: calc(12px * var(--fs, 1)); margin-left: 6px; }

/* tool windows: their own layer under ordinary dialogs, and the pill that brings a tucked-away tool back */
#uc .uc-tmodal { z-index: 9990; }
#uc .uc-toolpill { font: 600 calc(12px * var(--fs, 1))/1 var(--sans) !important; letter-spacing: 0 !important; text-transform: none !important; color: #fff !important; background: #7c3aed !important; border: 1px solid #7c3aed !important; border-radius: 20px !important; padding: 6px 12px !important; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(124,58,237,.35) !important; animation: tp-in .3s ease; }
#uc .uc-toolpill[hidden] { display: none; }
#uc .uc-toolpill .tp-ic { font-size: calc(14px * var(--fs, 1)); }
@keyframes tp-in { from { transform: translateY(-6px); opacity: 0; } to { transform: none; opacity: 1; } }
#uc .dlg-min { appearance: none !important; -webkit-appearance: none !important; margin: -4px 0 -4px auto !important; min-width: 0 !important; width: 30px !important; height: 30px !important; padding: 0 !important; border: 0 !important; border-radius: 6px !important; background: transparent !important; color: var(--muted) !important; font: 700 calc(15px * var(--fs, 1))/1 var(--sans) !important; cursor: pointer; box-shadow: none !important; display: grid; place-items: center; }
#uc .dlg-min:hover { background: color-mix(in srgb, var(--ink) 8%, transparent) !important; color: var(--ink) !important; }
#uc .dlg-min + .dlg-x { margin-left: 2px !important; }
#uc .ct-f.ok { border-color: color-mix(in srgb, #1f8a4c 45%, var(--line)) !important; color: #1f7a44 !important; } #uc .ct-f.ok.on { background: color-mix(in srgb, #1f8a4c 12%, transparent) !important; } #uc .rd-rm { color: var(--danger) !important; }

/* movie tool: the fixed "Arrived" panel above the missing list */
#uc .mt-arrived { border: 1px solid color-mix(in srgb, #1f8a4c 40%, var(--line)); border-radius: 8px; background: color-mix(in srgb, #1f8a4c 6%, var(--surface)); padding: 8px 10px; display: flex; flex-direction: column; gap: 6px; flex: none; }
#uc .mt-arrived[hidden] { display: none; }
#uc .ma-h { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: calc(13px * var(--fs, 1)); }
#uc .ma-h > b { color: #1f7a44; }
#uc .ma-h .muted { font-size: calc(12px * var(--fs, 1)); }
#uc .ma-acts { margin-left: auto; display: flex; gap: 5px; }
#uc .ma-list { max-height: 168px; overflow: auto; display: flex; flex-direction: column; }
#uc .ma-row { display: grid; grid-template-columns: 26px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 4px 0; border-top: 1px solid color-mix(in srgb, #1f8a4c 15%, var(--line-soft)); font-size: calc(13px * var(--fs, 1)); }
#uc .ma-row .mt-thumb { width: 26px; height: 38px; }
#uc .ma-t { min-width: 0; overflow-wrap: anywhere; }
#uc .ma-s { display: block; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); }
#uc .ma-s .spin { width: 10px; height: 10px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; vertical-align: -1px; }

/* auto-refresh: items that just appeared flash, then fade */
#uc .uc-row.uc-new { animation: uc-new 3s ease-out; }
@keyframes uc-new { 0%, 35% { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); } 100% { background: transparent; box-shadow: none; } }

/* movie tool: "Radarr needs you" - amber, fixed above the list */
#uc .mt-attn { border: 1px solid color-mix(in srgb, #d08a00 55%, var(--line)); border-left: 5px solid #d08a00; border-radius: 8px; background: color-mix(in srgb, #f5b300 13%, var(--surface)); padding: 9px 11px; display: flex; flex-direction: column; gap: 6px; flex: none; }
#uc .mt-attn[hidden] { display: none; }
#uc .mt-attn.pulse { animation: na-pulse 1.1s ease 2; }
@keyframes na-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(208,138,0,0); } 40% { box-shadow: 0 0 0 6px rgba(208,138,0,.35); } }
#uc .na-h { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
#uc .na-ic { font-size: calc(22px * var(--fs, 1)); line-height: 1; color: #b37400; }
#uc .na-t { display: flex; flex-direction: column; gap: 2px; flex: 1 1 220px; min-width: 0; }
#uc .na-t b { font-size: calc(14px * var(--fs, 1)); color: #7a4d00; }
#uc .na-s { font-size: calc(12px * var(--fs, 1)); color: #8a5a00; }
#uc .na-go { margin-left: auto; background: #d08a00 !important; border-color: #d08a00 !important; color: #fff !important; }
#uc .na-list { max-height: 150px; overflow: auto; display: flex; flex-direction: column; }
#uc .na-row { display: grid; grid-template-columns: 26px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 4px 0; border-top: 1px solid color-mix(in srgb, #d08a00 22%, var(--line-soft)); font-size: calc(13px * var(--fs, 1)); }
#uc .na-row .mt-thumb { width: 26px; height: 38px; }
#uc .na-pick { color: #8a5a00 !important; font-weight: 700 !important; }
#uc .mt-row.need { box-shadow: inset 4px 0 0 #d08a00; background: color-mix(in srgb, #f5b300 8%, transparent); }
#uc .rd-chip.pick { animation: na-chip 1.6s ease-in-out infinite; }
@keyframes na-chip { 50% { background: color-mix(in srgb, #d08a00 32%, transparent); } }
#uc .rd-pickbar { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
#uc .rd-pos { margin-left: auto; font: 700 calc(12px * var(--fs, 1))/1 var(--sans); color: #8a5a00; }
#uc.uc-dark .na-t b, #uc.uc-dark .na-s, #uc.uc-dark .na-pick, #uc.uc-dark .rd-pos { color: #f2c060 !important; }
#uc .uc-toolpill.attn { background: #d08a00 !important; border-color: #d08a00 !important; box-shadow: 0 2px 10px rgba(208,138,0,.45) !important; }
#uc .uc-toolpill .tp-need { background: rgba(255,255,255,.25); border-radius: 10px; padding: 2px 7px; }
#uc .uc-toolpill.pulse { animation: na-pulse 1.1s ease 3; }

/* Settings > Tools: the movie card holds the Radarr settings, under a thin line */
#uc .tl-card.tl-stack { flex-direction: column; align-items: stretch; gap: 0; }
#uc .tl-top { display: flex; gap: 12px; align-items: center; }
#uc .tl-stack > .rd-box { border: 0; border-top: 1px solid var(--line-soft); border-radius: 0; margin: 12px 0 0; padding: 12px 0 2px; background: none; }

/* Empty folders: spacing tidy-up (same layout) */
#uc .ef-list { border-radius: 8px; }
#uc .ef-row { padding: 7px 10px; gap: 10px; }
#uc .ef-row .ef-disk:first-of-type { min-width: 48px; text-align: center; box-sizing: border-box; }
#uc .ef-bar { align-items: center; }
#uc .ef-also { display: inline-flex; align-items: center; gap: 4px; }

/* Settings > General > Auto-refresh: one compact box */
#uc .st-ar-box { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 6px 14px; padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--r); }
#uc .st-ar-box:has(.st-ar:checked) { border-color: var(--accent); background: var(--accent-soft); }
#uc .st-ar-box .chk { display: inline-flex; align-items: center; gap: 8px; margin: 0; }
#uc .st-ar-box input[type=checkbox], #uc .st-radio input[type=checkbox] { width: 16px; height: 16px; flex: none; accent-color: var(--accent); }
#uc .st-ar-every { display: inline-flex; align-items: center; gap: 8px; font-size: calc(13px * var(--fs, 1)); white-space: nowrap; margin: 0; }
#uc .st-ar-every select { width: auto; }
#uc .st-ar-note { grid-column: 1 / -1; font-size: calc(12px * var(--fs, 1)); padding-left: 24px; }

/* Empty folders: setup card - disk and pool pills, share menu */
#uc .ef-card { border: 1px solid var(--line); border-radius: 10px; background: var(--surface); padding: 12px 14px; display: flex; flex-direction: column; gap: 12px; }
#uc .ef-sec { display: flex; flex-direction: column; gap: 6px; }
#uc .ef-lbl { display: flex; align-items: center; gap: 10px; font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#uc .ef-lbl2 { margin-top: 4px; }
#uc .ef-quick { display: inline-flex; gap: 2px; }
#uc .ef-quick button { appearance: none !important; -webkit-appearance: none !important; margin: 0 !important; min-width: 0 !important; border: 0 !important; background: none !important; padding: 2px 5px !important; font: 600 calc(11px * var(--fs, 1))/1 var(--sans) !important; color: var(--accent) !important; text-transform: none !important; letter-spacing: 0 !important; cursor: pointer; border-radius: 4px !important; box-shadow: none !important; }
#uc .ef-quick button:hover { background: var(--accent-soft) !important; }
#uc .ef-disks { display: flex; flex-wrap: wrap; gap: 6px; }
#uc .ef-chip { position: relative; cursor: pointer; }
#uc .ef-chip input { position: absolute; opacity: 0; pointer-events: none; }
#uc .ef-chip span { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px 6px 10px; border: 1px solid var(--line); border-radius: 18px; font: 600 calc(12.5px * var(--fs, 1))/1 var(--mono); color: var(--muted); background: var(--ground); transition: background .12s, border-color .12s, color .12s; }
#uc .ef-chip span::before { content: ''; width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid currentColor; box-sizing: border-box; }
#uc .ef-chip input:checked + span { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); color: var(--accent); }
#uc .ef-chip input:checked + span::before { background: currentColor; }
#uc .ef-chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
#uc .ef-opts { flex-direction: row; flex-wrap: wrap; align-items: flex-end; gap: 10px 22px; padding-top: 12px; border-top: 1px solid var(--line-soft); }
#uc .ef-sharef { display: flex; flex-direction: column; gap: 6px; }
#uc .ef-sharef select { min-width: 180px; }
#uc .ef-hint { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); line-height: 1.4; display: flex; gap: 6px; }
#uc .ef-hint::before { content: 'ⓘ'; font-size: calc(12px * var(--fs, 1)); }

/* switch-style toggle */
#uc .ef-toggle { display: inline-flex; align-items: center; gap: 9px; cursor: pointer; font-size: calc(13px * var(--fs, 1)); line-height: 1.3; position: relative; }
#uc .ef-toggle input { position: absolute; opacity: 0; pointer-events: none; }
#uc .ef-sw { flex: none; width: 32px; height: 18px; border-radius: 10px; background: color-mix(in srgb, var(--ink) 22%, transparent); position: relative; transition: background .15s; }
#uc .ef-sw::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,.3); transition: transform .15s; }
#uc .ef-toggle input:checked + .ef-sw { background: var(--accent); }
#uc .ef-toggle input:checked + .ef-sw::after { transform: translateX(14px); }
#uc .ef-toggle input:focus-visible + .ef-sw { outline: 2px solid var(--accent); outline-offset: 2px; }
#uc .ef-toggle small { display: block; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); }
#uc .ef-setup.ef-card, #uc .ef-setup.ef-card.compact { flex-direction: column; align-items: stretch; gap: 12px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
#uc .ef-skipbox .ef-sw { margin-top: 1px; }


/* More toggle: solid accent so it stands out */
#uc .uc-fk.uc-fk-toggle { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink, #fff) !important; font-size: calc(22px * var(--fs, 1)); font-weight: 800; width: 38px; }
#uc .uc-fk.uc-fk-toggle { display: flex; align-items: center; justify-content: center; }
#uc .uc-fk.uc-fk-toggle span { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; transform: none; line-height: 0; }
#uc .uc-fk.uc-fk-toggle svg { width: calc(15px * var(--fs, 1)); height: calc(15px * var(--fs, 1)); fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; display: block; }
#uc .uc-fkeys.more .uc-fk-toggle span { transform: rotate(-90deg); }
#uc .uc-fk.uc-fk-toggle:active { filter: brightness(.9); }

/* Touch screens: unRAID's red button hover "sticks" after a tap (there's no
 * mouse to move away). Inside unCommander, hover looks like the normal
 * button; the red only shows while a finger is actually pressing. */
body { --uc-press-bg: var(--hover-button-background); --uc-press-ink: var(--hover-button-text-color); --uc-press-line: var(--hover-button-border); }
@media (hover: none) {
  #uc { --hover-button-background: var(--button-background); --hover-button-text-color: var(--button-text-color); --hover-button-border: var(--button-border); }
  #uc button:active { --hover-button-background: var(--uc-press-bg); --hover-button-text-color: var(--uc-press-ink); --hover-button-border: var(--uc-press-line); }
}
/* Size column: same font as the Date column, in the accent colour */
#uc .uc-row .col-size { font: 500 calc(11px * var(--fs, 1))/1 var(--sans); letter-spacing: -.01em; font-variant-numeric: tabular-nums; color: var(--accent); }
#uc .uc-row .col-size.dsz { font-weight: 700; }
#uc .uc-row .col-size.gb { font-weight: 700; font-size: calc(14px * var(--fs, 1)) !important; }   /* files of 1 GB and more */

/* Wider names: the column button sits in the empty corner above the tick boxes,
 * so the rows no longer keep a blank strip on the right for it */
#uc .uc-pane .uc-cols, #uc .uc-pane .uc-row { padding-right: 6px; }
#uc .uc-colbtn { left: 7px; right: auto !important; }
#uc .uc-colpop { left: 6px; right: auto; }

/* ---------- Tools > TV shows with missing episodes ---------- */
#uc .tv-intro { font-size: calc(12px * var(--fs, 1)); line-height: 1.4; margin-top: 4px; }
#uc .tv-prog { display: flex; flex-direction: column; gap: 6px; font-size: calc(13px * var(--fs, 1)); }
#uc .tv-prog .spin { width: 12px; height: 12px; border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%; display: inline-block; animation: uc-spin .8s linear infinite; vertical-align: -1px; }
#uc .tv-bar { height: 6px; border-radius: 3px; background: var(--line-soft); overflow: hidden; }
#uc .tv-bar i { display: block; height: 100%; background: var(--accent); transition: width .4s; }
#uc .tv-row { cursor: default; }
#uc .tv-sum { display: block; font-size: calc(12px * var(--fs, 1)); color: var(--ink-2); margin-top: 2px; overflow-wrap: anywhere; }
#uc .tv-sum a, #uc .tv-how a, #uc .mt-detail a { color: var(--accent); }
#uc .tv-status { display: inline-block; font: 600 calc(10px * var(--fs, 1))/1 var(--sans); padding: 2px 6px; border-radius: 8px; vertical-align: 1px; }
#uc .tv-status.ended { background: var(--line-soft); color: var(--muted); }
#uc .tv-status.running { background: color-mix(in srgb, #1f8a4c 14%, transparent); color: #1f7a44; }
#uc .mt-kind.tv-k-missing, #uc .mt-kind.tv-k-seasons { background: color-mix(in srgb, var(--danger) 13%, transparent); color: var(--danger); }
#uc .mt-kind.tv-k-look, #uc .mt-kind.tv-k-nomatch { background: color-mix(in srgb, #d08a00 16%, transparent); color: #8a5a00; }
#uc .mt-kind.tv-k-complete, #uc .mt-kind.tv-k-uptodate { background: color-mix(in srgb, #1f8a4c 14%, transparent); color: #1f7a44; }
#uc .tv-row.tv-ignored, #uc .tv-row.tv-complete, #uc .tv-row.tv-uptodate { opacity: .8; }
#uc .tv-dhead { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 14px; margin: 8px 0 10px; }
#uc .tv-dhead h3 { margin: 0 0 4px; font-size: calc(16px * var(--fs, 1)); }
#uc .tv-poster { width: 92px; border-radius: 5px; display: block; }
#uc .tv-how { font-size: calc(12px * var(--fs, 1)); margin: 4px 0; }
#uc .tv-rules { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 4px; }
#uc .tv-legend { display: flex; align-items: center; gap: 6px; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); margin: 6px 0; }
#uc .tv-legend .tv-cell { width: 12px; height: 12px; margin-left: 8px; }
#uc .tv-grid { display: flex; flex-direction: column; gap: 10px; }
#uc .tv-season.skip { opacity: .45; }
#uc .tv-sh { display: flex; align-items: center; gap: 10px; font-size: calc(13px * var(--fs, 1)); margin-bottom: 5px; }
#uc .tv-sh .ef-open { margin-left: auto !important; }
#uc .tv-sh .tv-snseason { font-weight: 700; background: var(--accent) !important; border-color: var(--accent) !important; color: #fff !important; }
#uc .tv-sh .tv-snseason small { font-weight: 500; opacity: .85; }
#uc .tv-sh .tv-snseason + .ef-open { margin-left: 0 !important; }
#uc .tv-cells { display: flex; flex-wrap: wrap; gap: 3px; }
#uc .tv-cell { display: inline-grid; place-items: center; min-width: 24px; height: 22px; padding: 0 3px; border-radius: 4px; font: 600 calc(10.5px * var(--fs, 1))/1 var(--sans); box-sizing: border-box; cursor: default; }
#uc .tv-cell.have { background: color-mix(in srgb, #1f8a4c 22%, transparent); color: #1f6b3d; }
#uc .tv-cell.miss { background: var(--danger); color: #fff; }
#uc .tv-cell.nf { background: color-mix(in srgb, #f5b300 45%, var(--surface)); color: #6b4500; border: 1px dashed #d08a00; }
#uc .tv-cell.future { background: transparent; border: 1px dashed var(--line); color: var(--muted); }
#uc.uc-dark .tv-cell.have { color: #8fe0ad; }
#uc .tv-note { font-size: calc(12.5px * var(--fs, 1)); margin-top: 10px; line-height: 1.45; }
#uc .tv-files { font-size: calc(11.5px * var(--fs, 1)); margin-top: 4px; max-height: 140px; overflow: auto; }
#uc .tv-search { display: flex; gap: 8px; margin: 8px 0 10px; }
#uc .tv-search input { flex: 1; min-width: 0; font: calc(13px * var(--fs, 1))/1.2 var(--sans); padding: 6px 8px; border: 1px solid var(--line); border-radius: var(--r-input); background: var(--surface); color: var(--ink); }

/* Settings > Tools: Radarr settings fold away under their heading */
#uc details.rd-acc > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; }
#uc details.rd-acc > summary::-webkit-details-marker { display: none; }
#uc .rd-chev { margin-left: auto; width: 8px; height: 8px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); transition: transform .2s; margin-right: 4px; }
#uc details.rd-acc[open] .rd-chev { transform: rotate(-135deg); }
#uc details.rd-acc:not([open]) { padding-bottom: 2px; }
#uc details.rd-acc[open] > summary { margin-bottom: 8px; }
#uc .tv-offline { color: #8a5a00; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; }
#uc.uc-dark .tv-offline { color: #f2c060; }
#uc details.rd-acc { display: block; }
#uc details.rd-acc > * + * { margin-top: 8px; }
/* looking at one show: the folder box, banners and filters step aside */
#uc .tv-dlg.tv-inshow .mt-setup, #uc .tv-dlg.tv-inshow .tl-when, #uc .tv-dlg.tv-inshow .mt-attn, #uc .tv-dlg.tv-inshow .mt-bar { display: none !important; }
#uc .tv-dlg.tv-inshow .mt-detail { max-height: calc(100vh - 200px); }

#uc .tv-cell.asked { background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--accent); border: 1px solid var(--accent); }
#uc .tv-snd { margin-right: 4px !important; }
#uc .tv-row .rd-chip { margin-top: 4px; }

/* ✕ to clear the Jump and pattern boxes */
#uc .uc-clrwrap { position: relative; display: inline-flex; align-items: center; min-width: 0; }
#uc .uc-clrwrap > input { width: 100% !important; padding-right: 24px !important; }
#uc .uc-clrwrap.j { width: 240px; }
#uc .uc-clrwrap.p { width: 130px; }
#uc .uc-appbar .uc-clrwrap.j { flex: 0 1 200px; min-width: 110px; width: auto; }
@media (max-width: 900px) { #uc .uc-clrwrap.j { flex: 1 1 160px; width: auto; } }
#uc .uc-clr { appearance: none !important; -webkit-appearance: none !important; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 18px !important; height: 18px !important; min-width: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 50% !important; background: color-mix(in srgb, var(--ink) 14%, transparent) !important; color: var(--ink-2) !important; font: 700 calc(10px * var(--fs, 1))/18px var(--sans) !important; text-align: center; cursor: pointer; box-shadow: none !important; }
#uc .uc-clr:hover { background: color-mix(in srgb, var(--ink) 24%, transparent) !important; }
#uc .uc-clrwrap > input:placeholder-shown + .uc-clr { display: none; }
#uc .uc-jump::-webkit-search-cancel-button { -webkit-appearance: none; display: none; }
/* the result count after a scan you started: a short highlight */
#uc .uc-flash { animation: uc-flash 1.6s ease-out; border-radius: 4px; }
@keyframes uc-flash { 0%, 30% { background: color-mix(in srgb, var(--accent) 22%, transparent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent); } 100% { background: transparent; box-shadow: none; } }

/* TV: deleting a show's folder */
#uc .tv-delrow { margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--line-soft); display: flex; justify-content: flex-end; }
#uc .ef-open.tv-del { color: var(--danger) !important; border-color: color-mix(in srgb, var(--danger) 40%, var(--line)) !important; }
#uc .tvdel-head { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 12px; align-items: start; margin-bottom: 12px; font-size: calc(13px * var(--fs, 1)); line-height: 1.5; }
#uc .tvdel-poster { width: 54px; border-radius: 4px; display: block; }
#uc .tvdel-path { font-size: calc(12px * var(--fs, 1)); color: var(--ink-2); overflow-wrap: anywhere; margin: 2px 0; }
#uc .warnbox.danger { background: color-mix(in srgb, var(--danger) 10%, var(--surface)); border-left-color: var(--danger); }
#uc .tvdel-warn { margin-bottom: 10px; line-height: 1.5; }
#uc .tvdel-opt { display: flex; gap: 8px; align-items: flex-start; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; margin: 6px 0; }
#uc .tvdel-note { font-size: calc(12px * var(--fs, 1)); margin: 6px 0; }
/* messages must show above an open window (tools, dialogs) - before, they were hidden behind it */
#uc:has(.uc-modal:not([hidden])) .uc-toast { position: fixed; bottom: 28px; z-index: 10050; }
/* TV details: IMDb / TVmaze links and rating */
#uc .tv-links { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 6px 0 2px; }
#uc .tv-link { display: inline-flex; align-items: center; gap: 4px; font: 600 calc(12px * var(--fs, 1))/1 var(--sans); padding: 5px 9px; border-radius: var(--r-btn, 6px); border: 1px solid var(--line); color: var(--accent) !important; text-decoration: none; background: var(--surface); }
#uc .tv-link.imdb { background: #f5c518; border-color: #e2b616; color: #000 !important; }
#uc .tv-rating { font: 700 calc(13px * var(--fs, 1))/1 var(--sans); color: #b37400; }
#uc .tv-rating small { font-weight: 500; color: var(--muted); margin-left: 1px; }
#uc .tv-genres { font-size: calc(12px * var(--fs, 1)); }
/* TV details: the Sonarr button, big and on its own line */
#uc .tv-sndrow { margin: 10px 0 6px; }
#uc .uc-btn.tv-snd { display: block; width: 100%; max-width: 460px; padding: 11px 16px !important; font: 700 calc(14.5px * var(--fs, 1))/1.2 var(--sans) !important; background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink, #fff) !important; border-radius: var(--r-btn, 6px) !important; box-shadow: 0 2px 6px color-mix(in srgb, var(--accent) 30%, transparent); text-align: center; }
#uc .uc-btn.tv-snd:active { filter: brightness(.92); }
#uc .uc-btn.tv-snd:disabled { opacity: .6; }

/* TV Details: "What's wrong" - every problem with the show in plain words */
#uc .tv-issues { margin: 12px 0 10px; border: 1px solid color-mix(in srgb, #d08a00 55%, var(--line)); border-left: 5px solid #d08a00; border-radius: 8px; background: color-mix(in srgb, #f5b300 11%, var(--surface)); padding: 10px 12px; }
#uc .tv-issues.minor { border-color: var(--line); border-left-color: var(--muted); background: color-mix(in srgb, var(--muted) 7%, var(--surface)); }
#uc .tv-ih { font: 700 calc(13.5px * var(--fs, 1))/1.2 var(--sans); color: #8a5a00; margin-bottom: 6px; }
#uc .tv-issues.minor .tv-ih { color: var(--muted); }
#uc .tv-issue + .tv-issue { border-top: 1px solid color-mix(in srgb, #d08a00 25%, var(--line)); margin-top: 8px; padding-top: 8px; }
#uc .tv-it { font: 700 calc(13px * var(--fs, 1))/1.35 var(--sans); display: flex; align-items: center; gap: 7px; }
#uc .tv-in { flex: none; width: 19px; height: 19px; border-radius: 50%; background: #d08a00; color: #fff; font: 700 calc(11px * var(--fs, 1))/19px var(--sans); text-align: center; }
#uc .tv-ib { font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; }
#uc .tv-ib p { margin: 5px 0; }
#uc .tv-ib .mono { word-break: break-word; }
#uc .tv-do { background: color-mix(in srgb, var(--surface) 70%, transparent); border-radius: 6px; padding: 6px 8px; }
#uc .tv-fx { display: inline-block; min-width: 62px; font-weight: 700; color: #8a5a00; }
#uc .tv-cmpw { overflow-x: auto; margin: 6px 0; }
#uc .tv-cmp { border-collapse: collapse; font-size: calc(12px * var(--fs, 1)); }
#uc .tv-cmp th, #uc .tv-cmp td { border: 1px solid var(--line); padding: 3px 8px; text-align: center; background: var(--surface); }
#uc .tv-cmp td:first-child { text-align: left; font-weight: 600; white-space: nowrap; }
#uc .tv-cmp td.diff { background: color-mix(in srgb, #f5b300 30%, var(--surface)); font-weight: 700; }
#uc .tv-two { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 6px 0; }
#uc .tv-two > div { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; }
#uc .tv-two .mono { display: block; margin-top: 3px; font-size: calc(12px * var(--fs, 1)); }
@media (max-width: 560px) { #uc .tv-two { grid-template-columns: 1fr; } }
#uc .tv-iacts { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; }
#uc .tv-iacts .tv-ok { font-weight: 700; border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .tv-more summary { cursor: pointer; font-size: calc(12px * var(--fs, 1)); color: var(--accent); margin-top: 4px; }
#uc .tv-why { color: #8a5a00; }
#uc .tv-ord { color: var(--accent); }
#uc .tv-ordnote { display: inline-block; margin: 4px 0 2px; font-size: calc(12px * var(--fs, 1)); padding: 3px 8px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--ink); }
#uc .tv-rules .tv-wrong { font-weight: 700; border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .tv-qhint { font-size: calc(12px * var(--fs, 1)); margin: -2px 0 8px; line-height: 1.4; }
#uc .tv-cur { display: inline-block; font-weight: 700; font-size: calc(12.5px * var(--fs, 1)); color: #2a7a3a; padding: 4px 0; }
/* delete dialog: trash or for good */
#uc .fd-choice { display: grid; gap: 6px; margin: 4px 0 8px; }
#uc .fd-opt { display: flex; gap: 9px; align-items: flex-start; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; font-size: calc(13px * var(--fs, 1)); line-height: 1.4; }
#uc .fd-opt input { margin-top: 3px; accent-color: var(--accent); }
#uc .fd-opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
#uc .fd-opt.fd-forever:has(input:checked) { border-color: var(--danger); background: color-mix(in srgb, var(--danger) 9%, var(--surface)); }
#uc .fd-opt.fd-forever input { accent-color: var(--danger); }
#uc .fd-permbox { border: 1px solid var(--danger); border-radius: 8px; padding: 2px 10px; background: color-mix(in srgb, var(--danger) 7%, var(--surface)); }
#uc .fd-permbox[hidden] { display: none; }
#uc .fd-permbox.pulse { animation: na-pulse 1.1s ease 2; }

/* ---------- Text size (Settings > Look & sound, saved per device) ----------
 * Every built-in font size is "base x --fs"; --fs is set on this device only.
 * 100% is the original look. */
/* 2. F-keys: the small "F5" sits on the same line as "Copy" */
#uc .uc-fk { align-items: baseline; }
#uc .uc-fk .k { line-height: 1; }
#uc .uc-fk.uc-fk-toggle { align-items: center; }
/* 3. "Aa" (Batch rename) is real letters, not a symbol: smaller than the others */
#uc .uc-fk .ic.txt { font-size: .78em; font-weight: 700; letter-spacing: -.02em; }
/* bigger text (110% and up): a thicker outline round the active pane */
#uc.uc-big .uc-box { border-width: 3px; }
/* the slider */
#uc .fs-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
#uc .fs-row input[type=range] { flex: 1 1 220px; max-width: 360px; accent-color: var(--accent); }
#uc .fs-row .fs-val { min-width: 4.2em; text-align: center; font: 700 calc(13px * var(--fs, 1))/1 var(--mono); color: var(--accent); }
#uc .fs-row .uc-btn.fs-step { min-width: 34px !important; padding: 4px 0 !important; font-weight: 700; }
#uc .fs-note { font-size: calc(12.5px * var(--fs, 1)); margin-top: 6px; }
/* 5. Keyboard tab: two independent columns, so "Other" sits right under "Ticking" */
#uc .kb-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 0 28px; align-items: start; }
#uc .kb-col { min-width: 0; }

/* TV: downloads waiting for an import in Sonarr */
#uc .tv-stuck { margin: 12px 0 10px; border: 1px solid color-mix(in srgb, #d08a00 55%, var(--line)); border-left: 5px solid #d08a00; border-radius: 8px; background: color-mix(in srgb, #f5b300 11%, var(--surface)); padding: 10px 12px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .tv-stuck-i { padding: 5px 0; border-top: 1px solid color-mix(in srgb, #d08a00 25%, var(--line)); line-height: 1.4; overflow-wrap: anywhere; }
#uc .tv-stuck-i:first-of-type { border-top: none; }
#uc .tv-stuck .tv-iacts { align-items: center; }
#uc .tv-stuck .tv-iacts .muted { font-size: calc(12px * var(--fs, 1)); }
#uc .ef-open.tv-imp { border-color: #d08a00 !important; color: #8a5a00 !important; font-weight: 700; }

/* movie / TV tool buttons next to Settings: small squares with an icon */
#uc .uc-appbar .uc-toolbtn { flex: none; display: inline-flex; align-items: center; justify-content: center; padding: 3px !important; aspect-ratio: 1; min-width: 0 !important; margin: 0 !important; line-height: 0; }
#uc .uc-appbar .uc-toolbtn[hidden] { display: none; }
#uc .uc-toolbtn svg { width: calc(17px * var(--fs, 1)); height: calc(17px * var(--fs, 1)); display: block; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
#uc .tl-iconopt { display: flex; gap: 8px; align-items: center; margin: 2px 0 8px; font-size: calc(13px * var(--fs, 1)); }
/* the ".." name cell: unRAID's own stylesheet gives every div.up a border */
#uc div.up { border: none; }
#uc .st-about { font-size: calc(13px * var(--fs, 1)); line-height: 1.55; }
#uc .st-about a { font-weight: 600; color: var(--accent); white-space: nowrap; }
/* Settings > About: Buy me a coffee */
#uc .st-bmc { display: inline-flex; width: max-content; align-self: flex-start; align-items: center; gap: 7px; margin-top: 10px; padding: 7px 14px 7px 10px; border-radius: 999px; background: #ffdd00; color: #0d0c22 !important; font: 700 calc(13px * var(--fs, 1))/1 var(--sans); text-decoration: none !important; border: 1px solid #e6c700; box-shadow: 0 1px 2px rgba(0,0,0,.12); }
#uc .st-bmc:hover { filter: brightness(1.04); box-shadow: 0 2px 6px rgba(0,0,0,.18); }
#uc .st-bmc svg { width: calc(20px * var(--fs, 1)); height: calc(20px * var(--fs, 1)); fill: none; stroke: #0d0c22; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
#uc .st-bmc svg .cup { fill: #fff; }
#uc .st-bmc svg .rim { fill: #0d0c22; }

/* ---------- History window ---------- */
#uc .uc-dlg.hist-dlg { max-width: 760px; }
#uc .uc-dlg.hist-dlg .dlg-body { max-height: calc(100vh - 150px); }
#uc .hs { display: flex; flex-direction: column; gap: 10px; }
#uc .hs-intro { font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; }
#uc .hs-empty { padding: 18px 4px; text-align: center; }
#uc .hs-list { display: flex; flex-direction: column; gap: 8px; }
#uc .hs-step { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
#uc .hs-h { display: flex; align-items: center; gap: 8px; padding: 7px 10px; background: var(--surface-2); flex-wrap: wrap; }
#uc .hs-car { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; min-width: 0; margin: 0; padding: 0; border: 0; background: none; color: var(--muted); display: grid; place-items: center; cursor: pointer; border-radius: 4px; }
#uc .hs-car:hover { background: var(--accent-soft); color: var(--accent); }
#uc .hs-car svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
#uc .hs-car.on svg { transform: rotate(90deg); }
#uc .hs-tm { font: 600 calc(11.5px * var(--fs, 1))/1 var(--mono); color: var(--muted); white-space: nowrap; }
#uc .hs-lb { flex: 1 1 200px; min-width: 0; font-weight: 600; overflow-wrap: anywhere; }
#uc .hs-step.undone .hs-lb { text-decoration: line-through; color: var(--muted); font-weight: 500; }
#uc .hs-pill { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .05em; text-transform: uppercase; padding: 4px 6px; border-radius: 4px; background: var(--surface-3); color: var(--muted); white-space: nowrap; }
#uc .hs-pill.part { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
#uc .hs-pill.busy { background: var(--accent-soft); color: var(--accent); }
#uc .hs-pill.cant { background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); }
#uc .hs-all { font-weight: 600; }
#uc .hs-parts { border-top: 1px solid var(--line-soft); }
#uc .hs-p { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 10px; row-gap: 1px; align-items: start; padding: 6px 12px 6px 40px; border-bottom: 1px solid var(--line-soft); cursor: pointer; margin: 0; font-weight: 400; }
#uc .hs-p:last-of-type { border-bottom: 0; }
#uc .hs-p input { grid-row: span 3; margin: 2px 0 0; accent-color: var(--accent); }
#uc .hs-p input:disabled { opacity: .35; }
#uc .hs-p.done, #uc .hs-p.cant { cursor: default; }
#uc .hs-n { font: 600 calc(13px * var(--fs, 1))/1.35 var(--name-font); overflow-wrap: anywhere; }
#uc .hs-p.done .hs-n { text-decoration: line-through; color: var(--muted); }
#uc .hs-tx { font-size: calc(12px * var(--fs, 1)); color: var(--muted); overflow-wrap: anywhere; }
#uc .hs-tx b { font-weight: 600; color: var(--ink-2); }
#uc .hs-note { font-size: calc(12px * var(--fs, 1)); }
#uc .hs-ok { color: var(--ok); font-weight: 600; }
#uc .hs-busy { color: var(--accent); font-weight: 600; }
#uc .hs-why { color: var(--warn); }
#uc .hs-cant { color: var(--danger); }
#uc .hs-more { padding: 6px 12px 6px 40px; font-size: calc(12px * var(--fs, 1)); }
#uc .hs-f { display: flex; justify-content: flex-end; padding: 8px 10px; border-top: 1px solid var(--line-soft); background: var(--surface-2); }
#uc .hs-f .uc-btn:disabled, #uc .hs-all:disabled { opacity: .5; cursor: default; }

/* Wrap long lines (viewer and editor) */
#uc .wrap-pick { cursor: pointer; }
#uc .wrap-pick input { margin: 0; accent-color: var(--accent); }
#uc .vw.wrap .vw-l { min-width: 0; }
#uc .vw.wrap .vw-t { white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; flex: 1; }
#uc .ed-wrap.wrap textarea.ed { white-space: pre-wrap; overflow-wrap: anywhere; overflow-x: hidden; }
#uc .ed-wrap.wrap .ed-pre { white-space: pre-wrap; overflow-wrap: anywhere; }
/* scroll bars always visible in the viewer and editor (some themes and browser settings make them thin or hide them) */
#uc .vw, #uc textarea.ed { scrollbar-width: auto; scrollbar-color: color-mix(in srgb, var(--muted) 70%, transparent) transparent; }
#uc .vw::-webkit-scrollbar, #uc textarea.ed::-webkit-scrollbar { width: 12px; height: 12px; display: block; }
#uc .vw::-webkit-scrollbar-thumb, #uc textarea.ed::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--muted) 70%, transparent); border: 3px solid transparent; background-clip: padding-box; border-radius: 6px; }
#uc .vw::-webkit-scrollbar-track, #uc .vw::-webkit-scrollbar-corner, #uc textarea.ed::-webkit-scrollbar-track, #uc textarea.ed::-webkit-scrollbar-corner { background: transparent; }

/* ---------- right-click menu (a bottom sheet on touch screens) ----------
 * Buttons here are reset hard (!important): unRAID's own button style would
 * otherwise leak in (capitals, letter-spacing, gradients, margins). */
#uc .uc-ctx { position: fixed; z-index: 1000; min-width: 236px; max-width: min(330px, calc(100vw - 12px)); max-height: calc(100vh - 12px); overflow-y: auto; background: var(--menu-bg, var(--surface)); border: 1px solid var(--menu-line, var(--line)); border-radius: 8px; box-shadow: 0 1px 2px rgba(16,20,24,.06), 0 10px 30px rgba(16,20,24,.16); padding: 5px 0; font: 400 calc(13.5px * var(--fs, 1))/1.3 var(--sans); color: var(--ink); text-align: left; animation: uc-pop .12s ease-out; }
#uc.uc-dark .uc-ctx { box-shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.5); }
@keyframes uc-pop { from { transform: scale(.96); opacity: 0; } }
#uc .uc-ctx[hidden], #uc .uc-ctx-veil[hidden] { display: none; }
#uc .uc-ctx .ctx-h { display: flex; align-items: flex-start; gap: 6px; padding: 5px 12px 7px; margin-bottom: 4px; border-bottom: 1px solid var(--line-soft); font: 599 calc(12px * var(--fs, 1))/1.35 var(--sans); letter-spacing: .03em; color: var(--ink-2); }
#uc .uc-ctx .ctx-h .dot { flex: none; font-size: calc(8px * var(--fs, 1)); line-height: calc(14px * var(--fs, 1)); }
#uc .uc-ctx .ctx-h .t { flex: 1; min-width: 0; overflow-wrap: anywhere; }   /* the whole name, wrapped lines kept clear of the dot */
#uc .uc-ctx button { -webkit-appearance: none !important; appearance: none !important; display: flex !important; align-items: center; gap: 10px; width: 100% !important; min-width: 0 !important; height: auto !important; margin: 0 !important; padding: 7px 12px !important; border: 0 !important; border-radius: 0 !important; background: none !important; color: var(--ink) !important; font: 400 calc(13.5px * var(--fs, 1))/1.3 var(--sans) !important; text-align: left; text-transform: none !important; letter-spacing: normal !important; text-shadow: none !important; box-shadow: none !important; cursor: pointer; white-space: nowrap; }
#uc .uc-ctx button:hover:not(:disabled), #uc .uc-ctx button:focus-visible { background: var(--accent-soft) !important; outline: none; }
#uc .uc-ctx button:disabled { opacity: .45; cursor: default; }
#uc .uc-ctx button .ic { width: 18px; height: 16px; flex: none; display: grid; place-items: center; color: var(--muted); }
#uc .uc-ctx button .ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; display: block; }
#uc .uc-ctx button .lb { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-ctx button .lb small { display: block; margin-top: 1px; font: 400 calc(11.5px * var(--fs, 1))/1.25 var(--sans); color: var(--muted); overflow: hidden; text-overflow: ellipsis; }
#uc .uc-ctx button .sc { flex: none; margin-left: 14px; font: 500 calc(11px * var(--fs, 1))/1 var(--mono); color: var(--muted); }
#uc .uc-ctx button.hl { font-weight: 600 !important; }
#uc .uc-ctx button.hl .ic { color: var(--accent); }
#uc .uc-ctx button.danger, #uc .uc-ctx button.danger .ic { color: var(--danger) !important; }
#uc .uc-ctx button.locked { opacity: .5; }
#uc .uc-ctx hr { border: 0; border-top: 1px solid var(--line-soft); margin: 4px 0; height: 0; background: none; }
#uc .uc-ctx-veil { position: fixed; inset: 0; z-index: 999; background: rgba(10, 14, 18, .32); }
#uc .uc-ctx.sheet { left: 0 !important; right: 0; bottom: 0; top: auto !important; max-width: none; width: 100%; max-height: 72vh; border-radius: 14px 14px 0 0; padding: 6px 0 calc(8px + env(safe-area-inset-bottom, 0px)); animation: uc-sheet .18s ease-out; }
#uc .uc-ctx.sheet button { padding: 12px 18px !important; font-size: calc(15px * var(--fs, 1)) !important; }
#uc .uc-ctx.sheet button .ic svg { width: 18px; height: 18px; }
#uc .uc-ctx.sheet button .ic { width: 22px; height: 18px; }
#uc .uc-ctx.sheet .ctx-h { padding: 8px 18px 10px; justify-content: center; }
#uc .uc-ctx.sheet .ctx-h .t { flex: 0 1 auto; }
#uc .uc-ctx.sheet .ctx-cancel { justify-content: center; font-weight: 600 !important; color: var(--accent) !important; border-top: 1px solid var(--line-soft) !important; margin-top: 4px !important; }
@keyframes uc-sheet { from { transform: translateY(40%); opacity: .4; } }
@media (prefers-reduced-motion: reduce) { #uc .uc-ctx, #uc .uc-ctx.sheet { animation: none; } }
#uc .uc-list { -webkit-touch-callout: none; }
#uc.uc-touch .uc-trail { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }

/* ---------- clipboard: the pill at the top, and marks on the rows ---------- */
#uc .uc-clip { flex: none; display: inline-flex; align-items: stretch; border: 1px solid var(--accent); border-radius: 999px; overflow: hidden; background: var(--accent-soft); animation: uc-pop .25s ease-out; }
#uc .uc-clip[hidden] { display: none; }
#uc .uc-clip button { -webkit-appearance: none !important; appearance: none !important; display: inline-flex !important; align-items: center; gap: 6px; height: auto !important; min-width: 0 !important; margin: 0 !important; padding: 4px 11px !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; color: var(--ink) !important; font: 400 calc(13px * var(--fs, 1))/1.25 var(--sans) !important; text-transform: none !important; letter-spacing: normal !important; text-shadow: none !important; box-shadow: none !important; white-space: nowrap; cursor: pointer; }
#uc .uc-clip button + button { border-left: 1px solid color-mix(in srgb, var(--accent) 35%, transparent) !important; }
#uc .uc-clip-what svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
#uc .uc-clip-what b { font-weight: 700; }
#uc .uc-clip-what .m { margin-left: 2px; font: 600 calc(11.5px * var(--fs, 1))/1 var(--mono); color: var(--muted); }
#uc .uc-clip .uc-clip-go { background: var(--accent) !important; color: var(--accent-ink) !important; font-weight: 600 !important; }
#uc .uc-clip .uc-clip-go:hover { filter: brightness(1.07); }
#uc .uc-clip .uc-clip-x { color: var(--muted) !important; padding: 4px 9px !important; }
#uc .uc-clip .uc-clip-x:hover { color: #fff !important; }
#uc .clip-tag { flex: none; margin-left: 6px; font: 600 calc(9.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .03em; padding: 2px 4px; border-radius: 3px; background: var(--accent-soft); color: var(--accent); vertical-align: 1px; }
#uc .clip-tag.cut { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
#uc .uc-row.clip-cut .nm { color: var(--muted); }      /* the name fades; its ✂ cut tag stays readable */
#uc .uc-row.clip-cut .nm.dir { color: color-mix(in srgb, var(--accent) 55%, var(--surface)); }
#uc .clip-tag { display: inline-block; text-decoration: none; }  /* not struck through with a tagged name */

/* ---------- the top bar on narrower screens: drop the least-needed things first ---------- */
#uc .uc-appbar #uc-free { display: none; }                     /* free space now shows in each pane's header */
/* applied one step at a time, only while something still sticks out:
 * b1 array pill · b2 small cart pill · b3 Settings as an icon · b4 Go to · b5 logo, narrower Jump · b6 tighter */
#uc.uc-b1 .uc-appbar .uc-arrstop { display: none; }
#uc.uc-b2 .uc-clip .w, #uc.uc-b2 .uc-clip-what .m { display: none; }
#uc.uc-b3 .uc-appbar .uc-settings-btn .t { display: none; }
#uc.uc-b4 .uc-appbar .uc-goto { display: none; }
#uc.uc-b5 .uc-appbar .uc-clrwrap.j { flex: 0 1 150px; min-width: 90px; width: auto; }
#uc.uc-b5 .uc-appbar .uc-jump { flex: 1 1 auto; min-width: 0; width: 100%; }
#uc.uc-b5 .uc-appbar .uc-logo { display: none; }
#uc.uc-b6 .uc-appbar .uc-clrwrap.j { flex-basis: 110px; min-width: 70px; }
#uc.uc-b6 .uc-appbar { gap: 6px; }
#uc.uc-b7 .uc-appbar { flex-wrap: wrap; row-gap: 4px; }      /* phone width: a second row, last resort */
#uc .uc-pane-head .count { margin-left: auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-pane-head .hfree { flex: none; opacity: .75; white-space: nowrap; }
#uc .uc-pane-head .hfree:empty { display: none; }
#uc .uc-pane-head .hfree::before { content: '· '; }
#uc.uc-w4 .uc-pane-head .hfree { display: none; }

/* ---------- drag between panes ---------- */
#uc .uc-row[draggable="true"] { -webkit-user-drag: element; }
#uc .uc-list.drop-here { box-shadow: inset 0 0 0 2px var(--accent); background: color-mix(in srgb, var(--accent) 6%, transparent); }
#uc .uc-row.drop-on { background: color-mix(in srgb, var(--accent) 18%, transparent) !important; box-shadow: inset 0 0 0 2px var(--accent); }
#uc .uc-dragghost { position: fixed; top: -200px; left: 0; padding: 5px 10px; border-radius: 6px; background: var(--accent); color: var(--accent-ink); font: 600 calc(12.5px * var(--fs, 1)) var(--name-font); white-space: nowrap; }

/* ---------- the Paste window ---------- */
#uc .uc-dlg.paste-dlg { max-width: 680px; }
#uc .uc-dlg.paste-dlg .dlg-body { max-height: calc(100vh - 170px); }
#uc .pw-into { padding: 8px 10px; background: var(--accent-soft); border-radius: 6px; font-weight: 600; overflow-wrap: anywhere; }
#uc .pw-into small { display: block; font: 600 calc(10px * var(--fs, 1))/1.4 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#uc .pw { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
#uc .pw-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 7px 10px; background: var(--surface-2); border-bottom: 1px solid var(--line); font-weight: 600; }
#uc .pw-head .sp { flex: 1; }
#uc .pw-head .muted { font-weight: 400; }
#uc .pw-all input, #uc .pw-i input { margin: 0; accent-color: var(--accent); }
#uc .pw-clashn { color: var(--warn); font-weight: 600; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pw-list { max-height: 46vh; overflow-y: auto; }
#uc .pw-i { display: grid; grid-template-columns: 18px 62px minmax(0, 1fr) auto; gap: 2px 8px; align-items: start; padding: 7px 10px; border-top: 1px solid var(--line-soft); margin: 0; font-weight: 400; cursor: pointer; }
#uc .pw-i:first-child { border-top: 0; }
#uc .pw-i input { margin-top: 2px; }
#uc .pw-i.clash { background: color-mix(in srgb, var(--warn) 7%, var(--surface)); }
#uc .pw-i.off .pw-n, #uc .pw-i.off .pw-op { opacity: .45; }
#uc .pw-i.off .pw-n b { text-decoration: line-through; }
#uc .pw-op { font: 600 calc(11.5px * var(--fs, 1))/1.6 var(--mono); color: var(--accent); white-space: nowrap; }
#uc .pw-op.cut { color: var(--warn); }
#uc .pw-n { min-width: 0; display: flex; flex-direction: column; gap: 1px; }
#uc .pw-n b { font: 600 calc(13px * var(--fs, 1))/1.35 var(--name-font); overflow-wrap: anywhere; }
#uc .pw-from { font: calc(11.5px * var(--fs, 1))/1.35 var(--mono); color: var(--muted); overflow-wrap: anywhere; }
#uc .pw-why { font-size: calc(12px * var(--fs, 1)); color: var(--warn); }
#uc .pw-res { font-size: calc(12px * var(--fs, 1)); color: var(--ok); }
#uc .pw-res b { font-family: var(--name-font); }
#uc .pw-seg { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; flex: none; }
#uc .pw-seg button { -webkit-appearance: none; appearance: none; border: 0; margin: 0; min-width: 0; padding: 4px 9px; background: var(--surface); color: var(--ink-2); font: calc(12px * var(--fs, 1))/1.2 var(--sans); cursor: pointer; box-shadow: none; }
#uc .pw-seg button + button { border-left: 1px solid var(--line); }
#uc .pw-seg button.on { background: var(--accent); color: var(--accent-ink); font-weight: 600; }
#uc .pw-seg button:disabled { opacity: .45; cursor: default; }
#uc .pw-notes, #uc .pw-foot { font-size: calc(12.5px * var(--fs, 1)); }
@media (max-width: 560px) { #uc .pw-i { grid-template-columns: 18px minmax(0, 1fr); } #uc .pw-op { display: none; } #uc .pw-seg { grid-column: 2; justify-self: start; } }

/* ---------- Properties ---------- */
#uc .pr { display: flex; flex-direction: column; gap: 6px; }
#uc .pr-r { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 10px; align-items: baseline; }
#uc .pr-k { font: 600 calc(10.5px * var(--fs, 1))/1.4 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
#uc .pr-v { overflow-wrap: anywhere; }
/* unRAID's button style must not leak into these small buttons either */
#uc .pw-seg button, #uc .hs-car { height: auto !important; min-width: 0 !important; margin: 0 !important; text-transform: none !important; letter-spacing: normal !important; text-shadow: none !important; box-shadow: none !important; }
#uc .pw-seg button { padding: 4px 9px !important; border: 0 !important; border-radius: 0 !important; background: var(--surface) !important; color: var(--ink-2) !important; font: calc(12px * var(--fs, 1))/1.2 var(--sans) !important; }
#uc .pw-seg button + button { border-left: 1px solid var(--line) !important; }
#uc .pw-seg button.on { background: var(--accent) !important; color: var(--accent-ink) !important; font-weight: 600 !important; }
#uc .hs-car { padding: 0 !important; border: 0 !important; background: none !important; }
#uc .uc-clip .uc-clip-go { gap: 0 !important; }

/* ---------- the list (cart): opens from the 📋 pill ---------- */
#uc .uc-clip.bump { animation: uc-bump .35s ease-out; }
@keyframes uc-bump { 40% { transform: scale(1.06); } }
#uc .uc-cart { position: absolute; top: 44px; right: 10px; z-index: 60; width: min(460px, calc(100% - 20px)); max-height: min(70vh, calc(100% - 60px)); display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 1px 2px rgba(16,20,24,.06), 0 10px 30px rgba(16,20,24,.16); font: 400 calc(13px * var(--fs, 1))/1.3 var(--sans); color: var(--ink); animation: uc-pop .14s ease-out; }
#uc .uc-cart[hidden] { display: none; }
#uc .uc-cart .sp { flex: 1; }
#uc .kt-head { display: flex; align-items: center; gap: 8px; padding: 8px 10px 8px 12px; border-bottom: 1px solid var(--line-soft); }
#uc .kt-title { font-weight: 600; font-size: calc(13.5px * var(--fs, 1)); }
#uc .kt-close, #uc .kt-x { -webkit-appearance: none !important; appearance: none !important; border: 0 !important; background: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 2px 6px !important; border-radius: 4px !important; color: var(--muted) !important; font: 400 calc(13px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; text-transform: none !important; letter-spacing: normal !important; cursor: pointer; }
#uc .kt-close:hover, #uc .kt-x:hover { color: var(--danger) !important; background: var(--surface-2) !important; }
#uc .kt-body { overflow-y: auto; padding: 0 0 6px; min-height: 0; }
#uc .kt-cb { width: 15px; height: 15px; flex: none; border: 1.5px solid var(--line); border-radius: 3px; display: inline-grid; place-items: center; background: var(--surface); cursor: pointer; }
#uc .kt-cb.on, #uc .kt-cb.part { background: var(--accent); border-color: var(--accent); }
#uc .kt-cb.on::after { content: ""; width: 4px; height: 8px; border: solid var(--accent-ink); border-width: 0 2px 2px 0; transform: translateY(-1px) rotate(45deg); }
#uc .kt-cb.part::after { content: ""; width: 8px; height: 2px; background: var(--accent-ink); }
#uc .kt-cb.dis { opacity: .35; cursor: default; }
#uc .kt-cb:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
#uc .kt-car { -webkit-appearance: none !important; appearance: none !important; width: 16px !important; height: 16px !important; min-width: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; background: none !important; box-shadow: none !important; color: var(--muted) !important; display: grid !important; place-items: center; flex: none; cursor: pointer; }
#uc .kt-car svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
#uc .kt-car.on svg { transform: rotate(90deg); }
#uc .kt-nocar { width: 16px; flex: none; }
#uc .kt-f { display: flex; align-items: center; gap: 6px; padding: 6px 10px 6px calc(8px + var(--d) * 18px); background: var(--surface-2); border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line); font: 600 calc(12.5px * var(--fs, 1))/1.3 var(--name-font); color: var(--accent); }
#uc .kt-f:first-child { border-top: 0; }
#uc .kt-fn { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .kt-cnt { font: 500 calc(11px * var(--fs, 1))/1 var(--mono); color: var(--muted); }
#uc .kt-i { display: flex; align-items: center; gap: 8px; padding: 4px 8px 4px calc(8px + var(--d) * 18px); border-bottom: 1px solid var(--line-soft); }
#uc .kt-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .kt-n.dir { font: 700 calc(12.5px * var(--fs, 1))/1.3 var(--name-font); color: var(--accent); }
#uc .kt-n small { margin-left: 6px; font: 400 calc(11px * var(--fs, 1)) var(--sans); color: var(--warn); }
#uc .kt-i.off .kt-n { opacity: .45; }
#uc .kt-mode { display: inline-flex; flex: none; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; }
#uc .kt-mode button { -webkit-appearance: none !important; appearance: none !important; border: 0 !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 2px 8px !important; border-radius: 0 !important; background: var(--surface) !important; color: var(--muted) !important; font: 400 calc(11.5px * var(--fs, 1))/1.3 var(--sans) !important; box-shadow: none !important; text-transform: none !important; letter-spacing: normal !important; cursor: pointer; }
#uc .kt-mode button + button { border-left: 1px solid var(--line) !important; }
#uc .kt-mode button.on { background: var(--accent) !important; color: var(--accent-ink) !important; font-weight: 600 !important; }
#uc .kt-mode button.on.cut { background: var(--warn) !important; color: #fff !important; }
#uc .kt-mode button:disabled { opacity: .45; cursor: default; }
#uc .kt-s { display: flex; align-items: center; gap: 8px; padding: 3px 8px 3px calc(8px + var(--d) * 18px); font-size: calc(12.5px * var(--fs, 1)); border-bottom: 1px dashed var(--line-soft); background: color-mix(in srgb, var(--surface-2) 50%, var(--surface)); }
#uc .kt-s .kt-n.dir { font-size: calc(12px * var(--fs, 1)); font-weight: 600; }
#uc .kt-s.off .kt-n { opacity: .45; text-decoration: line-through; }
#uc .kt-s.kt-wait { color: var(--muted); font-style: italic; padding-left: calc(32px + var(--d) * 18px); }
#uc .kt-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; border-top: 1px solid var(--line-soft); }
#uc .kt-hint { flex: 1 1 100%; font-size: calc(12px * var(--fs, 1)); color: var(--muted); }
#uc .kt-foot .uc-btn:disabled { opacity: .5; cursor: default; }
#uc .st-adv { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; padding: 2px 5px; border-radius: 3px; background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); vertical-align: 1px; }
#uc .st-warn { display: inline-block; margin-top: 4px; font-size: calc(12.5px * var(--fs, 1)); color: var(--warn); }
#uc .st-ctxrow { display: flex; gap: 8px; align-items: flex-start; margin: 4px 0 10px; font-size: calc(13px * var(--fs, 1)); line-height: 1.45; }
#uc .st-ctxrow input { margin-top: 3px; accent-color: var(--accent); }

/* ---------- Tag for delete: the two-part pill and the two lists ---------- */
#uc .uc-clip [hidden] { display: none !important; }
#uc .uc-clip .uc-clip-what, #uc .uc-clip .uc-clip-del { padding: 3px 9px 3px 10px !important; gap: 6px !important; }
#uc .uc-clip .uc-clip-what:hover { background: color-mix(in srgb, var(--accent) 14%, transparent) !important; }
#uc .uc-clip .uc-clip-del { color: var(--danger) !important; font-weight: 600 !important; padding-left: 7px !important; }
#uc .uc-clip .uc-clip-del:hover { background: color-mix(in srgb, var(--danger) 10%, transparent) !important; }
#uc .uc-clip-dot { align-self: center; color: var(--muted); font-size: calc(14px * var(--fs, 1)); line-height: 1; }
#uc .uc-clip svg { flex: none; }
#uc .uc-clip .ci { width: 18px; height: 18px; }
#uc .uc-clip .ct { width: 19px; height: 19px; color: var(--danger); }
#uc .uc-clip .uc-clip-x svg { width: 13px; height: 13px; }
#uc .uc-clip .uc-clip-x { color: var(--ink-2) !important; }
#uc .bdg { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px; background: var(--accent); color: var(--accent-ink); font: 700 calc(11.5px * var(--fs, 1))/1 var(--sans); box-sizing: border-box; }
#uc .bdg.red { background: var(--danger); color: #fff; }
#uc .uc-clip .cmp { display: none; align-items: center; gap: 3px; font: 700 calc(13.5px * var(--fs, 1))/1 var(--sans); }
#uc .uc-clip .cmp svg { width: 18px; height: 18px; }
#uc .uc-clip .cmp.c-k { color: var(--warn); }
/* narrow screens: ⧉3  ✂1   🗑2 | Paste | ✕ */
#uc.uc-b2 .uc-clip .ci, #uc.uc-b2 .uc-clip .bdg, #uc.uc-b2 .uc-clip-dot { display: none !important; }
#uc.uc-b2 .uc-clip .cmp:not([hidden]) { display: inline-flex; }
#uc.uc-b2 .uc-clip .uc-clip-what { gap: 9px !important; padding: 3px 8px !important; }
#uc.uc-b2 .uc-clip .uc-clip-del { padding: 3px 9px 3px 4px !important; gap: 3px !important; }
#uc .uc-row.clip-del .nm { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--danger) 70%, transparent); }
#uc .clip-tag.del { background: color-mix(in srgb, var(--danger) 13%, transparent); color: var(--danger); }
#uc .kt-tabs { display: flex; gap: 5px; flex: 1; min-width: 0; flex-wrap: wrap; }
#uc .kt-tab { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; text-transform: none !important; letter-spacing: normal !important; display: inline-flex !important; align-items: center; gap: 6px; white-space: nowrap; border: 1px solid var(--line) !important; background: var(--surface) !important; border-radius: 999px !important; padding: 3px 9px 3px 7px !important; color: var(--ink-2) !important; font: 400 calc(12.5px * var(--fs, 1))/1.2 var(--sans) !important; cursor: pointer; }
#uc .kt-tab svg { width: 15px; height: 15px; }
#uc .kt-tab .bdg { min-width: 18px; height: 18px; font-size: calc(11px * var(--fs, 1)); }
#uc .kt-tab.on { border-color: var(--accent) !important; background: var(--accent-soft) !important; color: var(--ink) !important; font-weight: 600 !important; }
#uc .kt-tab.d { color: var(--danger) !important; }
#uc .kt-tab.d.on { border-color: var(--danger) !important; background: color-mix(in srgb, var(--danger) 9%, var(--surface)) !important; }
#uc .uc-cart.del { border-color: color-mix(in srgb, var(--danger) 55%, var(--line)); }
#uc .uc-cart.del .kt-head { background: color-mix(in srgb, var(--danger) 7%, var(--surface)); border-bottom-color: color-mix(in srgb, var(--danger) 25%, var(--line)); border-radius: 8px 8px 0 0; }
#uc .uc-cart.del .kt-n { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--danger) 60%, transparent); }
#uc .uc-cart.del .kt-i.off .kt-n { text-decoration: none; }
#uc .uc-cart.del .kt-cb.on, #uc .uc-cart.del .kt-cb.part { background: var(--danger); border-color: var(--danger); }
#uc .uc-cart.del .kt-cb.on::after { border-color: #fff; }
#uc .uc-cart.del .kt-cb.part::after { background: #fff; }
#uc .kt-ib { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; display: inline-grid !important; place-items: center; flex: none; padding: 2px 6px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--muted) !important; cursor: pointer; }
#uc .kt-ib svg { width: 15px; height: 15px; }
#uc .kt-ib.kt-tag:hover { color: var(--danger) !important; border-color: var(--danger) !important; }
#uc .kt-ib.kt-back:hover { color: var(--accent) !important; border-color: var(--accent) !important; }
#uc .kt-ib:disabled { opacity: .4; cursor: default; }

/* ---------- folder tree: the caret between the checkbox and the name ---------- */
#uc .tcar { display: inline-grid; place-items: center; width: 16px; height: 16px; margin-right: 3px; flex: none; vertical-align: -3px; color: var(--muted); border-radius: 3px; cursor: pointer; }
#uc .tcar.none { cursor: default; }
#uc .tcar svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
#uc .tcar.on svg { transform: rotate(90deg); }
#uc .tcar:not(.none):hover { color: var(--accent); background: var(--accent-soft); }

/* ---------- list panel and pill: your adjustments (beta 7) ---------- */
#uc .uc-cart { width: min(660px, calc(100% - 20px)); font: 400 calc(12px * var(--fs, 1))/1.3 var(--sans); }
#uc .uc-cart.del { border: 4px solid var(--danger); }
#uc .uc-cart.del .kt-head { background: color-mix(in srgb, var(--danger) 17%, var(--surface)); border-radius: 4px 4px 0 0; }
#uc .kt-i { padding: 1px 8px 1px calc(8px + var(--d) * 18px); }
#uc .kt-foot { border-top: none; }
#uc .uc-clip { border: 1px solid #cfcfcf; }
#uc.uc-dark .uc-clip { border-color: #4a525a; }
#uc .uc-row.clip-del .nm { color: var(--danger) !important; }
#uc .uc-clip .uc-clip-x { padding-left: 6px !important; }
#uc .uc-clip button { background: none !important; }
#uc .st-empty-row { margin: 10px 0 4px; } #uc .st-empty-row .muted { flex: 1 1 260px; }

/* ---------- picture editor ---------- */
#uc .ie { display: flex; flex-direction: column; gap: 8px; }
#uc .ie-tools { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: calc(13px * var(--fs, 1)); }
#uc .ie-grp { display: inline-flex; align-items: center; gap: 5px; }
#uc .ie-grp .uc-btn { padding: 4px 9px; }
#uc .ie-l { font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
#uc .ie-tools select, #uc .ie-tools input[type=number] { font: calc(13px * var(--fs, 1)) var(--sans); padding: 3px 6px; border: 1px solid var(--line); border-radius: var(--r-input); background: var(--surface); color: var(--ink); height: auto; }
#uc .ie-tools input[type=number] { width: 78px; }
#uc .ie-qw { display: inline-flex; align-items: center; gap: 5px; margin-left: 6px; }
#uc .ie-qw[hidden] { display: none; }
#uc .ie-q { width: 90px; accent-color: var(--accent); }
#uc .ie-qv { font: 600 calc(12px * var(--fs, 1)) var(--mono); min-width: 2.2em; }
#uc .uc-dlg.ie-dlg .dlg-body { max-height: calc(100vh - 130px); }
#uc .ie-stage { height: clamp(220px, calc(100vh - 340px), 70vh); display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: var(--r); border: 1px solid var(--line);
  background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 18px 18px; }
#uc .ie-stage.loading::after { content: "Opening…"; color: var(--muted); }
#uc .ie-wrap { position: relative; display: inline-block; max-width: 100%; max-height: 100%; line-height: 0; overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none; }
#uc .ie-cv { display: block; max-width: 100%; max-height: clamp(220px, calc(100vh - 342px), 70vh); width: auto; height: auto; }
#uc .ie-crop { position: absolute; box-shadow: 0 0 0 9999px rgba(0,0,0,.5), inset 0 0 0 1px rgba(0,0,0,.55); outline: 2px solid #fff; cursor: move; }
#uc .ie-crop i { filter: drop-shadow(0 0 1px rgba(0,0,0,.9)); }
#uc .ie-crop::before, #uc .ie-crop::after { content: ""; position: absolute; inset: 33.33% 0; border-top: 1px solid rgba(255,255,255,.5); border-bottom: 1px solid rgba(255,255,255,.5); pointer-events: none; }
#uc .ie-crop::after { inset: 0 33.33%; border: 0; border-left: 1px solid rgba(255,255,255,.5); border-right: 1px solid rgba(255,255,255,.5); }
#uc .ie-crop[hidden] { display: none; }
#uc .ie-crop i { position: absolute; width: 22px; height: 22px; border: 3px solid #fff; z-index: 1; }
#uc .ie-crop i[data-c="nw"] { left: 0; top: 0; border-width: 4px 0 0 4px; cursor: nwse-resize; }
#uc .ie-crop i[data-c="ne"] { right: 0; top: 0; border-width: 4px 4px 0 0; cursor: nesw-resize; }
#uc .ie-crop i[data-c="sw"] { left: 0; bottom: 0; border-width: 0 0 4px 4px; cursor: nesw-resize; }
#uc .ie-crop i[data-c="se"] { right: 0; bottom: 0; border-width: 0 4px 4px 0; cursor: nwse-resize; }
@media (pointer: coarse) { #uc .ie-crop i { width: 30px; height: 30px; } }
#uc .ie-bottom { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; justify-content: space-between; font-size: calc(12.5px * var(--fs, 1)); }
#uc .ie-namef { display: inline-flex; align-items: center; gap: 8px; flex: 0 1 380px; }
#uc .ie-nm { flex: 1; min-width: 0; font: calc(13px * var(--fs, 1)) var(--mono); padding: 4px 8px; border: 1px solid var(--line); border-radius: var(--r-input); background: var(--surface); color: var(--ink); }
#uc .clip-tag { font: 600 calc(10px * var(--fs, 1))/1 var(--mono); }

/* ---------- Gallery view ---------- */
#uc .uc-galbtn, #uc .uc-galsz button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; display: inline-grid !important; place-items: center; padding: 2px 5px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--muted) !important; cursor: pointer; font: 600 calc(10.5px * var(--fs, 1))/1.2 var(--mono) !important; }
#uc .uc-galbtn { margin-left: 8px !important; }
#uc .uc-galbtn[hidden], #uc .uc-galsz[hidden] { display: none !important; }
#uc .uc-galbtn svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; }
#uc .uc-galbtn:hover, #uc .uc-galsz button:hover { color: var(--accent) !important; border-color: var(--accent) !important; }
#uc .uc-galbtn.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
#uc .uc-galsz { display: inline-flex; gap: 2px; margin-left: 8px; }
#uc .uc-pane.gal .uc-cols { display: none; }
#uc .uc-pane.gal .uc-spacer-v { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--tile, 160px), 1fr)); gap: 8px; padding: 8px; height: auto !important; align-content: start; }
#uc .uc-pane.gal .uc-list .uc-row.uc-tile { position: relative; top: auto; left: auto; right: auto; height: auto; display: flex; flex-direction: column; padding: 0; border: 1px solid var(--line-soft); border-radius: 6px; overflow: hidden; background: var(--surface); grid-template-columns: none; }
#uc .uc-tile .tl-pic { position: relative; aspect-ratio: 1 / 1; display: grid; place-items: center; background: var(--surface-2); overflow: hidden; }
#uc .uc-tile .tl-pic img { width: 100%; height: 100%; object-fit: contain; display: block; -webkit-user-drag: none; user-select: none; }
#uc .uc-tile .tl-pic { width: 100%; }
#uc .uc-tile .tl-ic { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); }
#uc .uc-tile .tl-ic svg { width: calc(var(--tile, 160px) * .38) !important; height: calc(var(--tile, 160px) * .38) !important; }
#uc .uc-tile .tl-ic svg, #uc .gp-ic svg { width: 42%; height: 42%; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-tile .tl-ic.dir, #uc .uc-tile .tl-ic.up { color: var(--accent); }
#uc .uc-tile .tl-ext { position: absolute; bottom: 6px; right: 6px; font: 700 calc(9.5px * var(--fs, 1))/1 var(--mono); text-transform: uppercase; padding: 2px 4px; border-radius: 3px; background: var(--surface); color: var(--muted); border: 1px solid var(--line-soft); }
#uc .uc-tile .nm { padding: 4px 6px; font-size: calc(12px * var(--fs, 1)); line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center; }
#uc .uc-tile .nm.dir { color: var(--accent); font-weight: 600; }
#uc .uc-tile .col-sel { position: absolute; top: 5px; left: 10px; border: 4px solid transparent; z-index: 2; width: auto; padding: 3px; border-radius: 4px; background: color-mix(in srgb, var(--surface) 80%, transparent); }
#uc .uc-tile .clip-tag { position: absolute; top: 6px; right: 6px; margin: 0; z-index: 2; }
#uc .uc-pane.gal .uc-list .uc-row.uc-tile.cursor { outline: 2px solid var(--accent); outline-offset: -2px; }
#uc .uc-pane.gal .uc-list .uc-row.uc-tile.sel { background: var(--accent-soft); border-color: var(--accent); }
#uc .uc-tile.drop-on { outline: 2px dashed var(--accent); }
#uc .uc-box { position: relative; }
#uc .uc-gprev { position: absolute; inset: 0; z-index: 6; display: flex; flex-direction: column; background: var(--surface); }
#uc .gp-head { display: flex; align-items: center; gap: 10px; padding: 5px 8px 5px 12px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
#uc .gp-t { font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#uc .gp-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 calc(13px * var(--fs, 1)) var(--name-font); }
#uc .gp-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; overflow: hidden; padding: 8px;
  background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 18px 18px; }
#uc .gp-body img, #uc .gp-body video { max-width: 100%; max-height: 100%; object-fit: contain; min-height: 0; }
#uc .gp-body audio { width: min(420px, 100%); }
#uc .gp-ic { display: grid; place-items: center; width: 160px; height: 160px; color: var(--muted); }
#uc .gp-msg { max-width: 420px; text-align: center; color: var(--muted); font-size: calc(12.5px * var(--fs, 1)); }
#uc .gp-text { align-self: stretch; flex: 1; margin: 0; padding: 10px 12px; overflow: auto; white-space: pre-wrap; word-break: break-word; font: calc(12px * var(--fs, 1))/1.45 var(--mono); background: var(--surface); border: 1px solid var(--line-soft); border-radius: 6px; text-align: left; }
#uc .gp-foot { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-top: 1px solid var(--line); font-size: calc(12px * var(--fs, 1)); }
#uc .gp-info { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .gp-btns { display: inline-flex; gap: 6px; }
#uc .gp-btns .uc-btn, #uc .gp-x { padding: 3px 9px; }

/* a name on the Copy/Cut/Delete list sits in a pill of the same colour as its tag (row height unchanged) */
#uc .nm-t { padding: 1px 6px; margin-left: -6px; border-radius: 4px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
#uc .nm-t.copy { background: var(--accent-soft); color: var(--accent); }
#uc .nm-t.cut { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
#uc .nm-t.del { background: color-mix(in srgb, var(--danger) 13%, transparent); color: var(--danger); }
#uc .uc-tile .nm-t { margin-left: 0; }

/* ---------- video & music player ---------- */
#uc .vp-host { display: flex; height: clamp(240px, calc(100vh - 230px), 80vh); }
#uc .vp { flex: 1; display: flex; flex-direction: column; min-height: 0; width: 100%; height: 100%; background: #000; border-radius: 6px; overflow: hidden; }
#uc .gp-body .vp { align-self: stretch; }
#uc .vp.aud { background: var(--surface-2); }
#uc .vp-stage { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
#uc .vp-v { max-width: 100%; max-height: 100%; width: 100%; height: 100%; object-fit: contain; background: #000; }
#uc .vp.aud .vp-v { display: none; }
#uc .vp-msg { position: absolute; inset: auto 16px 16px 16px; padding: 10px 12px; border-radius: 6px; background: rgba(0,0,0,.78); color: #fff; font-size: calc(13px * var(--fs, 1)); text-align: center; }
#uc .vp-msg[hidden] { display: none; }
#uc .vp-bar { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: #15181b; color: #e8ecef; font: calc(12px * var(--fs, 1)) var(--mono); }
#uc .vp-bar.off { opacity: .45; pointer-events: none; }
#uc .vp-b { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 30px !important; height: 26px !important; padding: 0 6px !important; border: 1px solid #3a4148 !important; border-radius: 5px !important; background: #23282d !important; color: #e8ecef !important; font: 600 13px/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; }
#uc .vp-b:hover { border-color: var(--accent) !important; }
#uc .vp-seek { flex: 1; min-width: 60px; accent-color: var(--accent); }
#uc .vp-aud { max-width: 210px; font: calc(12px * var(--fs, 1)) var(--sans); background: #23282d; color: #e8ecef; border: 1px solid #3a4148; border-radius: 5px; padding: 2px 4px; }
#uc .vp-aud[hidden] { display: none; }
#uc .vp-mode { color: #9aa4ad; font-size: calc(11px * var(--fs, 1)); white-space: nowrap; }
#uc .vp:fullscreen { border-radius: 0; }
#uc .st-ff { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line-soft); display: grid; gap: 6px; font-size: calc(13px * var(--fs, 1)); }
#uc .vp-sub { max-width: 210px; font: calc(12px * var(--fs, 1)) var(--sans); background: #23282d; color: #e8ecef; border: 1px solid #3a4148; border-radius: 5px; padding: 2px 4px; }
#uc .vp-sub[hidden], #uc .vp-sync[hidden] { display: none; }
#uc .vp-sync { display: inline-flex; align-items: center; gap: 4px; }
#uc .vp-sync .vp-b { min-width: 24px !important; height: 22px !important; }
#uc .vp-sv { color: #9aa4ad; font-size: calc(11px * var(--fs, 1)); min-width: 7.5em; text-align: center; }
#uc .vp-v::cue { background: rgba(0,0,0,.7); color: #fff; font-family: var(--sans); }
#uc .st-ff-more { display: grid; gap: 6px; margin-top: 4px; }
#uc .st-ff-more[hidden] { display: none; }
#uc .st-vc .uc-btn { padding: 1px 8px; margin-left: 6px; }
#uc .st-ff { display: grid; gap: 8px; font-size: calc(13px * var(--fs, 1)); margin-top: 0; padding-top: 0; border-top: 0; }
#uc .st-ff-more { padding-left: 26px; border-left: 2px solid var(--line-soft); margin-left: 18px; }
#uc .st-ffdl { padding-left: 38px; display: grid; gap: 6px; }
#uc .st-ffdl[hidden] { display: none; }
#uc .st-sub { margin-top: 4px; }
#uc .st-ffrm { margin-top: 6px; }
#uc .vp-sv { -webkit-appearance: none !important; appearance: none !important; border: 0 !important; background: none !important; box-shadow: none !important; margin: 0 !important; padding: 0 4px !important; height: auto !important; color: #9aa4ad !important; font: calc(11px * var(--fs, 1)) var(--mono) !important; min-width: 8.5em; text-align: center; cursor: pointer; }
#uc .uc-ctx:not(.sheet) { max-height: none; }
/* the pill: no background on its buttons (Paste keeps its colour) */
#uc .uc-clip .uc-clip-what, #uc .uc-clip .uc-clip-del, #uc .uc-clip .uc-clip-x, #uc .uc-clip .uc-clip-what:hover, #uc .uc-clip .uc-clip-del:hover, #uc .uc-clip .uc-clip-x:hover { background: none !important; }
#uc .uc-clip .uc-clip-what:hover, #uc .uc-clip .uc-clip-del:hover { text-decoration: underline; text-underline-offset: 3px; }

/* ---------- your tweaks (beta 17) ---------- */
#uc .uc-clip { background: none; }
#uc .uc-clip .uc-clip-x:hover { color: var(--danger) !important; }
#uc .st-panel { padding: 4px 14px 14px; }
#uc .st-h { margin: -4px -14px 2px; }

/* ---------- Settings > Colours ---------- */
#uc .pal-top { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
#uc .pal-l { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
#uc .pal-base { font: calc(13px * var(--fs, 1)) var(--sans); padding: 4px 6px; border: 1px solid var(--line); border-radius: var(--r-input); background: var(--surface); color: var(--ink); max-width: 100%; }
#uc .pal-modes { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
#uc .pal-modes button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; border: 0 !important; border-radius: 0 !important; height: auto !important; min-width: 0 !important; box-shadow: none !important; padding: 4px 12px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: calc(12.5px * var(--fs, 1)) var(--sans) !important; cursor: pointer; }
#uc .pal-modes button + button { border-left: 1px solid var(--line) !important; }
#uc .pal-modes button.on { background: var(--accent) !important; color: var(--accent-ink) !important; font-weight: 600 !important; }
#uc .pal-now { font-size: calc(12px * var(--fs, 1)); }
#uc .pal-body { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(220px, 1fr); gap: 16px; align-items: start; }
@media (max-width: 760px) { #uc .pal-body { grid-template-columns: 1fr; } }
#uc .pal-grid { display: grid; gap: 4px; }
#uc .pal-r { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 3px 0; font-size: calc(13px * var(--fs, 1)); line-height: 1.3; }
#uc .pal-r input[type=color] { width: 34px; height: 26px; padding: 0; border: 1px solid var(--line); border-radius: 6px; background: none; cursor: pointer; }
#uc .pal-r .pal-hex { width: 84px !important; min-width: 0 !important; max-width: 84px !important; margin: 0 !important; height: 26px; box-sizing: border-box; padding: 0 6px; font: calc(12px * var(--fs, 1)) var(--mono); color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-input); }
#uc .pal-r .pal-hex:focus { border-color: var(--accent); outline: none; }
#uc .pal-r .pal-hex.bad { border-color: var(--danger); color: var(--danger); }
#uc .pal-prev { border: 2px solid var(--accent); border-left-width: 4px; border-radius: 6px; overflow: hidden; background: var(--surface); font-size: calc(12.5px * var(--fs, 1)); }
#uc .pp-head { display: flex; justify-content: space-between; padding: 6px 10px; background: var(--accent); font: 600 calc(10.5px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; }
#uc .pp-side { color: var(--accent-ink); } #uc .pp-count { color: var(--sel-count-head, #ffe65e); }
#uc .pp-row { display: flex; align-items: center; gap: 8px; padding: 0 10px; height: var(--rowpx, 23px); border-bottom: 1px solid var(--line-soft); }
#uc .pp-row.cur { background: var(--cursor); }
#uc .pp-row.sel { background: var(--accent-soft); }
#uc .pp-box { width: 13px; height: 13px; border: 1.5px solid var(--line); border-radius: 3px; flex: none; }
#uc .pp-box.on { background: var(--accent); border-color: var(--accent); }
#uc .pp-dir { color: var(--accent); font-weight: 700; font-family: var(--name-font); }
#uc .pp-row .nm-t { margin-left: 0; }
#uc .pp-foot { display: flex; gap: 8px; align-items: center; padding: 8px 10px; }
#uc .pp-btn { background: var(--accent); color: var(--accent-ink); border-radius: 5px; padding: 3px 10px; font-weight: 600; }
#uc .pp-ok { color: var(--ok); border: 1px solid currentColor; border-radius: 999px; padding: 1px 8px; font-size: calc(11px * var(--fs, 1)); }
#uc .pp-del { color: var(--danger); border: 1px solid var(--danger); border-radius: 5px; padding: 2px 9px; margin-left: auto; }
#uc .pal-save .pal-name { flex: 1 1 200px; width: auto; }

/* ---------- own tab ---------- */
#uc.uc-solo { margin: 0; border: 0; border-radius: 0; box-shadow: none; }
#uc .st-solo { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 10px 0 6px; }
#uc .st-solo .st-solo-b { display: inline-flex; align-items: center; padding: 9px 16px; font-size: calc(14px * var(--fs, 1)); font-weight: 600; text-decoration: none; }
#uc .st-solo .muted { flex: 1 1 260px; }

/* ---------- your tweaks (beta 19) ---------- */
#uc .st-panel:not([hidden]) ~ .st-panel:not([hidden]) { margin-top: 1px; }
#uc .uc-ctx { border: 1px solid #b7b7b7; border-top: 6px solid #7e7e7e; padding: 0; box-shadow: 0 1px 2px rgba(16,20,24,.36), 0 10px 30px rgba(16,20,24,.36); }
#uc .uc-ctx .ctx-h { background-color: var(--cursor); border-bottom: 1px solid #c5c5c5; }
#uc .uc-ctx .ctx-h .t { color: var(--cursor-ink, inherit); }   /* the name on the menu's header bar: the cursor bar's text colour */
#uc.uc-dark .uc-ctx { border-color: #4a525a; border-top-color: #8a949d; box-shadow: 0 1px 2px rgba(0,0,0,.5), 0 10px 30px rgba(0,0,0,.55); }
#uc.uc-dark .uc-ctx .ctx-h { border-bottom-color: #3a4148; }
#uc .tv-legend .tv-skipall { margin-left: auto; }
#uc .tv-legend:has(.tv-skipall) { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }

/* TV details: ended or continuing, prominent */
#uc .tv-life { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin: 4px 0 8px; }
#uc .tv-life-b { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font: 700 calc(13px * var(--fs, 1))/1.2 var(--sans); letter-spacing: .02em; text-transform: uppercase; }
#uc .tv-life.ended .tv-life-b { background: color-mix(in srgb, var(--ink-2) 14%, transparent); color: var(--ink-2); }
#uc .tv-life.running .tv-life-b { background: color-mix(in srgb, var(--ok) 16%, transparent); color: var(--ok); }
#uc .tv-life.tbd .tv-life-b { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
#uc .tv-life-m { font-size: calc(12.5px * var(--fs, 1)); color: var(--muted); }
#uc .tv-season { padding-bottom: 5px; border-bottom: 1px solid #d0d0d0; }
#uc.uc-dark .tv-season { border-bottom-color: var(--line); }
#uc .ie-ang { width: 140px; accent-color: var(--accent); }
#uc .ie-angv { font: 600 calc(12px * var(--fs, 1)) var(--mono); min-width: 3.4em; }
#uc .ie-ang0[hidden] { display: none; }
#uc .ie-wrap:has(.ie-ang:active) { outline: none; }
/* a grid to line things up against while straightening */
#uc .ie-wrap.grid::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image: linear-gradient(rgba(255,255,255,.55) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.55) 1px, transparent 1px);
  background-size: 100% 12.5%, 12.5% 100%; mix-blend-mode: difference; }
/* music: cover and tags */
#uc .vp.aud .vp-stage { padding: 16px; }
#uc .vp-art { display: flex; flex-direction: column; align-items: center; gap: 12px; max-height: 100%; min-height: 0; text-align: center; }
#uc .vp-cover { max-width: min(360px, 100%); max-height: calc(100% - 70px); min-height: 0; object-fit: contain; border-radius: 6px; box-shadow: 0 6px 24px rgba(0,0,0,.25); }
#uc .vp-tags { font-size: calc(13.5px * var(--fs, 1)); line-height: 1.45; color: var(--ink); }
#uc .vp-tags b { font-size: calc(15px * var(--fs, 1)); }

/* music window: small, with the folder's track list */
#uc .uc-dlg.music { max-width: min(560px, calc(100vw - 24px)); }
#uc .mp .vp-host { height: auto; }
#uc .mp .vp { width: 100%; }
#uc .mp .vp-stage { padding: 14px 16px; justify-content: flex-start; }
#uc .mp .vp-art { flex-direction: row; align-items: center; gap: 14px; text-align: left; width: 100%; }
#uc .mp .vp-art .gp-ic, #uc .mp .vp-cover { flex: none; width: 112px; height: 112px; max-width: none; max-height: none; object-fit: cover; display: flex; align-items: center; justify-content: center; }
#uc .mp .vp-art .gp-ic svg { width: 56px; height: 56px; }
#uc .mp .vp-tags { min-width: 0; overflow-wrap: anywhere; }
#uc .mp .vp-bar { border-radius: 0 0 6px 6px; }
#uc .mp-head { display: flex; justify-content: space-between; padding: 10px 2px 4px; color: var(--muted, #8a939b); font-size: calc(11.5px * var(--fs, 1)); }
#uc .mp-list { list-style: none; margin: 0; padding: 0; max-height: min(42vh, 360px); overflow-y: auto; border: 1px solid var(--line, #d8dde2); border-radius: 6px; }
#uc .mp-list li { display: flex; gap: 10px; align-items: baseline; padding: 6px 10px; cursor: pointer; border-bottom: 1px solid var(--line-soft); font-size: calc(13px * var(--fs, 1)); }
#uc .mp-list li:last-child { border-bottom: 0; }
#uc .mp-list li:hover { background: var(--hover, rgba(0,0,0,.04)); }
#uc .mp-list li.on { background: var(--cursor, #d7ebf5); font-weight: 600; }
#uc .mp-n { flex: none; min-width: 2.2em; text-align: right; color: var(--muted, #8a939b); font: calc(11.5px * var(--fs, 1)) var(--mono); }
#uc .mp-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- Music library ----------
 * The two panes keep fixed widths in the library; change them here (or in
 * Settings > Custom CSS): --mus-left is the artists pane. */
#uc { --mus-left: 34%; --mus-cover: 112px; }
@media (min-width: 701px) {
  #uc.uc-mus .uc-panes { grid-template-columns: minmax(0, var(--mus-left)) minmax(0, 1fr); }
  #uc.uc-mus .uc-crumbs { grid-template-columns: minmax(0, calc(var(--mus-left) - 44px)) auto minmax(0, 1fr); }
}
#uc .uc-musbtn { -webkit-appearance: none !important; appearance: none !important; margin: 0 0 0 8px !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; display: inline-grid !important; place-items: center; padding: 2px 5px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--muted) !important; cursor: pointer; }
#uc .uc-musbtn[hidden], #uc .uc-endmus[hidden] { display: none !important; }
#uc .uc-musbtn svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-musbtn:hover { color: var(--accent) !important; border-color: var(--accent) !important; }
#uc .uc-musbtn.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
#uc .uc-endmus { -webkit-appearance: none !important; appearance: none !important; margin: 0 0 0 8px !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; padding: 3px 9px !important; border: 1px solid var(--line) !important; border-radius: var(--r-btn) !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(12px * var(--fs, 1))/1.2 var(--sans) !important; letter-spacing: 0; text-transform: none; cursor: pointer; white-space: nowrap; }
#uc .uc-endmus:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
/* album covers on the right */
#uc .uc-tile .tl-pic img.tl-cover { object-fit: cover; }
#uc .tl-play { position: absolute; right: 8px; bottom: 8px; z-index: 2; -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; padding: 0 !important; min-width: 0 !important; width: 38px !important; height: 38px !important; border: 0 !important; border-radius: 50% !important; background: var(--accent) !important; color: var(--accent-ink) !important; display: grid !important; place-items: center; box-shadow: 0 2px 8px rgba(0,0,0,.35) !important; opacity: .92; cursor: pointer; transition: transform .12s, opacity .12s; }
#uc .tl-play:hover { opacity: 1; transform: scale(1.08); }
#uc .tl-play svg { width: 15px; height: 15px; fill: currentColor; stroke: none; margin-left: 2px; }
/* an album: the strip above its files */
#uc .mus-strip { flex: none; display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
#uc .mus-strip .ms-cover { width: var(--mus-cover); height: var(--mus-cover); flex: none; border-radius: 4px; object-fit: cover; background: var(--surface-3); box-shadow: 0 1px 4px rgba(0,0,0,.15); }
#uc .mus-strip .ms-ic { display: grid; place-items: center; color: var(--muted); box-shadow: none; }
#uc .mus-strip .ms-ic svg { width: 50%; height: 50%; fill: none; stroke: currentColor; stroke-width: 1.4; }
#uc .ms-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
#uc .ms-t { font-weight: 700; font-size: calc(18px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .ms-s { font-size: calc(14px * var(--fs, 1)); color: var(--ink-2); }
#uc .ms-f { font: calc(12px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .uc-row.mus-now .nm { color: var(--accent) !important; font-weight: 700; }
#uc .uc-row.mus-now .nm::before { content: '▶'; font-size: .8em; margin-right: 6px; }
/* the player under the right pane */
#uc .mus-player { flex: none; border-top: 1px solid var(--line); }
#uc .mus-player .vp { display: flex; flex-direction: row; align-items: stretch; height: auto; background: #15181b; border-radius: 0; }
#uc .mus-player .vp-stage { flex: 0 1 280px; min-width: 0; padding: 5px 10px !important; justify-content: flex-start; }
#uc .mus-player .vp-art { flex-direction: row; align-items: center; gap: 10px; text-align: left; min-width: 0; width: 100%; }
#uc .mus-player .vp-art .gp-ic, #uc .mus-player .vp-cover { flex: none; width: 36px; height: 36px; max-width: none; max-height: none; object-fit: cover; border-radius: 3px; box-shadow: none; color: #9aa4ad; }
#uc .mus-player .vp-art .gp-ic svg { width: 22px; height: 22px; }
#uc .mus-player .vp-tags { min-width: 0; color: #e8ecef; font-size: calc(11.5px * var(--fs, 1)); line-height: 1.3; max-height: 2.6em; overflow: hidden; white-space: nowrap; }
#uc .mus-player .vp-tags b { font-size: calc(12.5px * var(--fs, 1)); }
#uc .mus-player .vp-bar { flex: 1; min-width: 0; }
#uc .mus-player .vp-msg { inset: 2px 6px; padding: 4px 8px; font-size: calc(11.5px * var(--fs, 1)); }

/* the menu by the finger on a tablet: roomier rows, tap anywhere outside to close */
#uc .uc-ctx.touch { min-width: 260px; max-width: min(340px, calc(100vw - 12px)); }
#uc .uc-ctx.touch button { padding: 10px 14px !important; font-size: calc(14.5px * var(--fs, 1)) !important; }
#uc .uc-ctx.touch button .ic { width: 20px; height: 18px; }
#uc .uc-ctx.touch button .ic svg { width: 17px; height: 17px; }
#uc .uc-ctx-veil.clear { background: transparent; }

/* iPad: press-and-hold must not select the page's text (Safari needs the -webkit- name);
 * text boxes and the text in windows (viewer, properties) stay selectable */
#uc.uc-touch { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
#uc.uc-touch input, #uc.uc-touch textarea, #uc.uc-touch [contenteditable="true"], #uc.uc-touch .uc-dlg .dlg-body { -webkit-user-select: text; user-select: text; -webkit-touch-callout: default; }
#uc .uc-row, #uc .uc-tile, #uc .uc-ctx, #uc .uc-fkeys, #uc .uc-pane-head { -webkit-user-select: none; }

/* while unCommander is used by finger, the page around it can't be selected either:
 * iPad otherwise selects all of it from a press-and-hold */
html.uc-noselect, html.uc-noselect body { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
html.uc-noselect input, html.uc-noselect textarea, html.uc-noselect #uc .uc-dlg .dlg-body { -webkit-user-select: text; user-select: text; }
/* by finger only: a bigger ▸ in the folder tree, with an even bigger area that counts as a tap on it */
#uc.uc-touch .tcar { position: relative; width: 24px; height: 20px; margin-right: 4px; vertical-align: -5px; }
#uc.uc-touch .tcar svg { width: 14px; height: 14px; stroke-width: 2.6; }
#uc.uc-touch .tcar:not(.none)::after { content: ''; position: absolute; inset: -3px -8px -3px -10px; }
/* music library: year and songs under each cover; song lengths in an album */
#uc .uc-tile .tl-sub { margin-top: -3px; padding: 0 6px 5px; font: calc(10.5px * var(--fs, 1))/1.3 var(--mono); color: var(--muted); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-pane.mus-times .uc-row .nm { position: relative; padding-right: 50px; }
#uc .mus-len { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); font-weight: 400; }


/* the cart's count when it holds both copies and cuts: half copy colour, half cut colour */
#uc .bdg.mix { background: linear-gradient(90deg, var(--accent) 50%, var(--warn) 50%); color: #fff; text-shadow: 0 0 2px rgba(0,0,0,.45); }

/* ---------- music tag editor ---------- */
#uc .tg-dlg .dlg-foot { display: none; }
#uc .tg-dlg .dlg-body { max-height: none; height: calc(100vh - 150px); overflow: hidden; padding: 0; gap: 0; }
#uc .tg { display: flex; flex-direction: column; height: 100%; min-height: 0; }
#uc .tg [hidden] { display: none !important; }
#uc .tg-path { padding: 8px 16px; font: calc(12px * var(--fs, 1)) var(--mono); color: var(--muted); border-bottom: 1px solid var(--line-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .tg-edit { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 12px; padding: 12px 16px; }
#uc .tg-fill { display: flex; flex-wrap: wrap; gap: 10px; }
#uc .tg-card { flex: 1 1 240px; display: flex !important; gap: 12px; align-items: flex-start; padding: 11px 14px !important; height: auto !important; margin: 0 !important; border: 1px solid var(--line) !important; border-radius: 8px !important; background: var(--surface) !important; color: var(--ink) !important; text-align: left; cursor: pointer; font: inherit !important; text-transform: none !important; letter-spacing: 0 !important; box-shadow: none !important; }
#uc .tg-card.main { border: 2px solid var(--accent) !important; }
#uc .tg-card:hover { border-color: var(--accent) !important; background: var(--accent-soft) !important; }
#uc .tg-card .ic svg { width: 22px; height: 22px; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; display: block; }
#uc .tg-card .tx { display: flex; flex-direction: column; gap: 2px; }
#uc .tg-card .tx b { font-size: calc(14px * var(--fs, 1)); }
#uc .tg-card .tx span { font-size: calc(12.5px * var(--fs, 1)); color: var(--muted); white-space: normal; }
#uc .tg-hint { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: calc(12.5px * var(--fs, 1)); color: var(--muted); }
#uc .tg-filled { padding: 3px 10px; border-radius: 20px; background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); font-weight: 600; }
#uc .tg-album { display: flex; gap: 18px; align-items: flex-start; }
#uc .tg-cov { display: flex; flex-direction: column; gap: 6px; width: 140px; flex: none; }
#uc .tg-pic { position: relative; width: 140px; height: 140px; border-radius: 6px; background: var(--surface-2); border: 1px dashed var(--line); overflow: hidden; box-sizing: border-box; }
#uc .tg-pic.chg { border: 2px solid var(--ok); }
#uc .tg-pic img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .tg-nopic { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); }
#uc .tg-nopic svg { width: 36px; height: 36px; fill: none; stroke: currentColor; stroke-width: 1.4; }
#uc .tg-new { position: absolute; top: 6px; right: 6px; padding: 2px 6px; border-radius: 4px; background: var(--ok); color: #fff; font: 700 calc(10.5px * var(--fs, 1))/1.2 var(--sans); }
#uc .tg-covsel { width: 100%; font-size: calc(12px * var(--fs, 1)); }
#uc .tg-savejpg { font-size: calc(12px * var(--fs, 1)); line-height: 1.3; }
#uc .tg-afields { flex: 1; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 18px; }
#uc .tg-af { display: flex; flex-direction: column; gap: 3px; font-size: calc(12px * var(--fs, 1)); color: var(--muted); }
#uc .tg-af input { height: 34px; box-sizing: border-box; font-size: calc(14px * var(--fs, 1)); padding: 0 10px; color: var(--ink); }
#uc .tg input.chg { border: 2px solid var(--ok) !important; background: color-mix(in srgb, var(--ok) 8%, var(--surface)) !important; font-weight: 600; color: var(--ink); }
#uc .tg-was { display: none; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); text-decoration: line-through; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .tg-af .tg-was { text-decoration: none; }
#uc .tg-was.on { display: block; }
#uc .tg-more { font-size: calc(12.5px * var(--fs, 1)); color: var(--muted); align-self: flex-end; margin-top: -6px; }
#uc .tg-songs { flex: 1; min-height: 0; border: 1px solid var(--line); border-radius: 8px; display: flex; flex-direction: column; overflow: hidden; }
#uc .tg-body { flex: 1; min-height: 0; overflow-y: auto; }
#uc .tg-dlg { --tgc: 14px 64px minmax(0, 1.4fr) minmax(0, 1fr) 56px; }
#uc .tg-dlg.tg-disc { --tgc: 14px 64px 54px minmax(0, 1.4fr) minmax(0, 1fr) 56px; }
#uc .tg-dlg.tg-moreon { --tgc: 14px 64px minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, .9fr) minmax(0, .9fr) 56px; }
#uc .tg-dlg.tg-disc.tg-moreon { --tgc: 14px 64px 54px minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, .9fr) minmax(0, .9fr) 56px; }
#uc .tg-dlg:not(.tg-moreon) .tg-x { display: none; }
#uc .tg-row { display: grid; grid-template-columns: var(--tgc); gap: 8px; align-items: start; padding: 4px 12px; border-bottom: 1px solid var(--line-soft); }
#uc .tg-row.tg-head { padding: 7px 12px; background: var(--surface-2); border-bottom: 1px solid var(--line); font: 600 calc(10.5px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
#uc .tg-row .r { text-align: right; }
#uc .tg-row.ro { opacity: .5; }
#uc .tg-dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 11px; }
#uc .tg-row.chg .tg-dot { background: var(--ok); }
#uc .tg-c { display: flex; flex-direction: column; min-width: 0; }
#uc .tg-c input { width: 100%; box-sizing: border-box; height: 28px; padding: 0 6px; font-size: calc(13px * var(--fs, 1)); border: 1px solid transparent; border-radius: 4px; background: transparent; color: var(--ink); }
#uc .tg-c input:hover:not(:disabled) { border-color: var(--line-soft); }
#uc .tg-c input:focus { border-color: var(--accent); background: var(--surface); outline: none; }
#uc .tg-c input.chg { color: var(--ok); }
#uc .tg-c .tg-was { padding: 0 7px; }
#uc .tg-file { padding: 0 7px 2px; font: calc(11px * var(--fs, 1)) var(--name-font); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .tg-len { font: calc(12px * var(--fs, 1)) var(--mono); color: var(--muted); padding-top: 6px; }
#uc .tg-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 11px 16px; border-top: 1px solid var(--line); background: var(--surface-2); }
#uc .tg-sum { font-size: calc(14px * var(--fs, 1)); color: var(--muted); display: inline-flex; align-items: center; gap: 8px; }
#uc .tg-sum.on { color: var(--ink); font-weight: 600; }
#uc .tg-sum i { width: 10px; height: 10px; border-radius: 50%; background: var(--ok); }
#uc .tg-sumd { font-size: calc(12.5px * var(--fs, 1)); }
#uc .tg-sp { flex: 1; }
#uc .tg-link { -webkit-appearance: none !important; appearance: none !important; border: 0 !important; background: none !important; padding: 0 !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; color: var(--accent) !important; text-decoration: underline; text-underline-offset: 3px; font: 500 calc(13px * var(--fs, 1)) var(--sans) !important; text-transform: none !important; letter-spacing: 0 !important; cursor: pointer; }
#uc .tg-keep { font-size: calc(13px * var(--fs, 1)); }
#uc .tg-bar .uc-btn { height: 34px; padding: 0 16px; font-size: calc(13.5px * var(--fs, 1)); }
/* find this album online */
#uc .tg-find { flex: 1; min-height: 0; display: flex; flex-direction: column; }
#uc .tg-fhead { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line-soft); }
#uc .tg-ftitle { flex: 1; display: flex; flex-direction: column; gap: 2px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .tg-ftitle b { font-size: calc(15px * var(--fs, 1)); }
#uc .tg-fmain { flex: 1; min-height: 0; display: flex; }
#uc .tg-fleft { width: 420px; max-width: 45%; flex: none; display: flex; flex-direction: column; min-height: 0; border-right: 1px solid var(--line); }
#uc .tg-fq { display: flex; gap: 8px; align-items: flex-end; padding: 12px 14px; border-bottom: 1px solid var(--line-soft); }
#uc .tg-fq .tg-af { flex: 1; min-width: 0; }
#uc .tg-fq .tg-af input { height: 32px; font-size: calc(13px * var(--fs, 1)); }
#uc .tg-fq .uc-btn { height: 32px; }
#uc .tg-fcount { padding: 8px 14px 4px; font: 600 calc(10.5px * var(--fs, 1))/1.3 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
#uc .tg-fres { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding: 4px 10px 12px; }
#uc .tg-rel { display: flex !important; gap: 10px; align-items: center; padding: 8px !important; height: auto !important; margin: 0 !important; border: 1px solid var(--line-soft) !important; border-radius: 8px !important; background: var(--surface) !important; color: var(--ink) !important; text-align: left; cursor: pointer; font: inherit !important; text-transform: none !important; letter-spacing: 0 !important; box-shadow: none !important; }
#uc .tg-rel:hover { border-color: var(--accent) !important; }
#uc .tg-rel.on { border: 2px solid var(--accent) !important; background: var(--accent-soft) !important; }
#uc .tg-rpic { width: 54px; height: 54px; flex: none; border-radius: 4px; background: var(--surface-3); overflow: hidden; }
#uc .tg-rpic img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .tg-rtx { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; font-size: calc(12px * var(--fs, 1)); }
#uc .tg-rtx b { font-size: calc(13.5px * var(--fs, 1)); }
#uc .tg-chip { flex: none; padding: 3px 8px; border-radius: 20px; background: var(--surface-3); color: var(--muted); font: 500 calc(11.5px * var(--fs, 1)) var(--sans); }
#uc .tg-chip.ok { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); font-weight: 700; }
#uc .tg-fright { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 12px; padding: 14px 16px; }
#uc .tg-fempty { padding: 30px 10px; text-align: center; }
#uc .tg-rhead { display: flex; gap: 16px; align-items: flex-start; font-size: calc(13px * var(--fs, 1)); line-height: 1.5; }
#uc .tg-rhead > img, #uc .tg-rhead > .tg-nopic { width: 112px; height: 112px; flex: none; border-radius: 6px; object-fit: cover; background: var(--surface-2); }
#uc .tg-rt { font-size: calc(17px * var(--fs, 1)); }
#uc .tg-verdict { display: inline-block; margin-top: 6px; padding: 4px 10px; border-radius: 20px; background: var(--surface-3); font-weight: 600; }
#uc .tg-verdict.ok { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); }
#uc .tg-verdict.warn { background: color-mix(in srgb, var(--warn) 16%, transparent); color: var(--warn); }
#uc .tg-cmp { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; }
#uc .tg-crow { display: grid; grid-template-columns: 30px minmax(0, 1fr) 50px 24px minmax(0, 1fr) 50px; gap: 8px; align-items: center; padding: 5px 12px; border-bottom: 1px solid var(--line-soft); font-size: calc(12.5px * var(--fs, 1)); }
#uc .tg-chead { position: sticky; top: 0; background: var(--surface-2); border-bottom: 1px solid var(--line); font: 600 calc(10.5px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
#uc .tg-crow .r { text-align: right; font-family: var(--mono); font-size: calc(12px * var(--fs, 1)); }
#uc .tg-cf { font: calc(12px * var(--fs, 1)) var(--name-font); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .tg-mk { text-align: center; font-weight: 700; }
#uc .tg-mk.ok { color: var(--ok); }
#uc .tg-mk.bad { color: var(--warn); }
#uc .tg-fbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 11px 16px; border-top: 1px solid var(--line); background: var(--surface-2); font-size: calc(12.5px * var(--fs, 1)); }
#uc .tg-fbar .uc-btn, #uc .tg-fhead .uc-btn { height: 34px; padding: 0 16px; font-size: calc(13.5px * var(--fs, 1)); }
@media (max-width: 760px) { #uc .tg-fmain { flex-direction: column; } #uc .tg-fleft { width: auto; max-width: none; border-right: 0; border-bottom: 1px solid var(--line); max-height: 45%; } #uc .tg-afields { grid-template-columns: 1fr; } }

/* F-keys: both rows at once (F-keys on top, More below), slimmer */
#uc .uc-fkeys.both .uc-fk-track { width: 100%; flex-direction: column; gap: 3px; transform: none; transition: none; }
#uc .uc-fkeys.both .uc-fk-page { width: 100%; padding-right: 4px; visibility: visible; }
#uc .uc-fkeys.both .uc-fk:not(.uc-fk-toggle) { padding: 2px 2px; }
#uc .uc-fkeys.both { padding-top: 3px; padding-bottom: 3px; }
#uc .uc-fkeys.both .uc-fk-toggle span { transform: rotate(90deg) !important; }
#uc .uc-fk-toggle span { transition: transform .38s cubic-bezier(.65,0,.35,1) !important; }
#uc .uc-fkeys.rise .uc-fk-page[data-page="more"] { animation: uc-fk-rise .38s cubic-bezier(.65,0,.35,1); }
#uc .uc-fkeys.rise .uc-fk-page[data-page="f"] { animation: uc-fk-fade .38s ease-in-out; }
@keyframes uc-fk-rise { from { transform: translateY(100%); opacity: 0; } }
@keyframes uc-fk-fade { from { opacity: .3; } }
@media (prefers-reduced-motion: reduce) { #uc .uc-fkeys.rise .uc-fk-page { animation: none; } }

/* music library, inside an artist: the albums, then the other files smaller; a small "up" */
#uc .uc-pane.mus-tiles .uc-spacer-v { display: block !important; padding: 8px 10px 14px; }
#uc .mt-h { display: flex; align-items: center; gap: 8px; margin: 2px 0 8px; font: 600 calc(10.5px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
#uc .mt-h span { padding: 1px 6px; border-radius: 9px; background: var(--surface-3); font-weight: 600; }
#uc .mt-sec.small { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--line); }
#uc .mt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--tile, 160px), 1fr)); gap: 10px; align-content: start; }
#uc .mt-sec.small .mt-grid { grid-template-columns: repeat(auto-fill, minmax(calc(var(--tile, 160px) * .55), 1fr)); gap: 8px; }
#uc .mt-sec.small .uc-tile .nm { font-size: calc(11px * var(--fs, 1)); padding: 3px 5px; }
#uc .mt-sec.small .uc-tile .tl-ic svg { width: calc(var(--tile, 160px) * .2) !important; height: calc(var(--tile, 160px) * .2) !important; }
#uc .mt-sec.small .uc-tile .tl-ext { font-size: calc(8.5px * var(--fs, 1)); bottom: 4px; right: 4px; }
#uc .uc-pane.gal .uc-list .uc-row.uc-tile.mt-up { display: inline-flex; flex-direction: row; align-items: center; position: static; height: auto; margin: 0 0 10px; padding: 3px 10px 3px 7px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); cursor: pointer; overflow: visible; }
#uc .uc-pane.gal .uc-list .uc-row.uc-tile.mt-up:hover { border-color: var(--accent); }
#uc .uc-tile.mt-up .nm { display: inline-flex; align-items: center; gap: 5px; padding: 0; font-size: calc(12px * var(--fs, 1)); color: var(--ink-2); }
#uc .uc-tile.mt-up svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

/* album tiles: name and year/songs on the left */
#uc .mt-sec:not(.small) .uc-tile .nm, #uc .mt-sec:not(.small) .uc-tile .tl-sub { align-self: stretch; text-align: left !important; padding-left: 8px; padding-right: 8px; }
/* the tag editor window, and its release list */
#uc .uc-dlg.full.tg-dlg { max-width: min(1000px, calc(100vw - 40px)); }
#uc .tg-fleft { max-width: 35%; }

/* in its own tab there are no unRAID scroll arrows in the corner, so the buttons can go all the way right */
#uc.uc-solo { --fk-clear: 5px; }

/* the terminal: a third of the height under the panes, as wide as both */
#uc.uc-termon > .uc-panes { flex: 2 1 0 !important; }
#uc > .uc-term { flex: 1 1 0; min-height: 140px; display: flex; flex-direction: column; margin: 6px 4px 0; border-radius: 6px; overflow: hidden; background: #000; border: 1px solid #000; }
#uc > .uc-term[hidden] { display: none; }
#uc .ut-bar { display: flex; align-items: center; gap: 10px; padding: 3px 4px 3px 10px; background: #4e4e4e; color: #d6dde3; font: calc(11.5px * var(--fs, 1))/1.3 var(--mono); }
#uc .ut-t { font-weight: 600; color: #fff; }
#uc .ut-dir { color: #74bdff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
#uc .ut-sp { flex: 1; }
#uc .ut-tip { color: #d9c68e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
#uc .ut-b { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 22px !important; padding: 0 10px !important; border: 1px solid #3a4148 !important; border-radius: 5px !important; background: #2a2f35 !important; color: #e8ecef !important; font: 500 calc(11.5px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .ut-b:hover { border-color: var(--accent) !important; }
#uc .ut-hide { background: var(--cursor) !important; border-color: var(--cursor) !important; color: #000 !important; }
#uc .ut-exit { background: var(--danger) !important; border-color: var(--danger) !important; color: #fff !important; }
#uc .ut-hide:hover, #uc .ut-exit:hover { filter: brightness(1.1); border-color: #fff !important; }
#uc .ut-frame { flex: 1; width: 100%; min-height: 0; border: 0; background: #000; display: block; }
#uc .uc-termbtn.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
@media (max-width: 900px) { #uc .ut-tip { display: none; } }

/* ---------- playlists ---------- */
#uc .uc-plpill { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border-color: var(--accent); color: var(--accent); max-width: 240px; }
#uc .uc-plpill[hidden] { display: none; }
#uc .uc-plpill svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; flex: none; }
#uc .uc-plpill span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
#uc .uc-plpill b { padding: 0 6px; border-radius: 9px; background: var(--accent); color: var(--accent-ink); font-weight: 700; }
#uc .tl-add { position: absolute; right: 52px; bottom: 12px; z-index: 2; -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; padding: 0 !important; min-width: 0 !important; width: 30px !important; height: 30px !important; border: 0 !important; border-radius: 50% !important; background: rgba(20,24,28,.75) !important; color: #fff !important; display: grid !important; place-items: center; cursor: pointer; opacity: 0; transition: opacity .12s, transform .12s; box-shadow: 0 2px 6px rgba(0,0,0,.3) !important; }
#uc .uc-tile:hover .tl-add, #uc.uc-touch .tl-add, #uc .tl-add:focus { opacity: 1; }
#uc .tl-add:hover { transform: scale(1.08); background: var(--accent) !important; }
#uc .tl-add svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
#uc .uc-dlg.pl-dlg { max-width: min(1000px, calc(100vw - 40px)); }
#uc .pl-dlg .dlg-foot { display: none; }
#uc .pl-dlg .dlg-body { max-height: none; height: calc(100vh - 150px); overflow: hidden; padding: 0; gap: 0; }
#uc .pl { display: flex; flex-direction: column; height: 100%; min-height: 0; }
#uc .pl [hidden] { display: none !important; }
#uc .pl-edit { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; }
#uc .pl-top { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 14px; }
#uc .pl-name { width: 320px; max-width: 100%; }
#uc .pl-info { font-size: calc(13px * var(--fs, 1)); color: var(--ink-2); padding-bottom: 0; }
#uc .pl-top .uc-btn { height: 34px; }
#uc .pl-file { font: calc(11.5px * var(--fs, 1)) var(--mono); }
#uc .pl-list { flex: 1; min-height: 0; overflow-y: auto; border: 1px solid var(--line); border-radius: 8px; }
#uc .pl-row { display: grid; grid-template-columns: 22px 34px minmax(0, 1fr) 54px auto; gap: 8px; align-items: center; padding: 4px 10px; border-bottom: 1px solid var(--line-soft); }
#uc .pl-row.dragging { opacity: .4; }
#uc .pl-row.over { box-shadow: inset 0 2px 0 var(--accent); }
#uc .pl-row.now { background: var(--cursor); }
#uc .pl-row.miss .pl-t span { color: var(--danger); }
#uc .pl-grip { cursor: grab; color: var(--muted); letter-spacing: -2px; user-select: none; }
#uc .pl-num { font: calc(11.5px * var(--fs, 1)) var(--mono); color: var(--muted); text-align: right; }
#uc .pl-t { display: flex; flex-direction: column; min-width: 0; }
#uc .pl-t b { font-weight: 500; font-size: calc(13px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .pl-t span { font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .pl-len { font: calc(12px * var(--fs, 1)) var(--mono); color: var(--muted); text-align: right; }
#uc .pl-btns { display: flex; gap: 3px; margin-right: 5px; }
#uc .pl-btns button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; width: 26px !important; height: 24px !important; padding: 0 !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 600 12px/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; }
#uc .pl-btns button:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .pl-btns button[data-b="del"]:hover { border-color: var(--danger) !important; color: var(--danger) !important; }
#uc .pl-empty { padding: 30px 16px; text-align: center; line-height: 1.6; }
#uc .pl-player { flex: none; }
#uc .pl-player .vp { flex-direction: row; height: auto; border-radius: 6px; background: #15181b; }
#uc .pl-player .vp-stage { flex: 0 1 260px; min-width: 0; padding: 5px 10px !important; justify-content: flex-start; }
#uc .pl-player .vp-art { flex-direction: row; align-items: center; gap: 10px; text-align: left; width: 100%; }
#uc .pl-player .vp-art .gp-ic, #uc .pl-player .vp-cover { flex: none; width: 36px; height: 36px; max-width: none; max-height: none; object-fit: cover; border-radius: 3px; box-shadow: none; color: #9aa4ad; }
#uc .pl-player .vp-art .gp-ic svg { width: 22px; height: 22px; }
#uc .pl-player .vp-tags { color: #e8ecef; font-size: calc(11.5px * var(--fs, 1)); line-height: 1.3; max-height: 2.6em; overflow: hidden; white-space: nowrap; }
#uc .pl-player .vp-bar { flex: 1; min-width: 0; }
#uc .pl-sum { font-size: calc(12.5px * var(--fs, 1)); color: var(--danger); }
#uc .pl-save { flex: 1; min-height: 0; display: flex; flex-direction: column; }
#uc .pl-sbody { flex: 1; min-height: 0; overflow-y: auto; padding: 14px 16px; display: flex; flex-direction: column; gap: 12px; }
#uc .pl-for { display: flex; flex-wrap: wrap; gap: 6px; }
#uc .pl-tg { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 32px !important; padding: 0 14px !important; border: 1px solid var(--line) !important; border-radius: 16px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(13px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .pl-tg:hover { border-color: var(--accent) !important; }
#uc .pl-tg.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; font-weight: 600 !important; }
#uc .pl-hint { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); padding: 8px 12px; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--line-soft); }
#uc .pl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; }
#uc .pl-wide { grid-column: 1 / -1; }
#uc .pl-inrow { display: flex; gap: 6px; }
#uc .pl-inrow input { flex: 1; min-width: 0; }
#uc .pl-inrow .uc-btn, #uc .pl-inrow select { height: 34px; flex: none; }
#uc .pl-grid input[type=text], #uc .pl-grid input[type=password] { height: 34px; box-sizing: border-box; padding: 0 10px; font-size: calc(13px * var(--fs, 1)); color: var(--ink); }
#uc .pl-prev { margin: 0; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); font: calc(12px * var(--fs, 1))/1.5 var(--mono); color: var(--ink-2); white-space: pre; overflow-x: auto; }
#uc .pl-warn { font-size: calc(12.5px * var(--fs, 1)); color: var(--warn); }
@media (max-width: 760px) { #uc .pl-grid { grid-template-columns: 1fr; } #uc .pl-row { grid-template-columns: 18px minmax(0, 1fr) auto; } #uc .pl-num, #uc .pl-len { display: none; } }

/* playlist rows: title then its length; artist › album under it */
#uc .pl-row { grid-template-columns: 18px 34px minmax(0, 1fr) auto !important; }
#uc .pl-cov { width: 34px; height: 34px; border-radius: 3px; overflow: hidden; background: var(--surface-3); display: block; }
#uc .pl-cov img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .pl-tt { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
#uc .pl-tt b { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .pl-tt b::after { content: ''; }
#uc .pl-dur { flex: none; font: calc(11.5px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .pl-dur:not(:empty)::before { content: '- '; }
#uc .pl-sub { font-size: calc(11.5px * var(--fs, 1)); color: var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .pl-al { font-weight: 660; }
#uc .pl-miss { color: var(--danger); }
#uc .pl-len { display: none; }
#uc .uc-plpill i { width: 7px; height: 7px; border-radius: 50%; background: var(--warn); flex: none; }
#uc .pl-list.drop-in, #uc .pd-list.drop-in { outline: 2px dashed var(--accent); outline-offset: -3px; background: var(--accent-soft); }
#uc .pl-bar .tg-link.pl-end { color: var(--danger) !important; }
/* pinned at the right of the panes */
#uc { --pl-dock-w: 340px; }
@media (min-width: 701px) {
  #uc.uc-pldocked .uc-panes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) var(--pl-dock-w); }
  #uc.uc-pldocked.uc-mus .uc-panes { grid-template-columns: minmax(0, calc(var(--mus-left) - 6%)) minmax(0, 1fr) var(--pl-dock-w); }
  #uc.uc-pldocked .uc-crumbs { padding-right: calc(var(--pl-dock-w) + 10px); }   /* the right path box ends where the right pane does */
  #uc .uc-crumbs > .pd-tools { position: absolute; top: 4px; bottom: 4px; right: 2px; width: var(--pl-dock-w); }
  #uc.uc-pldocked.uc-mus .uc-crumbs { grid-template-columns: minmax(0, calc(var(--mus-left) - 6% - 44px)) auto minmax(0, 1fr); }
}
#uc .uc-pldock { min-width: 0; min-height: 0; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 5px; overflow: hidden; background: var(--surface); }
#uc .uc-pldock[hidden] { display: none; }
#uc .pd-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding: 5px 6px 5px 8px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
#uc .pd-name { flex: 1 1 120px; min-width: 0; height: 26px; box-sizing: border-box; padding: 0 6px; font: 600 calc(13px * var(--fs, 1)) var(--sans); border: 1px solid transparent; background: transparent; color: var(--ink); }
#uc .pd-name:hover, #uc .pd-name:focus { border-color: var(--line); background: var(--surface); outline: none; }
#uc .pd-head .pl-info { font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .pd-btns { display: flex; gap: 3px; margin-left: auto; }
#uc .pd-btns button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 24px !important; padding: 0 8px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(12px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .pd-btns button:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .pd-list { flex: 1; min-height: 0; overflow-y: auto; }
#uc .pd-list .pl-row { grid-template-columns: 14px 28px minmax(0, 1fr) auto !important; gap: 6px; padding: 3px 6px; }
#uc .pd-list .pl-cov { width: 28px; height: 28px; }
#uc .pd-list .pl-tt b { font-size: calc(12px * var(--fs, 1)); }
#uc .pd-list .pl-sub { font-size: calc(10.5px * var(--fs, 1)); }
#uc .pd-list .pl-btns button { width: 20px !important; height: 20px !important; font-size: 10px !important; }
#uc .pd-list .pl-empty { padding: 20px 12px; font-size: calc(12px * var(--fs, 1)); }
#uc .pd-foot { padding: 5px 8px; border-top: 1px solid var(--line-soft); font-size: calc(11px * var(--fs, 1)); color: var(--muted); text-align: center; }

/* F8 Delete when pointed at: red, white text (in the own tab there's no unRAID red behind it) */
@media (hover: hover) { #uc .uc-fk.danger:hover { background: var(--danger) !important; border-color: var(--danger) !important; color: #fff !important; } }
#uc .uc-fk.uc-fk-toggle { width: 28px; }
#uc .uc-btn.danger.pl-end { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 45%, var(--line)); background: var(--surface); }
#uc .uc-btn.danger.pl-end:hover { background: var(--danger); border-color: var(--danger); color: #fff; }
/* the pinned playlist's player */
#uc .pd-player { flex: none; border-top: 1px solid var(--line); }
#uc .pd-player .vp { display: flex; flex-direction: column; height: auto; border-radius: 0; background: #15181b; }
#uc .pd-player .vp-stage { padding: 6px 8px !important; justify-content: flex-start; }
#uc .pd-player .vp-art { flex-direction: row; align-items: center; gap: 8px; text-align: left; width: 100%; min-width: 0; }
#uc .pd-player .vp-art .gp-ic, #uc .pd-player .vp-cover { flex: none; width: 34px; height: 34px; max-width: none; max-height: none; object-fit: cover; border-radius: 3px; box-shadow: none; color: #9aa4ad; }
#uc .pd-player .vp-art .gp-ic svg { width: 20px; height: 20px; }
#uc .pd-player .vp-tags { min-width: 0; color: #e8ecef; font-size: calc(11px * var(--fs, 1)); line-height: 1.3; max-height: 2.6em; overflow: hidden; white-space: nowrap; }
#uc .pd-player .vp-tags b { font-size: calc(12px * var(--fs, 1)); }
#uc .pd-player .vp-bar { gap: 5px; padding: 4px 6px; }
#uc .pd-player .vp-mode, #uc .pd-player .vp-aud { display: none !important; }
#uc .pd-list .pl-row.now { background: var(--cursor); }
#uc .pd-list .pl-row.now .pl-tt b { color: var(--accent); font-weight: 700; }

/* the playlist pill: a clear music note */
#uc .uc-plpill svg.pl-note { width: 20px; height: 20px; stroke-width: 1.6; }
#uc .uc-plpill svg.pl-note ellipse { fill: currentColor; }

/* ---------- the player at the bottom (in the Select / Sort bar) ---------- */
#uc .uc-bp { position: relative; flex: 0 1 var(--bp-w, 720px); min-width: 0; height: 28px; display: flex; align-items: center; gap: 4px; padding-right: 3px; border-radius: 4px; background: var(--accent); color: var(--accent-ink); --bp-ink: var(--accent-ink); --bp-soft: color-mix(in srgb, var(--accent-ink) 78%, transparent); --bp-line: color-mix(in srgb, var(--accent-ink) 32%, transparent); --bp-fill: color-mix(in srgb, var(--accent-ink) 14%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, #000 12%, transparent); }
#uc .uc-bp[hidden] { display: none; }
#uc:not(.uc-bpon) .uc-spacer.bp-sp { display: none; }
#uc .bp-host { flex: 1; min-width: 0; height: 100%; display: flex; }
#uc .uc-bp .vp { flex-direction: row; align-items: center; height: 100%; min-height: 0; background: transparent; border-radius: 4px; overflow: visible; }
#uc .uc-bp .vp-stage { flex: 1 1 auto; min-width: 0; height: 100%; padding: 0 0 0 3px !important; justify-content: flex-start; position: relative; }
#uc .uc-bp .vp-art { flex-direction: row; align-items: center; gap: 6px; min-width: 0; width: 100%; height: 100%; }
#uc .uc-bp .vp-art .gp-ic, #uc .uc-bp .vp-cover { flex: none; width: 22px; height: 22px; max-width: none; max-height: none; object-fit: cover; border-radius: 50%; box-shadow: 0 0 0 1px var(--bp-line); color: var(--bp-soft); }
#uc .uc-bp .vp-art .gp-ic svg { width: 14px; height: 14px; }
#uc .uc-bp .vp-tags { min-width: 0; font-size: calc(11.5px * var(--fs, 1)); line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--bp-soft); }
#uc .uc-bp .vp-tags br, #uc .uc-bp .vp-tags .muted { display: none; }
#uc .uc-bp .vp-tags b { color: var(--bp-ink); font-size: calc(12px * var(--fs, 1)); margin-right: 6px; }
#uc .uc-bp .vp-bar { flex: none; min-width: 0; height: 100%; padding: 0 4px; gap: 4px; background: transparent; color: var(--bp-ink); font-size: calc(10.5px * var(--fs, 1)); }
#uc .uc-bp .vp-b { min-width: 22px !important; height: 20px !important; padding: 0 4px !important; font-size: 11px !important; border-color: var(--bp-line) !important; background: var(--bp-fill) !important; color: var(--bp-ink) !important; }
#uc .uc-bp .vp-play { min-width: 26px !important; }
#uc .uc-bp .vp-mode, #uc .uc-bp .vp-aud, #uc .uc-bp .vp-sub, #uc .uc-bp .vp-sync { display: none !important; }
#uc .uc-bp .vp-msg { inset: auto 0 calc(100% + 6px) 0; padding: 4px 8px; font-size: calc(11.5px * var(--fs, 1)); }
#uc .bp-x { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 22px !important; padding: 0 7px !important; border: 1px solid var(--bp-line) !important; border-radius: 11px !important; background: var(--bp-fill) !important; color: var(--bp-ink) !important; font: 600 calc(11px * var(--fs, 1))/1 var(--mono) !important; box-shadow: none !important; cursor: pointer; display: inline-flex !important; align-items: center; gap: 4px; flex: none; }
#uc .bp-x { padding: 0 6px !important; font-family: var(--sans) !important; }
#uc .bp-x:hover, #uc .uc-bp .vp-b:hover { border-color: var(--bp-ink) !important; background: color-mix(in srgb, var(--accent-ink) 26%, transparent) !important; }
#uc .bp-pop { position: absolute; right: 0; bottom: calc(100% + 6px); z-index: 50; width: min(420px, 90vw); max-height: min(60vh, 460px); display: flex; flex-direction: column; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); overflow: hidden; }
#uc .bp-pop[hidden] { display: none; }
#uc .bq-head { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid var(--line); background: var(--surface-2); font-size: calc(12.5px * var(--fs, 1)); }
#uc .bq-head button, #uc .bq-row button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 24px !important; padding: 0 8px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(12px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; }
#uc .bq-list { overflow-y: auto; }
#uc .bq-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 4px 10px; border-bottom: 1px solid var(--line-soft); cursor: pointer; }
#uc .bq-row:hover { background: var(--accent-soft); }
#uc .bq-row.now { background: var(--cursor); }
#uc .bq-row.now .bq-t b { color: var(--accent); font-weight: 700; }
#uc .bq-n { font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); text-align: right; }
#uc .bq-t { display: flex; flex-direction: column; min-width: 0; }
#uc .bq-t b { font-weight: 500; font-size: calc(12.5px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .bq-t span { font-size: calc(11px * var(--fs, 1)); color: var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .bq-row button { width: 22px !important; height: 20px !important; padding: 0 !important; }
#uc .vp-tags .vt-sep { display: none; font-style: normal; }
#uc .uc-bp .vp-tags .vt-sep { display: inline; color: var(--bp-line); }

/* the bottom player on the accent colour: its seek bar, and the song's card on hover */
#uc .uc-bp .vp-t, #uc .uc-bp .vp-d { color: var(--bp-soft); }
#uc .uc-bp .vp-seek { flex: none; width: var(--bp-seek, 110px); min-width: 50px; -webkit-appearance: none; appearance: none; height: 14px; background: transparent; cursor: pointer; }
#uc .uc-bp .vp-seek::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--bp-line); }
#uc .uc-bp .vp-seek::-moz-range-track { height: 4px; border-radius: 2px; background: var(--bp-line); }
#uc .uc-bp .vp-seek::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--bp-ink); }
#uc .uc-bp .vp-seek::-webkit-slider-thumb { -webkit-appearance: none; width: 11px; height: 11px; margin-top: -3.5px; border: 0; border-radius: 50%; background: var(--bp-ink); }
#uc .uc-bp .vp-seek::-moz-range-thumb { width: 11px; height: 11px; border: 0; border-radius: 50%; background: var(--bp-ink); }
#uc .uc-bp .vp-stage { cursor: default; }
#uc .bp-card { --bc-cover: 120px; position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%); z-index: 50; width: min(480px, 92vw); max-height: min(72vh, 620px); display: flex; flex-direction: column; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow); font-size: calc(12.5px * var(--fs, 1)); overflow: hidden; }
#uc .bp-card[hidden] { display: none; }
#uc .bc-top { flex: none; display: flex; gap: 14px; align-items: center; padding: 14px; background: color-mix(in srgb, var(--accent) 10%, var(--surface)); border-bottom: 1px solid var(--line); }
#uc .bc-cov { flex: none; width: var(--bc-cover); height: var(--bc-cover); border-radius: 6px; overflow: hidden; background: var(--surface-2); display: flex; align-items: center; justify-content: center; color: var(--muted); box-shadow: 0 2px 8px rgba(0,0,0,.25); }
#uc .bc-cov img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .bc-cov svg { width: 46px; height: 46px; }
#uc .bc-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
#uc .bc-title { font-size: calc(16px * var(--fs, 1)); font-weight: 700; line-height: 1.25; }
#uc .bc-artist { font-size: calc(13.5px * var(--fs, 1)); }
#uc .bc-album { font-size: calc(13px * var(--fs, 1)); color: var(--ink-2); }
#uc .bc-fmt { color: var(--muted); font-size: calc(12px * var(--fs, 1)); }
#uc .bc-when { margin-top: 6px; display: flex; align-items: center; gap: 7px; font: calc(11.5px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .bc-bar { flex: 1; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
#uc .bc-bar i { display: block; height: 100%; background: var(--accent); }
#uc .bc-qh { flex: none; display: flex; align-items: center; gap: 8px; justify-content: space-between; padding: 7px 10px 5px 14px; font-size: calc(11.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .bc-list { flex: 1; min-height: 0; overflow-y: auto; margin: 0 10px 10px; border: 1px solid var(--line); border-radius: 6px; }
#uc .bc-alb { position: sticky; top: 0; z-index: 1; display: flex; align-items: center; gap: 8px; padding: 5px 8px; background: var(--surface-2); border-bottom: 1px solid var(--line-soft); font-size: calc(12px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .bc-ac { flex: none; width: 28px; height: 28px; border-radius: 3px; overflow: hidden; background: var(--surface-3); }
#uc .bc-ac img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .bc-ar { color: var(--accent); }
#uc .bc-row { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 3px 10px; border-bottom: 1px solid var(--line-soft); cursor: pointer; }
#uc .bc-row:hover { background: var(--accent-soft); }
#uc .bc-row.now { background: var(--cursor); font-weight: 700; }
#uc .bc-n { text-align: right; font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .bc-nt { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .bc-d { font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .bc-eq { display: inline-flex; align-items: flex-end; gap: 1.5px; height: 10px; }
#uc .bc-eq i { width: 2.5px; background: var(--accent); animation: bc-eq .9s ease-in-out infinite alternate; }
#uc .bc-eq i:nth-child(2) { animation-delay: -.3s; } #uc .bc-eq i:nth-child(3) { animation-delay: -.6s; }
#uc.bc-paused .bc-eq i { animation-play-state: paused; }
@keyframes bc-eq { from { height: 2px; } to { height: 10px; } }

/* the active pane's header is the accent colour: its 'on' buttons turn the other way round */
#uc .uc-pane.active .uc-galbtn.on, #uc .uc-pane.active .uc-musbtn.on { background: var(--accent-ink) !important; border-color: var(--accent-ink) !important; color: var(--accent) !important; }
#uc .uc-bp .bp-qb { flex: none; padding: 0 6px; font: 600 calc(11px * var(--fs, 1))/1 var(--mono); color: var(--bp-soft); white-space: nowrap; }
#uc .bc-mkpl { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 22px !important; padding: 0 8px !important; border: 1px solid var(--line) !important; border-radius: 5px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(11.5px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; flex: none; }
#uc .bc-mkpl:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc.uc-dark { --line-cols: var(--line); }
/* the array is stopped: a red stop sign in the top bar (nothing shows while it's started) */
#uc .uc-arrstop { display: inline-grid; place-items: center; text-decoration: none; }
#uc .uc-arrstop svg path:first-child { fill: var(--danger); stroke: var(--danger); stroke-linejoin: round; }
#uc .uc-arrstop svg path + path { stroke: #fff; stroke-width: 1.8; stroke-linecap: round; }

/* ---------- the playlist editor and the player (beta 56) ---------- */
#uc .uc-crumbs { position: relative; }
#uc .pd-tools { display: flex; align-items: center; gap: 4px; min-width: 0; box-sizing: border-box; }
#uc .pd-tools[hidden] { display: none; }
#uc .pd-tools button, #uc .pd-tools select { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 100% !important; max-height: 30px; box-sizing: border-box; padding: 0 9px !important; border: 1px solid var(--line) !important; border-radius: var(--r-btn, 5px) !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 600 calc(12px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; white-space: nowrap; }
#uc .pd-tools select { flex: 1 1 auto; width: auto !important; max-width: none !important; padding-right: 22px !important; text-overflow: ellipsis;
  background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%) !important; background-position: calc(100% - 13px) 50%, calc(100% - 8px) 50% !important; background-size: 5px 5px !important; background-repeat: no-repeat !important; }
#uc .pd-tools button:hover, #uc .pd-tools select:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .pd-tools .pd-x { flex: none; padding: 0 8px !important; }
@media (max-width: 700px) { #uc .uc-crumbs > .pd-tools { position: static; height: 30px; } }
#uc .pd-head { flex-wrap: nowrap; }
#uc .pd-dot { display: none; width: 7px; height: 7px; border-radius: 50%; background: var(--warn); flex: none; }
#uc .uc-pldock.dirty .pd-dot { display: inline-block; }
#uc .pd-file { padding: 3px 8px; font: calc(10.5px * var(--fs, 1))/1.3 var(--mono); color: var(--muted); border-bottom: 1px solid var(--line-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; direction: rtl; text-align: left; }
#uc .pd-list .pl-row { cursor: pointer; }
#uc .pd-list .pl-row:hover { background: var(--accent-soft); }
#uc .pd-list .pl-row.now { background: var(--cursor); }
#uc .pd-player { display: none !important; }
/* the ♪ button at the top */
#uc .uc-plbtn[hidden] { display: none !important; }
#uc .uc-plbtn.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
#uc .uc-plbtn svg ellipse { fill: currentColor; }
/* the player: song number (opens the editor) and volume */
#uc .uc-bp .bp-qb { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 22px !important; padding: 0 7px !important; border: 1px solid transparent !important; border-radius: 11px !important; background: transparent !important; box-shadow: none !important; color: var(--bp-soft) !important; font: 600 calc(11px * var(--fs, 1))/1 var(--mono) !important; cursor: pointer; }
#uc .uc-bp .bp-qb:hover { border-color: var(--bp-line) !important; background: var(--bp-fill) !important; color: var(--bp-ink) !important; }
#uc .bp-vol { flex: none; display: inline-flex; align-items: center; height: 100%; }
#uc .bp-vol[hidden] { display: none; }
#uc .bp-vb { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; width: 24px !important; height: 22px !important; padding: 0 !important; border: 0 !important; background: transparent !important; box-shadow: none !important; color: var(--bp-ink) !important; cursor: pointer; display: grid !important; place-items: center; }
#uc .bp-vb svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
#uc .bp-vb svg path:first-child { fill: currentColor; }
#uc .bp-vr { -webkit-appearance: none; appearance: none; width: 0; min-width: 0; margin: 0; padding: 0; opacity: 0; height: 14px; background: transparent; cursor: pointer; transition: width .2s ease, opacity .2s ease, margin .2s ease; }
#uc .bp-vol:hover .bp-vr, #uc .bp-vr:focus { width: 70px; opacity: 1; margin: 0 6px 0 2px; }
#uc .bp-vr::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: var(--bp-line); }
#uc .bp-vr::-moz-range-track { height: 4px; border-radius: 2px; background: var(--bp-line); }
#uc .bp-vr::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--bp-ink); }
#uc .bp-vr::-webkit-slider-thumb { -webkit-appearance: none; width: 11px; height: 11px; margin-top: -3.5px; border: 0; border-radius: 50%; background: var(--bp-ink); }
#uc .bp-vr::-moz-range-thumb { width: 11px; height: 11px; border: 0; border-radius: 50%; background: var(--bp-ink); }
#uc .uc-bp .bp-idle .vp-tags b { margin-right: 0; }
/* the card's buttons */
#uc .bc-tools { flex: none; display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
#uc .bc-tools select { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; height: 28px !important; min-width: 0 !important; max-width: 220px !important; width: auto !important; padding: 0 24px 0 9px !important; border: 1px solid var(--line) !important; border-radius: 6px !important; background: var(--surface) !important; color: var(--ink) !important; font: 600 calc(12.5px * var(--fs, 1))/1 var(--sans) !important; cursor: pointer;
  background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%) !important; background-position: calc(100% - 13px) 50%, calc(100% - 8px) 50% !important; background-size: 5px 5px !important; background-repeat: no-repeat !important; }
#uc .bc-tb { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 28px !important; padding: 0 8px !important; border: 1px solid var(--line) !important; border-radius: 6px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 600 calc(12px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; display: inline-grid !important; place-items: center; }
#uc .bc-tb svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
#uc .bc-tb:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .bc-tb.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
#uc .bc-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
#uc .bc-empty { display: flex; flex-direction: column; gap: 6px; padding: 18px 16px; color: var(--ink-2); line-height: 1.45; }
#uc .bc-mkname { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 0 !important; border: 0 !important; background: none !important; box-shadow: none !important; color: var(--ink) !important; font: 700 calc(12px * var(--fs, 1))/1.2 var(--sans) !important; cursor: pointer; }
#uc .bc-mkname:hover { color: var(--accent) !important; text-decoration: underline; }
#uc .bc-dot { display: inline-block; width: 7px; height: 7px; margin-left: 5px; border-radius: 50%; background: var(--warn); vertical-align: 1px; }
/* the gallery's preview of a song */
#uc .gp-cover { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 6px; box-shadow: 0 2px 10px rgba(0,0,0,.25); }
/* picking a folder or a playlist file */
#uc .fb-box { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--surface); margin-top: 6px; }
#uc .fb-box[hidden] { display: none; }
#uc .fb-path { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; padding: 6px 8px; background: var(--surface-2); border-bottom: 1px solid var(--line-soft); font: calc(12px * var(--fs, 1)) var(--mono); }
#uc .fb-path i { color: var(--muted); font-style: normal; }
#uc .fb-path button, #uc .fb-row { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; border: 0 !important; background: none !important; cursor: pointer; color: var(--ink-2) !important; }
#uc .fb-path button { padding: 1px 3px !important; border-radius: 3px !important; font: inherit !important; }
#uc .fb-path button:hover { background: var(--accent-soft) !important; color: var(--accent) !important; }
#uc .fb-list { max-height: 240px; overflow-y: auto; display: flex; flex-direction: column; }
#uc .fb-row { display: flex !important; align-items: center; gap: 8px; width: 100%; padding: 5px 10px !important; border-bottom: 1px solid var(--line-soft) !important; border-radius: 0 !important; text-align: left; font: calc(13px * var(--fs, 1))/1.3 var(--sans) !important; }
#uc .fb-row:hover { background: var(--accent-soft) !important; }
#uc .fb-row.on { background: var(--cursor) !important; font-weight: 700 !important; }
#uc .fb-ic { width: 16px; height: 16px; flex: none; color: var(--accent); display: grid; place-items: center; }
#uc .fb-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
#uc .fb-up { color: var(--muted) !important; }
#uc .fb-none, #uc .fb-err { padding: 10px; }
#uc .uc-dlg.fb-dlg { width: min(560px, calc(100vw - 32px)); }
#uc .fb-dlg .fb-list { max-height: min(50vh, 420px); }
#uc .fb-note { margin-top: 6px; font-size: calc(12px * var(--fs, 1)); }
#uc .pl-inrow select.pl-dirs { flex: 0 1 auto; max-width: 200px; }

/* ---------- the playlist panel (beta 57): above the player, or pinned at the side ---------- */
#uc .uc-np { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--surface); color: var(--ink); border: 1px solid var(--np-line, #b2b2b2); border-radius: 8px; overflow: hidden; font-size: calc(12.5px * var(--fs, 1)); }
#uc .uc-np[hidden] { display: none; }
#uc .uc-np.float { position: fixed; z-index: 60; box-shadow: 0 10px 34px rgba(0,0,0,.28), 0 2px 6px rgba(0,0,0,.12); }
#uc .uc-np.pinned { position: relative; z-index: 2; border-radius: 5px; border-color: var(--np-pin-line, #cbd2d6); }
#uc.uc-dark { --np-pin-line: var(--line); }
#uc.uc-dark { --np-line: var(--line); }
#uc .np-tools { flex: none; display: flex; align-items: center; gap: 4px; padding: 5px 6px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
#uc .np-tools button, #uc .np-tools select, #uc .nn-btns button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 28px !important; box-sizing: border-box !important; padding: 0 9px !important; border: 1px solid var(--line) !important; border-radius: 6px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 600 calc(12px * var(--fs, 1))/26px var(--sans) !important; box-shadow: none !important; cursor: pointer; white-space: nowrap; flex: none; display: inline-flex !important; align-items: center; justify-content: center; vertical-align: middle; }
#uc .np-tools select { flex: 1 1 auto !important; width: auto !important; max-width: none !important; min-width: 60px !important; padding: 0 22px 0 9px !important; overflow: hidden; text-overflow: ellipsis; display: block !important; text-align: left;
  background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%) !important; background-position: calc(100% - 13px) 50%, calc(100% - 8px) 50% !important; background-size: 5px 5px !important; background-repeat: no-repeat !important; }
#uc .np-tools button:hover, #uc .np-tools select:hover, #uc .nn-btns button:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .np-tools button[hidden] { display: none !important; }
#uc .uc-np .np-ic { width: 28px !important; padding: 0 !important; }
#uc .uc-np .np-ic svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-np .np-ic.on { background: var(--accent) !important; border-color: var(--accent) !important; color: var(--accent-ink) !important; }
#uc .np-x { font-size: 13px !important; }
#uc .np-head { flex: none; display: flex; align-items: center; gap: 6px; padding: 5px 8px 3px; }
#uc .np-name { flex: 1 1 auto; min-width: 0; height: 26px; box-sizing: border-box; padding: 0 6px; margin: 0 0 0 -6px; font: 700 calc(14px * var(--fs, 1)) var(--sans); border: 1px solid transparent; background: transparent; color: var(--ink); }
#uc .np-name:hover, #uc .np-name:focus { border-color: var(--line); background: var(--surface); outline: none; }
#uc .np-dot { display: none; width: 7px; height: 7px; border-radius: 50%; background: var(--warn); flex: none; }
#uc .uc-np.dirty .np-dot { display: inline-block; }
#uc .np-file .pl-info { flex: none; direction: ltr; font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .np-file { flex: none; display: flex; align-items: baseline; gap: 8px; padding: 0 8px 6px; font: calc(10.5px * var(--fs, 1))/1.3 var(--mono); color: var(--muted); border-bottom: 1px solid var(--line); }
#uc .np-path { flex: 1 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; direction: rtl; text-align: left; }
/* the song playing */
#uc .np-now { flex: none; display: grid; grid-template-columns: var(--np-cover, 96px) minmax(0, 1fr); gap: 4px 12px; padding: 10px; background: color-mix(in srgb, var(--accent) 9%, var(--surface)); border-bottom: 1px solid var(--line); }
#uc .np-now[hidden] { display: none; }
#uc .nn-cov { width: var(--np-cover, 96px); height: var(--np-cover, 96px); border-radius: 6px; overflow: hidden; background: var(--surface-3); box-shadow: 0 2px 8px rgba(0,0,0,.25); }
#uc .nn-cov img { width: 100%; height: 100%; object-fit: cover; display: block; }
#uc .nn-main { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
#uc .nn-title { color: var(--accent); font-size: calc(15px * var(--fs, 1)); font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
#uc .nn-artist { font-size: calc(13px * var(--fs, 1)); }
#uc .nn-album { color: var(--ink-2); }
#uc .nn-fmt { color: var(--muted); font-size: calc(11.5px * var(--fs, 1)); }
#uc .nn-next { margin-top: auto; padding-top: 4px; font-size: calc(11.5px * var(--fs, 1)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .nn-next i { font-style: normal; color: var(--accent); font-weight: 600; }
#uc .nn-next span { color: var(--muted); }
#uc .nn-btns { grid-column: 1 / -1; display: flex; align-items: center; gap: 4px; padding-top: 6px; }
#uc .nn-btns button { height: 26px !important; line-height: 24px !important; font-size: calc(11.5px * var(--fs, 1)) !important; }
/* pinned: the player sits under the song */
#uc .np-slot:empty { display: none; }
#uc .np-slot { flex: none; padding: 6px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--accent) 9%, var(--surface)); }
#uc .np-slot .uc-bp { flex: none; width: 100%; min-width: 0; }
#uc .np-slot .uc-bp .vp-stage { display: none; }
#uc .np-slot .uc-bp .vp-bar { flex: 1; }
#uc .np-slot .uc-bp .vp-seek { flex: 1 1 auto; width: auto; }
#uc .np-slot .bp-qb, #uc .np-slot .bp-x { display: none !important; }
#uc .np-slot .bp-idle .vp-stage { display: flex; }
/* the list */
#uc .np-list { position: relative; flex: 1 1 auto; min-height: 120px; overflow-y: auto; }
#uc .np-rows { position: relative; }
#uc .np-list .pl-row { position: absolute; left: 0; right: 0; height: 44px; box-sizing: border-box; grid-template-columns: 14px 32px minmax(0, 1fr) auto !important; gap: 7px; padding: 0 6px; cursor: pointer; }
#uc .np-list .pl-row:hover { background: var(--accent-soft); }
#uc .np-list .pl-row.now { background: var(--cursor); }
#uc .np-list .pl-row.now .pl-tt b { color: var(--accent); font-weight: 700; }
#uc .np-list .pl-cov { position: relative; width: 32px; height: 32px; }
#uc .np-list .pl-cov .bc-eq { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: center; gap: 2px; padding-bottom: 6px; background: rgba(0,0,0,.45); height: auto; }
#uc .np-list .pl-cov .bc-eq i { background: #fff; }
#uc .np-list .pl-tt b { font-size: calc(12.5px * var(--fs, 1)); }
#uc .np-list .pl-sub { font-size: calc(11px * var(--fs, 1)); }
#uc .np-list .pl-btns button { width: 22px !important; height: 22px !important; font-size: 10px !important; }
#uc .np-list .pl-empty { position: static; padding: 24px 14px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .np-list.drop-in { outline: 2px dashed var(--accent); outline-offset: -3px; background: var(--accent-soft); }
#uc .np-drop { position: absolute; left: 4px; right: 4px; height: 2px; background: var(--accent); z-index: 2; pointer-events: none; }
#uc .np-foot { flex: none; padding: 5px 8px; border-top: 1px solid var(--line-soft); font-size: calc(11px * var(--fs, 1)); color: var(--muted); text-align: center; }
#uc .uc-np.float .np-foot { display: none; }
#uc .uc-bp .vp-stage { cursor: pointer; }
/* the Save as window's folder picker looks like the active pane */
#uc .fb-box.pl-fb { border: 2px solid var(--accent); border-left-width: 4px; border-radius: 5px; background: var(--pane-active-bg); }
#uc .fb-box.pl-fb .fb-path { background: var(--accent); color: var(--accent-ink); border-bottom-color: color-mix(in srgb, var(--accent) 30%, transparent); }
#uc .fb-box.pl-fb .fb-path button { color: var(--accent-ink) !important; }
#uc .fb-box.pl-fb .fb-path button:hover { background: color-mix(in srgb, var(--accent-ink) 20%, transparent) !important; color: var(--accent-ink) !important; }
#uc .fb-box.pl-fb .fb-path i { color: color-mix(in srgb, var(--accent-ink) 70%, transparent); }
@media (max-width: 700px) { #uc .uc-np.pinned { min-height: 60vh; } }

/* beta 58: the big play / pause, the shuffled list, busy */
#uc .np-pp { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; flex: none; width: 40px !important; height: 40px !important; padding: 0 !important; border: 0 !important; border-radius: 50% !important; background: var(--accent) !important; color: var(--accent-ink) !important; box-shadow: 0 2px 6px color-mix(in srgb, var(--accent) 45%, transparent) !important; cursor: pointer; display: grid !important; place-items: center; }
#uc .np-pp svg { width: 18px; height: 18px; fill: currentColor; }
#uc .np-pp:not(.on) svg { margin-left: 2px; }
#uc .np-pp:hover { filter: brightness(1.12); }
#uc .np-pp:disabled { opacity: .35; cursor: default; }
#uc .np-head { padding: 6px 8px 0; }
#uc .np-list.shuf .pl-grip { visibility: hidden; }
#uc .np-list.shuf .pl-row { cursor: pointer; }
#uc .uc-np.busy .np-list, #uc .uc-np.busy .np-now { opacity: .5; transition: opacity .2s; }
#uc.uc-plbusy, #uc.uc-plbusy * { cursor: progress !important; }
#uc .np-tools button[data-n="clear"]:hover { color: var(--danger) !important; border-color: var(--danger) !important; }
#uc .np-nm { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
#uc .np-nm .pl-info { font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .np-sub { display: flex; align-items: center; gap: 6px; min-width: 0; }
#uc .np-sub .np-dot { margin: 0; }
#uc .tl-play { border: 4px solid #fff !important; }
#uc .tl-add { border: 3px solid #fff !important; }
#uc .np-now { border-bottom: none; padding-bottom: 1px; }
#uc .pl-btns button[data-b="dir"] svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
#uc .np-list .pl-btns button[data-b="dir"] { display: inline-grid !important; place-items: center; }

/* the Select / Sort bar with the player: nothing on either side ever wraps - the player gives way instead,
   a step at a time as it gets narrower: a shorter seek bar, no song number, the title shortens, no volume, no times,
   no seek bar, just the cover with ⏮ ▶ ⏭, then just the cover (click it for the playlist) */
#uc.uc-bpon .uc-selbar { flex-wrap: nowrap; }
#uc.uc-bpon .uc-selbar > * { flex-shrink: 0; }
#uc.uc-bpon .uc-selbar > .uc-spacer { flex: 1 1 0; min-width: 4px; }
#uc.uc-bpon .uc-selbar > .uc-bp { flex: 0 1 var(--bp-w, 720px); min-width: 34px; overflow: hidden; }
#uc .uc-selbar .uc-hidden { white-space: nowrap; }
#uc .uc-selbar > .uc-bp { container-type: inline-size; container-name: bp; }
#uc .uc-bp .vp-art .gp-ic, #uc .uc-bp .vp-cover { flex: none; }
@container bp (max-width: 620px) { #uc .uc-bp .vp-seek { width: 70px; } }
@container bp (max-width: 540px) { #uc .uc-bp .bp-qb { display: none !important; } }
@container bp (max-width: 460px) { #uc .uc-bp .vp-seek { width: 50px; } #uc .uc-bp .bp-vol { display: none; } }
@container bp (max-width: 390px) { #uc .uc-bp .vp-t, #uc .uc-bp .vp-d { display: none; } }
@container bp (max-width: 320px) { #uc .uc-bp .vp-seek { display: none; } }
@container bp (max-width: 240px) { #uc .uc-bp .vp-tags { display: none; } #uc .uc-bp .vp-stage { flex: 0 0 auto; } }
@container bp (max-width: 170px) { #uc .uc-bp .vp-prev, #uc .uc-bp .vp-next { display: none !important; } }
@container bp (max-width: 100px) { #uc .uc-bp .bp-x { display: none !important; } }
@container bp (max-width: 70px) { #uc .uc-bp .vp-bar { display: none !important; } }
#uc.uc-bpon .uc-selbar > .uc-pat { flex: 0 1 auto; min-width: 48px; }
@media (max-width: 1100px) { #uc.uc-bpon .uc-selbar > .uc-lbl { display: none; } #uc.uc-bpon .uc-selbar > .uc-pat, #uc.uc-bpon .uc-selbar > input.uc-pat { width: 90px !important; min-width: 0 !important; } }
/* too narrow for both sides and the player on one line: the player gets a line of its own */
@media (max-width: 860px) { #uc.uc-bpon .uc-selbar { flex-wrap: wrap; } #uc.uc-bpon .uc-selbar > .uc-bp { flex: 1 1 100%; order: 9; } #uc.uc-bpon .uc-selbar > .uc-spacer.bp-sp { display: none; } }
#uc .pl-ptres { padding: 7px 10px; border-radius: 6px; background: var(--surface-2); font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .pl-ptres.ok { background: color-mix(in srgb, var(--ok) 12%, var(--surface)); color: var(--ok); }
#uc .pl-ptres.bad { background: color-mix(in srgb, var(--danger) 10%, var(--surface)); color: var(--danger); }
#uc .pl-ptres[hidden] { display: none; }
#uc .fb-sp { flex: 1; }
#uc .fb-path .fb-new { font: 600 calc(11.5px * var(--fs, 1))/1 var(--sans) !important; padding: 3px 8px !important; border: 1px solid currentColor !important; border-radius: 5px !important; opacity: .9; }
#uc .fb-mk { display: flex; gap: 6px; align-items: center; padding: 6px 8px; border-bottom: 1px solid var(--line-soft); background: var(--surface-2); }
#uc .fb-mk[hidden] { display: none; }
#uc .fb-mkn { flex: 1; min-width: 0; height: 28px; box-sizing: border-box; padding: 0 8px; border: 1px solid var(--line); border-radius: var(--r-input); background: var(--surface); color: var(--ink); font: calc(13px * var(--fs, 1)) var(--sans); }
#uc .fb-jump { display: flex; flex-wrap: wrap; gap: 4px; padding: 5px 8px; border-bottom: 1px solid var(--line-soft); }
#uc .fb-jump button { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: 22px !important; padding: 0 8px !important; border: 1px solid var(--line) !important; border-radius: 11px !important; background: var(--surface) !important; color: var(--ink-2) !important; font: 500 calc(11.5px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; }
#uc .fb-jump button:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
/* Tools > Music library check */
#uc .mc-setup { display: flex; flex-direction: column; gap: 8px; }
#uc .mc-setup.ef-card { padding: 12px; }
#uc .mc-what { font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; }
#uc .mc-sum { margin: 10px 0 6px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .mc-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 8px 2px; }
#uc .mc-list { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
#uc .mc-list .ef-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 10px; align-items: center; padding: 5px 10px; border-bottom: 1px solid var(--line-soft); }
#uc .mc-list div.ef-row { grid-template-columns: minmax(0, 1fr) auto auto; }
#uc .mc-list .ef-row.on { background: var(--accent-soft); }
#uc .mc-list .ef-path { min-width: 0; overflow-wrap: anywhere; }
#uc .mc-list .ef-path .in { color: var(--muted); }
#uc .mc-meta { font-size: calc(12px * var(--fs, 1)); color: var(--ink-2); white-space: nowrap; }
#uc .mc-note { color: var(--danger); }
#uc .mc-rels { margin: 0 0 10px 18px; padding: 8px 10px; border-left: 3px solid var(--line); display: grid; gap: 6px; }
#uc .mc-rhint { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .mc-rel { display: flex; align-items: center; gap: 10px; }
#uc .mc-rt { flex: 1; min-width: 0; }
#uc .mc-rt > span:first-child { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .mc-no { color: var(--danger); } #uc .mc-yes { color: #1f7a44; }
#uc .mc-warn { font-size: calc(12px * var(--fs, 1)); }
#uc .mc-list .uc-btn { padding: 2px 10px !important; height: 26px !important; }
#uc .mc-grp { border-bottom: 1px solid var(--line); }
#uc .mc-gh { display: flex; align-items: center; gap: 8px; padding: 6px 10px; background: var(--surface-2); font-weight: 600; color: var(--accent); }
#uc .mc-gr { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 10px; align-items: center; padding: 5px 10px 5px 22px; border-top: 1px solid var(--line-soft); }
/* the playlist folded by artist and album */
#uc .np-list .pl-alb { position: absolute; left: 0; right: 0; height: 44px; box-sizing: border-box; display: grid; grid-template-columns: 14px 32px minmax(0, 1fr) auto; gap: 7px; align-items: center; padding: 0 6px; border-bottom: 1px solid var(--line-soft); background: var(--surface-2); cursor: pointer; }
#uc .np-list .pl-alb:hover { background: var(--accent-soft); }
#uc .np-list .pl-alb.now { box-shadow: inset 3px 0 0 var(--accent); }
#uc .np-list .pl-alb.now .pl-tt b { color: var(--accent); }
#uc .np-list .pl-alb .pa-car { color: var(--muted); font-size: 12px; transition: transform .15s; text-align: center; }
#uc .np-list .pl-alb.open .pa-car { transform: rotate(90deg); }
#uc .np-list .pl-alb .pl-tt b { font-weight: 700; }
#uc .np-list .pl-alb .pl-sub { color: var(--muted); }
#uc .np-list .pl-alb.art { background: color-mix(in srgb, var(--accent) 8%, var(--surface-2)); }
#uc .np-list .pl-alb.art .pl-cov { border-radius: 50%; }
#uc .np-list .pl-alb.lv1, #uc .np-list .pl-row.lv1 { padding-left: 22px; }
#uc .np-list .pl-row.lv2 { padding-left: 38px; }
#uc .np-list .pl-alb.dragging { opacity: .4; }
/* Tools > Music (two tools in one card) */
#uc .tl-sub { display: flex; align-items: center; gap: 14px; padding: 8px 0 2px; border-top: 1px solid var(--line-soft); margin-top: 6px; }
#uc .tl-sub .tl-txt { flex: 1; min-width: 0; }
/* Tools > Playlist check */
#uc .pc-setup.ef-card { padding: 12px; }
#uc .pc-res { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
#uc .pc-res[hidden] { display: none; }
#uc .pc-sum { font-size: calc(14px * var(--fs, 1)); }
#uc .pc-ok { color: var(--ok); font-weight: 600; } #uc .pc-bad { color: var(--danger); font-weight: 600; }
#uc .pc-style { font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); }
#uc .pc-map { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.4fr); gap: 6px 10px; align-items: end; padding: 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); }
#uc .pc-arrow { padding-bottom: 6px; color: var(--muted); font-size: 16px; }
#uc .pc-hint { grid-column: 1 / -1; font-size: calc(12px * var(--fs, 1)); }
#uc .pc-acts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
#uc .pc-note { color: var(--warn); font-size: calc(12.5px * var(--fs, 1)); }
#uc .pc-lh { font-weight: 700; font-size: calc(12.5px * var(--fs, 1)); color: var(--danger); }
#uc .pc-raw { display: block; font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); overflow-wrap: anywhere; }
#uc .mc-list .ef-row.gone { opacity: .45; text-decoration: line-through; }
#uc .pc-res .mc-list div.ef-row { grid-template-columns: minmax(0, 1fr) auto auto; }
#uc .uc-dlg.full.mc-dlg, #uc .uc-dlg.full.pc-dlg { max-width: min(1800px, calc(70vw - 40px)); }
#uc .ef-path { font-family: var(--sans); }
#uc .mc-list .ef-path .in { color: var(--accent); font-weight: 600; }
#uc .mc-list .ef-row { padding: 2px 10px; }
/* the folded playlist, compact: artists and songs inside albums on one line, no pictures */
#uc .np-list .pl-alb.art { grid-template-columns: 14px minmax(0, 1fr) auto; }
#uc .np-list .pl-alb.art .pa-line { min-width: 0; display: flex; align-items: baseline; gap: 8px; white-space: nowrap; overflow: hidden; }
#uc .np-list .pl-alb.art .pa-line b { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: calc(13px * var(--fs, 1)); }
#uc .np-list .pl-alb.art .pa-n { flex: none; font: calc(11px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .np-list .pl-alb.art.now .pa-line b { color: var(--accent); }
#uc .np-list .pl-alb.art .bc-eq { align-self: center; }
#uc .np-list .pl-alb.art .bc-eq i { background: var(--accent); }
#uc .np-list .pl-row.cmp { grid-template-columns: 14px minmax(0, 1fr) auto !important; }
#uc .np-list .pl-row.cmp .pl-tt { align-items: center; }
#uc .np-list .pl-row.cmp .pl-tt b { font-weight: 500; font-size: calc(12.5px * var(--fs, 1)); }
#uc .np-list .pl-row.cmp.now .pl-tt b { font-weight: 700; }
#uc .np-list .pl-row.cmp .bc-eq { margin-right: 2px; flex: none; }
#uc .np-list .pl-row.cmp .bc-eq i { background: var(--accent); }
#uc .np-list .pl-row.cmp.miss .pl-tt b { color: var(--danger); }
#uc .np-list .pl-row.cmp .pl-btns button { width: 20px !important; height: 20px !important; }
@media (max-width: 1200px) { #uc .ms-all { display: none; } }
#uc .np-list .pl-alb.art .pa-line b { flex: 0 0 auto; max-width: 65%; }
#uc .np-list .pl-alb.art .pa-n { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
#uc .np-list .pl-row.cmp { gap: 8px; }
/* artists look like folders in the panes: one line, accent, bold */
#uc .np-list .pl-alb.art:hover { background: var(--surface-2); }
#uc .np-list .pl-alb.art .pa-line b { color: var(--accent); font: 600 calc(13px * var(--fs, 1))/1.2 var(--sans); }
#uc .np-list .pl-alb.art .pl-btns button { width: 20px !important; height: 18px !important; }
#uc .np-list .pl-alb.art .pa-n { font: calc(11px * var(--fs, 1))/1.2 var(--mono); }
/* what's inside an unfolded artist sits on the cream of the cursor row */
#uc .np-list .pl-row.now, #uc .np-list .pl-row.lv1.now, #uc .np-list .pl-row.lv2.now { background: color-mix(in srgb, var(--accent) 16%, var(--surface)); border: 1px solid var(--accent); border-radius: 8px; }
/* the background of the active pane's list - also the playlist's */
#uc { --pane-active-bg: color-mix(in srgb, var(--accent) 3%, var(--surface)); }
#uc .np-list { background: var(--pane-active-bg); }
#uc .np-list .pl-alb.art { background: transparent; border-bottom: 1px solid var(--line-soft); }
#uc .np-list .pl-alb.art.now { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }
#uc .np-list .pl-alb.lv1 { background: color-mix(in srgb, var(--cursor) 60%, transparent); }
#uc .np-list .pl-alb.lv1:hover { background: var(--cursor); }
/* a long song name in the player: cut short, and it slides to show the rest */
#uc .np-slot .bp-idle .vp-stage { flex: 1 1 auto; min-width: 0; overflow: hidden; }
#uc .np-slot .bp-idle .vp-art { min-width: 0; }
#uc .uc-bp .vp-tags.mq-on { text-overflow: clip; }
#uc .uc-bp .vp-tags .mq { display: inline-block; white-space: nowrap; }
#uc .uc-bp .vp-tags.mq-on .mq { animation: uc-mq var(--mq-t, 10s) ease-in-out 1.5s infinite alternate; }
@keyframes uc-mq { 0%, 15% { transform: translateX(0); } 85%, 100% { transform: translateX(var(--mq, 0)); } }
@media (prefers-reduced-motion: reduce) { #uc .uc-bp .vp-tags.mq-on .mq { animation: none; } #uc .uc-bp .vp-tags.mq-on { text-overflow: ellipsis; } }
#uc .mc-sub { display: block; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); }
#uc .uc-bp .bp-host > .vp { flex: 1 1 auto; min-width: 0; }
#uc .uc-bp .bp-idle .vp-bar { flex: none !important; }
#uc .np-list .pl-alb.art .bc-eq i { background: var(--danger); }
#uc .bc-eq { height: fit-content; background-color: var(--cursor); padding: 3px; border: none; }
#uc .np-nm .pl-info { font: calc(11px * var(--fs, 1)) var(--sans); }
#uc .np-file { font: calc(10.5px * var(--fs, 1))/1.3 var(--sans); color: var(--accent); }
#uc .pl-btns button { color: var(--accent) !important; font: 600 calc(12px * var(--fs, 1))/1 var(--sans) !important; box-shadow: none !important; cursor: pointer; }
#uc .np-name { color: var(--accent); }
/* the terminal's folder: parts to click, like the path above the panes */
#uc .ut-dir { display: inline-flex; align-items: center; gap: 1px; }
#uc .ut-dir i { font-style: normal; color: #8c96a0; }
#uc .ut-seg { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 1px 3px !important; border: 0 !important; border-radius: 3px !important; background: none !important; box-shadow: none !important; color: inherit !important; font: inherit !important; cursor: pointer; }
#uc .ut-seg:hover { background: rgba(255,255,255,.15) !important; color: #fff !important; }
#uc .ut-clear { margin-left: 6px !important; }

/* ---------- Music check: two albums side by side (Open both) ---------- */
#uc.uc-muspair { --mus-left: 50%; }
/* rows: [tick] [▸] path · facts · Accept · Open */
#uc .mc-list .ef-row, #uc .mc-list div.ef-row { display: flex; align-items: center; gap: 10px; }
#uc .mc-list .ef-row .ef-path { flex: 1 1 auto; }
#uc .mc-list .ef-row > .uc-btn, #uc .mc-list .ef-row > .mc-meta, #uc .mc-list .ef-row > input { flex: none; }
#uc .mc-list .mc-accb, #uc .mc-gh .mc-accb { color: var(--muted) !important; }
#uc .mc-list .mc-accb:hover { color: var(--accent) !important; }
#uc .mc-gh .mc-accb { font-weight: 400; }
#uc .mc-bar .mc-bt { flex: 1 1 260px; font-size: calc(12px * var(--fs, 1)); }
#uc .mc-sum .mc-relist { margin-left: 8px; padding: 1px 10px !important; height: 24px !important; }
#uc .mc-ago { color: var(--ink-2); }
#uc .mc-chip { font-size: calc(11px * var(--fs, 1)); font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); }
#uc .mc-chip.diff { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
#uc .mc-peekb { -webkit-appearance: none; appearance: none; border: 0 !important; background: none !important; padding: 0 2px !important; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; color: var(--muted) !important; cursor: pointer; font-size: 12px; transition: transform .15s; }
#uc .mc-peekb.on { transform: rotate(90deg); color: var(--accent) !important; }
#uc .mc-peek { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px; padding: 6px 10px 8px 52px; border-bottom: 1px solid var(--line-soft); background: var(--surface-2); }
#uc .mc-peek img { width: 80px; height: 80px; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); background: var(--surface); }
#uc .mc-pfiles { display: flex; flex-direction: column; gap: 1px; font-size: calc(12px * var(--fs, 1)); color: var(--ink-2); flex-basis: 100%; }

/* ---------- the album strip in a narrow pane (iPad, small windows): picture and words on
 * the first line, the buttons on their own line under them ---------- */
#uc .uc-box { container-type: inline-size; container-name: ucbox; }
@container ucbox (max-width: 560px) {
  #uc .mus-strip { flex-wrap: wrap; row-gap: 8px; --mus-cover: 72px; }
  #uc .mus-strip .ms-txt { flex: 1 1 calc(100% - var(--mus-cover) - 12px); }
  #uc .mus-strip .ms-t { white-space: normal; overflow-wrap: anywhere; font-size: calc(16px * var(--fs, 1)); }
  #uc .mus-strip .ms-cover + .ms-txt + .uc-btn { margin-left: calc(var(--mus-cover) + 12px); }
  #uc .mus-strip .uc-btn { padding: 2px 10px !important; }
}

/* ---------- Make a cover ---------- */
#uc .cm-dlg { max-width: 720px; }
#uc .cm-wrap { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
#uc .cm-cv { width: 280px; height: 280px; border-radius: 6px; box-shadow: 0 1px 6px rgba(0,0,0,.25); flex: none; }
#uc .cm-side { flex: 1 1 240px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
#uc .cm-side .muted { font-size: calc(12px * var(--fs, 1)); line-height: 1.4; }
#uc .cm-emb { margin-top: 6px; font-weight: 600; }
/* Merge and Keep-format windows */
#uc .mg-q { font-weight: 600; margin: 10px 0 4px; }
#uc .mg-r { display: block; margin: 4px 0; line-height: 1.4; }
#uc .mg-note { margin-top: 10px; }
#uc .kf-list { max-height: 240px; overflow: auto; margin: 8px 0; padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px; font: calc(12px * var(--fs, 1)) var(--mono); background: var(--surface-2); }
/* Music check: checking again - a bar over the results */
#uc .mc-res { position: relative; }
#uc .mc-busy { display: flex; align-items: center; gap: 10px; margin: 10px 0 4px; padding: 10px 14px; border-radius: 8px; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: calc(14px * var(--fs, 1)); box-shadow: 0 2px 8px rgba(0,0,0,.15); }
#uc .mc-busy .spin { border-color: currentColor; border-right-color: transparent; }
#uc .mc-res.busy .mc-list, #uc .mc-res.busy .mc-tabs, #uc .mc-res.busy .mc-bar { opacity: .45; pointer-events: none; transition: opacity .2s; }
#uc .mg-sub { margin-left: 26px !important; }

/* ---------- New tab: the button and this tab's name ---------- */
/* New tab: the button with the tab's name box joined to it */
#uc .uc-tabcombo { display: inline-flex; align-items: stretch; flex: none; }
#uc .uc-tabcombo[hidden] { display: none !important; }
#uc .uc-tabcombo .uc-tabbtn { border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important; }
#uc .uc-appbar .uc-tabname { -webkit-appearance: none; appearance: none; margin: 0 !important; min-width: 0 !important; height: auto !important; box-shadow: none !important; width: 130px; max-width: 130px; padding: 0 8px !important; border: 1px solid var(--line) !important; border-left: 0 !important; border-radius: 0 6px 6px 0 !important; background: var(--surface) !important; color: var(--ink) !important; font: 600 calc(12px * var(--fs, 1)) var(--sans, inherit); text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: text; max-height: none; }
#uc .uc-appbar .uc-tabname.empty { color: var(--muted) !important; font-style: italic; font-weight: 400; opacity: .75; }
#uc .uc-appbar .uc-tabname:hover { border-color: var(--accent) !important; }
/* the New tab panel */
#uc .uc-tabpop { position: fixed; z-index: 60; width: 300px; padding: 12px; display: flex; flex-direction: column; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 8px 28px rgba(0,0,0,.22); }
#uc .uc-tabpop[hidden] { display: none !important; }
#uc .tp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
#uc .tp-row .uc-btn { height: 34px !important; display: flex; align-items: center; justify-content: center; text-decoration: none; background: var(--surface-3); border-color: var(--line-strong, var(--line)); color: var(--ink); font-weight: 600; }
#uc .tp-row .uc-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
#uc .uc-tabpop, #uc .uc-tabpop .chk, #uc .uc-tabpop input { font-size: calc(12.5px * var(--fs, 1)); }
#uc .tp-tip { grid-column: 1 / -1; margin-top: -4px; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); text-align: right; }
#uc .tp-row .uc-btn:only-child { grid-column: 1 / -1; }
#uc .tp-show { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 6px 10px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
#uc .tp-show .chk { grid-column: 2; justify-self: start; }
#uc .tp-show .tp-l { grid-row: 1; }
#uc .tp-row .tp-app { grid-column: 1 / -1; }
#uc .tp-l { font-weight: 600; color: var(--ink-2); font-size: calc(12.5px * var(--fs, 1)); }
#uc .tp-name { display: flex; align-items: center; gap: 8px; padding-top: 10px; border-top: 1px solid var(--line-soft); }
#uc .tp-name .tp-in { flex: 1; min-width: 0; }
#uc .tp-in::placeholder, #uc .tn-in::placeholder { font-style: italic; color: var(--muted); opacity: .75; }
/* tabs inside unCommander (application window, iPad Home Screen app): a row at the very top.
 * Its colours, by name (change them here or in Settings > Custom CSS). A colour with
 * see-through in it is written color-mix(in srgb, <colour> 75%, transparent): 75% of the
 * colour, the rest see-through. */
#uc {
  --wt-bar: #797979;            /* the row */
  --wt-line: #919191;           /* the row's bottom line */
  --wt-tab: #d4d4d4;            /* a tab that isn't shown */
  --wt-x: #8b8b8b;              /* a tab's ✕ */
  --wt-add-line: #bcbcbc;       /* the + button's dashed outline */
  --wt-add: color-mix(in srgb, var(--surface-3) 75%, transparent);          /* the + */
  --wt-add-hover: color-mix(in srgb, var(--surface-3) 14%, transparent);    /* behind the + under the mouse */
}
#uc.uc-dark { --wt-bar: #23282d; --wt-line: #3a4047; --wt-tab: #353b42; --wt-x: #8a949d; --wt-add-line: #4a525b; }
#uc .uc-wintabs { display: flex; align-items: flex-end; gap: 2px; padding: 8px 8px 0; background: var(--wt-bar); border-bottom: 1px solid var(--wt-line); flex: none; }
/* (no scrolling box: it would cut off the shown tab, which sits over the row's bottom line; many tabs shrink instead) */
#uc .uc-wintabs .wt { display: flex; align-items: center; gap: 6px; max-width: 200px; min-width: 70px; padding: 4px 4px 4px 18px; border: 1px solid transparent; border-bottom: 0; border-radius: 7px 7px 0 0; background-color: var(--wt-tab); color: var(--ink-2); font-size: calc(12.5px * var(--fs, 1)); cursor: pointer; user-select: none; }
/* just one tab (no ✕): the same room on its right as on its left */
#uc .uc-wintabs .wt:only-of-type { padding-right: 18px; }
#uc .uc-wintabs .wt:hover { background: var(--surface); }
/* the tab shown: bigger, so taller; over the row's bottom line, so the line doesn't show under it */
#uc .uc-wintabs .wt.on { background: linear-gradient(to bottom, var(--surface), var(--surface-3)); border-color: var(--line); color: var(--accent); font-weight: 700; margin-bottom: -1px; font-size: 16px; padding-top: 4px; padding-bottom: 7px; }
#uc .uc-wintabs .wt-n { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-style: italic; }
#uc .uc-wintabs .wt.on .wt-n { font-style: normal; }
#uc .uc-wintabs .wt-x { -webkit-appearance: none; appearance: none; border: 0 !important; background: none !important; box-shadow: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 1px 5px !important; border-radius: 4px !important; color: var(--wt-x) !important; cursor: pointer; font-size: 11px; line-height: 1.2; }
#uc .uc-wintabs .wt-x:hover { background: var(--surface-3) !important; color: var(--danger) !important; }
/* + : its top lines up with the tabs that aren't shown */
#uc .uc-wintabs .wt-add { -webkit-appearance: none; appearance: none; box-shadow: none !important; min-width: 0 !important; height: auto !important; cursor: pointer; line-height: 1.26; font-size: 16px; padding: 2px 9px 4px !important; margin: 0 0 0 4px !important; align-self: flex-end; border: 1px dashed var(--wt-add-line) !important; border-bottom: 0 !important; border-radius: 7px 7px 0 0 !important; background: none !important; color: var(--wt-add) !important; }
#uc .uc-wintabs .wt-add:hover { color: var(--surface) !important; background-color: var(--wt-add-hover) !important; }
#uc .uc-tabpop .tp-tip { text-align: right; }

/* ---------- Send to… (copies of the playlist) and Save as ---------- */
#uc .pl-sent { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; margin-bottom: 10px; background: var(--surface-2); display: flex; flex-direction: column; gap: 4px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pl-sent-h { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
#uc .pl-sent-r { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 10px; align-items: center; }
#uc .pl-sent-p { font: calc(12px * var(--fs, 1)) var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-2); }
#uc .pl-sent .uc-btn { padding: 2px 10px !important; }
#uc .pl-kodi { display: flex; flex-direction: column; gap: 6px; margin: 8px 0; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; }
#uc .pl-xsp { margin-left: 24px; line-height: 2; }
#uc .pl-xsp .muted { line-height: 1.4; font-size: calc(12px * var(--fs, 1)); }
#uc .pl-xsp .pl-xlim { width: 70px; }
#uc .pl-lines .pl-grid { line-height: 1.4; margin-top: 4px; }
#uc .pl-lines .pl-grid input, #uc .pl-lines .pl-grid select { width: 100%; }
#uc .pl-big { padding: 8px 10px; border-radius: 6px; background: color-mix(in srgb, var(--warn, #d08b00) 14%, var(--surface)); border: 1px solid color-mix(in srgb, var(--warn, #d08b00) 45%, var(--surface)); }
#uc .pl-big .uc-btn { margin-left: 6px; }
#uc .uc-dlg.ps-dlg { max-width: 620px; }
#uc .ps-dlg .pl-inrow { display: flex; gap: 6px; }
#uc .ps-dlg .pl-inrow input { flex: 1; min-width: 0; }
#uc .ps-note { margin-top: 10px; line-height: 1.45; }
#uc .ps-warn { margin-top: 6px; color: var(--danger); }
/* the playlist panel's buttons: Playlists…, pin and ✕ on the first line; Save, Save as…, Send…, Clear under them */
#uc .np-tools { flex-wrap: wrap; row-gap: 5px; }
#uc .np-tools .np-open { order: 1; flex: 1 1 calc(100% - 72px) !important; }
#uc .np-tools [data-n="pin"] { order: 2; }
#uc .np-tools [data-n="x"] { order: 3; }
#uc .np-tools [data-n="save"], #uc .np-tools [data-n="saveas"], #uc .np-tools [data-n="send"], #uc .np-tools [data-n="clear"] { order: 4; flex: 1 1 auto !important; }
/* Music check: what Lidarr is doing for a row */
#uc .mc-lid { flex: 0 1 auto; max-width: 340px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: calc(12px * var(--fs, 1)); padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-2); }
#uc .mc-lid.busy { color: var(--accent); border-color: var(--accent); }
#uc .mc-lid.busy .spin { width: 10px; height: 10px; vertical-align: -1px; }
#uc .mc-lid.ok { color: var(--ok); border-color: color-mix(in srgb, var(--ok) 50%, var(--surface)); }
#uc .mc-lid.bad { color: var(--danger); border-color: color-mix(in srgb, var(--danger) 50%, var(--surface)); }
#uc .mc-lid.need { color: var(--warn); border-color: var(--warn); font-weight: 600; }
#uc .mc-lidpick { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 10px 8px 34px; border-bottom: 1px solid var(--line-soft); background: color-mix(in srgb, var(--warn) 8%, var(--surface)); font-size: calc(12.5px * var(--fs, 1)); }
#uc .mc-lidpick select { max-width: 360px; }
/* Playlists… > Delete playlists… */
#uc .uc-dlg.pd-dlg { max-width: 560px; }
#uc .pd-list { max-height: 50vh; overflow: auto; margin-top: 10px; display: flex; flex-direction: column; gap: 2px; }
#uc .pd-g { font-weight: 700; color: var(--accent); margin: 8px 0 2px; }
#uc .pd-r { padding: 3px 4px; }
/* Send to…: the rarely needed fields folded away */
#uc .pl-adv { margin-top: 10px; border: 1px solid var(--line-soft); border-radius: 8px; padding: 6px 10px; }
#uc .pl-adv > summary { cursor: pointer; color: var(--ink-2); font-weight: 600; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pl-adv[open] > summary { margin-bottom: 8px; }
#uc .pl-extl { align-self: center; color: var(--muted); font: calc(13px * var(--fs, 1)) var(--mono); }
/* Send to…: only as tall as what it shows */
#uc .pl-send .dlg-body { height: auto; max-height: calc(100vh - 120px); overflow: auto; }
#uc .pl-send .pl-save, #uc .pl-send .pl-sbody { height: auto; flex: none; overflow: visible; }
#uc .pl-send .pl-prev { max-height: 110px; overflow: auto; margin: 0; }
#uc .pl-send .pl-adv { padding: 8px 10px; }
#uc .pl-send .pl-adv:empty { display: none; }
/* Music check: wide enough for its lists and buttons on a laptop screen too */
#uc .uc-dlg.full.mc-dlg { max-width: min(1800px, max(calc(70vw - 40px), 1080px), calc(100vw - 24px)); }
#uc .mc-tabs .ct-f { padding-left: 10px; padding-right: 10px; }
#uc .mc-tabs .mc-tlid { border-color: var(--accent); color: var(--accent); font-weight: 600; }
#uc .mc-tabs .mc-tlid.on { background: var(--accent); color: var(--accent-ink); }
#uc .mc-lrow .uc-btn { flex: none; }
/* Send to…: the newer destinations */
#uc .pl-lib { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: calc(12.5px * var(--fs, 1)); color: var(--ink-2); padding: 6px 10px; border-radius: 6px; background: var(--surface-2); }
#uc .pl-lib .pl-lib-in { flex: 1 1 260px; min-width: 0; font-family: var(--mono); }
#uc .pl-r2 { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; min-height: 34px; }
#uc .pl-r2 input[type=text] { width: 140px; }
#uc .pl-r2 input[type=text]:disabled { opacity: .5; }
#uc .pl-fh { font-size: calc(11.5px * var(--fs, 1)); margin-top: 2px; }

/* Send › Kodi: network shares from Unassigned Devices */
#uc .pl-ud { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: calc(12.5px * var(--fs, 1)); }
#uc .pl-udsh { display: inline-flex; align-items: center; gap: 6px; padding: 2px 3px 2px 9px; border: 1px solid var(--line); border-radius: 16px; }
#uc .pl-udsh i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); opacity: .5; }
#uc .pl-udsh.on i { background: #1f8a4c; opacity: 1; }
#uc .pl-udl { font-weight: 600; }
#uc .pl-udsh {
  background-color: var(--accent-soft-t);
}

#uc .pl-udsh.here {
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 700;
}

#uc .pl-udsh .uc-btn {
  padding: 2px 9px;
  min-height: 0;
  font-size: .92em;
  font-weight: 500;
}
/* /mnt/remotes, /mnt/disks: what isn't mounted */
#uc .ud-strip { flex: none; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding: 7px 10px; border-bottom: 1px solid var(--line); background: var(--surface-2); font-size: calc(12.5px * var(--fs, 1)); }
#uc .ud-strip .ud-l { font-weight: 600; color: var(--muted); }
#uc .ud-strip > .uc-btn { padding: 3px 12px; min-height: 0; }
/* User Scripts */
#uc .us-dlg .us-list { display: grid; }
#uc .us-tools { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
#uc .us-tools .us-q { flex: 1; min-width: 0; max-width: 360px; }
#uc .us-tools .us-cnt { margin-left: auto; font-size: .92em; }
#uc .us-row { display: flex; align-items: center; gap: 8px; padding: 8px 4px; border-bottom: 1px solid var(--line-soft); }
#uc .us-row .us-n, #uc .us-row .us-tt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
#uc .us-row .us-d { font-size: .9em; color: var(--muted); white-space: normal; overflow-wrap: anywhere; font-weight: 400; }
#uc .us-row.us-ed .chk { flex: 1; min-width: 0; }
#uc .us-row.us-ed.off { opacity: .75; }
#uc .us-row .us-ord { display: flex; gap: 4px; flex: none; }
#uc .us-row .us-ord .uc-btn { min-width: 34px; padding: 3px 0; }
#uc .us-row .us-run { color: var(--ok); font-size: .85em; font-weight: 600; }
#uc .us-hint { margin-bottom: 8px; }
#uc .uc-dlg .chk {
  align-items: flex-start;
  color: var(--accent);
}

#uc .uc-dlg .chk > input {
  margin-top: 4px;
  flex: none;
  margin-right: 10px;
}
/* the output, like User Scripts' window: a web page, monospace, the theme's background */
#uc .us-out { height: min(66vh, calc(100vh - 230px)); overflow: auto; padding: 10px 12px; background: var(--surface-2); color: var(--ink); border: 1px solid var(--line); border-radius: var(--r); font: calc(12.5px * var(--fs, 1))/1.45 var(--mono); }
#uc .us-out .us-text { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 10px; }
#uc .us-out .us-note { color: var(--danger); }
/* /mnt/remotes, /mnt/disks rows: mounted · un-mount / mount */
#uc .uc-row .ud-pill, #uc .uc-row .ud-act { display: inline-block; margin-left: 10px; padding: 1px 9px; border-radius: 10px; font: 500 calc(11px * var(--fs, 1))/16px var(--sans); vertical-align: 1px; }
#uc .uc-row .ud-pill.on { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok); border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent); }
#uc .uc-row .ud-act { appearance: none !important; margin: 0 0 0 6px !important; min-width: 0 !important; height: auto !important; border: 1px solid var(--line) !important; background: var(--surface) !important; color: var(--ink-2) !important; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; }
#uc .uc-row .ud-act.on { margin-left: 0 !important; border-color: var(--accent) !important; color: var(--accent) !important; background: var(--accent-soft-t) !important; }
#uc .uc-row .ud-act:hover { border-color: var(--accent) !important; color: var(--accent) !important; }
#uc .uc-row.ghost .col-name { color: var(--muted); }
/* Clean up */
#uc .cl-list { display: grid; gap: 2px; }
#uc .cl-row { padding: 9px 4px; border-bottom: 1px solid var(--line-soft); }
#uc .cl-row .cl-t { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
#uc .cl-row .cl-h { display: flex; gap: 12px; align-items: baseline; }
#uc .cl-row .cl-sz { margin-left: auto; font: 600 calc(12.5px * var(--fs, 1)) var(--mono); color: var(--ink-2); white-space: nowrap; }
#uc .cl-row .cl-d { font-size: .92em; color: var(--muted); }
#uc .cl-tot { margin-top: 10px; }
#uc .uc-tmodal.over { z-index: 10010; }
/* the mount pills: a column of their own at the right of the name, next to Size - lined up on every row */
#uc .uc-row .col-name:has(.ud-cell) { display: flex; align-items: center; }
#uc .uc-row .ud-cell { margin-left: auto; padding-left: 10px; width: 170px; flex: none; display: flex; align-items: center; gap: 6px; }
#uc .uc-row .ud-cell .ud-pill, #uc .uc-row .ud-cell .ud-act { margin-left: 0 !important; }
#uc .us-row .us-n, #uc .us-row .us-tt {
  color: var(--accent);
}
#uc .uc-btn.danger {
  background-color: var(--danger);
  color: var(--accent-ink);
  padding: 8px 12px;
}
#uc .st-help .warnbox ul { margin: 6px 0 0 18px; padding: 0; }
/* the array is stopped */
#uc .uc-arraybar { padding: 7px 12px; background: color-mix(in srgb, var(--warn) 16%, var(--surface)); border-bottom: 1px solid color-mix(in srgb, var(--warn) 40%, var(--line)); color: var(--ink); font-size: calc(12.5px * var(--fs, 1)); }
#uc.uc-noarray .uc-toolbtn[data-opentool], #uc.uc-noarray .uc-plbtn, #uc.uc-noarray .uc-bm.arr { opacity: .4; pointer-events: none; }
/* first launch */
#uc .su-dlg .su-intro { margin-bottom: 12px; line-height: 1.5; }
#uc .su-dlg .su-res { margin: 8px 0; font-weight: 600; }
#uc .su-dlg .su-ok { color: var(--ok); } #uc .su-dlg .su-warn { color: var(--warn); } #uc .su-dlg .su-bad { color: var(--danger); }
#uc .su-dlg .su-more { margin-top: 10px; }
#uc .st-safe { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 8px 0; }
#uc .st-safe > span { min-width: 0; overflow-wrap: anywhere; }
#uc .tp-row .uc-btn:hover, #uc .tp-row .uc-btn:focus-visible { border-color: var(--accent) !important; color: var(--accent) !important; background: var(--accent-soft) !important; text-decoration: none !important; }
#uc .uc-tabpop .tp-tip {
  text-align: left;
}
#uc .uc-tabpop {
  border: 1px solid #adadad;
}
#uc .st-ok { color: var(--ok); font-weight: 600; }
#uc .st-bad { color: var(--danger); font-weight: 600; }
/* Go to… panel */
#uc .uc-gopop { position: fixed; z-index: 60; width: 340px; max-height: min(80vh, 640px); overflow: auto; padding: 6px; background: var(--surface); border: 1px solid #adadad; border-radius: 10px; box-shadow: 0 8px 28px rgba(0,0,0,.22); font-size: calc(13px * var(--fs, 1)); }
#uc .uc-gopop[hidden] { display: none !important; }
#uc .go-sec { padding: 4px 0 6px; }
#uc .go-sec + .go-sec { border-top: 1px solid var(--line-soft); }
#uc .go-h { padding: 6px 10px 4px; font: 600 calc(10.5px * var(--fs, 1))/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--head-ink, var(--muted)); }
#uc .go-h span { margin-left: 4px; color: var(--ink-2); }
#uc .go-row { appearance: none !important; display: flex !important; align-items: center; gap: 10px; width: 100%; margin: 0 !important; padding: 6px 10px !important; border: 0 !important; border-radius: 6px; background: none !important; color: var(--ink) !important; text-align: left; cursor: pointer; font-size: inherit; text-transform: none !important; letter-spacing: 0 !important; height: auto !important; min-width: 0 !important; }
#uc .go-row svg, #uc .go-chip svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.3; }
#uc .go-row .go-l { font-weight: 600; }
#uc .go-row .go-p { margin-left: auto; font: calc(11.5px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .go-row:hover, #uc .go-row:focus-visible, #uc .go-chip:hover, #uc .go-chip:focus-visible { background: var(--accent-soft) !important; outline: none; }
#uc .go-row.on, #uc .go-chip.on { background: var(--accent-soft-t) !important; box-shadow: inset 3px 0 0 var(--accent); }
#uc .go-row[disabled], #uc .go-chip[disabled] { opacity: .45; cursor: default; }
#uc .go-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 4px; padding: 2px 6px; }
#uc .go-chip { appearance: none !important; display: flex !important; align-items: center; gap: 7px; margin: 0 !important; padding: 6px 8px !important; border: 1px solid var(--line-soft) !important; border-radius: 6px; background: var(--surface-2) !important; color: var(--ink) !important; font-size: inherit; font-weight: 600; cursor: pointer; text-transform: none !important; letter-spacing: 0 !important; height: auto !important; min-width: 0 !important; }
/* Duplicates */
#uc .dp-modes { display: grid; gap: 6px; }
#uc .ef-sec.dp-min { display: flex; flex-direction: row; align-items: center; gap: 8px; flex-wrap: wrap; text-align: left; }
#uc .dp-min .dp-minv { width: 70px; }
#uc .dp-bar { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 8px 4px; background: var(--surface); border-bottom: 1px solid var(--line); }
#uc .dp-bar .dp-del { margin-left: auto; }
#uc .dp-bar .dp-in { width: 260px; }
#uc .dp-grp { padding: 8px 4px; border-bottom: 1px solid var(--line-soft); }
#uc .dp-h { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; margin-bottom: 4px; }
#uc .dp-h b { overflow-wrap: anywhere; color: var(--accent); }
#uc .dp-diff { color: var(--warn); font-weight: 600; }
#uc .dp-row { display: flex; align-items: center; gap: 10px; padding: 3px 4px 3px 8px; border-radius: 5px; cursor: pointer; font-size: calc(12.5px * var(--fs, 1)); }
#uc .dp-row.on { background: color-mix(in srgb, var(--danger) 8%, transparent); }
#uc .dp-row.on .dp-p { text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--danger) 60%, transparent); }
#uc .dp-row .dp-p { flex: 1; min-width: 0; overflow-wrap: anywhere; }
#uc .dp-row .dp-dev { flex: none; min-width: 64px; font-weight: 600; color: var(--accent); }
#uc .dp-row .dp-tag { flex: none; font-size: .85em; padding: 0 7px; border-radius: 8px; color: var(--ok); border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent); }
#uc .dp-row .dp-sz, #uc .dp-row .dp-dt { flex: none; font: calc(11.5px * var(--fs, 1)) var(--mono); color: var(--muted); }
#uc .dp-more { margin: 10px auto; display: block; }
/* What's using space */
#uc .sp-top { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
#uc .sp-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; font: calc(13px * var(--fs, 1)) var(--mono); }
#uc .sp-crumb button { appearance: none !important; background: none !important; border: 0 !important; padding: 2px 4px !important; margin: 0 !important; color: var(--accent) !important; cursor: pointer; font: inherit; text-transform: none !important; height: auto !important; min-width: 0 !important; }
#uc .sp-crumb button:last-child { color: var(--ink) !important; font-weight: 700; }
#uc .sp-tot { margin-left: auto; white-space: nowrap; }
#uc .sp-map { position: relative; flex: none; height: min(34vh, 340px); border-radius: 6px; overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); }
#uc .sp-t { position: absolute; box-sizing: border-box; margin: 1px; border-radius: 3px; overflow: hidden; padding: 4px 6px; color: #fff; font-size: calc(11.5px * var(--fs, 1)); line-height: 1.25; display: flex; flex-direction: column; text-shadow: 0 1px 2px rgba(0,0,0,.35); }
#uc .sp-t[data-go] { cursor: pointer; }
#uc .sp-t:hover { filter: brightness(1.12); }
#uc .sp-t span { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .sp-t small { opacity: .9; }
#uc .sp-t.dir { border: 1px solid rgba(255,255,255,.55); } #uc .sp-t.dir span::before { content: '📁 '; }
#uc .sp-t.vid, #uc .sp-legend i.vid, #uc .sp-k.vid { background: #7b5cc4; }
#uc .sp-t.aud, #uc .sp-legend i.aud, #uc .sp-k.aud { background: #1f9e8f; }
#uc .sp-t.img, #uc .sp-legend i.img, #uc .sp-k.img { background: #d9822b; }
#uc .sp-t.arc, #uc .sp-legend i.arc, #uc .sp-k.arc { background: #b04a5a; }
#uc .sp-t.oth, #uc .sp-legend i.oth, #uc .sp-k.oth, #uc .sp-t.rest, #uc .sp-k.rest { background: #7d8790; }
#uc .sp-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; margin: 6px 0 10px; font-size: calc(11.5px * var(--fs, 1)); color: var(--muted); }
#uc .sp-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: -8px; }
#uc .sp-list { display: grid; }
#uc .sp-row { display: grid; grid-template-columns: 14px minmax(0, 1fr) minmax(80px, 180px) 52px 80px 90px; align-items: center; gap: 10px; padding: 4px 6px; border-bottom: 1px solid var(--line-soft); font-size: calc(12.5px * var(--fs, 1)); }
#uc .sp-row.dir, #uc .sp-row.sp-up { cursor: pointer; }
#uc .sp-row.dir .sp-n { font-weight: 600; color: var(--accent); }
#uc .sp-row:hover { background: var(--accent-soft-t); }
#uc .sp-row .sp-k { width: 10px; height: 10px; border-radius: 2px; }
#uc .sp-row .sp-n { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#uc .sp-row .sp-bar { height: 8px; border-radius: 4px; background: var(--surface-3); overflow: hidden; }
#uc .sp-row .sp-bar b { display: block; height: 100%; background: var(--accent); }
#uc .sp-row .sp-pc, #uc .sp-row .sp-s { text-align: right; font: calc(11.5px * var(--fs, 1)) var(--mono); }
#uc .sp-row .sp-c { text-align: right; font-size: .9em; }
#uc .sp-top, #uc .sp-legend { flex: none; }
#uc .sp-row.sp-up { grid-template-columns: 14px 1fr; }
#uc .sp-row.sp-up .sp-n { grid-column: 2; color: var(--accent); }
#uc .dp-keep { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; flex: 1 1 100%; order: 3; }
#uc .dp-kinds { display: flex; flex-wrap: wrap; gap: 6px; }
#uc .dp-why { flex: 1 1 100%; font-size: .9em; }
#uc .dp-row .dp-tag.lo { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 45%, transparent); }
#uc .dp-row .dp-acts { flex: none; display: inline-flex; gap: 4px; }
#uc .dp-row .dp-act { appearance: none !important; margin: 0 !important; padding: 1px 7px !important; min-width: 0 !important; height: auto !important; border: 1px solid var(--line) !important; border-radius: 6px; background: var(--surface) !important; color: var(--accent) !important; font-size: calc(11px * var(--fs, 1)); line-height: 18px; cursor: pointer; }
#uc .dp-row .dp-act:hover { border-color: var(--accent) !important; background: var(--accent-soft) !important; }
#uc .dp-h .dp-both { appearance: none !important; order: 9; margin: 0 0 0 auto !important; padding: 1px 9px !important; min-width: 0 !important; height: auto !important; border: 1px solid var(--line) !important; border-radius: 6px; background: var(--surface) !important; color: var(--accent) !important; font-size: calc(11.5px * var(--fs, 1)); line-height: 20px; cursor: pointer; white-space: nowrap; }
#uc .dp-h .dp-both:hover { border-color: var(--accent) !important; background: var(--accent-soft) !important; }
#uc .fp-pick { display: inline-flex; align-items: center; gap: 4px; padding: 1px 4px 1px 9px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); font: 600 calc(11.5px * var(--fs, 1))/1.5 var(--mono); }
#uc .dp-h .dp-hb { order: 9; margin-left: auto; display: inline-flex; gap: 6px; }
#uc .dp-h .dp-hb .dp-both { margin: 0 !important; }
#uc .dp-h .dp-clr { color: var(--muted) !important; }
#uc .dp-row .dp-rmdir { color: var(--danger, #c0392b) !important; }
#uc .dp-row .dp-rmdir:hover { border-color: var(--danger, #c0392b) !important; background: color-mix(in srgb, var(--danger, #c0392b) 10%, transparent) !important; }

/* the tools' "Look in" folders (Duplicates, Empty folders) */
#uc .fl-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
#uc .fl-chips { display: inline-flex; flex-wrap: wrap; gap: 5px; flex: 1; min-width: 200px; font-size: calc(12px * var(--fs, 1)); }
#uc .fl-acts { display: inline-flex; gap: 6px; }
#uc .fp-pick .fp-x2 { font-weight: 400; opacity: .75; }
#uc .fp-pick .fp-x { appearance: none !important; margin: 0 !important; padding: 0 4px !important; min-width: 0 !important; height: auto !important; border: 0 !important; border-radius: 8px; background: none !important; box-shadow: none !important; color: inherit !important; font-size: calc(10px * var(--fs, 1)); line-height: 16px; cursor: pointer; opacity: .6; }
#uc .fp-pick .fp-x:hover { opacity: 1; background: color-mix(in srgb, var(--accent) 18%, transparent) !important; }
#uc .fl-fb { margin-top: 8px; border: 1px solid var(--line); border-radius: 8px; padding: 8px; background: var(--ground); }
#uc .fl-fb[hidden] { display: none; }
#uc .fl-fb .fb-list { max-height: 220px; }
#uc .fl-fbbar { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
#uc .fl-cur { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: calc(11.5px * var(--fs, 1)); }
/* Duplicates: the two kinds as tabs */
#uc .dp-desc { font-size: calc(12px * var(--fs, 1)); }
#uc .ef-setup:not([hidden]) ~ .ef-prog .ef-prog-h { display: none; }

/* Duplicates, laid out like Settings: folder tabs, cards with a header strip; the window keeps one size */
#uc .uc-dlg.dp-dlg { width: min(1500px, calc(100vw - 40px)); height: calc(100vh - 60px); }
#uc .uc-dlg.dp-dlg .dlg-body { flex: 1; max-height: none; }
#uc .dp-card { border: 1px solid var(--line); border-top-width: 1px; border-radius: 8px; background: var(--surface); padding: 0 14px 14px; display: flex; flex-direction: column; gap: 10px; }
#uc .dp-card[hidden] { display: none; }
#uc .dp-ch { margin: 0 -14px; padding: 9px 14px; font: 700 calc(12px * var(--fs, 1))/1.2 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); background: var(--surface-2); border-bottom: 1px solid var(--line-soft); border-radius: 8px 8px 0 0; }
#uc .dp-desc { color: var(--ink-2); font-size: calc(12.5px * var(--fs, 1)); line-height: 1.45; }
#uc .dp-note { color: var(--ink-2); font-size: calc(12px * var(--fs, 1)); }
#uc .dp-card .dp-min { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
#uc .dp-card .ef-lbl { color: var(--ink-2); }
#uc .dp-card .fl-chips { flex: 0 1 auto; min-width: 0; }
#uc .dp-card .fp-pick, #uc .uc-dlg .fl-row .fp-pick { font-size: calc(12px * var(--fs, 1)); padding: 3px 5px 3px 10px; border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); }
#uc .fl-row .fl-chips { flex: 0 1 auto; }
#uc .dp-res { padding-bottom: 6px; }
#uc .dp-res .dp-bar { position: sticky; top: -12px; z-index: 2; display: block; margin: 0 -14px; padding: 0 14px 10px; background: var(--surface); border-bottom: 1px solid var(--line); border-radius: 8px 8px 0 0; }
#uc .dp-res .dp-top { display: flex; align-items: center; gap: 14px; margin: 0 -14px 10px; padding: 6px 8px 6px 14px; }
#uc .dp-res .dp-top .dp-sum { font: 600 calc(13px * var(--fs, 1))/1.2 var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink); }
#uc .dp-res .dp-top .dp-del { margin-left: auto; text-transform: none; letter-spacing: 0; }
#uc .dp-res .dp-keep { display: flex; flex-direction: column; gap: 8px; }
#uc .dp-trow { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 10px; }
#uc .dp-tl { width: 46px; flex: none; font: 700 calc(11px * var(--fs, 1))/1 var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
#uc .dp-szl { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); font-size: calc(12.5px * var(--fs, 1)); }
#uc .dp-seg { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
#uc .dp-seg button { appearance: none !important; margin: 0 !important; min-width: 0 !important; height: auto !important; padding: 5px 12px !important; border: 0 !important; border-right: 1px solid var(--line) !important; border-radius: 0 !important; background: var(--surface-2) !important; box-shadow: none !important; color: var(--ink) !important; font: 600 calc(12px * var(--fs, 1))/1.2 var(--sans) !important; text-transform: none !important; letter-spacing: 0 !important; cursor: pointer; }
#uc .dp-seg button:last-child { border-right: 0 !important; }
#uc .dp-seg button:hover { background: var(--accent-soft) !important; color: var(--accent) !important; }
#uc .dp-res .dp-why { color: var(--ink-2); font-size: calc(11.5px * var(--fs, 1)); }
#uc .dp-res .dp-in { width: 260px; }
#uc .dp-grp { padding: 10px 6px; }
#uc .dp-grp.some { background: color-mix(in srgb, var(--danger) 3%, transparent); }
#uc .dp-row { padding: 4px 6px 4px 8px; border-left: 3px solid transparent; }
#uc .dp-row:nth-of-type(odd) { background: var(--surface-2); }
#uc .dp-row:hover { background: var(--accent-soft); }
#uc .dp-row.on, #uc .dp-row.on:nth-of-type(odd) { background: color-mix(in srgb, var(--danger) 14%, transparent); border-left-color: var(--danger); }
#uc .dp-row.on .dp-p { color: var(--danger); }
#uc .dp-grp {
  border-bottom: 2px solid #c6c6c6;
}
#uc .dp-res .dp-keep { align-items: stretch; text-align: left; }
#uc .dp-res .dp-trow { justify-content: flex-start; }
#uc .dp-res .dp-top .dp-del { font: 600 calc(12.5px * var(--fs, 1))/1.2 var(--sans) !important; }

/* Duplicates: the two lists as big choices - the one you're on is unmistakable */
#uc .dp-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
#uc .dp-tab { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; align-items: start; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); cursor: pointer; transition: border-color .12s, background .12s; }
#uc .dp-tab:hover { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
#uc .dp-tab input { grid-row: 1 / span 2; margin: 2px 0 0; accent-color: var(--accent); width: 16px; height: 16px; }
#uc .dp-tab .dp-tt { font: 700 calc(14px * var(--fs, 1))/1.3 var(--sans); color: var(--ink); }
#uc .dp-tab .dp-td { color: var(--ink-2); font-size: calc(12px * var(--fs, 1)); line-height: 1.45; }
#uc .dp-tab .dp-now { display: none; position: absolute; top: -9px; right: 12px; padding: 1px 9px; border-radius: 9px; background: var(--accent); color: var(--accent-ink); font: 700 calc(10.5px * var(--fs, 1))/1.6 var(--sans); }
#uc .dp-tab.on { border: 2px solid var(--accent); padding: 11px 13px; background: var(--accent-soft); }
#uc .dp-tab.on .dp-tt { color: var(--accent); }
#uc .dp-tab.on .dp-now { display: block; }
#uc .dp-top .dp-rname { color: var(--accent); }
@media (max-width: 700px) { #uc .dp-tabs { grid-template-columns: 1fr; } }

#uc .dp-ch {
  margin: 0 -14px;
  padding: 5px 14px;
  font: 700 calc(12px * var(--fs, 1))/1.2 var(--mono);
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--ink-2);
  background:var(--accent-soft-t);
  border-bottom: 1px solid #a9a9a9;
  border-radius: 8px 8px 0 0;
}

#uc .dp-card {
  border: 1px solid #a9a9a9;
    border-top-width: 1px;
  border-top-width: 1px;
  border-radius: 8px;
  background: var(--surface);
  padding: 0 14px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#uc .dp-grp {
  border-bottom: 2px solid #a9a9a9;
}

#uc .dp-grp {
  padding: 8px 6px;
}

#uc .dp-h {
  display: flex;
  gap: 12px;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 4px;
  margin-left: -20px;
  background-color: #f3f3f3;
  margin-right: -20px;
  padding: 9px 20px;
  margin-top: -10px;
  border-top: 1px solid #a9a9a9;
  border-bottom: 1px solid #dbdbdb;
}
#uc .dp-list > .dp-grp:last-of-type { border-bottom: 0; }

#uc .ut-pbox { display: flex; gap: 8px; align-items: stretch; padding: 6px 8px; background: #1b1b1b; border-bottom: 1px solid #333; }
#uc .ut-pbox[hidden] { display: none; }
#uc .ut-pta { flex: 1; height: 38px; min-height: 0; resize: none; background: #000; color: #ddd; border: 1px solid var(--accent); border-radius: 4px; padding: 8px; font: calc(12px * var(--fs, 1))/1.3 var(--mono); }
#uc .ut-paste { margin-left: 4px !important; }
/* the copy that stays: pale green, the whole row */
#uc .dp-row.keep, #uc .dp-row.keep:nth-of-type(odd) { background: color-mix(in srgb, var(--ok) 13%, var(--surface)); border-left-color: var(--ok); }
#uc .dp-row.keep .dp-tag:not(.lo):not(.fold) { background: var(--ok); color: #fff; border-color: var(--ok); font-weight: 600; }
#uc .dp-row .dp-tag.fold { color: var(--ink-2); border-color: var(--line); }
#uc .dp-ok { color: var(--ok); font-weight: 600; }
#uc .dp-res .dp-tickvis { background: color-mix(in srgb, var(--ok) 16%, var(--surface)) !important; border-color: color-mix(in srgb, var(--ok) 55%, var(--line)) !important; color: var(--ink) !important; font-weight: 600 !important; }
#uc .dp-res .dp-tickvis:hover { background: color-mix(in srgb, var(--ok) 26%, var(--surface)) !important; }
#uc .dp-row .dp-dev {
  min-width: 34px;
}

#uc .dp-min .dp-minv {
  padding-left: 6px;
}

#uc .ut-pta {
  flex: 1;
  height: 38px;
  min-height: 0;
  resize: none;
  background: #000;
  color: #ffd11b;
  border: 1px solid #7a6510;
  border-radius: 4px;
  padding: 8px;
  font: calc(12px * var(--fs, 1))/1.3 var(--mono);
}

#uc .ut-pbox {
  display: flex;
  gap: 8px;
  align-items: stretch;
  padding: 6px 8px;
  background: #4e4e4e;
  border-bottom: 1px solid #4e4e4e;
}
#uc .ut-pbox .ut-pta::placeholder { color: var(--ut-dim, #808080) !important; opacity: 1 !important; font-style: normal !important; }
#uc .ut-pta:focus { outline: 1px solid #7a6510; outline-offset: 0; border-color: #7a6510; box-shadow: 0 0 0 2px #7a6510; }
/* paste w/ edit: Run and Close (own classes - .ut-b is the header buttons) */
#uc .ut-pbox .ut-prun { height: 38px !important; background: #2f7d46 !important; border-color: #2f7d46 !important; color: #fff !important; }
#uc .ut-pbox .ut-prun:hover { filter: brightness(1.1); }
#uc .ut-pbox .ut-pcan { height: 38px !important; }

#uc .ut-b {
  border: 1px solid #7f7f7f !important;
}

/* changed lately (Settings > General): the name and date in their own colour */
#uc { --recent: #0a8a3a; }
#uc.uc-dark { --recent: #4fd27a; }
#uc .uc-row.recent:not(.sel) .col-name, #uc .uc-row.recent:not(.sel) .col-date { color: var(--recent); }
#uc .uc-row.recent:not(.sel) .col-name { font-weight: 600; }
/* the Jump box while it filters the list */
#uc .uc-jump.filtering { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); background: var(--accent-soft); }
/* Settings > Keyboard */
#uc .st-kgrp { margin: 14px 0 4px; display: flex; flex-direction: column; gap: 6px; }
#uc .st-kh { font-weight: 700; color: var(--head-ink, inherit); }
#uc .st-fkgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 6px 14px; margin: 4px 0 0 26px; }
#uc .st-fkk { display: flex; align-items: center; gap: 8px; }
#uc .st-fkk kbd { min-width: 34px; text-align: center; }
#uc .st-fkk select { flex: 1; min-width: 0; }
#uc .st-recent { flex-wrap: wrap; align-items: center; gap: 8px; margin: 10px 0; }
#uc .st-recent .muted { flex-basis: 100%; }
#uc .uc-fkeys[hidden] { display: none !important; }
#uc .st-radio input { flex: none; }
/* the jump / filter switch inside the Jump box */
#uc .uc-clrwrap.j > input { padding-left: 28px !important; }
#uc .uc-jmode { appearance: none !important; -webkit-appearance: none !important; position: absolute; left: 4px; top: 50%; transform: translateY(-50%); z-index: 1; width: 20px !important; height: 20px !important; min-width: 0 !important; margin: 0 !important; padding: 0 !important; border: 0 !important; border-radius: 4px !important; background: transparent !important; color: var(--muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
#uc .uc-jmode svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#uc .uc-jmode:hover { background: color-mix(in srgb, var(--ink) 12%, transparent) !important; color: var(--ink); }
#uc .uc-jmode.on { color: var(--accent); }
#uc .uc-jmode.on svg { fill: color-mix(in srgb, var(--accent) 25%, transparent); }
#uc .st-about {
  font-size: calc(13px * var(--fs, 1));
  line-height: 1.55;
  margin-top: -5px;
}

#uc .st-logo {
  display: block;
  width: min(360px, 100%);
  height: auto;
  margin: none;
  margin-top: -16x;
  margin-left: -16px;
}

/* inside an archive (read-only): the archive in the path bar, and a quiet hint in the pane */
#uc .tr-seg.arc { background: var(--arc-pill-bg, var(--arc-bg, color-mix(in srgb, var(--warn, #d08a00) 16%, transparent))); border: none; border-radius: 6px; padding: 2px 7px; }
#uc .tr-seg.arc, #uc .uc-path.active .tr-seg.arc.here { font-weight: 400; }
/* inside an archive: the strip under the pane header */
#uc .uc-arcbar { display: flex; align-items: center; gap: 10px; padding: 5px 12px; font-size: calc(12px * var(--fs, 1)); color: var(--arc-bar-ink, var(--ink)); background: var(--arc-bar-bg, var(--arc-bg, color-mix(in srgb, var(--warn, #d08a00) 14%, var(--surface)))); border-bottom: none; }
#uc .uc-arcbar[hidden] { display: none; }
#uc .uc-arcbar .ab-t { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#uc .uc-arcclose { flex: none; font: inherit; font-weight: 600; padding: 3px 10px; border-radius: var(--r-btn, 6px); border: 1px solid var(--muted); background: var(--surface); color: var(--muted); cursor: pointer; }
#uc .uc-arcclose:hover { background-color: var(--accent); border-color: var(--accent); color: var(--accent-ink, #fff); }
/* function keys that can't work inside an archive */
#uc .uc-fk.arc-off { opacity: .38; }
]]></INLINE>
</FILE>
